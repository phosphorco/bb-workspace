amends "workbench:plan"

meta {
  title = "Context Magnet installation and BB usage proof: Codex and Claude"
  goal = "Deliver a repeatable, published-source Workbench Context Magnet installation for Codex and Claude used through BB, and genuine thread-associated observations in the BB inspector for both harnesses. Finish only with accepted installation, live evidence, cleanup, and publication—not fixture counts or a working unavailable panel."
}

// Brief: /home/ubuntu/.bb/thread-storage/thr_6m53rk7vvv/BRIEF.md
// NEW campaign and sibling ledger: no imported evidence, completions or rulings.
// The session-etl-refactor plan/ledger are historical inputs, not execution state.
// Current request authorizes planning only. Grants below document ownership;
// they do not authorize installation, provider launches, live writes or push.
// Native BB/public Plugin SDK first. No fork/build/SDK changes are planned.
// Keep genuine contribution, native observation, association, and model use
// separate. Claude cannot be dropped or passed by reusing a Codex fixture.
// Expand exact remaining implementation/live/publication nodes after discovery;
// preserve these acceptance gates and add their real producer dependencies.

local installationMap = new Action {
  id = "installation-map"
  owner = "planner"
  outcome = "Read today's source, repository status/remotes, selected Workbench/runtime provenance, and actual BB Codex/Claude launch and hook configuration paths. Produce a source-cited minimal installation route for BOTH harnesses: supported versions, hook events/encoding/trust, BB-selected executable/config paths, applicable project guidance and scope, existing producer-source diff/publication needs, and exact verification/retirement steps. Identify what is already usable versus what needs code. Do not reimplement accepted plumbing, assume a past receipt is current, create another BB checkout, run hooks/providers, or change runtime. Report exact prospective write footprints and shared effects, including sandbox access, concurrent same-cwd visibility, and trace retention. A missing Claude route is an unresolved obligation, never an optional future extension."
  grant {
    "plans/context-magnet-usage-proof/installation-map.md"
    "plans/context-magnet-usage-proof/baseline.json"
  }
  oracle = module.adjudicated("Report cites current selected source/API contracts and dated read-only evidence for both harnesses; separates published commits from dirty inputs/local artifacts, configuration from hook installation, and fixture/historical receipts from current runtime. Names minimal supported installation/publication route and exact missing work, with failure/cleanup boundaries; no unexamined version or Claude hook assumption and no live effects.", "planner")
}

local observationMap = new Action {
  id = "observation-map"
  owner = "planner"
  outcome = "Determine the smallest native/plugin-only observation and exact association route for real BB Codex AND Claude sessions. Inspect current thread metadata/events, existing read-only native evidence, Workbench decisions/receipts, inspector RPC/UI, and current harness schemas. Reproduce safe current-API integration failures without provider launch. Establish which session/turn/contribution identifiers each authority exposes, what delivery/admission can actually be proved, whether hook-side observation is needed, and how legitimate multiple contributions and source bounds are handled. Do not assume Claude exposes Codex rollout framing, require an inaccessible numeric ordinal, guess joins by timestamp/text, or read/export unrelated message bodies. If a route remains unknown, record its smallest bounded probe and exact authority rather than propose a fork change."
  grant { "plans/context-magnet-usage-proof/observation-map.md" }
  oracle = module.adjudicated("Current source and API evidence support an explicit separate Codex/Claude capability matrix and association chain. Failing live boundaries and known unsupported cases are documented with bounded reproducible witnesses; native observation is distinguished from producer emission and semantic use. Concrete missing capabilities/probes, privacy bounds, multi-turn behavior, and negative controls are identified. No fixture is represented as a live session.", "planner")
}

local proofContract = new Action {
  id = "proof-contract"
  owner = "planner"
  outcome = "Write the acceptance contract and installation/runbook outline using the two maps. For each harness define installed/configured/selected/emitted/native-observed/associated/UI-observed facts, evidence authorities and keys, exact body/hash provenance when available, and explicit unobserved facts. Require one genuine BB task per harness and a supported repeat/multi-turn case without rejecting legitimate additional contributions as duplicates. Include disabled, verified-zero, unavailable/partial, wrong-thread/session, unsupported-version, changed-source and retention/bounds controls. Choose a usable redacted locator instead of inventing a numeric native ordinal unless available and necessary. Specify redacted live report fields, artifact/source hashes, concrete UI observations, cleanup, and fresh-source reproducibility. If a required native association is infeasible, leave acceptance unresolved and return to the owner rather than silently weaken or drop a harness."
  grant {
    "plans/context-magnet-usage-proof/CONTRACT.md"
    "plans/context-magnet-usage-proof/acceptance.json"
    "plans/context-magnet-usage-proof/RUNBOOK.md"
  }
  needs {
    module.produced(installationMap); module.verified(installationMap)
    module.produced(observationMap); module.verified(observationMap)
  }
  oracle = module.adjudicated("Every goal in BRIEF.md maps to a named acceptance instrument for both harnesses. Exact associations have source-backed authorities; context emission/native observation/model use are not conflated; normal multi-turn and failures are accounted for. Runbook outline has actual selected paths/source delivery and safe cleanup. Unsupported promises remain explicit and block delivery, not disappear from acceptance.", "planner")
}

local proofInstruments = new Action {
  id = "proof-instruments"
  owner = "verification-author"
  outcome = "Implement bounded proof-report validation and its tests from the accepted contract. The verifier commands named by the two live Guards must require a real-session report with independently collected thread/harness identity, source/runtime/config provenance, genuine guidance, Workbench facts, supported native observation/association and UI observation. Validate report artifacts/hashes and retained evidence rather than trust arbitrary booleans. Reject absent, partial, foreign, stale or fixture-only reports; never synthesize a successful live report from test data. Fixtures prove the instrument, not either live Guard. Validate exact missing-evidence failures and current API shapes as well as positive contract cases; keep observation transport and future setup authority separate."
  grant {
    "plans/context-magnet-usage-proof/verify-proof.mjs"
    "plans/context-magnet-usage-proof/verify-proof.test.mjs"
    "plans/context-magnet-usage-proof/fixtures/**"
  }
  needs { module.produced(proofContract); module.verified(proofContract) }
  oracle = module.mechanical("node --test plans/context-magnet-usage-proof/verify-proof.test.mjs")
}

local projectScope = new Selector {
  id = "project-optin-scope"
  owner = "cole"
  outcome = "Choose temporary proof configuration or retained project guidance after the installation map makes exact visibility and cleanup effects concrete. Either branch must prove both harnesses and preserve shared traces. A choice is not permission to run arbitrary installers or alter account/shim/router state; the next graph revision must spell out exact effects and authority."
  question = "Should the real project guidance/configuration used for the Codex and Claude proof be temporary and retired afterward, or retained as published project configuration?"
  options { "temporary-proof-configuration"; "retained-project-configuration" }
  needs { module.produced(installationMap); module.verified(installationMap) }
}

local deliveryGraph = new Action {
  id = "remaining-delivery-graph"
  owner = "planner"
  outcome = "Replace only the unresolved delivery portion of THIS new graph with concrete remaining work from the accepted maps/contract and Cole's configuration choice. Add the smallest exact-path plugin/Workbench fixes, source publication/reproducible build, actual install/opt-in and current loaded-boundary validation, live observation/report producers for each harness, repeat/multi-turn/negative controls, config retirement or retention, current integration checks, and child-first publication/promotion as required. Attach artifact availability AND passing evidence dependencies from actual producers to the two live Guards and final acceptance. Separate live authority/sandbox gates from code fixtures; installation scope must exclude account/shim/state changes unless separately necessary and approved. Do not recreate old completed nodes, generic recovery frameworks, speculative services, or pretend the existing graph grants execution. Resolve each map's unknowns with narrow probes/owner decisions. Keep these stable acceptance IDs."
  grant { "plans/context-magnet-usage-proof.plan.pkl" }
  needs {
    module.produced(proofContract); module.verified(proofContract)
    module.ruled(projectScope)
  }
  oracle = module.adjudicated("workbench plan check succeeds. Revised delivery nodes cover all accepted obligations with actual source paths, finite commands/evidence, and distinct code/live/publish authority; overlapping writes are ordered. Both live Guards consume produced+verified live evidence Actions, never just design or fixture completion. Final review consumes installation reproducibility, actual both-harness proofs, cleanup/retention and publication evidence. No ready live mutation is authorized solely by a descriptive grant. Remaining unknowns have explicit revisiting triggers or blocking nodes. No completed historical work is copied into this campaign.", "planner")
}

local codexLive = new Guard {
  id = "codex-live-usage"
  owner = "proof-reviewer"
  outcome = "Verify genuine BB Codex usage after the exact install/implementation/report-producing nodes have been authored, authorized and verified. Require real project contribution, supported native observation and exact thread/session/turn association, matching inspector RPC and visible UI, current source/runtime provenance, and accepted repeat/negative-control evidence. Missing report or fixture-only evidence fails."
  observes {
    "plans/context-magnet-usage-proof/codex-live-proof.json"
    "plans/context-magnet-usage-proof/acceptance.json"
    "plans/context-magnet-usage-proof/verify-proof.mjs"
  }
  needs {
    module.produced(deliveryGraph); module.verified(deliveryGraph)
    module.produced(proofInstruments); module.verified(proofInstruments)
  }
  oracle = module.mechanical("node plans/context-magnet-usage-proof/verify-proof.mjs --harness codex --require-live --report plans/context-magnet-usage-proof/codex-live-proof.json")
}

local claudeLive = new Guard {
  id = "claude-live-usage"
  owner = "proof-reviewer"
  outcome = "Verify genuine BB Claude usage after the exact install/implementation/report-producing nodes have been authored, authorized and verified. Require real project contribution, supported Claude-native observation and exact thread/session/turn association, matching inspector RPC and visible UI, current source/runtime provenance, and accepted repeat/negative-control evidence. Codex success cannot substitute; missing Claude evidence cannot be called an optional extension."
  observes {
    "plans/context-magnet-usage-proof/claude-live-proof.json"
    "plans/context-magnet-usage-proof/acceptance.json"
    "plans/context-magnet-usage-proof/verify-proof.mjs"
  }
  needs {
    module.produced(deliveryGraph); module.verified(deliveryGraph)
    module.produced(proofInstruments); module.verified(proofInstruments)
  }
  oracle = module.mechanical("node plans/context-magnet-usage-proof/verify-proof.mjs --harness claude --require-live --report plans/context-magnet-usage-proof/claude-live-proof.json")
}

local endState = new Guard {
  id = "installation-and-usage-acceptance"
  owner = "cole"
  outcome = "Accept the actual destination, not merely completion of discovery or a green partial graph. Inspect installation from published source and documented configuration, repeatable genuine Codex and Claude sessions through BB, exact inspector-associated observations and claim limits, current checks/loaded provenance, cleanup or retained configuration, and reviewed child/workspace publication. Resolve every in-scope obligation still in notes; do not call this complete if either harness, installation reproducibility, native association, safe lifecycle or source delivery remains future work."
  observes {
    "/home/ubuntu/.bb/thread-storage/thr_6m53rk7vvv/BRIEF.md"
    "plans/context-magnet-usage-proof/**"
    "plans/context-magnet-usage-proof.plan.pkl"
    "plans/context-magnet-usage-proof.ledger.jsonl"
  }
  needs {
    module.verified(codexLive); module.verified(claudeLive)
    module.produced(deliveryGraph); module.verified(deliveryGraph)
  }
  oracle = module.adjudicated("Cole can follow the documented install/runbook from published source without an undisclosed dirty source tree or thread-only binary. Both genuine BB Codex and Claude sessions have accepted observable context evidence associated to their actual threads; UI inspection agrees and model use is not invented. Current full affected verification and combined behavior pass; installation provenance, safe cleanup/retention and authorized child-first publication are evidenced. No unresolved required work, obsolete plan claim, fixture substitution, or unrelated dirty-work loss remains.", "cole")
}

nodes {
  installationMap
  observationMap
  proofContract
  proofInstruments
  projectScope
  deliveryGraph
  codexLive
  claudeLive
  endState
}
