amends "workbench:plan"

// Ledger lives outside the tree so final evidence cannot re-dirty the workspace:
//   --ledger /home/ubuntu/.bb/thread-storage/thr_i7xakgdxdd/workspace-reconciliation.ledger.jsonl
// Oracles run with --cwd /home/ubuntu/bb; scripts live in plans/workspace-reconciliation/.
//
// Re-entry rule: any change to a child origin/main after full-check and before final-clean
// re-opens children-drained -> full-check -> reload-changed -> promote. tested-shas binds them.
// To avoid livelock, peers are asked for a short publish freeze from full-check to final-clean; a
// peer push that still lands after promote is reported in final-report as "next promotion".
//
// Skill steps 2-4 (fetch/rebase, content comparison incl. untracked files, ADR-guided conflict
// resolution, logical commits, disposable generated-file removal) are performed by each owning
// thread for its own work (peer-registry records owners); handed-off-work covers anything an owner
// explicitly hands to the reconciler.

meta {
  title = "BB workspace reconciliation (2026-10)"
  goal = "Workspace, fork, plugins and community-plugins are clean, on main, equal to origin/main, verified, exercised at runtime, and recorded by matching workspace gitlinks, with every peer thread's intended work published by its owner and no authored work discarded."
}

local reconciler = "thr_i7xakgdxdd"
local scripts = "plans/workspace-reconciliation"

local inventory = new Guard {
  id = "inventory"
  owner = reconciler
  outcome = "Current HEADs, recorded gitlinks, dirt and runtime presence are observed for all four repositories."
  observes { "/home/ubuntu/bb"; "fork"; "plugins"; "community-plugins"; "fork/build/bb" }
  oracle = module.mechanical("./bin/status")
}

local planReview = new Guard {
  id = "plan-review"
  owner = reconciler
  outcome = "An independent reviewer accepts this graph as a faithful encoding of the reconcile-bb-workspace skill, workspace AGENTS.md and the coordination agreements in force."
  observes { "plans/workspace-reconciliation.plan.pkl"; "plans/workspace-reconciliation/"; ".agents/skills/reconcile-bb-workspace/SKILL.md"; "AGENTS.md" }
  oracle = module.adjudicated("Every skill step maps to a node or an explicit, justified note; oracles prove their outcomes and include known-failure cases; no node authorizes discarding authored work, publishing a peer's held work, restarting bb.service, or changing host selection without explicit authorization.", "plan-reviewer")
}

local peerRegistry = new Guard {
  id = "peer-registry"
  owner = reconciler
  outcome = "Every dirty or unpushed path in the four repositories is attributed to a live owner thread that has committed to publish it or explicitly hand it to the reconciler."
  observes { "plugins"; "community-plugins"; "fork"; "/home/ubuntu/bb" }
  needs { module.verified(inventory) }
  oracle = module.adjudicated("A current registry (ledger note) lists each dirty path group with its owner thread, state, and promised hand-off, and no group is unowned or abandoned.", reconciler)
}

local handedOffWork = new Action {
  id = "handed-off-work"
  owner = reconciler
  outcome = "Work an owner explicitly hands to the reconciler (none so far) is fetched, compared, conflict-resolved against docs/adrs, committed in logical units and pushed; disposable generated files are removed only when confirmed disposable."
  grant { "only paths explicitly handed off by their owner thread, recorded in a ledger note" }
  needs { module.verified(peerRegistry) }
  oracle = module.adjudicated("Every hand-off recorded in the ledger is either pushed (SHA noted, checks run) or recorded as 'none'; no authored work was discarded.", reconciler)
}

local providerSettingsHandoff = new Guard {
  id = "provider-settings-handoff"
  owner = "thr_qjduvhha3z"
  outcome = "The provider-settings campaign has pushed its accepted cohort to plugins and community-plugins origin/main, retired every temporary scaffold, released the shared-generator window, and sent its runtime receipt (or Cole accepted a source-only hand-off)."
  observes { "plugins/packages/bb-provider-settings"; "plugins/plugins"; "community-plugins/plugins/perspectives"; "plugins/tools/workspaces-sync" }
  needs { module.verified(peerRegistry) }
  oracle = module.adjudicated("A bb thread tell from thr_qjduvhha3z names pushed SHAs that are ancestors of each child origin/main, states scaffold retirement, explicitly releases the shared-generator window, and attaches a combined runtime receipt for those SHAs, or records Cole's acceptance of a source-only hand-off.", reconciler)
}

local childrenDrained = new Guard {
  id = "children-drained"
  owner = reconciler
  outcome = "fork, plugins and community-plugins have no uncommitted or unpushed work, are on main, equal freshly fetched origin/main, and carry no temporary scaffold leaf."
  observes { "fork"; "plugins"; "community-plugins"; "fork/refs/remotes/origin/main"; "plugins/refs/remotes/origin/main"; "community-plugins/refs/remotes/origin/main" }
  needs { module.verified(providerSettingsHandoff); module.verified(handedOffWork) }
  oracle = module.mechanical("\(scripts)/drained.sh")
}

local fullCheck = new Guard {
  id = "full-check"
  owner = reconciler
  outcome = "The exact drained child revisions pass install plus every repository check under the pinned toolchain; tested SHAs and the pre-promotion baseline gitlinks are recorded in plans/workspace-reconciliation/ and logs are kept. Build/test rewrite gitignored dist/ in the live leaves before any reload, which is acceptable because nothing reloads until after the check; if the post-check drained run reports movement, inspect the logs rather than rerunning blindly."
  observes { "plugins"; "community-plugins"; "fork"; "\(scripts)/tested-shas" }
  needs { module.verified(childrenDrained) }
  oracle = module.mechanical("\(scripts)/full-check.sh")
}

local reloadChanged = new Action {
  id = "reload-changed"
  owner = reconciler
  outcome = "Every installed plugin whose leaf changed between the recorded gitlinks and the tested SHAs is reloaded after the full check (recorded in reloads.log) and running; affected surfaces get a smoke check or the owner's runtime receipt for exactly those SHAs."
  grant { "runtime: bb plugin reload of changed leaves only, after owner acknowledgement; never a service restart"; "\(scripts)/reloads.log" }
  needs { module.verified(fullCheck) }
  oracle = module.mechanical("\(scripts)/reload-check.sh")
}

local selectionGate = new Guard {
  id = "selection-gate"
  owner = reconciler
  outcome = "Host plugin selection is unchanged; any new plugin leaf (e.g. plugin-provider-settings) is reported as a selection gap."
  observes { "/home/ubuntu/phosphor/rosetta-machine/hosts/bb-machine/home/.config/rosetta-machine/bb-plugins.tsv" }
  needs { module.verified(childrenDrained) }
  oracle = module.adjudicated("Only allowed outcome without Cole's explicit request naming bb-machine: no bb-plugins.tsv row is added or changed, and every new selectable leaf is listed as a gap in the final report.", reconciler)
}

local promote = new Action {
  id = "promote"
  owner = reconciler
  outcome = "Workspace gitlinks equal tested-shas, which are published on each child origin/main; plans/workspace-reconciliation* are committed; workspace main is clean and pushed."
  grant { "/home/ubuntu/bb gitlinks"; "plans/workspace-reconciliation.plan.pkl"; "\(scripts)/ (scripts, tested-shas, baseline-gitlinks, reloads.log)" }
  needs { module.verified(planReview); module.verified(fullCheck); module.verified(reloadChanged); module.verified(selectionGate) }
  oracle = module.mechanical("\(scripts)/promote-check.sh")
}

local finalClean = new Guard {
  id = "final-clean"
  owner = reconciler
  outcome = "All four repositories are clean, on main, equal to origin/main; bin/check passes without warnings; fork/build/bb and fork/upstream match their locks; gitlinks equal tested-shas."
  observes { "/home/ubuntu/bb"; "fork"; "plugins"; "community-plugins"; "fork/build/bb"; "fork/upstream" }
  needs { module.verified(promote) }
  oracle = module.mechanical("\(scripts)/final-check.sh")
}

local finalReport = new Guard {
  id = "final-report"
  owner = reconciler
  outcome = "Cole receives final repository SHAs, verification results, and every remaining publication, activation or selection gap; reconciliation is not claimed complete while a required gap remains."
  observes { "BRIEF.md"; "final status message" }
  needs { module.verified(inventory) }
  oracle = module.adjudicated("The report lists the four SHAs, links check logs, and names any gap (selection, activation, held peer work, newer peer commits) explicitly; it claims reconciliation complete only if final-clean is verified.", reconciler)
}

nodes { inventory; planReview; peerRegistry; handedOffWork; providerSettingsHandoff; childrenDrained; fullCheck; reloadChanged; selectionGate; promote; finalClean; finalReport }
