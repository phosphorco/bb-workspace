  grant { "plans/identity-experience/acceptance/plugins.mjs"; "plans/identity-experience/acceptance/plugins/**" }
  oracle = module.adjudicated("Root reviews real public binding/factory paths, baseline/fork capability detection, same immutable operation after uncertainty, multi-owner drafts and actual storage transactions, packed resolution and provider failures. External transport mocks do not count as real delivery or human admission.", "root")
}

local n_commissioning_instruments = new Action {
  id = "commissioning-instruments"
  owner = "release-coordinator"
  outcome = "Implement read-only source/build receipt checks and bounded multi-client/session/performance/upgrade orchestration, with explicit live preflight and cleanup."
