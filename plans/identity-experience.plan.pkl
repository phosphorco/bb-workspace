  owner = "native-coordinator"
  outcome = "Implement server-derived self personal palette/favicon read/set/clear, shared inheritance and identity-fenced synchronization including first-paint/theme/favicon cache ownership with native settings UI/SDK/CLI. Contract must name exact current hooks; root adds their concrete grants before source dispatch and owns DB/shared exports. Preserve provider-neutral current identity page."
  needs { module.verified(n_shared_contracts); module.verified(n_source_ready); module.produced(n_native_instruments); module.verified(n_native_instruments) }
  grant { "fork/build/bb/apps/server/src/services/p6r/personal-appearance"; "fork/build/bb/apps/app/src/components/settings"; "fork/build/bb/apps/app/src/lib/favicon-color-preference.ts"; "fork/build/bb/apps/app/src/hooks/queries/system-queries.ts"; "fork/build/bb/packages/server-contract/src/api/system.ts"; "fork/build/bb/packages/sdk/src/areas/system.ts"; "fork/build/bb/apps/cli/src/commands/settings.ts" }
