amends "workbench:plan"

meta {
  title = "Complete the provider-neutral BB identity experience"
  goal = "Deliver the reconciled master-plan shared identity workflows, personal settings, portable plugins and maintainable tested deployment through message-driven BB child teams."
}

// Intent only: current observations/rulings are in the sibling ledger.
// README and briefs define staging preservation and explicit dispatch grants.
// Future mechanical instruments below must be built/reviewed, never replaced by a passing placeholder.

local n_reconcile_native = new Action {
  id = "reconcile-native"
  owner = "native-coordinator"
  outcome = "Reconcile native authority, author/editor, provider/model/tool context, settings, personal appearance, presence and UX with master-plan obligations and latest selected/pushed source; identify exact remaining work without reopening completed changes."
  grant { "plans/identity-experience/evidence/native.md" }
  oracle = module.adjudicated("Root inspects cited source and dated receipts, distinguishes intended/implemented/tested/live/deployed, incorporates new 862aee5/3149864/1bcd757 inputs, lists acceptance and narrow footprints, and corrects stale STATUS/old IA assumptions. No product writes. Worker execution matches requested BB child-thread tuple.", "root")
}

local n_reconcile_plugins = new Action {
  id = "reconcile-plugins"
  owner = "plugins-coordinator"
  outcome = "Reconcile provider contracts, portable package/consumer adoption, view-as/state, external contributions and notifications with master-plan obligations and latest selected/pushed source; identify exact remaining work without reopening completed changes."
  grant { "plans/identity-experience/evidence/plugins.md" }
  oracle = module.adjudicated("Root inspects cited source and dated receipts, distinguishes intended/implemented/tested/live/deployed, incorporates new 862aee5/3149864/1bcd757 inputs, lists acceptance and narrow footprints, and corrects stale STATUS/old IA assumptions. No product writes. Worker execution matches requested BB child-thread tuple.", "root")
}

local n_reconcile_release = new Action {
  id = "reconcile-release"
  owner = "release-coordinator"
  outcome = "Reconcile source selection, preservation, deployment, fresh-instance/session compatibility, performance, upgrade and security scope with master-plan obligations and latest selected/pushed source; identify exact remaining work without reopening completed changes."
  grant { "plans/identity-experience/evidence/release.md" }
  oracle = module.adjudicated("Root inspects cited source and dated receipts, distinguishes intended/implemented/tested/live/deployed, incorporates new 862aee5/3149864/1bcd757 inputs, lists acceptance and narrow footprints, and corrects stale STATUS/old IA assumptions. No product writes. Worker execution matches requested BB child-thread tuple.", "root")
}

local n_scope_crosswalk = new Action {
  id = "scope-crosswalk"
  owner = "root"
  outcome = "Map every essential workflow, maintenance gate and subsequent Cole decision to delivered evidence, a remaining node or an explicit scope decision. Retain unknowns and supersede contradictory old IA assumptions."
  needs { module.verified(n_reconcile_native); module.verified(n_reconcile_plugins); module.verified(n_reconcile_release) }
  grant { "plans/identity-experience/crosswalk.md" }
  oracle = module.adjudicated("Each master-plan section 3,5-10,13 and subsequent identity/settings/security decision has a disposition with source and oracle; no claimed-author fallback, retired plugin resurrection, or implicit expansion to unrelated Analytics/router work. Reuse completed evidence only within its revision/runtime scope.", "root")
}

local n_plan_coherence = new Guard {
  id = "plan-coherence"
  owner = "root"
  outcome = "Review graph coverage, independent work, true dependencies, evidence classes and shared-file ownership before delivery."
  needs { module.produced(n_scope_crosswalk); module.verified(n_scope_crosswalk) }
  observes { "plans/identity-experience.plan.pkl"; "plans/identity-experience/README.md"; "plans/identity-experience/crosswalk.md" }
  oracle = module.adjudicated("Run workbench plan check successfully; every outcome has a decisive instrument/rubric and owner; no green partial graph or invented evidence. Contracts can advance independently of host preparation. Implementation and external side effects remain separately gated.", "root")
}

local n_source_probe = new Guard {
  id = "source-probe"
  owner = "release-coordinator"
  outcome = "Inspect the selected existing workspace: source preservation, active grants and source/runtime identities; compare main and additional published branch without moving any HEAD. Cole selected /home/ubuntu/bb-service for implementation; bb-machine reachability is not a prerequisite for this target."
  needs { module.verified(n_reconcile_release); module.ruled(n_execution_target) }
  observes { "AGENTS.md"; "bin/status"; "fork"; "plugins"; "community-plugins"; "plans/identity-experience/evidence/release.md" }
  oracle = module.adjudicated("Root reviews read-only receipts for the selected host/path/branch/gitlinks/artifact/runtime, exact uncommitted ownership and unchanged normal runtime. Cole's current bb-service selection supersedes its comparison-only campaign restriction; preserve separate preview state/ports. Inspect current source and stale receipts without treating historical tests as current loaded-byte proof. No new checkout or reset.", "root")
}

local n_execution_target = new Selector {
  id = "execution-target"
  owner = "root"
  outcome = "Record the actual owner ruling and revise dependent footprints/instruments for the chosen branch; a ruling does not automatically select implementation."
  needs { module.verified(n_reconcile_release) }
  options { "canonical-bb-machine"; "bb-service"; "existing-authorized-proof" }
  question = "Which already-authorized staging source/host will carry delivery while preserving normal authored work?"
}

local n_source_ready = new Action {
  id = "source-ready"
  owner = "release-coordinator"
  outcome = "Reconcile the selected source set in the chosen authorized workspace, including fork main/native patch and new plugin/archive inputs; preserve authored changes and record the exact grant/host/toolchain before dispatch."
  needs { module.ruled(n_execution_target); module.verified(n_source_probe); module.verified(n_plan_coherence) }
  grant { "plans/identity-experience/evidence/source-ready.md"; "fork"; "plugins"; "community-plugins"; "sdk-artifacts" }
  oracle = module.adjudicated("Root reviews preservation and actual selected source receipt, reachable tooling and no normal runtime mutation. If execution-target chooses an existing proof, cite its current explicit authorization and exact paths/state/ports; comparison-only briefs are insufficient. Child status/HEAD inspected before changes; new source commits and dependency archives resolve coherently. Workspace root instructions honored. This node does not promote normal or certify untested combined behavior.", "root")
}

local n_native_contract = new Action {
  id = "native-contract"
  owner = "native-coordinator"
  outcome = "Specify minimal native contracts for original author/editor/retry actor, provider-neutral self and personal appearance, model/tool context, native commands and live presence; include interaction resolvers, attachment-only groups and plural structured tool provenance; justify each upstream touchpoint."
  needs { module.verified(n_plan_coherence) }
  grant { "plans/identity-experience/contracts/native.md"; "plans/identity-experience/contracts/native-fixtures/**" }
  oracle = module.adjudicated("Root and plugins coordinator inspect actual caller requirements. Define effective personal/shared theme+favicon selection, reset and session transitions; preserve upstream command/grouped-edit rules. Distinguish profile snapshots, authorship and presence. No core import of bb-identity or provider IDs; no generalized API without a concrete consumer.", "root")
}

local n_plugin_contract = new Action {
  id = "plugin-contract"
  owner = "plugins-coordinator"
  outcome = "Specify provider health presentation and consumer target/operation semantics, public package distribution, same-artifact baseline/fork behavior and exact per-feature parity."
  needs { module.verified(n_plan_coherence) }
  grant { "plans/identity-experience/contracts/plugins.md"; "plans/identity-experience/contracts/plugin-fixtures/**" }
  oracle = module.adjudicated("Root and native coordinator inspect public capability shape, self-only/collaborator target policies, failure/no-default fallback, request/background lifetimes, external-author distinction and immutable operations. Incorporate newly ported community identity/archive rather than redo it. Keep schema/storage/policy with features and provider credentials/config with provider.", "root")
}

local n_baseline_measurements = new Action {
  id = "baseline-measurements"
  owner = "release-coordinator"
  outcome = "Build and run bounded comparable current/unmodified-target measurements before choosing numeric budgets or expanding implementation; record actual workloads, versions and limitations."
  needs { module.verified(n_plan_coherence); module.verified(n_source_ready) }
  grant { "plans/identity-experience/acceptance/baseline/**"; "plans/identity-experience/evidence/baseline/**" }
  oracle = module.adjudicated("Root reviews actual direct-send, mixed-queue, list/edit/roster/reconnect baseline measurements, no-N+1/write invariants, p50/p95/bytes/writes/locks/memory/fanout and fixture cleanup. Synthetic workloads and real-host evidence explicitly differ. Cannot set budget success from an unrun script or accept missing runtime as zero cost.", "root")
}

local n_commissioning_contract = new Action {
  id = "commissioning-contract"
  owner = "release-coordinator"
  outcome = "Define source/runtime observability, actual two-person acceptance, fresh-instance and bounded session compatibility, measurable budgets and external-operation prerequisites."
  needs { module.verified(n_plan_coherence); module.verified(n_baseline_measurements) }
  grant { "plans/identity-experience/contracts/commissioning.md" }
  oracle = module.adjudicated("Root reviews specified supported versions and numeric budgets with measurement method and comparable baseline. Cover master-plan no-N+1/no-unchanged-profile-write invariants, p50/p95/bytes/writes/locks/memory/fanout; real human positive and direct untrusted negative; fixture cleanup, revocation, no production producers. Define migration and restart/recovery evidence without promising arbitrary downgrades or shared live DB writers.", "root")
}

local n_shared_contracts = new Guard {
  id = "shared-contracts"
  owner = "root"
  outcome = "Resolve cross-lane contract collisions and issue exact nonoverlapping implementation assignments."
  needs { module.produced(n_native_contract); module.verified(n_native_contract); module.produced(n_plugin_contract); module.verified(n_plugin_contract); module.produced(n_commissioning_contract); module.verified(n_commissioning_contract) }
  observes { "plans/identity-experience/contracts/**" }
  oracle = module.adjudicated("All consumers can implement from accepted contracts; single owners for SDK/barrels, generator/locks, app/server registration and patch sealing. Resolve shape disagreements by message before edits. Replace future acceptance commands with agreed real instruments; no blocking all lanes on unrelated artifact production.", "root")
}

local n_native_instruments = new Action {
  id = "native-instruments"
  owner = "native-coordinator"
  outcome = "Implement decisive route/provider-input/timeline/appearance/presence/browser acceptance instruments against agreed contracts, with failure controls."
  needs { module.verified(n_shared_contracts); module.verified(n_source_ready) }
  grant { "plans/identity-experience/acceptance/native.mjs"; "plans/identity-experience/acceptance/native/**" }
  oracle = module.adjudicated("Root reviews production-boundary assertions, per-group identity, before-commit invalidation, native compact/clear commands, expiry, offline/reconnect/owner-change and UI accessibility controls. Intentionally wrong authors, unwanted shared writes and presence leaks fail. Mock/real evidence remains explicit; missing imports and crashes are failures.", "root")
}

local n_plugin_instruments = new Action {
  id = "plugin-instruments"
  owner = "plugins-coordinator"
  outcome = "Implement portable consumer/state/provider/distribution acceptance instruments and controlled external transport recovery cases."
