  oracle = module.adjudicated("All master-plan/subsequent product outcomes have current required evidence or an explicit Cole disposition, including formerly vague notes. If containment-scope expands campaign, root must first add and verify its concrete requirements; a ruling alone is not completion. UI and model agree with durable authorship; upstream baseline works; legacy/upgrade limits are accepted, not hidden.", "root")
}

local n_source_promotion = new Action {
  id = "source-promotion"
  owner = "root"
  outcome = "Commit/push selected children first, verify remote containment, then update workspace gitlinks to the exact exercised composition and push its promotion receipt."
  needs { module.verified(n_product_acceptance) }
  grant { "fork"; "plugins"; "community-plugins"; "sdk-artifacts"; "plans/identity-experience/evidence/source-promotion.md" }
  oracle = module.adjudicated("Root verifies scoped commits, clean selected authored changes, child remote containment, matching tested gitlinks and combined staging proof. Preserve other dirty work. No forced push or normal-host move is implied.", "root")
}

local n_host_handoff = new Action {
  id = "host-handoff"
  owner = "release-coordinator"
  outcome = "Prepare the concrete rosetta-machine normal-host promotion/handoff using the tested workspace receipt and existing machine-role policy, with rollback/forward-repair and capability checks."
  needs { module.verified(n_source_promotion) }
  grant { "plans/identity-experience/evidence/host-handoff.md" }
  oracle = module.adjudicated("Root reviews exact host/service/source/config declaration diff and installation/validation commands. Actual deployment uses its existing authorization and runtime preflight; no credential copy, svc ownership change or normal outage is implied by a plan grant. Post-write rollback limits explicit. Record live destination only when actually deployed.", "root")
}

local n_final_closeout = new Guard {
  id = "final-closeout"
  owner = "root"
  outcome = "Close the campaign only when product acceptance and actual agreed delivery destination are evidenced."
  needs { module.verified(n_host_handoff) }
  observes { "plans/identity-experience.plan.pkl"; "plans/identity-experience.ledger.jsonl"; "plans/identity-experience/evidence/host-handoff.md" }
  oracle = module.adjudicated("No outstanding in-scope ledger notes, decisions or promised live/deployment steps are hidden. Distinguish prepared handoff from deployed host; if actual promotion is in the agreed destination, require its verified live receipt before passing. Report exact artifacts, current limitations and who owns any separately scoped containment effort.", "root")
}

