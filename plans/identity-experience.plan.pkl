  grant { "plans/identity-experience/acceptance/commissioning.mjs"; "plans/identity-experience/acceptance/commissioning/**" }
  oracle = module.adjudicated("Root reviews exact runtime/source binding, actual test-harness assertions, explicit selected fixtures, participant opt-in, no forged headers, no unrelated credential/state access, failure/cancellation cleanup, deadlines and warm shared-cache preservation. Live mode refuses missing prerequisites rather than downgrading to mocks.", "root")
}

local n_native_authorship = new Action {
  id = "native-authorship"
  owner = "native-coordinator"
  outcome = "Complete only demonstrated native author/editor/context/lifetime and durable interaction-resolver gaps on top of patch0016; preserve original author separately from editor and retry invoker through existing supported lifecycle paths. Request exact queue/domain/storage/tool-context additions from root before editing; DB schema/migration/shared exports are handed to compose-native, not silently included in this grant."
  needs { module.verified(n_shared_contracts); module.verified(n_source_ready); module.produced(n_native_instruments); module.verified(n_native_instruments) }
  grant { "fork/build/bb/apps/server/src/services/p6r/native-authorship.ts"; "fork/build/bb/apps/server/src/services/p6r/native-request.ts"; "fork/build/bb/apps/server/src/services/threads"; "fork/build/bb/packages/domain/src/p6r-message-author.ts"; "fork/build/bb/packages/thread-view"; "fork/build/bb/apps/app/src/components/thread/timeline" }
  oracle = module.mechanical("node plans/identity-experience/acceptance/native.mjs --suite authorship")
}

