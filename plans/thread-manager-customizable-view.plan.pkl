amends "workbench:plan"
meta { title = "Deliver customizable Thread Manager views"; goal = "Ship discoverable execution filters, personal configurable columns, and legible mobile navigation through the canonical plugin, with reviewed proof and publication." }
local contract = new Action {
  id = "view-contract"; owner = "execution-steward"
  grant { "$BB_THREAD_STORAGE/view-work/contract.md"; "$BB_THREAD_STORAGE/BRIEF.md" }
  outcome = "Refresh the brief and establish independent UI/persistence/proof grants, fixed feature interfaces, and acceptance for the authorized UX increment."
  oracle = module.adjudicated("The contract names the user outcome, stable column/persistence interfaces, mobile interactions, independent footprints, and delivery proof; brief reflects current work.", "execution-steward")
}
local designReview = new Guard {
  id = "design-perspectives"; owner = "execution-steward"
  needs { module.produced(contract); module.verified(contract) }
  observes { "plugins/plugins/thread-manager/**"; "$BB_THREAD_STORAGE/view-work/contract.md" }
  outcome = "Gather four weak-area perspectives, verify the returned artifact and retain prioritized decisions and disclosed gaps. Apply contract corrections to affected lanes."
  oracle = module.adjudicated("A verified perspective artifact is reviewed, actionable requirements resolved or explicitly justified, and unknowns retained.", "execution-steward")
}
local persistence = new Action {
  id = "personal-view-state"; owner = "codex-persistence-worker"
  needs { module.produced(contract); module.verified(contract) }
  grant { "plugins/plugins/thread-manager/view-layout.ts"; "plugins/plugins/thread-manager/view-state-storage.ts"; "plugins/plugins/thread-manager/view-preferences.tsx"; "plugins/plugins/thread-manager/server.ts"; "plugins/plugins/thread-manager/recent-message-storage.ts (append state migrations only)"; "plugins/plugins/thread-manager/test/view-*.test.*" }
  outcome = "Implement strict column schema and personal SQLite preferences through bb-identity resources and React controller, with owner isolation, CAS/receipts, conflict and uncertainty handling, no browser drafts."
  oracle = module.mechanical("bun run --cwd plugins/plugins/thread-manager test && bun run --cwd plugins/plugins/thread-manager typecheck")
}
local ui = new Action {
  id = "customizable-mobile-ui"; owner = "codex-ui-worker"
  needs { module.produced(contract); module.verified(contract) }
  grant { "plugins/plugins/thread-manager/app.tsx"; "plugins/plugins/thread-manager/app.css"; "plugins/plugins/thread-manager/customize-view.tsx"; "plugins/plugins/thread-manager/mobile-thread-list.tsx"; "plugins/plugins/thread-manager/test/customize-*.test.*"; "plugins/plugins/thread-manager/test/mobile-*.test.*" }
  outcome = "Implement discoverable Provider/Model filters and active chips, Customize view with keyboard ordering/presets/reset, native TanStack visibility/order, and one compact mobile row representation with explicit select/preview/open/sort. Preserve existing workflows."
  oracle = module.mechanical("bun run --cwd plugins/plugins/thread-manager typecheck && bun run --cwd plugins/plugins/thread-manager test")
}
local proof = new Action {
  id = "browser-proof-instrument"; owner = "codex-browser-worker"
  needs { module.produced(contract); module.verified(contract) }
  grant { "plugins/plugins/thread-manager/test/browser/customizable-view.cjs"; "plugins/plugins/thread-manager/test/browser/fixtures/**"; "$BB_THREAD_STORAGE/view-work/browser-*" }
  outcome = "Build a reproducible production-asset browser instrument for configurable views, identity-scoped save/reload, hidden filters, mobile touch/keyboard/focus, short screens and text zoom; prove it detects missing implementation and fails on real regressions."
  oracle = module.adjudicated("The instrument has concrete assertions and retained evidence of an expected baseline failure, with controlled fixtures clearly distinguished from live proof.", "execution-steward")
}
local integrate = new Action {
  id = "integrate-view-delivery"; owner = "execution-steward"
  needs { module.produced(persistence); module.produced(ui); module.produced(proof); module.verified(designReview) }
  grant { "plugins/tools/workspaces-sync/definition.ts"; "plugins/bun.lock"; "plugins/plugins/thread-manager/package.json"; "plugins/plugins/thread-manager/tsconfig*.json"; "plugins/plugins/thread-manager/**"; "$BB_THREAD_STORAGE/view-work/**" }
  outcome = "Independently inspect lane results, compose generated dependency/package metadata, fix integration defects, and run focused checks plus browser acceptance against canonical built assets."
  oracle = module.mechanical("bun run --cwd plugins/plugins/thread-manager typecheck && bun run --cwd plugins/plugins/thread-manager test && node plugins/plugins/thread-manager/test/browser/customizable-view.cjs")
}
local review = new Guard {
  id = "implementation-perspectives"; owner = "execution-steward"
  needs { module.produced(integrate); module.verified(persistence); module.verified(ui); module.verified(proof) }
  observes { "plugins/plugins/thread-manager/**"; "$BB_THREAD_STORAGE/view-work/**" }
  outcome = "Gather four perspectives on implemented weak areas, byte-verify review output, apply reasonable suggestions, retain disagreements and coverage limits, and rerun affected acceptance."
  oracle = module.adjudicated("Verified perspective findings are triaged against exact source and evidence; material issues fixed and tested, remaining limits disclosed without pretending complete coverage.", "execution-steward")
}
local checks = new Guard {
  id = "repository-and-browser-acceptance"; owner = "execution-steward"
  needs { module.verified(review); module.produced(integrate); module.verified(integrate) }
  observes { "plugins/**"; "community-plugins/**"; "$BB_THREAD_STORAGE/view-work/**" }
  outcome = "Run the complete organization repository contract and final responsive/keyboard/identity/browser regressions after review fixes. Verify the concurrent published community commit before recording the combined composition."
  oracle = module.adjudicated("Retained complete organization and community check results pass, with the local community dependency boundary disclosed. Canonical reload after build, final production-asset browser checks and staged diff checks pass against unchanged publication sources. Inspect the actual artifacts; do not infer success from worker reports.", "execution-steward")
}
local activate = new Action {
  id = "canonical-reload-and-live-proof"; owner = "execution-steward"
  needs { module.verified(checks) }
  grant { "canonical runtime Thread Manager plugin generation"; "$BB_THREAD_STORAGE/view-work/live-proof.*" }
  outcome = "Reload the canonical plugin after full build, prove its source path and live layout/preferences/filters behavior, and inspect the combined normal workspace. Preserve authored work and account for pending publication gitlink deltas."
  oracle = module.adjudicated("Canonical reload/source and live behavioral evidence pass against the inspected composition; pending gitlink deltas and limitations are explicit. Publication must finish the normal workspace contract.", "execution-steward")
}
local publish = new Action {
  id = "commit-push-and-promote"; owner = "execution-steward"
  needs { module.produced(activate); module.verified(activate) }
  grant { "plugins/.git task-only commit and origin/main push"; ".git workspace receipt and origin/main push"; "plans/thread-manager-customizable-view.plan.pkl"; "plans/thread-manager-customizable-view.ledger.jsonl"; "plugins gitlink"; "community-plugins gitlink (already-published concurrent commit only)"; "$BB_THREAD_STORAGE/view-work/publication.json" }
  outcome = "Commit reviewed Thread Manager and generated metadata only, push the selected child first, record the exercised composition in a workspace receipt and push it, then verify remote hashes without disturbing concurrent work."
  oracle = module.adjudicated("Exact task child and workspace receipt are pushed in order; remote hashes match publication evidence, the normal workspace contract passes after promotion, and no unrelated edits were staged.", "execution-steward")
}
local communicate = new Action {
  id = "communicate-delivery"; owner = "execution-steward"
  needs { module.produced(publish); module.verified(publish) }
  grant { "$BB_THREAD_STORAGE/BRIEF.md"; "$BB_THREAD_STORAGE/view-work/delivery.md"; "final user response" }
  outcome = "Refresh brief to the delivered outcome and communicate the concrete filtering/customization/mobile changes, validation, commit IDs, plan/evidence links and remaining limits. Account for every authorized obligation."
  oracle = module.adjudicated("Brief and delivery note accurately describe shipped behavior and evidence; final response is self-contained, concise and discloses unresolved scope or coverage.", "execution-steward")
}
nodes { contract; designReview; persistence; ui; proof; integrate; review; checks; activate; publish; communicate }
