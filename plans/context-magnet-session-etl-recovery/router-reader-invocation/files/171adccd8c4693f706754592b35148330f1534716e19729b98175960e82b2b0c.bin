import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { chmod, mkdir, mkdtemp, readFile, readlink, symlink, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { describe, it } from "node:test";
import {
  HOST_FILES,
  accountAddCommand,
  accountRenameCommand,
  accountCeilingCommand,
  accountCommand,
  activateHostGenerationCommand,
  activeHostGeneration,
  candidateHostGenerationCommand,
  createHostGenerationManifest,
  findWritableShimDirectorySnippet,
  hostGenerationDirectory,
  hostFileModesCommand,
  installCommand,
  inspectHostInstallationCommand,
  machineAccountLoginCommand,
  preinstallDoctorCommand,
  routerCommand,
  routerPath,
  shellQuote,
  statusCommand,
  threadCommand,
} from "../deployment.ts";
import type { RuntimeDoctor } from "../rpc-contract.ts";

async function runBash(script: string, path: string, home?: string): Promise<{ exitCode: number | null; stdout: string; stderr: string }> {
  return runShell("/bin/bash", script, path, home);
}

async function runShell(executable: string, script: string, path: string, home?: string): Promise<{ exitCode: number | null; stdout: string; stderr: string }> {
  const child = spawn(executable, ["-c", script], {
    env: { PATH: path, ...(home ? { HOME: home } : {}) },
    stdio: ["ignore", "pipe", "pipe"],
  });
  let stdout = "";
  let stderr = "";
  child.stdout.on("data", (chunk) => { stdout += chunk; });
  child.stderr.on("data", (chunk) => { stderr += chunk; });
  const exitCode = await new Promise<number | null>((resolve) => child.once("exit", resolve));
  return { exitCode, stdout, stderr };
}

async function runExecutable(executable: string, args: string[]): Promise<{ exitCode: number | null; stdout: string; stderr: string }> {
  const child = spawn(executable, args, { stdio: ["ignore", "pipe", "pipe"] });
  let stdout = "";
  let stderr = "";
  child.stdout.on("data", (chunk) => { stdout += chunk; });
  child.stderr.on("data", (chunk) => { stderr += chunk; });
  const exitCode = await new Promise<number | null>((resolve) => child.once("exit", resolve));
  return { exitCode, stdout, stderr };
}

describe("remote deployment commands", () => {
  it("distinguishes an absent install from a missing runtime with retained state", async () => {
    const home = await mkdtemp(join(tmpdir(), "csr-inspect-home-"));
    const inspect = () => runBash(inspectHostInstallationCommand(home), process.env.PATH ?? "");
    const absent = await inspect();
    assert.equal(absent.exitCode, 0, absent.stderr);
    assert.deepEqual(JSON.parse(absent.stdout), { installed: false, launcher: null });
    const root = join(home, ".codex-subscription-router");
    await mkdir(join(root, "accounts"), { recursive: true });
    const missing = await inspect();
    assert.notEqual(missing.exitCode, 0);
    assert.match(missing.stderr, /operator recovery is required/);
    await mkdir(join(root, "lib"));
    await writeFile(join(root, "lib", "router-command"), "#!/bin/sh\nexit 0\n");
    const installed = await inspect();
    assert.equal(installed.exitCode, 0, installed.stderr);
    assert.equal(JSON.parse(installed.stdout).installed, true);
  });

  it("surfaces dangling runtime links instead of reporting not installed", async () => {
    const home = await mkdtemp(join(tmpdir(), "csr-inspect-broken-"));
    const lib = join(home, ".codex-subscription-router", "lib");
    await mkdir(lib, { recursive: true });
    await symlink(join(lib, "missing-generation"), join(lib, "router-command"));
    const result = await runBash(inspectHostInstallationCommand(home), process.env.PATH ?? "");
    assert.notEqual(result.exitCode, 0);
    assert.match(result.stderr, /ENOENT/);
    assert.equal(result.stdout, "");
  });
  it("builds the machine account login command", () => {
    assert.equal(machineAccountLoginCommand(), "account login-machine");
  });
  it("starts a pending account with a server-known cleanup id", () => {
    assert.equal(accountAddCommand("20260819-a1b2c3"), "account add --id '20260819-a1b2c3'");
    assert.equal(accountAddCommand("20260819-a1b2c3", "Work"), "account add --id '20260819-a1b2c3' 'Work'");
  });
  it("quotes display names for account renames", () => {
    assert.equal(accountRenameCommand("20260819-a1b2c3", "Work account"), "account rename '20260819-a1b2c3' 'Work account'");
  });
  it("derives router paths from the selected machine home", () => {
    assert.equal(routerPath("/home/palani"), "/home/palani/.codex-subscription-router/lib/router.mjs");
  });

  it("quotes machine paths and account labels as inert shell arguments", () => {
    assert.equal(shellQuote("cheap 'backup'"), `'cheap '"'"'backup'"'"''`);
    assert.equal(
      routerCommand("/home/pal ani", `account add ${shellQuote("cheap; reboot")}`),
      `'/home/pal ani/.codex-subscription-router/lib/router-command' account add 'cheap; reboot'`,
    );
  });

  it("repairs executable and private modes after remote file updates", () => {
    assert.equal(
      hostFileModesCommand("/home/pal ani"),
      "chmod 700 '/home/pal ani/.codex-subscription-router/lib/router.mjs'"
        + " && chmod 600 '/home/pal ani/.codex-subscription-router/lib/accounts.mjs'"
        + " '/home/pal ani/.codex-subscription-router/lib/routing.mjs'"
        + " '/home/pal ani/.codex-subscription-router/lib/state.mjs'",
    );
  });

  it("activates only a complete digest-verified host generation", async () => {
    const home = await mkdtemp(join(tmpdir(), "csr-generation-"));
    const router = `
      if (process.argv.slice(2).join(" ") === "runtime preflight") {
        let sqliteAvailable = false;
        try { sqliteAvailable = typeof (await import("bun:sqlite")).Database === "function"; } catch {}
        console.log(JSON.stringify({ runtimeExecPath: process.execPath, runtimeVersion: process.versions.bun, bun: process.versions.bun ?? null, sqliteAvailable, sqliteError: null }));
      } else if (process.argv.slice(2).join(" ") === "state migrate-legacy-if-needed") {
        console.log(JSON.stringify({ migrated: false, backend: "sqlite", reason: "fresh-install" }));
      }
    `;
    const first = createHostGenerationManifest({ "router.mjs": router, "state.mjs": "export const version = 1;\n" });
    const firstDirectory = hostGenerationDirectory(home, first.digest);
    await mkdir(firstDirectory, { recursive: true });
    await writeFile(join(firstDirectory, "router.mjs"), router);
    await writeFile(join(firstDirectory, "state.mjs"), "export const version = 1;\n");

    const activated = await runBash(activateHostGenerationCommand(home, first, { expectedGeneration: null }), process.env.PATH ?? "");
    assert.equal(activated.exitCode, 0, activated.stderr);
    const result = JSON.parse(activated.stdout.trim().split("\n").at(-1)!);
    assert.match(result.runtimeExecPath, /\/bun$/);
    assert.equal(typeof result.bun, "string");
    assert.match(result.runtimeVersion, /^\d+\.\d+\.\d+/);
    assert.equal(typeof result.sqliteAvailable, "boolean");
    assert.equal(result.generationDigest, first.digest);
    const stableRouter = join(home, ".codex-subscription-router", "lib", "router.mjs");
    assert.equal(await readlink(stableRouter), "router-command");
    assert.equal(await readlink(join(home, ".codex-subscription-router", "lib", "bun")), result.runtimeExecPath);
    const launcher = await readFile(join(home, ".codex-subscription-router", "lib", "router-command"), "utf8");
    assert.match(launcher, new RegExp(result.runtimeExecPath.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")));
    assert.match(launcher, new RegExp(first.digest));
    const installedManifest = JSON.parse(await readFile(join(firstDirectory, "manifest.json"), "utf8"));
    assert.equal(installedManifest.capabilities.runtimeExecPath, result.runtimeExecPath);
    assert.equal(installedManifest.capabilities.runtimeVersion, result.runtimeVersion);

    const rejectingRouter = `
      if (process.argv.slice(2).join(" ") === "runtime preflight") {
        console.log(JSON.stringify({ runtimeExecPath: process.execPath, runtimeVersion: process.versions.bun,
          bun: process.versions.bun, sqliteAvailable: true, sqliteError: null }));
      } else if (process.argv.slice(2).join(" ") === "state migrate-legacy-if-needed") {
        console.error("state is not quiescent"); process.exit(9);
      }
    `;
    const rejecting = createHostGenerationManifest({ "router.mjs": rejectingRouter });
    const rejectingDirectory = hostGenerationDirectory(home, rejecting.digest);
    await mkdir(rejectingDirectory, { recursive: true });
    await writeFile(join(rejectingDirectory, "router.mjs"), rejectingRouter);
    const migrationRejected = await runBash(activateHostGenerationCommand(home, rejecting, { expectedGeneration: first.digest }), process.env.PATH ?? "");
    assert.notEqual(migrationRejected.exitCode, 0);
    assert.match(migrationRejected.stderr, /state migration failed.*not quiescent/s);
    assert.equal(await readlink(stableRouter), "router-command");
    assert.equal(await readFile(join(home, ".codex-subscription-router", "lib", "router-command"), "utf8"), launcher);

    const shim = join(home, "codex");
    // Existing installations point their shim at the legacy stable router
    // path. That path must cross the same atomic launcher on every upgrade.
    await symlink(stableRouter, shim);
    const secondRouter = `${router}\nif (process.argv.slice(2).join(" ") === "generation") console.log("second");\n`;
    const second = createHostGenerationManifest({ "router.mjs": secondRouter, "state.mjs": "export const version = 2;\n" });
    const secondDirectory = hostGenerationDirectory(home, second.digest);
    await mkdir(secondDirectory, { recursive: true });
    await writeFile(join(secondDirectory, "router.mjs"), secondRouter);
    await writeFile(join(secondDirectory, "state.mjs"), "export const version = 2;\n");
    const staleActivation = await runBash(activateHostGenerationCommand(home, second, { expectedGeneration: null }), process.env.PATH ?? "");
    assert.notEqual(staleActivation.exitCode, 0);
    assert.match(staleActivation.stderr, /active router generation changed/);
    assert.equal(await readFile(join(home, ".codex-subscription-router", "lib", "router-command"), "utf8"), launcher);

    const activatedSecond = await runBash(activateHostGenerationCommand(home, second, { expectedGeneration: first.digest }), process.env.PATH ?? "");
    assert.equal(activatedSecond.exitCode, 0, activatedSecond.stderr);
    const shimResult = await runExecutable(shim, ["generation"]);
    assert.equal(shimResult.exitCode, 0, shimResult.stderr);
    assert.equal(shimResult.stdout.trim(), "second");

    const corrupt = createHostGenerationManifest({ "router.mjs": `${router}\n// corrupt\n`, "state.mjs": "export const version = 3;\n" });
    const corruptHome = await mkdtemp(join(tmpdir(), "csr-generation-corrupt-"));
    const corruptDirectory = hostGenerationDirectory(corruptHome, corrupt.digest);
    await mkdir(corruptDirectory, { recursive: true });
    await writeFile(join(corruptDirectory, "router.mjs"), `${router}\n// corrupted after hashing\n`);
    await writeFile(join(corruptDirectory, "state.mjs"), "export const version = 3;\n");

    const rejected = await runBash(activateHostGenerationCommand(corruptHome, corrupt, { expectedGeneration: null }), process.env.PATH ?? "");
    assert.notEqual(rejected.exitCode, 0, `${rejected.stdout}\n${rejected.stderr}`);
    assert.match(rejected.stderr, /file digest mismatch: router\.mjs/);
    assert.equal(await readlink(stableRouter), "router-command");
  });

  it("keeps the launcher and aliases intact when real activation finds missing authority", async () => {
    const home = await mkdtemp(join(tmpdir(), "csr-activation-missing-state-"));
    const root = join(home, ".codex-subscription-router");
    const lib = join(root, "lib");
    await mkdir(lib, { recursive: true });
    await mkdir(join(root, "accounts"));
    const names = [...HOST_FILES];
    const contents = Object.fromEntries(await Promise.all(names.map(async (name) => [name, await readFile(new URL(`../host/${name}`, import.meta.url), "utf8")])));
    const manifest = createHostGenerationManifest(contents);
    const generation = hostGenerationDirectory(home, manifest.digest);
    await mkdir(generation, { recursive: true });
    for (const name of names) await writeFile(join(generation, name), contents[name]!);
    await writeFile(join(lib, "router-command"), "previous launcher\n");
    await writeFile(join(lib, "router.mjs"), "previous alias\n");
    const result = await runBash(activateHostGenerationCommand(home, manifest, { expectedGeneration: null }), process.env.PATH ?? "");
    assert.notEqual(result.exitCode, 0);
    assert.match(result.stderr, /operator recovery/);
    assert.equal(await readFile(join(lib, "router-command"), "utf8"), "previous launcher\n");
    assert.equal(await readFile(join(lib, "router.mjs"), "utf8"), "previous alias\n");
    await assert.rejects(readFile(join(root, "state.db")), { code: "ENOENT" });
  });

  it("parses the authoritative generation and targets inactive candidates", () => {
    const digest = "a".repeat(64);
    const launcher = `#!/bin/sh\nexec '/opt/bun' '/home/u/.codex-subscription-router/lib/versions/${digest}/router.mjs' "$@"\n`;
    assert.equal(activeHostGeneration(launcher), digest);
    assert.equal(activeHostGeneration("#!/bin/sh\nexit 0\n"), null);
    const manifest = { formatVersion: 1 as const, digest, files: { "router.mjs": "b".repeat(64) } };
    assert.match(candidateHostGenerationCommand("/home/u", manifest, "state inspect-migration"), new RegExp(`${digest}/router\\.mjs.*state inspect-migration`));
  });

  it("serializes competing activations and rejects the stale generation CAS", async () => {
    const home = await mkdtemp(join(tmpdir(), "csr-generation-race-"));
    const router = (label: string) => `
      const command = process.argv.slice(2).join(" ");
      if (command === "runtime preflight") console.log(JSON.stringify({ runtimeExecPath: process.execPath,
        runtimeVersion: process.versions.bun, bun: process.versions.bun, sqliteAvailable: true, sqliteError: null }));
      else if (command === "state migrate-legacy-if-needed") console.log(JSON.stringify({ migrated: false, backend: "sqlite" }));
      else if (command === "state prepare-active") console.log(JSON.stringify({ ready: true, backend: "sqlite" }));
      else if (command === "generation") console.log(${JSON.stringify(label)});
    `;
    const candidates = ["left", "right"].map((label) => {
      const content = router(label);
      return { label, content, manifest: createHostGenerationManifest({ "router.mjs": content }) };
    });
    for (const candidate of candidates) {
      const directory = hostGenerationDirectory(home, candidate.manifest.digest);
      await mkdir(directory, { recursive: true });
      await writeFile(join(directory, "router.mjs"), candidate.content);
    }
    const results = await Promise.all(candidates.map((candidate) =>
      runBash(activateHostGenerationCommand(home, candidate.manifest, { expectedGeneration: null }), process.env.PATH ?? "")));
    assert.equal(results.filter((result) => result.exitCode === 0).length, 1);
    const loser = results.find((result) => result.exitCode !== 0)!;
    assert.match(loser.stderr, /active router generation changed/);
    const winnerIndex = results.findIndex((result) => result.exitCode === 0);
    const launcher = await readFile(join(home, ".codex-subscription-router", "lib", "router-command"), "utf8");
    assert.equal(activeHostGeneration(launcher), candidates[winnerIndex].manifest.digest);
  });

  it("requires the exact Bun runtime with built-in SQLite", async () => {
    const router = new URL("../host/router.mjs", import.meta.url).pathname;
    const executable = process.execPath;
    const result = await runExecutable(executable, [router, "runtime", "preflight"]);
    assert.equal(result.exitCode, 0, result.stderr);
    const capability = JSON.parse(result.stdout.trim());
    assert.equal(capability.runtimeExecPath, executable);
    assert.equal(typeof capability.bun, "string");
    assert.equal(capability.sqliteAvailable, true);
  });

  it("reports Codex and Claude mise resolution before router installation", async () => {
    const root = await mkdtemp(join(tmpdir(), "bb-subscription-preinstall-doctor-"));
    const home = join(root, "home");
    const shims = join(home, ".local", "share", "mise", "shims");
    const bin = join(root, "bin");
    const selectedCodex = join(root, "selected-codex");
    const selectedClaude = join(root, "selected-claude");
    await mkdir(shims, { recursive: true });
    await mkdir(bin, { recursive: true });
    await writeFile(join(bin, "node"), `#!/bin/sh\nexec ${shellQuote(process.execPath)} "$@"\n`);
    await writeFile(join(shims, "codex"), "#!/bin/sh\necho 'codex-cli 9.8.7'\n");
    await writeFile(join(shims, "claude"), "#!/bin/sh\necho '6.5.4 (Claude Code)'\n");
    await writeFile(selectedCodex, "#!/bin/sh\necho 'codex-cli 9.8.7'\n");
    await writeFile(selectedClaude, "#!/bin/sh\necho '6.5.4 (Claude Code)'\n");
    await writeFile(join(shims, "mise"), `#!/bin/sh
case "$1" in
--version) echo 'mise 1.2.3' ;;
-C)
  case "$4" in
  codex) printf '%s\n' ${shellQuote(selectedCodex)} ;;
  claude) printf '%s\n' ${shellQuote(selectedClaude)} ;;
  *) exit 2 ;;
  esac
  ;;
*) exit 2 ;;
esac
`);
    await chmod(join(shims, "codex"), 0o755);
    await chmod(join(shims, "claude"), 0o755);
    await chmod(join(shims, "mise"), 0o755);
    await chmod(join(bin, "node"), 0o755);
    await chmod(selectedCodex, 0o755);
    await chmod(selectedClaude, 0o755);

    const result = await runBash(preinstallDoctorCommand(home), `${shims}:${bin}:/usr/bin:/bin`, home);
    assert.equal(result.exitCode, 0, result.stderr);
    const diagnosis = JSON.parse(result.stdout.trim().split("\n").at(-1)!) as RuntimeDoctor;
    assert.equal(diagnosis.healthy, true);
    assert.equal(diagnosis.codex.observedPath, join(shims, "codex"));
    assert.equal(diagnosis.codex.mise.selectedPath, selectedCodex);
    assert.equal(diagnosis.claude.source, "mise");
    assert.equal(diagnosis.claude.mise.selectedPath, selectedClaude);
    assert.ok(diagnosis.issues.some((issue) => issue.code === "router_not_installed"));
  });

  it("installs into a durable user bin directory the BB daemon searches before real Codex", () => {
    const command = installCommand("/home/palani");
    assert.match(command, /observed_codex="\$\(command -v codex\)"/);
    assert.match(command, /router_launcher='\/home\/palani\/\.codex-subscription-router\/lib\/router-command'/);
    assert.match(command, /\/bin\/sh -c/);
    assert.match(command, /for directory in \$PATH/);
    assert.match(command, /test "\$candidate" = "\$observed_codex"/);
    assert.match(command, /test -w "\$directory"/);
    assert.match(command, /--real-codex "\$real_codex"/);
    assert.match(command, /--shim "\$shim"/);
    assert.match(command, /--mise "\$mise_executable"/);
  });

  describe("findWritableShimDirectorySnippet (executed in a real shell)", () => {
    it("finds a writable directory before the active Codex executable on first install", async () => {
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-search-"));
      const home = join(root, "home");
      const writableDir = join(home, ".local", "bin");
      const systemDir = join(root, "system");
      await mkdir(writableDir, { recursive: true });
      await mkdir(systemDir, { recursive: true });
      const realCodex = join(systemDir, "codex");
      await writeFile(realCodex, "#!/bin/sh\necho real\n");
      await chmod(realCodex, 0o755);

      const result = await runBash(
        `observed_codex="$(command -v codex)"; ${findWritableShimDirectorySnippet} printf '%s' "$shim"`,
        `${writableDir}:${systemDir}`,
        home,
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.equal(result.stdout, join(writableDir, "codex"));
    });

    it("reuses the existing shim's own directory on reinstall instead of leaving shim empty", async () => {
      // Regression: observed_codex already IS the shim once installed, so the
      // loop must not stop before checking whether that same directory is
      // writable — it always is, since the shim was written there before.
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-reinstall-"));
      const home = join(root, "home");
      const shimDir = join(home, ".local", "bin");
      await mkdir(shimDir, { recursive: true });
      const shimFile = join(shimDir, "codex");
      await writeFile(shimFile, "#!/bin/sh\necho shim\n");
      await chmod(shimFile, 0o755);

      const result = await runBash(
        `observed_codex="$(command -v codex)"; ${findWritableShimDirectorySnippet} printf '%s' "$shim"`,
        shimDir,
        home,
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.equal(result.stdout, shimFile);
    });

    it("finds the same shim directory from the managed Zsh login shell", async () => {
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-zsh-"));
      const home = join(root, "home");
      const writableDir = join(home, ".local", "bin");
      const systemDir = join(root, "system");
      await mkdir(writableDir, { recursive: true });
      await mkdir(systemDir, { recursive: true });
      const realCodex = join(systemDir, "codex");
      await writeFile(realCodex, "#!/bin/sh\necho real\n");
      await chmod(realCodex, 0o755);

      const result = await runShell(
        "/bin/zsh",
        `PATH=${shellQuote(`${writableDir}:${systemDir}`)}; export PATH; observed_codex="$(command -v codex)"; ${findWritableShimDirectorySnippet} printf '%s' "$shim"`,
        `${writableDir}:${systemDir}`,
        home,
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.equal(result.stdout, join(writableDir, "codex"));
    });

    it("asks mise for the upstream Codex when the router owns mise's shim", async () => {
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-mise-"));
      const home = join(root, "home");
      const shims = join(home, ".local", "share", "mise", "shims");
      const localBin = join(home, ".local", "bin");
      const routerLib = join(home, ".codex-subscription-router", "lib");
      const realCodex = join(root, "installs", "codex");
      const mise = join(localBin, "mise");
      const capture = join(root, "install-args");
      await mkdir(shims, { recursive: true });
      await mkdir(localBin, { recursive: true });
      await mkdir(routerLib, { recursive: true });
      await mkdir(join(root, "installs"), { recursive: true });
      await writeFile(realCodex, "#!/bin/sh\necho codex-cli test\n");
      await writeFile(mise, `#!/bin/sh\nif test "$1" = -C && test "$3" = which && test "$4" = codex; then printf '%s\\n' ${shellQuote(realCodex)}; else exit 2; fi\n`);
      await writeFile(join(routerLib, "router-command"), `#!/bin/sh\nprintf '%s\\n' "$@" > ${shellQuote(capture)}\n`);
      await chmod(realCodex, 0o755);
      await chmod(mise, 0o755);
      await chmod(join(routerLib, "router-command"), 0o700);
      await symlink(mise, join(shims, "codex"));
      await symlink(mise, join(shims, "mise"));

      for (const [searchPath, destination] of [
        [`${shims}:${localBin}:/usr/bin:/bin`, join(shims, "codex")],
        [`${localBin}:${shims}:/usr/bin:/bin`, join(localBin, "codex")],
      ]) {
      const result = await runShell(
        "/bin/zsh",
        `PATH=${shellQuote(searchPath)}; export PATH; ${installCommand(home)}`,
        searchPath,
        home,
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.deepEqual((await readFile(capture, "utf8")).trim().split("\n"), [
        "install",
        "--real-codex", realCodex,
        "--shim", destination,
        "--mise", mise,
      ]);
      }
    });

    it("leaves shim empty when no writable directory precedes a non-writable Codex", async () => {
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-none-"));
      const systemDir = join(root, "system");
      await mkdir(systemDir, { recursive: true });
      const realCodex = join(systemDir, "codex");
      await writeFile(realCodex, "#!/bin/sh\necho real\n");
      await chmod(realCodex, 0o555);
      await chmod(systemDir, 0o555);

      const result = await runBash(
        `observed_codex="$(command -v codex)"; ${findWritableShimDirectorySnippet} printf '%s' "$shim"`,
        systemDir,
        join(root, "home"),
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.equal(result.stdout, "");
    });

    it("skips writable project directories before a durable user bin", async () => {
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-project-path-"));
      const home = join(root, "home");
      const projectDir = join(root, "checkout", "dist");
      const userBin = join(home, ".local", "bin");
      const systemDir = join(root, "system");
      await mkdir(projectDir, { recursive: true });
      await mkdir(userBin, { recursive: true });
      await mkdir(systemDir, { recursive: true });
      const realCodex = join(systemDir, "codex");
      await writeFile(realCodex, "#!/bin/sh\necho real\n");
      await chmod(realCodex, 0o755);

      const result = await runBash(
        `observed_codex="$(command -v codex)"; ${findWritableShimDirectorySnippet} printf '%s' "$shim"`,
        `${projectDir}:${userBin}:${systemDir}`,
        home,
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.equal(result.stdout, join(userBin, "codex"));
    });

    it("repairs a transient project shim through the next durable user bin", async () => {
      const root = await mkdtemp(join(tmpdir(), "bb-subscription-shim-transient-"));
      const home = join(root, "home");
      const projectDir = join(root, "checkout", "dist");
      const userBin = join(home, ".local", "bin");
      const launcher = join(home, ".codex-subscription-router", "lib", "router-command");
      await mkdir(projectDir, { recursive: true });
      await mkdir(userBin, { recursive: true });
      await mkdir(join(home, ".codex-subscription-router", "lib"), { recursive: true });
      await writeFile(launcher, "#!/bin/sh\nexit 0\n");
      await chmod(launcher, 0o700);
      await symlink(launcher, join(projectDir, "codex"));

      const result = await runBash(
        `observed_codex="$(command -v codex)"; router_launcher=${shellQuote(launcher)}; ${findWritableShimDirectorySnippet} printf '%s' "$shim"`,
        `${projectDir}:${userBin}:/usr/bin:/bin`,
        home,
      );
      assert.equal(result.exitCode, 0, result.stderr);
      assert.equal(result.stdout, join(userBin, "codex"));
    });
  });

  it("resolves a non-mise Codex path through symlinks before comparing to the shim", () => {
    // Guards against real_codex === shim when ~/.local/bin/codex is already a
    // plain symlink to the real executable and is first on PATH.
    const command = installCommand("/home/palani");
    assert.match(command, /real_codex="\$\(readlink -f "\$observed_codex" \|\| printf '%s' "\$observed_codex"\)"/);
  });

  it("reports the executable visible to the BB daemon with router status", () => {
    assert.equal(
      statusCommand("/home/pal ani"),
      `observed_codex="$(command -v codex || true)"; launcher='/home/pal ani/.codex-subscription-router/lib/router-command'; if test -x "$launcher"; then "$launcher" status --observed-codex "$observed_codex"; else '/home/pal ani/.codex-subscription-router/lib/router.mjs' status --observed-codex "$observed_codex"; fi`,
    );
    assert.match(statusCommand("/home/palani", true), /status --refresh --observed-codex/);
  });

  it("builds every supported account command with an inert argument", () => {
    assert.equal(accountCommand("add", "cheap; reboot"), "account add 'cheap; reboot'");
    assert.equal(accountCommand("enable", "acct-1"), "account enable 'acct-1'");
    assert.equal(accountCommand("disable", "acct-1"), "account disable 'acct-1'");
    assert.equal(accountCommand("remove", "acct-1"), "account remove 'acct-1'");
    assert.equal(accountCeilingCommand("acct-1", 75), "account cap 'acct-1' '75'");
    assert.equal(accountCeilingCommand("acct-1", null), "account cap 'acct-1' 'none'");
    assert.equal(threadCommand("thread; one", "acct-1"), "thread assign 'thread; one' 'acct-1'");
  });
});
