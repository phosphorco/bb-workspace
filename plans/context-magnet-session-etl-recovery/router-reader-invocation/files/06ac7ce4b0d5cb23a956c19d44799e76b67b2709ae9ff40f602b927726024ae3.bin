#!/usr/bin/env node
import { createHash, randomUUID } from "node:crypto";
import { spawn, spawnSync } from "node:child_process";
import { X_OK } from "node:constants";
import { accessSync, createReadStream, lstatSync, realpathSync } from "node:fs";
import { createInterface } from "node:readline";
import { access, chmod, copyFile, lstat, mkdir, open, readlink, realpath, rename, stat, symlink, unlink, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { dirname, isAbsolute, join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import * as RolloutFault from "./RolloutFault.ts";
import { aggregateRateLimits, chooseAccount, isPoolOverrideActive, isUsageCeilingReached, longestAndShortestWindow } from "./routing.mjs";
import { openRouterStateStore } from "./backend.mjs";
import { canAcceptThread, copyThreadRollout, discoverThreadRollout, ensureDurableThreadRollout, findMigratedThreadRollout, findUnassignedThreadRollout, linkAccount, loginMachineAccount, migrateAccountThreads, moveThread, probeAccount, recoverUnassignedThread, refreshAccounts, resumeThreadFromRollout } from "./accounts.mjs";
import { recoverMalformedNativeRollout } from "./session-migration.mjs";
import { installSharedHooks, removeSharedHooks, sharedHookArgs, sharedHooksStatus } from "./shared-hooks.mjs";

const ROOT = process.env.CODEX_SUBSCRIPTION_ROUTER_HOME
  ?? join(homedir(), ".codex-subscription-router");
let store;

function deploymentIdentity() {
  const path = new URL(import.meta.url).pathname;
  return {
    generationDigest: path.match(/\/versions\/([a-f0-9]{64})\/router\.mjs$/)?.[1] ?? null,
    runtimeExecPath: process.execPath,
    runtimeVersion: process.versions.bun ?? process.version,
  };
}

function reportStateDiagnostic(event) {
  const shouldReport = event.outcome === "rolled_back"
    || event.event === "json_lock_timeout"
    || event.event === "json_lock_reaped"
    || event.event === "json_lock_release_skipped"
    || Number(event.busyMs ?? 0) >= 10
    || Number(event.waitMs ?? 0) >= 50
    || Number(event.durationMs ?? 0) >= 100;
  if (shouldReport) {
    process.stderr.write(`codex-subscription-router-state ${JSON.stringify({
      timestamp: new Date().toISOString(), pid: process.pid, ...event,
    })}\n`);
  }
}

function idKey(id) {
  return JSON.stringify(id);
}

function turnIdFrom(value) {
  return value?.turnId ?? value?.turn_id ?? value?.turn?.id ?? null;
}

function threadIdFrom(value) {
  return value?.threadId
    ?? value?.thread_id
    ?? value?.thread?.id
    ?? null;
}

function isInteractiveAppServer(args) {
  const index = args.indexOf("app-server");
  if (index < 0) return false;
  return !["daemon", "proxy", "generate-ts", "generate-json-schema", "help"]
    .includes(args[index + 1]);
}

function writeMessage(message) {
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

// Requests that open or create a thread session. The request-side routing
// (#handle) and the response-side ownership commit (#handleRoutedResponse)
// must agree on exactly this set, or the two halves of the flow desync.
const LIFECYCLE_METHODS = ["thread/start", "thread/fork", "thread/resume", "thread/unarchive"];

// Pseudo-account for the native Codex child used by the "passthrough"
// new-thread policy. Real account ids never start with an underscore, so
// this can share the children map without colliding. It is never persisted:
// nothing in router state may reference it.
const NATIVE_ACCOUNT_ID = "__native__";
// The native child gets its own Codex home under the router root rather than
// the machine's ~/.codex: the default install links ~/.codex as the "primary"
// subscription, and sharing a home would let thread/list backfill and
// first-use recovery adopt native threads, run two app-servers on one SQLite
// home, and re-import native threads on rollback. This home holds no login;
// passthrough is therefore only effective while the Account Pooler override
// supplies authentication.
const NATIVE_HOME = join(ROOT, "native", "codex-home");
function nativeAccount() {
  return {
    id: NATIVE_ACCOUNT_ID,
    label: "Native Codex",
    codexHome: NATIVE_HOME,
    enabled: true, draining: false, controller: false,
  };
}

class CodexChild {
  constructor(account, executable, args, onRoutedResponse, onServerMessage) {
    this.account = account;
    this.knownThreads = new Set();
    this.onRoutedResponse = onRoutedResponse;
    this.onServerMessage = onServerMessage;
    this.sequence = 0;
    this.pendingInternal = new Map();
    this.routes = new Map();
    this.closing = false;
    this.exited = false;
    this.process = spawn(executable, args, {
      env: {
        ...process.env,
        CODEX_HOME: account.codexHome,
        CODEX_SQLITE_HOME: account.codexHome,
        CODEX_SUBSCRIPTION_ROUTER_ACTIVE_ACCOUNT: account.id,
      },
      stdio: ["pipe", "pipe", "pipe"],
    });
    this.process.stderr.pipe(process.stderr);
    // Without these, a write to a pipe whose reader already exited (a crash,
    // or the tail end of our own close()) surfaces as an unhandled "error"
    // event and takes down the whole proxy process, not just this child.
    this.process.on("error", () => undefined);
    this.process.stdin.on("error", () => undefined);
    this.done = this.#readOutput();
    // An uncommanded exit is reported through failPendingRoutes and eviction
    // in #select; it must never surface as an unhandled rejection.
    this.done.catch(() => undefined);
  }

  send(message, route = null) {
    if (this.exited) {
      // #select already evicts an exited child before handing out a fresh
      // one, but a request already in flight when the child died can still
      // reach here. Answer and release its lease now — failPendingRoutes
      // already ran and cleared this.routes, so nothing else ever will.
      if (route && message.id != null) {
        writeMessage({ id: message.id, error: { code: -32084,
          message: `Codex app-server for ${this.account.label} exited unexpectedly` } });
        if (route.leaseId) store.endRequest(route.leaseId, route.leaseToken).catch(() => undefined);
      }
      return;
    }
    if (route && message.id != null) this.routes.set(idKey(message.id), route);
    this.process.stdin.write(`${JSON.stringify(message)}\n`);
  }

  uniquePendingLease() {
    const pending = [...this.routes.values()];
    return pending.length === 1 && pending[0].leaseId
      ? pending[0].leaseId : null;
  }

  request(method, params) {
    const id = `bb-subscription-router:${process.pid}:${++this.sequence}`;
    return new Promise((resolve, reject) => {
      const timeout = setTimeout(() => {
        this.pendingInternal.delete(idKey(id));
        reject(new Error(`${method} timed out`));
      }, 30_000);
      this.pendingInternal.set(idKey(id), {
        resolve: (message) => {
          clearTimeout(timeout);
          if (message.error) reject(new Error(message.error.message ?? `${method} failed`));
          else resolve(message.result);
        },
      });
      this.send({ id, method, params });
    });
  }

  async close() {
    this.closing = true;
    this.process.stdin.end();
    const termTimer = setTimeout(() => this.process.kill("SIGTERM"), 2_000);
    // A child that ignores SIGTERM must never hang the proxy's own exit.
    const killTimer = setTimeout(() => this.process.kill("SIGKILL"), 5_000);
    await this.done.catch(() => undefined);
    clearTimeout(termTimer);
    clearTimeout(killTimer);
  }

  /**
   * Answers any request BB is still waiting on from this child with an
   * error, so BB fails fast instead of hanging, and releases each route's
   * on-disk lease. Without this second part these leases outlive the child:
   * they're stamped with the *proxy's* pid (still alive — only one of its
   * several children crashed), so the dead-pid reaper never reclaims them.
   */
  async failPendingRoutes(reason) {
    const releases = [];
    for (const [key, route] of this.routes) {
      try {
        writeMessage({ id: JSON.parse(key), error: { code: -32084, message: reason } });
      } catch {
        // Malformed route key; nothing sensible to answer.
      }
      if (route?.leaseId) releases.push(store.endRequest(route.leaseId, route.leaseToken).catch(() => undefined));
    }
    this.routes.clear();
    await Promise.all(releases);
  }

  async #readOutput() {
    const lines = createInterface({ input: this.process.stdout });
    for await (const line of lines) {
      let message;
      try {
        message = JSON.parse(line);
      } catch {
        process.stderr.write(`codex-subscription-router: ignored invalid child JSON: ${line}\n`);
        continue;
      }
      if (message.id != null) {
        const key = idKey(message.id);
        const internal = this.pendingInternal.get(key);
        if (internal) {
          this.pendingInternal.delete(key);
          internal.resolve(message);
          continue;
        }
        const route = this.routes.get(key);
        if (route) {
          this.routes.delete(key);
          if (await this.onRoutedResponse?.(message, route) === true) continue;
        }
      }
      if (await this.onServerMessage?.(message, this) === true) continue;
      writeMessage(message);
    }
    const [code, signal] = await new Promise((resolve) => {
      if (this.process.exitCode != null) resolve([this.process.exitCode, null]);
      else this.process.once("exit", (exitCode, exitSignal) => resolve([exitCode, exitSignal]));
    });
    this.exited = true;
    if (!this.closing) {
      // The proxy never asked this child to exit — a crash or an external
      // kill. Nothing will ever answer requests we already forwarded to it.
      await this.failPendingRoutes(`Codex app-server for ${this.account.label} exited unexpectedly (${code ?? signal})`);
    }
    if (code !== 0 && signal !== "SIGTERM") {
      throw new Error(`Codex app-server for ${this.account.label} exited with ${code ?? signal}`);
    }
  }
}

class AppServerProxy {
  constructor(state, args) {
    this.state = state;
    this.args = args;
    // With the Account Pooler override present, children authenticate with the
    // hub token, so local account quota is not being spent. Accounts still own
    // thread history; admission, failover and usage reporting defer to the hub.
    this.poolOverride = isPoolOverrideActive();
    if (this.poolOverride) {
      process.stderr.write("codex-subscription-router: Account Pooler override active; local quota gating disabled\n");
    }
    this.warnedPassthroughWithoutOverride = false;
    this.children = new Map();
    this.child = null;
    this.account = null;
    this.initializeParams = null;
    this.initialized = false;
    this.lastRefreshAt = 0;
    this.serverRoutes = new Map();
    this.serverSequence = 0;
    this.requestSequence = 0;
    this.turnLeases = new Map();
    this.shuttingDown = false;
    this.heartbeatTimer = null;
  }

  /**
   * The one teardown path for stdin EOF, SIGTERM/SIGINT/SIGHUP, and a fatal
   * failure in the client-message loop: close every child first (TERM,
   * bounded SIGKILL fallback — never an unbounded wait), THEN release every
   * lease this process holds. Releasing leases before the children have
   * actually stopped would let a concurrent drain/reassign/disable elsewhere
   * treat this account as idle while its child is still alive and writing.
   */
  async #shutdown(reason) {
    if (this.shuttingDown) return;
    this.shuttingDown = true;
    if (this.heartbeatTimer) clearInterval(this.heartbeatTimer);
    await Promise.all([...this.children.values()].map((child) => child.close()));
    await store.releaseOwnerLeases().catch((error) => {
      process.stderr.write(`codex-subscription-router: failed to release leases on shutdown: ${error instanceof Error ? error.message : String(error)}\n`);
    });
    process.stderr.write(`codex-subscription-router: shut down (${reason})\n`);
  }

  async run() {
    // Nothing already holds these leases from a previous run of this exact
    // process id (impossible), but a prior instance that died without
    // tearing down may have left leases behind under a now-dead pid.
    await store.drainActiveRequests(() => false).catch(() => undefined);

    const controller = this.state.accounts.find((account) => account.controller)
      ?? this.state.accounts[0];
    if (!controller) throw new Error("no Codex subscription is configured");
    await this.#select(controller);
    this.heartbeatTimer = setInterval(() => {
      void store.heartbeat().catch((error) => {
        process.stderr.write(`codex-subscription-router: state heartbeat failed: ${error instanceof Error ? error.message : String(error)}\n`);
      });
    }, 10_000);
    this.heartbeatTimer.unref();

    const onSignal = (signal) => {
      void this.#shutdown(signal).finally(() => process.exit(0));
    };
    process.once("SIGTERM", () => onSignal("SIGTERM"));
    process.once("SIGINT", () => onSignal("SIGINT"));
    process.once("SIGHUP", () => onSignal("SIGHUP"));

    try {
      await this.#serve();
    } finally {
      await this.#shutdown("stdin-eof-or-fatal-error");
    }
  }

  async #serve() {
    const lines = createInterface({ input: process.stdin });
    for await (const line of lines) {
      let message;
      try {
        message = JSON.parse(line);
      } catch {
        process.stderr.write("codex-subscription-router: ignored invalid client JSON\n");
        continue;
      }
      try {
        await this.#handle(message);
      } catch (error) {
        if (message.id != null) {
          writeMessage({
            id: message.id,
            error: { code: -32080, message: error instanceof Error ? error.message : String(error) },
          });
        } else {
          process.stderr.write(`codex-subscription-router: ${error instanceof Error ? error.message : String(error)}\n`);
        }
      }
    }
  }

  async #handle(message) {
    if (message.id != null && message.method == null) {
      const route = this.serverRoutes.get(idKey(message.id));
      if (route) {
        this.serverRoutes.delete(idKey(message.id));
        route.child.send({ ...message, id: route.originalId });
        return;
      }
      process.stderr.write("codex-subscription-router: ignored response for unknown server request\n");
      return;
    }
    if (message.method === "initialize" && message.id != null) {
      this.initializeParams = message.params ?? {};
      this.child.send(message, { method: "initialize" });
      return;
    }
    if (message.method === "initialized") {
      this.initialized = true;
      this.child.send(message);
      return;
    }
    if (message.method === "account/rateLimits/read" && message.id != null && !this.poolOverride) {
      await this.#refreshStateIfStale();
      const snapshots = this.state.accounts.flatMap((account) => account.snapshot ? [{
        ...account.snapshot,
        enabled: account.enabled && !account.draining,
        usageCeiling: account.usageCeiling,
      }] : []);
      writeMessage({ id: message.id, result: { rateLimits: aggregateRateLimits(snapshots) } });
      return;
    }
    if (message.method === "thread/list" && message.id != null) {
      await this.#aggregateThreadList(message);
      return;
    }

    const scopedThreadId = threadIdFrom(message.params);
    if (scopedThreadId) this.state = await store.read();
    const isLifecycleRequest = LIFECYCLE_METHODS.includes(message.method);
    if (await this.#isPassthroughRequest(message, scopedThreadId, isLifecycleRequest)) {
      await this.#select(nativeAccount());
      if (scopedThreadId && !isLifecycleRequest && !this.child.knownThreads.has(scopedThreadId)) {
        // A restarted native child has to reload the thread from its own
        // home before a turn or interrupt can address it.
        const native = this.child;
        await native.request("thread/resume", { threadId: scopedThreadId })
          .then(() => native.knownThreads.add(scopedThreadId), () => undefined);
      }
      // No store lease: the router owns nothing about this thread.
      this.child.send(message, { method: message.method, message, excluded: new Set(), leaseId: null, leaseToken: null });
      return;
    }
    if (this.account?.id === NATIVE_ACCOUNT_ID) {
      // Never let a routed request, a store lease, or an owned rollout land
      // in the native child just because it handled the previous request.
      const controller = this.state.accounts.find((account) => account.controller) ?? this.state.accounts[0];
      await this.#select(controller);
    }
    if (scopedThreadId && !this.state.threadOwners[scopedThreadId]
      && (isLifecycleRequest || message.method === "turn/start")) {
      const target = this.#accountForThreadRequest(message);
      this.state = await recoverUnassignedThread(store, scopedThreadId, target.id);
    }
    if (isLifecycleRequest) {
      // A new thread (thread/start) needs fresh quota to pick the right
      // account. This is at thread-creation frequency, not per-turn, so it
      // is not the hot-path probe the turn/start refresh was.
      if (message.method === "thread/start") await this.#refreshStateIfStale(true);
      const account = this.#accountForThreadRequest(message);
      if (account.id !== this.account.id) await this.#select(account);
      // BB's own lifecycle request IS the resume/fork/unarchive: never also
      // issue our own internal thread/resume first, or Codex sees two
      // writers on the same thread and rejects the second. If we hold a
      // durable (possibly migrated) rollout path for this thread, inject it
      // into BB's request so the one forwarded request lands in the right
      // place — a fresh child has no other way to find a migrated thread.
      // thread/start is exempt: it is inherently a brand-new thread with no
      // prior rollout to inject.
      if (message.method !== "thread/start" && scopedThreadId) {
        let rolloutPath = this.state.threadRollouts[scopedThreadId];
        if (this.state.threadOwners[scopedThreadId] === account.id) {
          rolloutPath ??= (await findUnassignedThreadRollout({ accounts: [account] }, scopedThreadId, []))?.path;
          if (rolloutPath) {
            try {
              rolloutPath = await ensureDurableThreadRollout(account, scopedThreadId, rolloutPath);
            } catch (error) {
              await this.#recoverMalformedRollout(error, account, scopedThreadId, rolloutPath);
              // Do not forward the lifecycle request after changing its
              // session path. The command that caused the repair did not
              // run; its retry will carry the recovered path.
              throw new Error("This thread's incomplete session record was repaired in a new copy and the original history was preserved. This request was not run; retry it.");
            }
            if (rolloutPath !== this.state.threadRollouts[scopedThreadId]) {
              this.state = await store.assignThread(scopedThreadId, account.id, null, rolloutPath);
            }
          }
        }
        if (rolloutPath && message.params?.path == null) {
          message = { ...message, params: { ...message.params, path: rolloutPath } };
        }
        // Codex resumes with the provider recorded in the rollout unless told
        // otherwise. A thread created directly against OpenAI carries
        // "openai", which under the Account Pooler base URL reaches the hub
        // without its token header (wss 404, then 401); a pool-created
        // rollout carries "bb-account-pool", which does not exist once the
        // override is gone. Pin the provider to the current launch.
        if (["thread/resume", "thread/fork"].includes(message.method) && message.params?.modelProvider == null) {
          message = { ...message, params: { ...message.params, modelProvider: this.poolOverride ? "bb-account-pool" : "openai" } };
        }
      }
    } else {
      const threadId = threadIdFrom(message.params);
      if (threadId) {
        const ownerId = this.state.threadOwners[threadId];
        const owner = this.state.accounts.find((account) => account.id === ownerId && account.enabled);
        if (owner && owner.id !== this.account.id) await this.#select(owner);
        if (owner && message.method === "turn/start" && this.#isExhausted(owner)) {
          await this.#ensureThreadAvailable(threadId);
          await this.#failoverTurn(message, new Set([owner.id]), owner);
          return;
        }
      }
      // Only a non-lifecycle request (e.g. an interrupt or approval reply
      // routed to a child that hasn't loaded this thread yet) may need our
      // own resume — a lifecycle request already carries one.
      if (scopedThreadId) await this.#ensureThreadAvailable(scopedThreadId);
    }
    let leaseId = null;
    let leaseToken = null;
    if (message.id != null && (scopedThreadId || isLifecycleRequest)) {
      leaseId = "lease:" + process.pid + ":" + (++this.requestSequence);
      const leaseState = message.method === "turn/start"
        ? await store.beginTurn(this.account.id, leaseId, process.pid, scopedThreadId)
        : await store.beginRequest(this.account.id, leaseId, process.pid, scopedThreadId);
      this.state = leaseState;
      leaseToken = leaseState.leaseToken;
      if (leaseState.leaseActive === false) throw new Error("lifecycle request was already completed");
    }
    try {
      this.child.send(message, { method: message.method, message, excluded: new Set(), leaseId, leaseToken });
    } catch (error) {
      if (leaseId) {
        await store.endRequest(leaseId, leaseToken).catch(() => undefined);
      }
      throw error;
    }
  }

  /**
   * Under the "passthrough" new-thread policy, decides whether a request
   * belongs to native Codex rather than a linked subscription. Threads the
   * router owns, and unowned threads whose history lives in a linked account
   * home (legacy conversations awaiting first-use recovery), stay routed.
   * Everything else — thread/start, and any thread the router has no record
   * or history of — is native, and the router never records it.
   */
  #passthroughActive() {
    if (this.state.newThreadPolicy !== "passthrough") return false;
    if (this.poolOverride) return true;
    if (!this.warnedPassthroughWithoutOverride) {
      this.warnedPassthroughWithoutOverride = true;
      process.stderr.write("codex-subscription-router: new-thread policy is passthrough but no Account Pooler override is present; routing new threads to linked subscriptions\n");
    }
    return false;
  }

  async #isPassthroughRequest(message, scopedThreadId, isLifecycleRequest) {
    // Re-read so an operator's policy flip reaches a live proxy.
    if (message.method === "thread/start") this.state = await store.read();
    if (!this.#passthroughActive()) return false;
    if (message.method === "thread/start") return true;
    if (!scopedThreadId) return false;
    // Any ownership record, even for a disabled or removed account, keeps the
    // thread on the routed path so its existing recovery rules apply.
    if (this.state.threadOwners[scopedThreadId]) return false;
    // A thread some child already loaded stays wherever it lives; this also
    // spares the linked-home walk on every native turn.
    for (const child of this.children.values()) {
      if (child.knownThreads.has(scopedThreadId)) return child.account.id === NATIVE_ACCOUNT_ID;
    }
    try {
      // Same search as routed first-use recovery, legacy homes included, so
      // a thread that route mode could recover never falls to the empty
      // native home.
      const linked = await findUnassignedThreadRollout(this.state, scopedThreadId);
      return linked === null;
    } catch {
      // Conflicting or malformed linked copies: let the routed path report it.
      return false;
    }
  }

  async #resumeFromRollout(child, threadId, rolloutPath, overrides = {}) {
    // Internal resumes (failover copies, lazily loaded owned threads) pin the
    // provider to the current launch for the same reason BB's own resume does.
    await resumeThreadFromRollout(child, threadId, rolloutPath, overrides);
    child.knownThreads.add(threadId);
  }

  async #ensureThreadAvailable(threadId) {
    if (this.child.knownThreads.has(threadId)) return;
    const ownerId = this.state.threadOwners[threadId];
    const owner = this.state.accounts.find((account) => account.id === ownerId);
    if (owner?.draining) return;
    let rolloutPath = this.state.threadRollouts[threadId];
    if (!rolloutPath && owner) {
      rolloutPath = await discoverThreadRollout(this.state.realCodex, owner, threadId, ROOT)
        ?? await findMigratedThreadRollout(owner, threadId);
    }
    if (owner && rolloutPath) {
      try {
        rolloutPath = await ensureDurableThreadRollout(owner, threadId, rolloutPath);
        if (this.state.threadRollouts[threadId] !== rolloutPath) {
          this.state = await store.assignThread(threadId, ownerId, null, rolloutPath);
        }
        await this.#resumeFromRollout(this.child, threadId, rolloutPath);
      } catch (error) {
        const recoveredPath = await this.#recoverMalformedRollout(error, owner, threadId, rolloutPath);
        await this.#resumeFromRollout(this.child, threadId, recoveredPath);
        throw new Error("This thread's incomplete session record was repaired in a new copy and the original history was preserved. This request was not run; retry it.");
      }
      return;
    }
    if (rolloutPath) await this.#resumeFromRollout(this.child, threadId, rolloutPath);
  }

  /**
   * Repairs the one malformed-record class the router can safely recover.
   * Both internal resumes and BB lifecycle resumes must go through this
   * boundary: the latter injects a rollout path instead of calling resume.
   */
  async #recoverMalformedRollout(error, account, threadId, sourcePath) {
    const fault = RolloutFault.of(error);
    if (fault === null || !RolloutFault.isRecoverable(fault)) throw error;
    let recovered;
    try {
      recovered = await recoverMalformedNativeRollout({ account, threadId, sourcePath });
    } catch (recoveryError) {
      const recoveryFault = RolloutFault.of(recoveryError);
      if (recoveryFault === null) throw recoveryError;
      throw RolloutFault.match(recoveryFault, {
        onCapacity: () => new Error("This thread's session record is incomplete and a repaired copy could not be written because storage is full. Free disk space, then retry; the original history was preserved."),
        onMalformedRecord: () => recoveryError,
        onMalformed: () => recoveryError,
        onUnsupportedFormat: () => recoveryError,
        onIdentityMismatch: () => recoveryError,
        onSafetyLimit: () => recoveryError,
        onUnsafe: () => recoveryError,
        onTransient: () => recoveryError,
        onIntegrity: () => recoveryError,
      });
    }
    this.state = await store.assignThread(threadId, account.id, null, recovered.path);
    return recovered.path;
  }

  async #refreshStateIfStale(force = false) {
    if (!force && Date.now() - this.lastRefreshAt < 60_000) return;
    this.state = await refreshAccounts(store);
    this.lastRefreshAt = Date.now();
  }

  async #aggregateThreadList(message) {
    const params = message.params ?? {};
    const limit = Math.max(1, Math.min(100, Number.isInteger(params.limit) ? params.limit : 20));
    let decoded = { version: 1, accounts: [] };
    if (params.cursor != null) {
      if (typeof params.cursor !== "string" || !params.cursor.startsWith("bb-router:")) {
        throw new Error("invalid subscription-router thread cursor");
      }
      try {
        decoded = JSON.parse(Buffer.from(params.cursor.slice(10), "base64url").toString("utf8"));
      } catch {
        throw new Error("invalid subscription-router thread cursor");
      }
      if (decoded?.version !== 1 || !Array.isArray(decoded.accounts)) {
        throw new Error("invalid subscription-router thread cursor");
      }
    }
    const saved = new Map(decoded.accounts.map((entry) => [entry.accountId, entry]));
    const { cursor: ignoredCursor, limit: ignoredLimit, ...filters } = params;
    const previous = this.account;
    const entries = [];
    this.state = await store.read();
    const listed = this.#passthroughActive()
      ? [...this.state.accounts, nativeAccount()]
      : this.state.accounts;
    try {
      for (const account of listed) {
        await this.#select(account);
        const prior = saved.get(account.id);
        const entry = {
          accountId: account.id,
          cursor: typeof prior?.cursor === "string" ? prior.cursor : null,
          items: Array.isArray(prior?.items) ? prior.items : [],
          initialized: prior?.initialized === true,
        };
        if (!entry.initialized || (entry.items.length === 0 && entry.cursor != null)) {
          const result = await this.child.request("thread/list", {
            ...filters, limit, cursor: entry.initialized ? entry.cursor : null,
          });
          entry.items = Array.isArray(result?.data) ? result.data : [];
          entry.cursor = typeof result?.nextCursor === "string" ? result.nextCursor : null;
          entry.initialized = true;
        }
        entries.push(entry);
      }
    } finally {
      if (previous) await this.#select(previous);
    }
    const candidates = entries.flatMap((entry) => entry.items.map((thread) => ({ accountId: entry.accountId, thread })));
    candidates.sort((left, right) =>
      String(right.thread?.updatedAt ?? right.thread?.createdAt ?? "").localeCompare(
        String(left.thread?.updatedAt ?? left.thread?.createdAt ?? ""),
      ));
    // thread/list only observes; it must never write ownership. A thread can
    // legitimately appear in more than one account's home (a stale copy left
    // behind by a move, for instance), and listing is not the moment to
    // arbitrate which one is authoritative — only a committed lifecycle
    // success or a committed move/failover may do that.
    const data = [];
    const selectedIds = new Set();
    for (const candidate of candidates) {
      const threadId = candidate.thread?.id;
      if (typeof threadId !== "string" || selectedIds.has(threadId)) continue;
      selectedIds.add(threadId);
      data.push(candidate.thread);
      if (data.length === limit) break;
    }
    for (const entry of entries) {
      entry.items = entry.items.filter((thread) => !selectedIds.has(thread?.id));
    }
    const hasMore = entries.some((entry) => entry.items.length > 0 || entry.cursor != null);
    const nextCursor = hasMore
      ? "bb-router:" + Buffer.from(JSON.stringify({ version: 1, accounts: entries }), "utf8").toString("base64url")
      : null;
    // Backfill ownership for threads nothing has ever recorded an owner for
    // — legacy conversations that predate this router and were never opened
    // through a lifecycle request. This never overwrites an existing owner
    // (that's the corruption thread/list used to cause), only fills a gap,
    // so a disabled/removed account still protects any thread it actually
    // owns. Only an enabled, non-draining account can be recorded as an
    // owner (the same eligibility assignThread enforces), and a thread
    // that's mid-migration is skipped entirely — that lock's owner is
    // already authoritative and about to change.
    const eligibleAccountIds = new Set(this.state.accounts
      .filter((account) => account.enabled && !account.draining)
      .map((account) => account.id));
    const unowned = new Map();
    for (const candidate of candidates) {
      const threadId = candidate.thread?.id;
      if (typeof threadId !== "string" || !eligibleAccountIds.has(candidate.accountId)) continue;
      if (this.state.threadOwners[threadId] == null && !unowned.has(threadId)) {
        unowned.set(threadId, candidate.accountId);
      }
    }
    if (unowned.size > 0) {
      this.state = await store.backfillThreadOwners([...unowned]);
    }
    writeMessage({ id: message.id, result: { data, nextCursor } });
  }

  #isExhausted(account) {
    if (this.poolOverride) return false;
    const { weekly } = longestAndShortestWindow(account.snapshot?.rateLimits);
    return isUsageCeilingReached({ ...account.snapshot, usageCeiling: account.usageCeiling })
      || weekly?.usedPercent >= 100
      || account.snapshot?.rateLimits?.rateLimitReachedType != null;
  }

  async #observeThreadIdentity(message, sourceChild) {
    const threadId = threadIdFrom(message.params);
    if (!message.method || !threadId) return;
    sourceChild.knownThreads.add(threadId);
    if (sourceChild.account.id === NATIVE_ACCOUNT_ID) return;

    this.state = await store.read();
    const sourceAccount = sourceChild.account;
    const ownerId = this.state.threadOwners[threadId] ?? null;
    if (ownerId && ownerId !== sourceAccount.id) {
      process.stderr.write(`codex-subscription-router: ignored conflicting owner observation for ${threadId}\n`);
      return;
    }
    const rolloutPath = typeof message.params?.thread?.path === "string"
      ? message.params.thread.path
      : null;
    if (ownerId === sourceAccount.id
      && (!rolloutPath || this.state.threadRollouts[threadId] === rolloutPath)) return;

    const leaseKeys = [turnIdFrom(message.params), threadId]
      .filter(Boolean).map((key) => sourceAccount.id + ":" + key);
    const leaseHandle = leaseKeys.map((key) => this.turnLeases.get(key)).find(Boolean);
    const leaseId = leaseHandle?.leaseId ?? sourceChild.uniquePendingLease();
    try {
      this.state = await store.assignThread(threadId, sourceAccount.id, leaseId, rolloutPath);
    } catch (error) {
      process.stderr.write("codex-subscription-router: rejected observed thread assignment: "
        + (error instanceof Error ? error.message : String(error)) + "\n");
    }
  }

  async #handleServerMessage(message, sourceChild) {
    const sourceAccount = sourceChild.account;
    await this.#observeThreadIdentity(message, sourceChild);
    if (message.method === "turn/completed") {
      const keys = [turnIdFrom(message.params), threadIdFrom(message.params)]
        .filter(Boolean).map((key) => sourceAccount.id + ":" + key);
      const lease = keys.map((key) => this.turnLeases.get(key)).find(Boolean);
      if (lease) {
        for (const [key, value] of this.turnLeases) {
          if (value.leaseId === lease.leaseId) this.turnLeases.delete(key);
        }
        await store.endRequest(lease.leaseId, lease.leaseToken).catch(() => undefined);
      }
    }
    if (message.id != null && message.method) {
      const routedId = "bb-subscription-router:server:" + process.pid + ":" + (++this.serverSequence);
      this.serverRoutes.set(idKey(routedId), {
        child: sourceChild,
        originalId: message.id,
      });
      writeMessage({ ...message, id: routedId });
      return true;
    }
    if (message.method === "account/rateLimits/updated" && this.poolOverride) {
      // The numbers describe the hub's account, not this local home.
      writeMessage(message);
      return true;
    }
    if (message.method === "account/rateLimits/updated") {
      const account = this.state.accounts.find((candidate) => candidate.id === sourceAccount.id);
      const rateLimits = message.params?.rateLimits ?? message.params;
      if (account && rateLimits) {
        account.snapshot ??= { id: account.id, label: account.label, enabled: account.enabled };
        account.snapshot.rateLimits = rateLimits;
        account.snapshotUpdatedAt = Date.now();
        void store.updateAccount(account.id, {
          snapshot: account.snapshot, snapshotUpdatedAt: account.snapshotUpdatedAt,
        }).catch(() => undefined);
      }
      const snapshots = this.state.accounts.flatMap((candidate) => candidate.snapshot ? [{
        ...candidate.snapshot,
        enabled: candidate.enabled && !candidate.draining,
        usageCeiling: candidate.usageCeiling,
      }] : []);
      writeMessage({
        ...message,
        params: { ...(message.params ?? {}), rateLimits: aggregateRateLimits(snapshots) },
      });
      return true;
    }
    const isThreadMessage = threadIdFrom(message.params) != null;
    const controller = this.state.accounts.find((account) => account.controller) ?? this.state.accounts[0];
    return Boolean(message.method && !isThreadMessage && sourceAccount.id !== controller?.id);
  }

  async #handleRoutedResponse(message, route, sourceAccount) {
    if (sourceAccount.id === NATIVE_ACCOUNT_ID) {
      const threadId = threadIdFrom(message.result);
      if (threadId && !message.error) this.children.get(NATIVE_ACCOUNT_ID)?.knownThreads.add(threadId);
      return false;
    }
    const isLifecycleSuccess = !message.error && LIFECYCLE_METHODS.includes(route.method);
    if (isLifecycleSuccess) {
      const threadId = threadIdFrom(message.result);
      try {
        if (threadId) {
          this.state = await store.assignThread(threadId, sourceAccount.id, route.leaseId);
          this.children.get(sourceAccount.id)?.knownThreads.add(threadId);
          if (this.state.releasedThreads.includes(threadId)) {
            this.state = await store.reclaimThread(threadId).catch(() => this.state);
          }
        }
      } catch (error) {
        writeMessage({ id: message.id, error: { code: -32082,
          message: error instanceof Error ? error.message : String(error) } });
        return true;
      } finally {
        if (route.leaseId) {
          await store.endRequest(route.leaseId, route.leaseToken).catch(() => undefined);
        }
      }
      return false;
    }
    if (route.method === "thread/archive" && !message.error) {
      const threadId = threadIdFrom(route.message?.params);
      if (threadId && this.state.threadOwners[threadId]) {
        this.state = await store.releaseThread(threadId).catch(() => this.state);
        for (const child of this.children.values()) child.knownThreads.delete(threadId);
      }
    }
    if (route.leaseId) {
      if (route.method === "turn/start" && !message.error) {
        const keys = [turnIdFrom(message.result), threadIdFrom(route.message?.params)]
          .filter(Boolean).map((key) => sourceAccount.id + ":" + key);
        for (const key of keys) this.turnLeases.set(key, {
          leaseId: route.leaseId, leaseToken: route.leaseToken,
        });
        if (keys.length === 0) {
          await store.endRequest(route.leaseId, route.leaseToken).catch(() => undefined);
        }
      } else {
        await store.endRequest(route.leaseId, route.leaseToken).catch(() => undefined);
      }
    }
    if (route.method !== "turn/start" || !message.error || this.poolOverride) return false;
    const text = `${message.error.message ?? ""} ${JSON.stringify(message.error.data ?? "")}`.toLowerCase();
    if (!["usage_limit", "usage limit", "rate_limit", "rate limit", "quota"].some((term) => text.includes(term))) return false;
    const excluded = new Set(route.excluded ?? []);
    sourceAccount = this.state.accounts.find((account) => account.id === sourceAccount.id) ?? sourceAccount;
    excluded.add(sourceAccount.id);
    const { weekly } = longestAndShortestWindow(sourceAccount.snapshot?.rateLimits);
    if (weekly) weekly.usedPercent = 100;
    if (sourceAccount.snapshot?.rateLimits) sourceAccount.snapshot.rateLimits.rateLimitReachedType = "rate_limit_reached";
    void store.updateAccount(sourceAccount.id, { snapshot: sourceAccount.snapshot, snapshotUpdatedAt: Date.now() })
      .catch(() => undefined);
    void this.#failoverTurn(route.message, excluded, sourceAccount).catch((error) => writeMessage({
      id: route.message.id,
      error: { code: -32081, message: error instanceof Error ? error.message : String(error) },
    }));
    return true;
  }

  #routingSnapshots(excluded) {
    return this.state.accounts.flatMap((account) => account.snapshot ? [{
      ...account.snapshot,
      id: account.id,
      label: account.label,
      enabled: account.enabled && !account.draining,
      usageCeiling: account.usageCeiling,
      createdAt: account.createdAt,
      threadCount: Object.values(this.state.threadOwners).filter((owner) => owner === account.id).length,
    }] : []).filter((snapshot) => !excluded.has(snapshot.id));
  }

  async #failoverTurn(message, excluded, sourceAccount) {
    const threadId = threadIdFrom(message.params);
    if (!threadId) throw new Error("all Codex subscriptions are depleted");
    const targetSnapshot = chooseAccount(this.#routingSnapshots(excluded), { quotaGated: !this.poolOverride }).account;
    const targetAccount = this.state.accounts.find((account) => account.id === targetSnapshot.id);
    if (!targetAccount) throw new Error("fallback Codex subscription is unavailable");
    const source = this.children.get(sourceAccount.id);
    if (!source) throw new Error("source Codex subscription is unavailable");
    let sourceLease = "lease:" + process.pid + ":" + (++this.requestSequence);
    let sourceLeaseToken = null;
    let targetLease = null;
    let targetLeaseToken = null;
    let claimed = false;
    let claimToken = null;
    const sourceLeaseState = await store.beginRequest(sourceAccount.id, sourceLease, process.pid, threadId);
    sourceLeaseToken = sourceLeaseState.leaseToken;
    try {
      this.state = await store.beginMigration(threadId, targetAccount.id, {
        expectedOwnerId: sourceAccount.id,
        ownerChangedMessage: "thread subscription changed before failover",
      });
      claimToken = this.state.claimToken;
      claimed = true;
      const read = await source.request("thread/read", { threadId, includeTurns: true });
      const thread = read?.thread;
      if (!thread?.path) throw new Error("existing Codex thread has no resumable history path");
      await this.#select(targetAccount);
      const next = this.child;
      const copiedPath = await copyThreadRollout(sourceAccount, targetAccount, threadId, thread);
      await this.#resumeFromRollout(next, threadId, copiedPath, {
        cwd: thread.cwd ?? null, model: null, modelProvider: thread.modelProvider ?? null,
      });
      targetLease = "lease:" + process.pid + ":" + (++this.requestSequence);
      this.state = await store.commitReassignment({
        threadId, targetAccountId: targetAccount.id, expectedOwnerId: sourceAccount.id, copiedPath,
        isTargetAcceptable: canAcceptThread,
        unavailableMessage: "fallback Codex subscription became unavailable during migration",
        leaseSwap: { endLeaseId: sourceLease, endLeaseToken: sourceLeaseToken,
          newLeaseId: targetLease, ownerPid: process.pid },
        claimToken,
      });
      targetLeaseToken = this.state.leaseToken;
      claimed = false;
      sourceLease = null;
      next.send(message, { method: "turn/start", message, excluded,
        leaseId: targetLease, leaseToken: targetLeaseToken });
      targetLease = null;
    } catch (error) {
      await this.#select(sourceAccount).catch(() => undefined);
      throw error;
    } finally {
      if (claimed) {
        await store.abortMigration(threadId, targetAccount.id, claimToken);
      }
      if (sourceLease) {
        await store.endRequest(sourceLease, sourceLeaseToken).catch(() => undefined);
      }
      if (targetLease) {
        await store.endRequest(targetLease, targetLeaseToken).catch(() => undefined);
      }
    }
  }

  #accountForThreadRequest(message) {
    const threadId = threadIdFrom(message.params);
    if (threadId) {
      const owner = this.state.threadOwners[threadId];
      const owned = this.state.accounts.find((account) => account.id === owner && account.enabled);
      if (owned) return owned;
    }
    const snapshots = this.state.accounts.flatMap((account) => account.snapshot ? [{
      ...account.snapshot,
      id: account.id,
      label: account.label,
      enabled: account.enabled && !account.draining,
      usageCeiling: account.usageCeiling,
      createdAt: account.createdAt,
      threadCount: Object.values(this.state.threadOwners).filter((owner) => owner === account.id).length,
    }] : []);
    return this.state.accounts.find(
      (account) => account.id === chooseAccount(snapshots, { quotaGated: !this.poolOverride }).account.id,
    );
  }

  async #select(account) {
    const existing = this.children.get(account.id);
    if (existing && existing.exited) {
      // A crashed child stays in the map only long enough for
      // failPendingRoutes to answer its in-flight requests; reusing it here
      // would mean writing to an already-dead process forever.
      this.children.delete(account.id);
    } else if (existing) {
      this.child = existing;
      this.account = account;
      return;
    }
    if (account.id === NATIVE_ACCOUNT_ID) await mkdir(account.codexHome, { recursive: true, mode: 0o700 });
    const next = new CodexChild(account, this.state.realCodex, await sharedHookArgs(ROOT, this.args),
      (response, route) => this.#handleRoutedResponse(response, route, account),
      (message, sourceChild) => this.#handleServerMessage(message, sourceChild));
    try {
      if (this.initializeParams != null) {
        await next.request("initialize", this.initializeParams);
        if (this.initialized) next.send({ method: "initialized" });
      }
    } catch (error) {
      await next.close();
      throw error;
    }
    this.children.set(account.id, next);
    this.child = next;
    this.account = account;
  }
}

async function passthrough(state, args) {
  const child = spawn(state.realCodex, await sharedHookArgs(ROOT, args), {
    env: process.env,
    stdio: "inherit",
  });
  const [code, signal] = await new Promise((resolve) =>
    child.once("exit", (exitCode, exitSignal) => resolve([exitCode, exitSignal])),
  );
  if (signal) process.kill(process.pid, signal);
  process.exitCode = code ?? 1;
}

function publicStatus(state, observedCodex = null) {
  const assignments = Object.entries(state.threadOwners)
    .reverse()
    .map(([threadId, accountId]) => ({ threadId, accountId }));
  return {
    installed: true,
    metricsVersion: 1,
    active: routerShimActive(state, observedCodex),
    shimPath: state.shimPath,
    observedCodex,
    newThreadPolicy: state.newThreadPolicy ?? "route",
    accounts: state.accounts.map((account) => ({
      id: account.id,
      providerAccountId: account.providerAccountId ?? null,
      label: account.label,
      enabled: account.enabled,
      draining: account.draining,
      controller: account.controller,
      usageCeiling: account.usageCeiling,
      usageCapped: isUsageCeilingReached({ ...account.snapshot, usageCeiling: account.usageCeiling }),
      snapshot: account.snapshot,
      snapshotUpdatedAt: account.snapshotUpdatedAt,
      history: (state.metrics?.hourly ?? [])
        .filter((point) => point.accountId === account.id
          && (account.providerAccountId
            ? point.providerAccountId === account.providerAccountId
            : !point.providerAccountId))
        .map(({ accountId: ignoredAccountId, ...point }) => point),
    })),
    assignedThreadCount: Object.keys(state.threadOwners).length - (state.releasedThreads ?? []).length,
    releasedThreadCount: (state.releasedThreads ?? []).length,
    assignments,
    storage: store?.storageStatus?.() ?? null,
    codex: store?.codexSelectionStatus?.() ?? null,
    deployment: deploymentIdentity(),
  };
}

function routerShimActive(state, observedCodex) {
  if (!state.shimPath || observedCodex !== state.shimPath) return false;
  try {
    if (!lstatSync(state.shimPath).isSymbolicLink()) return false;
    return realpathSync(state.shimPath) === realpathSync(join(ROOT, "lib", "router-command"));
  } catch {
    return false;
  }
}

function executableCandidates(name) {
  const seen = new Set();
  const candidates = [];
  for (const directory of (process.env.PATH ?? "").split(":")) {
    const path = join(directory || ".", name);
    if (seen.has(path)) continue;
    seen.add(path);
    try {
      accessSync(path, X_OK);
      candidates.push(path);
    } catch {}
  }
  return candidates;
}

function resolvedPath(path) {
  if (!path) return null;
  try { return realpathSync(path); } catch { return null; }
}

function shimInspection(path) {
  if (!path) return { exists: false, symlink: false, target: null };
  try {
    const metadata = lstatSync(path);
    return {
      exists: true,
      symlink: metadata.isSymbolicLink(),
      target: metadata.isSymbolicLink() ? resolvedPath(path) : null,
    };
  } catch {
    return { exists: false, symlink: false, target: null };
  }
}

function probedVersion(path) {
  if (!path) return { version: null, error: null };
  const result = spawnSync(path, ["--version"], {
    encoding: "utf8", timeout: 15_000, maxBuffer: 64 * 1024,
  });
  if (result.status !== 0) {
    return { version: null, error: (result.stderr || result.stdout || "version probe failed").trim() };
  }
  return { version: result.stdout.trim().split("\n")[0] || null, error: null };
}

function miseSelection(name) {
  const candidate = executableCandidates("mise")[0] ?? null;
  const executable = resolvedPath(candidate);
  if (!executable) return { executable: null, version: null, selectedPath: null, selectedVersion: null, error: "mise was not found on PATH" };
  const miseVersion = probedVersion(executable);
  const selected = spawnSync(executable, ["-C", homedir(), "which", name], {
    encoding: "utf8", timeout: 15_000, maxBuffer: 64 * 1024,
  });
  if (selected.status !== 0) return {
    executable,
    version: miseVersion.version,
    selectedPath: null,
    selectedVersion: null,
    error: (selected.stderr || selected.stdout || `mise could not resolve ${name}`).trim(),
  };
  const selectedPath = selected.stdout.trim().split("\n").at(-1) || null;
  const selectedVersion = probedVersion(selectedPath);
  return { executable, version: miseVersion.version, selectedPath, selectedVersion: selectedVersion.version, error: selectedVersion.error };
}

function runtimeDoctor(state) {
  const issues = [];
  const codexCandidates = executableCandidates("codex");
  const claudeCandidates = executableCandidates("claude");
  const observedCodex = codexCandidates[0] ?? null;
  const observedClaude = claudeCandidates[0] ?? null;
  const routerLauncher = join(ROOT, "lib", "router-command");
  const miseLauncher = join(ROOT, "lib", "mise-codex-command");
  const claudeMiseShim = join(process.env.MISE_DATA_DIR ?? join(homedir(), ".local", "share", "mise"), "shims", "claude");
  const codexMise = miseSelection("codex");
  const claudeMise = miseSelection("claude");
  const routedCodex = probedVersion(state.realCodex);
  const claudeVersion = probedVersion(observedClaude);
  const miseManaged = resolve(state.realCodex) === resolve(miseLauncher);
  const configuredShim = shimInspection(state.shimPath);
  const active = routerShimActive(state, observedCodex);
  const addIssue = (code, severity, summary, remediation) =>
    issues.push({ code, severity, summary, remediation });

  if (!state.shimPath || !configuredShim.exists) addIssue("shim_missing", "error", "The configured Codex shim is missing.", "Activate the router again; machine apply also repairs mise reshim drift.");
  else if (!configuredShim.symlink || configuredShim.target !== resolvedPath(routerLauncher)) addIssue("shim_target_wrong", "error", "The configured Codex shim no longer targets the router launcher.", "Activate the router again; machine apply also repairs mise reshim drift.");
  else if (!active) addIssue("router_bypassed", "error", "A different Codex executable appears before the router shim on BB's PATH.", "Inspect the ordered candidates and remove or reorder the competing executable.");
  if (routedCodex.error) addIssue("codex_version_probe_failed", "error", "The configured routed Codex executable failed its version probe.", "Inspect the routed executable and repair its installation before starting new work.");
  if (miseManaged && !codexMise.executable) addIssue("mise_unavailable", "error", "The mise-backed router cannot find mise.", "Restore the managed mise executable and reapply the machine configuration.");
  else if (miseManaged && (!codexMise.selectedPath || codexMise.error)) addIssue("mise_codex_unresolved", "error", "Mise cannot resolve a usable Codex executable.", "Reinstall the pinned Codex release with mise and reapply.");
  else if (miseManaged && routedCodex.version !== codexMise.selectedVersion) addIssue("mise_selection_drift", "error", "The routed Codex version differs from mise's machine-global selection.", "Run the machine apply or agent CLI updater to repair delegation.");

  let claudeSource = "missing";
  if (observedClaude) {
    const observedResolved = resolvedPath(observedClaude);
    const selectedResolved = resolvedPath(claudeMise.selectedPath);
    if (resolve(observedClaude) === resolve(claudeMiseShim) || (selectedResolved && observedResolved === selectedResolved)) claudeSource = "mise";
    else if ([join(homedir(), ".local", "bin", "claude"), join(homedir(), ".claude", "local", "claude")].includes(observedClaude)) claudeSource = "fallback";
    else claudeSource = "external";
  }
  if (!observedClaude) addIssue("claude_not_found", "error", "Claude Code is not available on BB's PATH.", "Install or reapply the managed Claude CLI.");
  else if (claudeVersion.error) addIssue("claude_version_probe_failed", "error", "Claude Code failed its version probe.", "Run the displayed executable with --version and repair that installation.");
  else if (claudeSource === "mise" && !claudeMise.executable) addIssue("claude_mise_unavailable", "error", "The managed Claude shim cannot find mise.", "Restore the managed mise executable and reapply the machine configuration.");
  else if (claudeSource === "mise" && (!claudeMise.selectedPath || claudeMise.error)) addIssue("mise_claude_unresolved", "error", "Mise cannot resolve a usable Claude executable.", "Reinstall the pinned Claude release with mise and reapply.");
  else if (claudeSource === "mise" && claudeVersion.version !== claudeMise.selectedVersion) addIssue("mise_claude_drift", "error", "The observed Claude version differs from mise's machine-global selection.", "Run the machine apply or agent CLI updater to repair the managed Claude installation.");
  else if (claudeSource === "mise" && resolve(observedClaude) !== resolve(claudeMiseShim) && shimInspection(claudeMiseShim).exists) addIssue("claude_mise_shim_bypassed", "warning", "Claude resolves to mise's installation path instead of its managed shim.", "Restore the managed PATH order so the mise shims directory comes first.");
  else if (claudeSource === "fallback") addIssue("claude_fallback_selected", "warning", "Claude Code is using a fallback installation instead of mise.", "Remove the fallback owner or restore the managed mise PATH order.");
  else if (claudeSource === "external") addIssue("claude_external_owner", "warning", "Claude Code resolves outside the managed mise installation.", "Inspect the ordered candidates and remove the competing owner if it is unintended.");

  return {
    healthy: !issues.some((issue) => issue.severity === "error"),
    deployment: deploymentIdentity(),
    checkedAt: Date.now(),
    issues,
    codex: {
      active,
      observedPath: observedCodex,
      resolvedTarget: resolvedPath(observedCodex),
      routedPath: state.realCodex,
      routedVersion: routedCodex.version,
      configuredShimPath: state.shimPath,
      configuredShimTarget: configuredShim.target,
      routerLauncherPath: routerLauncher,
      miseLauncherPath: miseManaged ? miseLauncher : null,
      candidates: codexCandidates,
      mise: codexMise,
    },
    claude: {
      observedPath: observedClaude,
      resolvedTarget: resolvedPath(observedClaude),
      version: claudeVersion.version,
      source: claudeSource,
      miseShimPath: claudeMiseShim,
      candidates: claudeCandidates,
      mise: claudeMise,
    },
  };
}

function option(args, name) {
  const index = args.indexOf(name);
  return index < 0 ? null : args[index + 1] ?? null;
}

async function probeRealCodexCandidate(executable, state, accountId = null) {
  const routeCounts = Object.values(state.threadOwners).reduce((counts, ownerAccountId) => {
    counts[ownerAccountId] = (counts[ownerAccountId] ?? 0) + 1;
    return counts;
  }, {});
  let accounts;
  if (accountId) {
    const account = state.accounts.find((candidate) => candidate.id === accountId);
    if (!account) throw new Error(`account ${accountId} not found`);
    accounts = [account];
  } else {
    accounts = state.accounts.filter((account) => account.snapshot?.connected === true
      && account.snapshot?.authType === "chatgpt");
  }
  if (accounts.length === 0) throw new Error("Codex candidate qualification requires at least one connected ChatGPT account");
  const snapshots = await Promise.all(accounts.map(async (account) => ({
    account,
    snapshot: await probeAccount(executable, account, routeCounts[account.id] ?? 0, ROOT),
  })));
  for (const { account, snapshot } of snapshots) {
    if (snapshot.connected !== true || snapshot.authType !== "chatgpt" || snapshot.rateLimits == null) {
      throw new Error(`Codex candidate could not read ChatGPT account and rate limits for ${account.id}`);
    }
  }
  return snapshots.map(({ account, snapshot }) => ({
    accountId: account.id,
    connected: snapshot.connected,
    authType: snapshot.authType,
    planType: snapshot.planType,
    rateLimitsAvailable: snapshot.rateLimits != null,
  }));
}

async function sha256File(path) {
  const digest = createHash("sha256");
  for await (const chunk of createReadStream(path)) digest.update(chunk);
  return digest.digest("hex");
}

function codexVersion(executable) {
  const result = spawnSync(executable, ["--version"], {
    encoding: "utf8", timeout: 15_000, maxBuffer: 64 * 1024,
  });
  if (result.status !== 0) {
    throw new Error(`Codex candidate version probe failed: ${(result.stderr || result.stdout || "no output").trim()}`);
  }
  const version = result.stdout.trim().split("\n")[0];
  if (!version) throw new Error("Codex candidate version probe returned no version");
  return version;
}

function quoteForSh(value) {
  return `'${value.replaceAll("'", `'"'"'`)}'`;
}

async function prepareMiseCodexLauncher(miseExecutable, requestedCodex) {
  if (!isAbsolute(miseExecutable)) throw new Error("mise executable path must be absolute");
  const mise = await realpath(resolve(miseExecutable));
  await access(mise, X_OK);

  const selection = spawnSync(mise, ["-C", homedir(), "which", "codex"], {
    encoding: "utf8", timeout: 15_000, maxBuffer: 64 * 1024,
  });
  if (selection.status !== 0) {
    throw new Error(`mise could not resolve Codex: ${(selection.stderr || selection.stdout || "no output").trim()}`);
  }
  const selected = selection.stdout.trim().split("\n").at(-1);
  if (!selected || !isAbsolute(selected)) throw new Error("mise returned an invalid Codex path");
  const selectedExecutable = await resolveCodexCandidate(selected);
  if (await realpath(resolve(requestedCodex)) !== selectedExecutable) {
    throw new Error("the requested Codex path does not match the current mise selection");
  }

  const launcher = join(ROOT, "lib", "mise-codex-command");
  const temporary = `${launcher}.${process.pid}.${randomUUID()}.tmp`;
  const contents = [
    "#!/bin/sh",
    `exec ${quoteForSh(mise)} -C ${quoteForSh(homedir())} exec -- codex "$@"`,
    "",
  ].join("\n");
  await mkdir(dirname(launcher), { recursive: true, mode: 0o700 });
  try {
    await writeFile(temporary, contents, { mode: 0o700 });
    await chmod(temporary, 0o700);
    const file = await open(temporary, "r");
    try { await file.sync(); } finally { await file.close(); }
    await rename(temporary, launcher);
    const parent = await open(dirname(launcher), "r");
    try { await parent.sync(); } finally { await parent.close(); }
  } catch (error) {
    await unlink(temporary).catch(() => undefined);
    throw error;
  }
  const version = codexVersion(launcher);
  return { launcher, mise, selectedExecutable, version };
}

async function resolveCodexCandidate(requested) {
  if (!isAbsolute(requested)) throw new Error("Codex candidate path must be absolute");
  const executable = await realpath(resolve(requested));
  const router = await realpath(new URL(import.meta.url));
  const target = join(ROOT, "lib", "router-command");
  if (executable === router || executable === target) {
    throw new Error("the Codex candidate resolves back to the router");
  }
  await access(executable, X_OK);
  return executable;
}

async function qualifyRealCodex(executable, state, accountId = null, expectedSha256 = null) {
  const before = await stat(executable);
  const sha256 = await sha256File(executable);
  if (expectedSha256 && sha256 !== expectedSha256) {
    throw new Error("Codex candidate digest does not match the qualification receipt");
  }
  const version = codexVersion(executable);
  const accounts = await probeRealCodexCandidate(executable, state, accountId);
  const after = await stat(executable);
  const afterSha256 = await sha256File(executable);
  if (before.dev !== after.dev || before.ino !== after.ino || before.size !== after.size
    || before.mtimeMs !== after.mtimeMs || sha256 !== afterSha256) {
    throw new Error("Codex candidate changed during qualification");
  }
  return { executable, sha256, version, accounts };
}

async function importQualifiedCodex(qualification) {
  const directory = join(ROOT, "lib", "codex", "versions", qualification.sha256);
  const destination = join(directory, "codex");
  await mkdir(directory, { recursive: true, mode: 0o700 });
  try {
    if (await sha256File(destination) === qualification.sha256) {
      await access(destination, X_OK);
      return destination;
    }
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
  }
  const temporary = `${destination}.${process.pid}.${randomUUID()}.tmp`;
  try {
    await copyFile(qualification.executable, temporary);
    await chmod(temporary, 0o500);
    const copiedSha256 = await sha256File(temporary);
    if (copiedSha256 !== qualification.sha256) {
      throw new Error("Codex candidate changed while importing its qualified bytes");
    }
    const file = await open(temporary, "r");
    try { await file.sync(); } finally { await file.close(); }
    await rename(temporary, destination);
    const parent = await open(directory, "r");
    try { await parent.sync(); } finally { await parent.close(); }
    return destination;
  } catch (error) {
    await unlink(temporary).catch(() => undefined);
    throw error;
  }
}

async function preflightRealCodex(args) {
  const requested = option(args, "--real-codex");
  if (!requested) throw new Error("codex preflight requires --real-codex <absolute path>");
  const executable = await resolveCodexCandidate(requested);
  const state = await store.read();
  const selection = store.codexSelectionStatus?.() ?? {};
  const qualification = await qualifyRealCodex(executable, state, option(args, "--account"));
  process.stdout.write(`${JSON.stringify({
    ready: true,
    realCodex: executable,
    sha256: qualification.sha256,
    version: qualification.version,
    selectionRevision: selection.selectionRevision ?? 0,
    selected: executable === resolve(state.realCodex),
    probedAccountCount: qualification.accounts.length,
    accounts: qualification.accounts,
  })}\n`);
}

async function selectRealCodex(args) {
  const requested = option(args, "--real-codex");
  const expectedSha256 = option(args, "--expect-sha256");
  const expectedRevision = Number(option(args, "--expect-selection-revision"));
  if (!requested || !expectedSha256 || !/^[a-f0-9]{64}$/.test(expectedSha256)
    || !Number.isSafeInteger(expectedRevision) || expectedRevision < 0) {
    throw new Error("codex select requires --real-codex <absolute path> --expect-sha256 <qualification digest> --expect-selection-revision <revision>");
  }
  const executable = await resolveCodexCandidate(requested);
  const state = await store.read();
  const qualification = await qualifyRealCodex(executable, state, null, expectedSha256);
  const imported = await importQualifiedCodex(qualification);
  await store.setRealCodex(imported, {
    sha256: qualification.sha256,
    version: qualification.version,
    qualifiedAccountIds: qualification.accounts.map((account) => account.accountId),
  }, expectedRevision);
  process.stdout.write(`${JSON.stringify({
    selected: true,
    realCodex: imported,
    sourceCodex: executable,
    sha256: qualification.sha256,
    version: qualification.version,
    selectionRevision: expectedRevision + 1,
    qualifiedAccountIds: qualification.accounts.map((account) => account.accountId),
  })}\n`);
}

async function installRouter(args) {
  const realCodex = option(args, "--real-codex");
  const miseExecutable = option(args, "--mise");
  const shim = option(args, "--shim") ?? join(homedir(), ".local", "bin", "codex");
  const primaryCodexHome = option(args, "--primary-codex-home")
    ?? process.env.CODEX_HOME
    ?? join(homedir(), ".codex");
  if (!realCodex) throw new Error("install requires --real-codex <absolute path>");
  const router = await realpath(new URL(import.meta.url));
  // The shim and every management command share this one atomic activation
  // boundary. If install is invoked directly in a development checkout, seed
  // the launcher; deployed generations have already created it after digest,
  // runtime, and migration verification and must not be overwritten here.
  const target = join(ROOT, "lib", "router-command");
  await mkdir(dirname(target), { recursive: true, mode: 0o700 });
  try {
    const existingLauncher = await lstat(target);
    if (!existingLauncher.isFile()) throw new Error(`router launcher is not a regular file: ${target}`);
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
    const temporaryTarget = `${target}.${process.pid}.${randomUUID()}.tmp`;
    const quoteForSh = (value) => `'${value.replaceAll("'", `'"'"'`)}'`;
    const launcher = `#!/bin/sh\nexec ${quoteForSh(process.execPath)} ${quoteForSh(router)} "$@"\n`;
    await writeFile(temporaryTarget, launcher, { mode: 0o700 });
    await chmod(temporaryTarget, 0o700);
    await rename(temporaryTarget, target);
  }
  const requestedExecutable = resolve(realCodex);
  if (requestedExecutable === resolve(shim)) throw new Error("the real Codex path and shim path must differ");
  const miseSelection = miseExecutable
    ? await prepareMiseCodexLauncher(miseExecutable, requestedExecutable)
    : null;
  let executable = miseSelection?.launcher ?? await realpath(requestedExecutable);
  if (executable === router || executable === target) {
    // Reinstalling once the shim already points at us: the caller's captured
    // "real codex" resolved through the shim and back to this script itself.
    // Fall back to the already-recorded real executable instead of letting
    // the router record itself as its own real Codex.
    const existingState = await store.read().catch(() => null);
    if (!existingState) throw new Error("cannot determine the real Codex executable: shim already points at the router");
    executable = await realpath(existingState.realCodex);
  }
  if (executable === router || executable === target) {
    throw new Error("the recorded real Codex executable resolves back to the router");
  }
  await access(executable, X_OK);
  let initialized = await store.initialize(executable, resolve(primaryCodexHome));
  if (initialized.realCodex !== executable && miseSelection) {
    const selection = store.codexSelectionStatus?.() ?? {};
    const connectedAccounts = initialized.accounts.filter((account) =>
      account.snapshot?.connected && account.snapshot?.authType === "chatgpt");
    const qualification = connectedAccounts.length > 0
      ? await qualifyRealCodex(executable, initialized)
      : {
          sha256: await sha256File(executable),
          version: miseSelection.version,
          accounts: [],
        };
    initialized = await store.setRealCodex(executable, {
      sha256: qualification.sha256,
      version: qualification.version,
      qualifiedAccountIds: qualification.accounts.map((account) => account.accountId),
    }, selection.selectionRevision ?? 0);
  }
  if (initialized.realCodex !== executable) {
    throw new Error("router install does not change an existing Codex selection; use codex preflight then codex select");
  }
  await mkdir(dirname(shim), { recursive: true, mode: 0o700 });
  try {
    const existing = await lstat(shim);
    if (!existing.isSymbolicLink()) {
      throw new Error(`refusing to replace existing file at ${shim}`);
    }
    if (resolve(dirname(shim), await readlink(shim)) !== target) {
      // Any pre-existing symlink (e.g. a normal codex install symlink) is safe to
      // replace: the real executable it pointed to was already captured above.
      await unlink(shim);
      await symlink(target, shim);
    }
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
    await symlink(target, shim);
  }
  await store.setShimPath(resolve(shim));
  await refreshAccounts(store);
  process.stdout.write(`${JSON.stringify({
    installed: true,
    shim,
    realCodex: executable,
    resolver: miseSelection ? {
      kind: "mise",
      executable: miseSelection.mise,
      selectedCodex: miseSelection.selectedExecutable,
      selectedVersion: miseSelection.version,
    } : { kind: "path" },
  })}\n`);
}

async function runManagementCommand(args) {
  if (args[0] === "hooks") {
    let result;
    if (args.length === 2 && args[1] === "status") result = await sharedHooksStatus(ROOT);
    else if (args.length === 2 && args[1] === "remove") result = await removeSharedHooks(ROOT);
    else if (args.length === 4 && args[1] === "install" && args[2] === "--workbench") {
      result = await installSharedHooks(ROOT, args[3], (await store.read()).realCodex);
    } else if (args.length === 1 || (args.length === 2 && ["help", "--help", "-h"].includes(args[1]))) {
      process.stdout.write("hooks install --workbench /absolute/versioned/workbench\n  Install and trust the exact three Workbench context commands for new Codex launches.\nhooks status\n  Inspect the shared installation without opening an account.\nhooks remove\n  Stop injecting shared hooks into new processes; account homes remain untouched.\n");
      return true;
    } else throw new Error("hooks requires install --workbench ABSOLUTE_PATH, status, remove, or --help");
    process.stdout.write(`${JSON.stringify(result)}\n`);
    return true;
  }
  if (args[0] === "runtime" && args[1] === "preflight") {
    let sqliteAvailable = false;
    let sqliteError = null;
    try {
      const sqlite = await import("bun:sqlite");
      sqliteAvailable = typeof sqlite.Database === "function";
      if (!sqliteAvailable) sqliteError = "bun:sqlite does not export Database";
    } catch (error) {
      sqliteError = error instanceof Error ? error.message : String(error);
    }
    process.stdout.write(`${JSON.stringify({
      runtimeExecPath: process.execPath,
      runtimeVersion: process.versions.bun,
      bun: process.versions.bun ?? null,
      sqliteAvailable,
      sqliteError,
    })}\n`);
    return true;
  }
  if (args[0] === "install") {
    await installRouter(args);
    return true;
  }
  if (args[0] === "codex" && args[1] === "preflight") {
    await preflightRealCodex(args);
    return true;
  }
  if (args[0] === "codex" && args[1] === "select") {
    await selectRealCodex(args);
    return true;
  }
  if (args[0] === "doctor") {
    process.stdout.write(`${JSON.stringify(runtimeDoctor(await store.read()))}\n`);
    return true;
  }
  if (args[0] === "thread" && args[1] === "inspect") {
    const threadId = args[2];
    if (!threadId) throw new Error("thread inspect requires a provider thread id");
    const state = await store.read();
    const accountId = Object.hasOwn(state.threadOwners, threadId) ? state.threadOwners[threadId] : null;
    const account = state.accounts.find((candidate) => candidate.id === accountId);
    const rolloutPath = Object.hasOwn(state.threadRollouts, threadId) ? state.threadRollouts[threadId] : null;
    const observedCodex = executableCandidates("codex")[0] ?? null;
    const active = routerShimActive(state, observedCodex);
    const issues = [];
    let rollout = { path: rolloutPath, state: "unrecorded", bytes: null, modifiedAt: null, errorCode: null };
    if (!accountId) issues.push("route_unassigned");
    if (!active) issues.push("router_bypassed");
    if (rolloutPath) {
      try {
        const info = await stat(rolloutPath);
        rollout = { ...rollout, state: info.isFile() ? "present" : "not-a-file", bytes: info.size, modifiedAt: info.mtimeMs };
        if (!info.isFile()) issues.push("recorded_rollout_not_a_file");
      } catch (error) {
        rollout = { ...rollout, state: error?.code === "ENOENT" ? "missing" : "unreadable", errorCode: error?.code ?? "UNKNOWN" };
        issues.push(error?.code === "ENOENT" ? "recorded_rollout_missing" : "recorded_rollout_unreadable");
      }
    } else issues.push("rollout_path_unrecorded");
    process.stdout.write(`${JSON.stringify({
      checkedAt: Date.now(), scope: "host-command-environment", providerThreadId: threadId,
      accountId, accountHome: account?.codexHome ?? null, rollout,
      launch: { active, observedCodex, configuredShim: state.shimPath, realCodex: state.realCodex },
      deployment: deploymentIdentity(), issues,
      note: "Metadata only: no native resume, content scan, repair, or proof that an existing provider process uses this account home.",
    })}\n`);
    return true;
  }
  if (args[0] === "status") {
    let refreshed;
    try {
      const current = await store.read();
      const hasDeadLease = Object.values(current.activeRequests).some((request) => {
        try {
          process.kill(request.ownerPid, 0);
          return false;
        } catch (error) {
          return error?.code === "ESRCH";
        }
      });
      // Only pay for a write transaction when a lease may need reaping;
      // otherwise every status poll remains a read-only SQLite transaction.
      if (hasDeadLease) await store.drainActiveRequests(() => false);
      refreshed = args.includes("--refresh")
        ? await refreshAccounts(store)
        : hasDeadLease ? await store.read() : current;
    } catch (error) {
      if (error?.message === "Codex Subscription Router is not installed") {
        process.stdout.write(`${JSON.stringify({ installed: false, active: false, shimPath: null,
          observedCodex: option(args, "--observed-codex"), accounts: [], assignedThreadCount: 0,
          assignments: [], storage: null, codex: null })}\n`);
        return true;
      }
      throw error;
    }
    process.stdout.write(`${JSON.stringify(publicStatus(refreshed, option(args, "--observed-codex")))}\n`);
    return true;
  }
  if (args[0] === "refresh") {
    process.stdout.write(`${JSON.stringify(publicStatus(await refreshAccounts(store)))}\n`);
    return true;
  }
  if (args[0] === "account" && args[1] === "add") {
    // deployment.ts's accountAddCommand emits `account add --id <id> [label]`
    // so the caller can reference the account before login completes; the
    // plain `account add <label>` form (no pre-chosen id) still works too.
    const requestedId = option(args, "--id");
    const label = requestedId ? args.slice(4).join(" ") : args.slice(2).join(" ");
    await linkAccount(store, label, requestedId);
    return true;
  }
  if (args[0] === "account" && args[1] === "login-machine") {
    await loginMachineAccount(store);
    return true;
  }
  if (args[0] === "account" && args[1] === "rename") {
    await store.updateAccount(args[2], { label: args.slice(3).join(" ") });
    return true;
  }
  if (args[0] === "account" && args[1] === "retired") {
    process.stdout.write(`${JSON.stringify({ accounts: store.retiredAccounts() })}\n`);
    return true;
  }
  if (args[0] === "account" && args[1] === "cancel") {
    // Best-effort cleanup for a login the user cancelled: the account row
    // may not exist yet (cancelled before device-auth completed) or may
    // exist with no threads (cancelled right after). Either is a no-op
    // success, not an error — there is nothing for the caller to retry.
    if (!args[2] || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(args[2])) throw new Error("cancel requires a safe account id");
    await store.cancelAccount(args[2]);
    return true;
  }
  if (args[0] === "policy" && args[1] === "new-threads") {
    const current = await store.read();
    if (args.length === 2) {
      process.stdout.write(`${JSON.stringify({ newThreadPolicy: current.newThreadPolicy })}\n`);
      return true;
    }
    if (args.length !== 3 || !["route", "passthrough"].includes(args[2])) {
      throw new Error("policy new-threads requires route or passthrough");
    }
    const next = await store.setNewThreadPolicy(args[2]);
    process.stdout.write(`${JSON.stringify({ newThreadPolicy: next.newThreadPolicy })}\n`);
    return true;
  }
  if (args[0] === "account" && args[1] === "cap") {
    const rawCeiling = args[3];
    const ceiling = rawCeiling === "none" ? null : Number(rawCeiling);
    if (rawCeiling == null || (ceiling !== null && (!Number.isFinite(ceiling) || ceiling < 0 || ceiling > 100))) {
      throw new Error("account cap requires a percentage from 0 to 100, or none");
    }
    await store.updateAccount(args[2], { usageCeiling: ceiling });
    return true;
  }
  if (args[0] === "account" && ["enable", "disable"].includes(args[1])) {
    if (args[1] === "disable") await migrateAccountThreads(store, args[2]);
    await store.updateAccount(args[2], { enabled: args[1] === "enable", draining: false });
    return true;
  }
  if (args[0] === "account" && args[1] === "remove") {
    await migrateAccountThreads(store, args[2]);
    await store.removeAccount(args[2]);
    return true;
  }
  if (args[0] === "thread" && args[1] === "assign") {
    await moveThread(store, args[2], args[3]);
    return true;
  }
  return false;
}

async function runStateCommand(args) {
  const {
    inspectLegacyMigration,
    migrateJsonToSqlite,
    migrateLegacyJsonIfNeeded,
    prepareStateBackend,
    preflightJsonToSqlite,
    verifyStateBackend,
  } = await import("./migration.mjs");
  let result;
  if (args[1] === "preflight" && [null, "sqlite"].includes(option(args, "--to"))) {
    result = await preflightJsonToSqlite(ROOT);
  } else if (args[1] === "inspect-migration") {
    result = await inspectLegacyMigration(ROOT);
  } else if (args[1] === "migrate" && [null, "sqlite"].includes(option(args, "--to"))) {
    result = await migrateJsonToSqlite(ROOT, option(args, "--expect-json-sha256"));
  } else if (args[1] === "migrate-legacy-if-needed") {
    result = await migrateLegacyJsonIfNeeded(ROOT, option(args, "--expect-json-sha256"));
  } else if (args[1] === "prepare-active") {
    result = await prepareStateBackend(ROOT);
  } else if (args[1] === "verify") {
    result = await verifyStateBackend(ROOT);
  } else {
    throw new Error("state command requires inspect-migration, preflight, migrate, migrate-legacy-if-needed, prepare-active, or verify");
  }
  process.stdout.write(`${JSON.stringify(result)}\n`);
}

async function main() {
  const args = process.argv.slice(2);
  if (args[0] === "hooks" && args[1] !== "install") {
    await runManagementCommand(args);
    return;
  }
  if (args[0] === "runtime" && args[1] === "preflight") {
    await runManagementCommand(args);
    return;
  }
  if (args[0] === "state") {
    await runStateCommand(args);
    return;
  }
  store = await openRouterStateStore(ROOT, {
    sqlite: { onDiagnostic: reportStateDiagnostic },
  });
  if (await runManagementCommand(args)) return;
  const state = await store.read();
  if (!isInteractiveAppServer(args)) {
    await passthrough(state, args);
    return;
  }
  const proxy = new AppServerProxy(state, args);
  await proxy.run();
}

const isMain = process.argv[1]
  && import.meta.url === pathToFileURL(await realpath(process.argv[1])).href;
if (isMain) {
  main().catch((error) => {
    process.stderr.write(`codex-subscription-router: ${error instanceof Error ? error.stack : String(error)}\n`);
    process.exitCode = 1;
  });
}
