import { useCallback, useEffect, useId, useRef, useState } from "react";
import { ThreadChat, definePluginApp, experimental_Icon as Icon, useRealtime, useRpc } from "@get-bb/plugin-sdk/app";
import type {
  InspectorResult,
  MagnetTraceEvent,
  ProjectedOperation,
  ProjectedWorkingBlock,
  TraceContribution,
  TraceGap,
  TraceProjection,
  TranscriptSpineMessage,
} from "./context-magnet.ts";
import type { HostTraceOperation, HostTracePageProjection, UnmatchedHostTraceContribution } from "./host-trace-adapter.ts";
import type { rpcContract } from "./server.ts";
import type { WorkbenchInspection, WorkbenchRecord } from "./workbench-adapter.ts";
import "./app.css";

const ACTION_ID = "context-magnet-inspector";
const CHANNEL = "context-magnet-changed";

type TraceCarrierResult = InspectorResult & Readonly<{ traceProjection?: TraceProjection; projection?: TraceProjection }>;

type InspectorResultWithHost = InspectorResult & Readonly<{
  host: Readonly<{
    state: "ready" | "partial" | "unavailable";
    detail: string;
    projection: HostTracePageProjection | null;
    cursor: string | null;
    nextCursor: string | null;
    gaps: readonly Readonly<{ pageCursor: string | null; gap: TraceGap }>[];
  }>;
}>;

export type TraceSpineEntry = Readonly<{
  message: TranscriptSpineMessage;
  before: readonly ProjectedWorkingBlock[];
  within: readonly ProjectedWorkingBlock[];
  after: readonly ProjectedWorkingBlock[];
}>;

export type TraceSpineLayout = Readonly<{
  entries: readonly TraceSpineEntry[];
  /** These have no safe transcript position, so remain explicit and separate. */
  unplaced: readonly ProjectedWorkingBlock[];
}>;

export type HostProjectionAccumulator = Readonly<{
  version: HostTracePageProjection["version"];
  threadId: string;
  snapshot: HostTracePageProjection["snapshot"];
  operations: readonly HostTraceOperation[];
  unmatched: readonly UnmatchedHostTraceContribution[];
  gaps: readonly Readonly<{ pageCursor: string | null; gap: TraceGap }>[];
  completeness: HostTracePageProjection["completeness"];
  nextCursor: string | null;
}>;

export class HostPageAccumulatorError extends Error {
  constructor(message: string) { super(message); this.name = "HostPageAccumulatorError"; }
}

function isThreadSignal(value: unknown, threadId: string): boolean {
  return typeof value === "object" && value !== null && (value as { threadId?: unknown }).threadId === threadId;
}

/** Do not turn an absent or malformed carrier into an empty working trace. */
export function projectionFromResult(result: InspectorResult | null): TraceProjection | null {
  if (result === null) return null;
  const candidate = (result as TraceCarrierResult).traceProjection ?? (result as TraceCarrierResult).projection;
  if (candidate === undefined || !Array.isArray(candidate.transcript) || !Array.isArray(candidate.workingBlocks) || !Array.isArray(candidate.gaps) || !Array.isArray(candidate.unmatched)) return null;
  return candidate;
}

/**
 * Builds the metadata trace strictly from carrier order and carrier placement.
 * It intentionally never derives a message relationship from event sequence,
 * timestamps, operation text, or a provider identifier.
 */
export function layoutTraceProjection(projection: TraceProjection): TraceSpineLayout {
  const entries = projection.transcript.map((message) => ({ message, before: [] as ProjectedWorkingBlock[], within: [] as ProjectedWorkingBlock[], after: [] as ProjectedWorkingBlock[] }));
  const entriesByMessageId = new Map(entries.map((entry) => [entry.message.id, entry]));
  const unplaced: ProjectedWorkingBlock[] = [];

  for (const block of projection.workingBlocks) {
    const placement = block.placement;
    if (placement.kind === "unmatched" || placement.kind === "unavailable") {
      unplaced.push(block);
      continue;
    }
    const anchor = entriesByMessageId.get(placement.anchor.id);
    // Projection validation normally makes this impossible. It remains visible
    // here rather than attaching it to a guessed nearby transcript marker.
    if (anchor === undefined) {
      unplaced.push(block);
      continue;
    }
    if (placement.kind === "before") anchor.before.push(block);
    else if (placement.kind === "after") anchor.after.push(block);
    else anchor.within.push(block);
  }
  return { entries, unplaced };
}

function operationIdentity(operation: HostTraceOperation): string {
  const { threadId, operationId, eventSeq } = operation.anchor;
  return `${threadId}\u0000${operationId}\u0000${eventSeq}`;
}

function contributionIdentity(contribution: TraceContribution): string {
  return `${contribution.contributionKey.threadId}\u0000${contribution.contributionKey.id}`;
}

function combinedCompleteness(left: HostTracePageProjection["completeness"], right: HostTracePageProjection["completeness"]): HostTracePageProjection["completeness"] {
  if (left === "unavailable" || right === "unavailable") return "unavailable";
  return left === "partial" || right === "partial" ? "partial" : "complete";
}

/**
 * Appends one authoritative page without reconstructing a relationship. The
 * host's operation anchor is the only merge key, and every contribution key
 * must remain unique throughout one immutable snapshot walk.
 */
export function accumulateHostProjection(previous: HostProjectionAccumulator | null, page: HostTracePageProjection): HostProjectionAccumulator {
  if (page.nextCursor !== page.page.nextCursor) throw new HostPageAccumulatorError("Host page next cursor disagrees with its page envelope.");
  if (previous === null) {
    if (page.page.cursor !== null) throw new HostPageAccumulatorError("The first host page must have a null cursor.");
  } else {
    if (page.version !== previous.version || page.threadId !== previous.threadId) throw new HostPageAccumulatorError("Host continuation changed trace identity.");
    if (page.snapshot.id !== previous.snapshot.id || page.snapshot.capturedAt !== previous.snapshot.capturedAt || page.snapshot.operationSeqHighWatermark !== previous.snapshot.operationSeqHighWatermark) throw new HostPageAccumulatorError("Host continuation changed snapshot identity.");
    if (previous.nextCursor === null || page.page.cursor !== previous.nextCursor) throw new HostPageAccumulatorError("Host continuation cursor drifted from the supplied opaque cursor.");
  }

  const contributions = new Set<string>();
  const append = (entry: HostTraceOperation | UnmatchedHostTraceContribution): void => {
    const rows = "contribution" in entry ? [entry.contribution] : entry.contributions;
    for (const contribution of rows) {
      const key = contributionIdentity(contribution);
      if (contributions.has(key)) throw new HostPageAccumulatorError("A retained host contribution appeared twice in one snapshot.");
      contributions.add(key);
    }
  };
  previous?.operations.forEach(append);
  previous?.unmatched.forEach(append);

  const operationIndex = new Map<string, number>();
  let lastNewOperationSequence = -1;
  const priorOperationCount = previous?.operations.length ?? 0;
  let sawNewOperation = false;
  const operations = previous === null ? [] : previous.operations.map((operation, index) => {
    operationIndex.set(operationIdentity(operation), index);
    lastNewOperationSequence = operation.anchor.eventSeq;
    return { anchor: operation.anchor, contributions: [...operation.contributions] };
  });
  for (const incoming of page.operations) {
    append(incoming);
    const identity = operationIdentity(incoming);
    const index = operationIndex.get(identity);
    if (index === undefined) {
      if (incoming.anchor.eventSeq < lastNewOperationSequence) throw new HostPageAccumulatorError("Host continuation regressed operation order.");
      operationIndex.set(identity, operations.length);
      operations.push({ anchor: incoming.anchor, contributions: [...incoming.contributions] });
      lastNewOperationSequence = incoming.anchor.eventSeq;
      sawNewOperation = true;
    } else {
      if (previous === null || index !== priorOperationCount - 1 || sawNewOperation) throw new HostPageAccumulatorError("Only the final prior host operation may extend at a page boundary.");
      const current = operations[index]!;
      if (current.anchor.turnId !== undefined && incoming.anchor.turnId !== undefined && current.anchor.turnId !== incoming.anchor.turnId) throw new HostPageAccumulatorError("Canonical host operation supplied conflicting turn identity.");
      operations[index] = {
        anchor: current.anchor.turnId === undefined && incoming.anchor.turnId !== undefined ? { ...current.anchor, turnId: incoming.anchor.turnId } : current.anchor,
        contributions: [...current.contributions, ...incoming.contributions],
      };
    }
  }
  const unmatched = previous === null ? [] : [...previous.unmatched];
  for (const entry of page.unmatched) {
    append(entry);
    unmatched.push(entry);
  }
  return {
    version: page.version,
    threadId: page.threadId,
    snapshot: page.snapshot,
    operations,
    unmatched,
    gaps: [...(previous?.gaps ?? []), ...page.gaps],
    completeness: previous === null ? page.completeness : combinedCompleteness(previous.completeness, page.completeness),
    nextCursor: page.nextCursor,
  };
}

/**
 * Bounded presentation chunks preserve the host's operation order. `turnId`
 * only groups adjacent host operations for scanning; it never creates a
 * transcript relationship or changes a block's placement.
 */
export function segmentHostOperations(operations: readonly HostTraceOperation[], maximum = 100): readonly (readonly HostTraceOperation[])[] {
  if (!Number.isSafeInteger(maximum) || maximum < 1) throw new HostPageAccumulatorError("Working block maximum must be a positive safe integer.");
  const chunks: HostTraceOperation[][] = [];
  let chunk: HostTraceOperation[] = [];
  let turnId: string | undefined;
  for (const operation of operations) {
    const operationTurnId = operation.anchor.turnId;
    if (chunk.length === maximum || (chunk.length > 0 && operationTurnId !== turnId)) {
      chunks.push(chunk);
      chunk = [];
    }
    if (chunk.length === 0) turnId = operationTurnId;
    chunk.push(operation);
  }
  if (chunk.length > 0) chunks.push(chunk);
  return chunks;
}

/** Unmatched evidence has no operation lane, but it remains bounded and lazy. */
export function segmentUnmatchedContributions(unmatched: readonly UnmatchedHostTraceContribution[], maximum = 100): readonly (readonly UnmatchedHostTraceContribution[])[] {
  if (!Number.isSafeInteger(maximum) || maximum < 1) throw new HostPageAccumulatorError("Unmatched block maximum must be a positive safe integer.");
  const chunks: UnmatchedHostTraceContribution[][] = [];
  for (let index = 0; index < unmatched.length; index += maximum) chunks.push(unmatched.slice(index, index + maximum));
  return chunks;
}

function outcomeLabel(contribution: TraceContribution): string {
  switch (contribution.outcome.kind) {
    case "rejected": return `Rejected (${contribution.outcome.rejection})`;
    case "delivered": return "Delivered";
    case "deduplicated": return "Deduplicated";
    case "failed": return `Failed (${contribution.outcome.failure})`;
    case "unavailable": return `Unavailable (${contribution.outcome.unavailable})`;
  }
}

function outcomeGlyph(contribution: TraceContribution): string {
  switch (contribution.outcome.kind) {
    case "delivered": return "✓";
    case "deduplicated": return "≈";
    case "rejected": return "−";
    case "failed": return "!";
    case "unavailable": return "?";
  }
}

export type ContributionStatusLabel = Readonly<{ glyph: string; label: string }>;

function hasExactModelReceipt(contribution: TraceContribution): boolean {
  return contribution.consumption.state === "consumed" && contribution.consumption.kind === "model-owned-receipt";
}

/** The declaration stays distinct from provider admission and model use. */
export function declarationStatusLabel(contribution: TraceContribution): ContributionStatusLabel {
  const admissions = contribution.admissions;
  const retentionGap = contribution.admissionGaps?.length ?? 0;
  if (admissions === undefined) return { glyph: "?", label: retentionGap > 0 ? "Declaration unavailable (admission retention gap)" : "Declaration unavailable" };
  const declared = admissions.some((admission) => admission.declaration === "declared");
  const unavailable = admissions.some((admission) => admission.declaration === "unavailable");
  const historyNote = retentionGap > 0 ? " (admission history retention gap)" : "";
  if (declared && unavailable) return { glyph: "◈", label: `Declaration partial/unavailable (some declaration evidence retained)${historyNote}` };
  if (unavailable) return { glyph: "?", label: `Declaration unavailable${historyNote}` };
  // An explicit empty list is the carrier's retained declared-only state, not
  // an absent declaration. A gap qualifies admission history, not declaration.
  return { glyph: "◇", label: `Declared${historyNote}` };
}

/**
 * Provider observations are deliberately not delivery or consumption evidence.
 * A retained accepted observation says nothing about model use without the
 * separate exact model-owned receipt below.
 */
export function providerAdmissionStatusLabel(contribution: TraceContribution): ContributionStatusLabel {
  const admissions = contribution.admissions;
  const retentionGaps = contribution.admissionGaps?.length ?? 0;
  if (admissions === undefined) return { glyph: "?", label: retentionGaps > 0 ? "Provider admission unavailable/partial (retention gap)" : "Provider admission unavailable" };
  const observations = admissions.flatMap((admission) => admission.observations);
  const failed = observations.find((observation) => observation.kind === "failed-settlement");
  const accepted = observations.some((observation) => observation.kind === "accepted");
  const constructed = observations.some((observation) => observation.kind === "constructed");
  const providerGaps = admissions.flatMap((admission) => admission.gaps);
  const partial = providerGaps.length > 0 || retentionGaps > 0 || admissions.some((admission) => admission.declaration === "unavailable");
  const gapSuffix = partial ? retentionGaps > 0 ? "; partial (admission retention gap)" : "; unavailable/partial" : "";
  if (accepted) {
    const modelUse = hasExactModelReceipt(contribution) ? "Provider accepted" : "Provider accepted; model use not observed";
    const failedSuffix = failed === undefined ? "" : `; failed settlement (${failed.settlement}) retained`;
    return { glyph: "✓", label: `${modelUse}${failedSuffix}${gapSuffix}` };
  }
  if (failed !== undefined) return { glyph: "!", label: `Provider admission failed settlement (${failed.settlement})${gapSuffix}` };
  if (constructed) return { glyph: "…", label: `Provider constructed${gapSuffix}` };
  if (partial) return { glyph: "?", label: retentionGaps > 0 ? "Provider admission unavailable/partial (admission retention gap)" : "Provider admission unavailable/partial" };
  return { glyph: "○", label: "Provider admission not observed" };
}

/** Short, visible model-owned receipt state paired with delivery, never inferred from acceptance. */
export function consumptionStatusLabel(consumption: TraceContribution["consumption"]): ContributionStatusLabel {
  switch (consumption.state) {
    case "consumed": return consumption.kind === "model-owned-receipt"
      ? { glyph: "●", label: "Consumed (model-owned receipt)" }
      : { glyph: "◐", label: "Host observed; model use not verified" };
    case "not-observed": return { glyph: "○", label: "Model use not observed" };
    case "unknown": return { glyph: "?", label: "Model use unknown" };
    case "unavailable": return { glyph: "—", label: "Model use unavailable" };
  }
}

function consumptionLabel(contribution: TraceContribution): string {
  switch (contribution.consumption.state) {
    case "consumed": return contribution.consumption.kind === "model-owned-receipt" ? "Consumed (exact model-owned receipt)" : "Host observed a result; model-owned use is not verified";
    case "not-observed": return "No consumption receipt observed";
    case "unknown": return "Consumption evidence is unknown";
    case "unavailable": return `Consumption evidence unavailable (${contribution.consumption.reason})`;
  }
}

function placementLabel(contribution: TraceContribution): string {
  if (contribution.placement.kind === "exact") return "Exact operation anchor";
  if (contribution.placement.kind === "nearest-rendered") return `Nearest rendered operation (${contribution.placement.direction})`;
  return `Unmatched (${contribution.placement.reason})`;
}

function operationEvidenceLabel(operation: ProjectedOperation): string {
  switch (operation.operation.contributionEvidence) {
    case "known-empty": return "No retained Context Magnet contribution";
    case "records-retained": return `${operation.contributions.length} retained contribution${operation.contributions.length === 1 ? "" : "s"}`;
    case "missing": return "Contribution evidence is missing";
    case "unavailable": return "Contribution evidence is unavailable";
    case "unknown": return "Contribution evidence is unknown";
  }
}

function contributionId(contribution: TraceContribution): string {
  return contribution.contributionKey.id;
}

function admissionObservationLabel(observation: NonNullable<TraceContribution["admissions"]>[number]["observations"][number]): string {
  return observation.kind === "failed-settlement" ? `failed settlement (${observation.settlement})` : observation.kind;
}

function ContributionPopover({ contribution, popoverId }: { contribution: TraceContribution | null; popoverId: string }) {
  const trigger = contribution?.trigger;
  const triggerLabel = trigger?.renderState === "unrendered"
    ? `Unrendered trigger fact ${trigger.factKey?.id ?? "with no supplied fact key"}`
    : trigger?.renderState === "rendered"
      ? `Rendered trigger fact ${trigger.factKey?.id ?? "with no supplied fact key"}`
      : trigger?.renderState === "withheld" ? "Trigger provenance is withheld" : "Trigger rendering state is unknown";
  const evidence = contribution?.evidence;
  const additionalEvidence = evidence === undefined ? 0 : Object.keys(evidence.unknownFields).length;
  return <section id={popoverId} popover="auto" className="context-magnet-popover" role="dialog" aria-label={contribution === null ? "Context Magnet contribution details" : `Context Magnet contribution ${contributionId(contribution)} details`}>
    {contribution === null ? <p>Select a Context Magnet status to inspect its retained rationale and evidence.</p> : <>
      <header><Icon name="Magnet" aria-hidden="true" /><div><strong>{outcomeLabel(contribution)}</strong><code>{contributionId(contribution)}</code></div></header>
      <dl className="context-magnet-facts">
        <div><dt>Placement</dt><dd>{placementLabel(contribution)}</dd></div>
        <div><dt>Inclusion reason</dt><dd>{contribution.inclusionReason.category}{contribution.inclusionReason.detail ? ` — ${contribution.inclusionReason.detail}` : ""}</dd></div>
        <div><dt>Trigger provenance</dt><dd>{triggerLabel}</dd></div>
        <div><dt>Declaration</dt><dd>{declarationStatusLabel(contribution).label}</dd></div>
        <div><dt>Provider admission</dt><dd>{providerAdmissionStatusLabel(contribution).label}</dd></div>
        <div><dt>Consumption</dt><dd>{consumptionLabel(contribution)}</dd></div>
        <div><dt>Redactions</dt><dd>{evidence?.redactions.length === 0 ? "None retained" : `${evidence?.redactions.length ?? 0} retained redaction marker${evidence?.redactions.length === 1 ? "" : "s"}`}</dd></div>
        <div><dt>Additional evidence</dt><dd>{additionalEvidence === 0 ? "None retained" : `${additionalEvidence} retained field${additionalEvidence === 1 ? "" : "s"} not interpreted by this renderer`}</dd></div>
      </dl>
      {contribution.admissions !== undefined && <section className="context-magnet-admission-details" aria-label="Retained provider admission evidence">
        <h3>Retained provider admission evidence</h3>
        {contribution.admissions.length === 0 ? <p>No provider admission observation was retained for this declaration.</p> : <ul>{contribution.admissions.map((admission) => <li key={`${admission.admissionKey.threadId}:${admission.admissionKey.id}:${admission.attempt.id}`}>
          <strong>{admission.declaration === "declared" ? "Declared" : "Declaration unavailable"}</strong><span> · {admission.attempt.providerKind} {admission.attempt.requestKind} · {admission.attempt.instructionMode} · selected tools: {admission.attempt.selectedToolSummary}</span>
          <ul>{admission.observations.length === 0 ? <li>No provider observation retained.</li> : admission.observations.map((observation) => <li key={observation.admissionObservationSequence}>{admissionObservationLabel(observation)}</li>)}</ul>
          {admission.gaps.length > 0 && <ul aria-label="Provider admission gaps">{admission.gaps.map((gap, index) => <li key={`${gap.kind}:${gap.scope}:${index}`}>{gap.kind} {gap.scope}: {gap.reason}</li>)}</ul>}
        </li>)}</ul>}
      </section>}
      {contribution.admissionGaps !== undefined && contribution.admissionGaps.length > 0 && <section className="context-magnet-admission-details" aria-label="Provider admission retention gaps"><h3>Provider admission retention gaps</h3><ul>{contribution.admissionGaps.map((gap, index) => <li key={`${gap.kind}:${gap.scope}:${index}`}>{gap.kind} {gap.scope}: {gap.reason}</li>)}</ul></section>}
      {evidence?.rawLocators && evidence.rawLocators.length > 0 && <ul className="context-magnet-locators" aria-label="Immutable raw evidence locators">{evidence.rawLocators.map((locator) => <li key={locator}><code>{locator}</code></li>)}</ul>}
    </>}
  </section>;
}

function ContextMagnetLane({ operationId, contributions, emptyLabel, popoverId, selectContribution }: { operationId: string; contributions: readonly TraceContribution[]; emptyLabel: string; popoverId: string; selectContribution: (contribution: TraceContribution) => void }) {
  if (contributions.length === 0) return <p className="context-magnet-operation-empty">{emptyLabel}</p>;
  return <ol className="context-magnet-contributions" aria-label={`Context Magnet contributions for operation ${operationId}`}>
    {contributions.map((contribution) => {
      const declaration = declarationStatusLabel(contribution);
      const admission = providerAdmissionStatusLabel(contribution);
      const consumption = consumptionStatusLabel(contribution.consumption);
      return <li key={contributionId(contribution)}>
      <button type="button" className={`context-magnet-status context-magnet-outcome-${contribution.outcome.kind}`} popoverTarget={popoverId} popoverTargetAction="show" aria-haspopup="dialog" aria-label={`Delivery: ${outcomeLabel(contribution)}. Declaration: ${declaration.label}. Provider admission: ${admission.label}. Model-owned consumption: ${consumption.label}. Open retained Context Magnet rationale and evidence for ${contributionId(contribution)}.`} onClick={() => selectContribution(contribution)}>
        <span className="context-magnet-state context-magnet-delivery"><span className="context-magnet-status-glyph" aria-hidden="true">{outcomeGlyph(contribution)}</span>Delivery: {outcomeLabel(contribution)}</span>
        <span className="context-magnet-state context-magnet-declaration"><span aria-hidden="true">{declaration.glyph}</span>Declaration: {declaration.label}</span>
        <span className="context-magnet-state context-magnet-admission"><span aria-hidden="true">{admission.glyph}</span>Provider: {admission.label}</span>
        <span className="context-magnet-state context-magnet-consumption"><span aria-hidden="true">{consumption.glyph}</span>Model: {consumption.label}</span>
      </button>
      {contribution.placement.kind === "nearest-rendered" && <span className="context-magnet-status-note">nearest rendered anchor</span>}
      {contribution.trigger.renderState === "unrendered" && <span className="context-magnet-status-note">unrendered rationale</span>}
    </li>;
    })}
  </ol>;
}

function OperationRow({ operation, popoverId, selectContribution }: { operation: ProjectedOperation; popoverId: string; selectContribution: (contribution: TraceContribution) => void }) {
  const key = operation.operation.key;
  return <li className="context-magnet-operation" data-operation-id={key.operationId}>
    <div className="context-magnet-operation-main"><span className="context-magnet-operation-sequence" aria-label={`Operation sequence ${key.eventSeq}`}>{key.eventSeq}</span><div><strong>{operation.operation.kind}</strong><code>{key.operationId}</code></div></div>
    <div className="context-magnet-operation-lane"><ContextMagnetLane operationId={key.operationId} contributions={operation.contributions} emptyLabel={operationEvidenceLabel(operation)} popoverId={popoverId} selectContribution={selectContribution} /></div>
  </li>;
}

function WorkingBlock({ block }: { block: ProjectedWorkingBlock }) {
  const [renderRows, setRenderRows] = useState(false);
  const [selectedContribution, setSelectedContribution] = useState<TraceContribution | null>(null);
  const popoverId = useId();
  const operationCount = block.operations.length;
  const contributionCount = block.operations.reduce((total, operation) => total + operation.contributions.length, 0);
  return <details className="context-magnet-working-block" onToggle={(event) => {
    const open = event.currentTarget.open;
    setRenderRows(open);
    if (!open) setSelectedContribution(null);
  }}>
    <summary><span>Working</span><span>{operationCount} operation{operationCount === 1 ? "" : "s"} · {contributionCount} contribution{contributionCount === 1 ? "" : "s"}</span></summary>
    {renderRows && <div className="context-magnet-working-body">
      <div className="context-magnet-working-columns" aria-hidden="true"><span>Operation</span><span>Context Magnet</span></div>
      <ol className="context-magnet-operations" aria-label={`Working block ${block.id} operations`}>{block.operations.map((operation) => <OperationRow key={`${operation.operation.key.eventSeq}:${operation.operation.key.operationId}`} operation={operation} popoverId={popoverId} selectContribution={setSelectedContribution} />)}</ol>
      <ContributionPopover contribution={selectedContribution} popoverId={popoverId} />
    </div>}
  </details>;
}

function BlockList({ blocks }: { blocks: readonly ProjectedWorkingBlock[] }) {
  return <>{blocks.map((block) => <WorkingBlock key={block.id} block={block} />)}</>;
}

function TraceSpine({ projection }: { projection: TraceProjection }) {
  const layout = layoutTraceProjection(projection);
  return <section className="context-magnet-trace-spine" aria-labelledby="context-magnet-trace-title">
    <header><div><h2 id="context-magnet-trace-title">Operational metadata trace</h2><p>Working blocks use only the carrier-supplied transcript anchor and placement.</p></div><span className="context-magnet-snapshot">Snapshot {projection.snapshot.id}</span></header>
    <ol className="context-magnet-trace-entries" aria-label="Carrier-supplied transcript trace">
      {layout.entries.map((entry) => <li key={entry.message.id} className={`context-magnet-trace-entry context-magnet-role-${entry.message.role}`}>
        <BlockList blocks={entry.before} />
        <article className="context-magnet-transcript-marker" aria-label={`${entry.message.role} transcript marker ${entry.message.id}`}>
          <span>{entry.message.role} message</span><code>{entry.message.id}</code>
          {entry.within.length > 0 && <div className="context-magnet-within"><p>{entry.message.role === "assistant" ? "Working within this assistant message" : "Carrier-supplied work within this message"}</p><BlockList blocks={entry.within} /></div>}
        </article>
        <BlockList blocks={entry.after} />
      </li>)}
    </ol>
    <TraceLimits projection={projection} unplaced={layout.unplaced} />
  </section>;
}

function Gap({ gap }: { gap: TraceGap }) {
  const range = gap.afterEventSeq === undefined && gap.beforeEventSeq === undefined ? "" : ` (between operations ${gap.afterEventSeq ?? "start"} and ${gap.beforeEventSeq ?? "end"})`;
  return <li><strong>{gap.scope}</strong>{range}: {gap.reason}</li>;
}

function TraceLimits({ projection, unplaced }: { projection: TraceProjection; unplaced: readonly ProjectedWorkingBlock[] }) {
  const unmatchedContributions = projection.unmatched.length;
  if (unplaced.length === 0 && unmatchedContributions === 0 && projection.gaps.length === 0) return null;
  return <details className="context-magnet-limits"><summary>Trace limits and unplaced evidence ({unplaced.length + unmatchedContributions + projection.gaps.length})</summary>
    {unplaced.length > 0 && <ul className="context-magnet-unplaced">{unplaced.map((block) => <li key={block.id}><strong>Working block {block.id}</strong>: {block.placement.kind === "unmatched" ? `unmatched (${block.placement.reason})` : block.placement.kind === "unavailable" ? `unavailable (${block.placement.reason})` : "carrier anchor not rendered"}.</li>)}</ul>}
    {unmatchedContributions > 0 && <ul className="context-magnet-unmatched">{projection.unmatched.map(({ contribution, state }) => <li key={contributionId(contribution)}><strong>{contributionId(contribution)}</strong>: {state}; {placementLabel(contribution)}.</li>)}</ul>}
    {projection.gaps.length > 0 && <ul className="context-magnet-gaps">{projection.gaps.map(({ pageCursor, gap }, index) => <Gap key={`${pageCursor ?? "first"}:${gap.scope}:${index}`} gap={gap} />)}</ul>}
  </details>;
}

function HostOperationRow({ operation, popoverId, selectContribution }: { operation: HostTraceOperation; popoverId: string; selectContribution: (contribution: TraceContribution) => void }) {
  const { anchor } = operation;
  return <li className="context-magnet-operation" data-operation-id={anchor.operationId}>
    <div className="context-magnet-operation-main"><span className="context-magnet-operation-sequence" aria-label={`Operation sequence ${anchor.eventSeq}`}>{anchor.eventSeq}</span><div><strong>{anchor.turnId === undefined ? "Unscoped host operation" : "Host operation"}</strong><code>{anchor.operationId}</code></div></div>
    <div className="context-magnet-operation-lane"><ContextMagnetLane operationId={anchor.operationId} contributions={operation.contributions} emptyLabel="No retained Context Magnet contribution" popoverId={popoverId} selectContribution={selectContribution} /></div>
  </li>;
}

/** One lazy Working disclosure and native shared popover for one accumulated host lane. */
function HostWorkingBlock({ operations, blockId }: { operations: readonly HostTraceOperation[]; blockId: string }) {
  const [renderRows, setRenderRows] = useState(false);
  const [selectedContribution, setSelectedContribution] = useState<TraceContribution | null>(null);
  const popoverId = useId();
  const contributionCount = operations.reduce((total, operation) => total + operation.contributions.length, 0);
  const suppliedTurnId = operations[0]?.anchor.turnId;
  const sharedTurnId = suppliedTurnId !== undefined && operations.every((operation) => operation.anchor.turnId === suppliedTurnId) ? suppliedTurnId : undefined;
  const compactTurnId = sharedTurnId === undefined || sharedTurnId.length <= 20 ? sharedTurnId : `${sharedTurnId.slice(0, 17)}…`;
  return <details className="context-magnet-working-block" onToggle={(event) => {
    const open = event.currentTarget.open;
    setRenderRows(open);
    if (!open) setSelectedContribution(null);
  }}>
    <summary><span>Working{sharedTurnId !== undefined && <span className="context-magnet-turn-label" aria-label={`Host turn ${sharedTurnId}`}>turn {compactTurnId}</span>}</span><span>{operations.length} operation{operations.length === 1 ? "" : "s"} · {contributionCount} contribution{contributionCount === 1 ? "" : "s"}</span></summary>
    {renderRows && <div className="context-magnet-working-body">
      <div className="context-magnet-working-columns" aria-hidden="true"><span>Operation</span><span>Context Magnet</span></div>
      <ol className="context-magnet-operations" aria-label={`Authoritative host operations in ${blockId}`}>{operations.map((operation) => <HostOperationRow key={`${operation.anchor.eventSeq}:${operation.anchor.operationId}`} operation={operation} popoverId={popoverId} selectContribution={setSelectedContribution} />)}</ol>
      <ContributionPopover contribution={selectedContribution} popoverId={popoverId} />
    </div>}
  </details>;
}

/** Explicitly unplaced contributions still receive bounded lazy inspection. */
function UnmatchedWorkingBlock({ unmatched }: { unmatched: readonly UnmatchedHostTraceContribution[] }) {
  const [renderRows, setRenderRows] = useState(false);
  const [selectedContribution, setSelectedContribution] = useState<TraceContribution | null>(null);
  const popoverId = useId();
  return <details className="context-magnet-working-block" onToggle={(event) => {
    const open = event.currentTarget.open;
    setRenderRows(open);
    if (!open) setSelectedContribution(null);
  }}>
    <summary><span>Unmatched Context Magnet evidence</span><span>{unmatched.length} contribution{unmatched.length === 1 ? "" : "s"}</span></summary>
    {renderRows && <div className="context-magnet-working-body">
      <p className="context-magnet-unmatched-description">These retained contributions have no safe supplied operation anchor and remain explicitly unplaced.</p>
      <ContextMagnetLane operationId="unmatched-host-contributions" contributions={unmatched.map(({ contribution }) => contribution)} emptyLabel="No unmatched contributions retained" popoverId={popoverId} selectContribution={setSelectedContribution} />
      <ContributionPopover contribution={selectedContribution} popoverId={popoverId} />
    </div>}
  </details>;
}

function HostTraceLane({ trace, loadingMore, refreshing, loadError, onLoadMore }: { trace: HostProjectionAccumulator; loadingMore: boolean; refreshing: boolean; loadError: string | null; onLoadMore: () => void }) {
  const blocks = segmentHostOperations(trace.operations);
  const unmatchedBlocks = segmentUnmatchedContributions(trace.unmatched);
  return <section className="context-magnet-trace-spine" aria-labelledby="context-magnet-trace-title">
    <header><div><h2 id="context-magnet-trace-title">Authoritative operational trace</h2><p>Host operation anchors are rendered in this separate metadata lane; this RPC does not supply transcript nesting.</p></div><span className="context-magnet-snapshot">Snapshot {trace.snapshot.id}</span></header>
    {blocks.map((operations, index) => <HostWorkingBlock key={`${operations[0]?.anchor.operationId ?? "empty"}:${index}`} operations={operations} blockId={`host-working-${index + 1}`} />)}
    {unmatchedBlocks.map((unmatched, index) => <UnmatchedWorkingBlock key={`unmatched-${index}`} unmatched={unmatched} />)}
    {(trace.unmatched.length > 0 || trace.gaps.length > 0 || trace.completeness !== "complete") && <details className="context-magnet-limits"><summary>Trace limits and unmatched evidence ({trace.unmatched.length + trace.gaps.length})</summary>
      {trace.completeness !== "complete" && <p>Host trace completeness: {trace.completeness}.</p>}
      {trace.unmatched.length > 0 && <p>Unmatched retained contributions are available in the separate unplaced Working disclosure above.</p>}
      {trace.gaps.length > 0 && <ul className="context-magnet-gaps">{trace.gaps.map(({ pageCursor, gap }, index) => <Gap key={`${pageCursor ?? "first"}:${gap.scope}:${index}`} gap={gap} />)}</ul>}
    </details>}
    {trace.nextCursor !== null && <div className="context-magnet-load-more"><button type="button" onClick={onLoadMore} disabled={loadingMore || refreshing} aria-label={loadingMore ? "Loading the next authoritative Context Magnet trace page" : "Load the next authoritative Context Magnet trace page"}>{loadingMore ? "Loading more…" : "Load more"}</button></div>}
    {loadError !== null && <p className="context-magnet-load-status" role="status">{loadError}</p>}
  </section>;
}

function TraceFields({ event }: { event: MagnetTraceEvent }) {
  const fields = [["Contributor", event.contributorId], ["Reason", event.reason], ["Source", event.sourceKind], ["Path", event.sourcePath], ["Label", event.debugLabel], ["Error", event.errorTag], ["Message", event.message], ["Mapping", event.mappingState], ["Raw evidence", event.rawEvidence]].filter((field): field is [string, string] => typeof field[1] === "string");
  return fields.length === 0 ? null : <dl className="context-magnet-fields">{fields.map(([label, value]) => <div key={label}><dt>{label}</dt><dd>{value}</dd></div>)}</dl>;
}

function workbenchRecordLabel(record: WorkbenchRecord): string {
  const contribution = record.contributionId === 0 ? "" : ` · contribution ${record.contributionId}`;
  return `${record.kind} · ${record.outcome}${contribution}`;
}

function WorkbenchRecordPopover({ record, popoverId }: { record: WorkbenchRecord | null; popoverId: string }) {
  return <section id={popoverId} popover="auto" className="context-magnet-popover" role="dialog" aria-label="Workbench context decision details">
    {record === null ? <p>Select a Workbench decision to inspect its retained evidence.</p> : <>
      <header><strong>{workbenchRecordLabel(record)}</strong><span>Record {record.id}</span></header>
      <dl className="context-magnet-fields">
        {record.source !== "" && <div><dt>Source</dt><dd>{record.source}</dd></div>}
        {record.contributor !== "" && <div><dt>Contributor</dt><dd>{record.contributor}</dd></div>}
        {record.turn !== "" && <div><dt>Turn</dt><dd>{record.turn}</dd></div>}
        <div><dt>Audience</dt><dd>{record.audience} · epoch {record.epoch}</dd></div>
        {record.profile !== "" && <div><dt>Profile</dt><dd>{record.profile}</dd></div>}
        <div><dt>Observed</dt><dd>{new Date(record.at).toLocaleString()}</dd></div>
      </dl>
      {record.reasons.length > 0 && <section><h4>Why Workbench selected this</h4><ol className="context-magnet-reasons">{record.reasons.map((reason, index) => <li key={`${reason.code}:${reason.provider}:${reason.rule}:${index}`}><strong>{reason.rule || `reason ${reason.code}`}</strong>{reason.provider !== "" && <> · {reason.provider}</>}{reason.parameters.length > 0 && <dl className="context-magnet-fields">{reason.parameters.map((parameter, parameterIndex) => <div key={`${parameter.key}:${parameterIndex}`}><dt>{parameter.key}</dt><dd>{String(parameter.value)}</dd></div>)}</dl>}</li>)}</ol></section>}
      {record.inputs.length > 0 && <section><h4>Decision inputs</h4><dl className="context-magnet-fields">{record.inputs.map((input, index) => <div key={`${input.key}:${index}`}><dt>{input.key}</dt><dd>{String(input.value)}</dd></div>)}</dl></section>}
      {record.sample !== null && <section><h4>Bounded contributed context</h4><p>{record.sample.originalBytes - record.sample.omittedBytes}/{record.sample.originalBytes} bytes retained{record.sample.omittedBytes === 0 ? "." : `; ${record.sample.omittedBytes} omitted.`}</p>{record.sample.excerpts.map((excerpt, index) => <pre className="context-magnet-workbench-excerpt" key={`${excerpt.offset}:${index}`}>{excerpt.text}</pre>)}</section>}
    </>}
  </section>;
}

function WorkbenchTraceLane({ inspection, loading }: { inspection: WorkbenchInspection | null; loading: boolean }) {
  const popoverId = useId();
  const [selected, setSelected] = useState<WorkbenchRecord | null>(null);
  if (inspection === null) return loading ? <p className="context-magnet-detail">Loading Workbench context history…</p> : null;
  return <section className="context-magnet-workbench" aria-label="Workbench Context Magnet decision history">
    <header className="context-magnet-working-header"><div><span className="context-magnet-eyebrow">Workbench context</span><h2>Context decisions</h2><p>{inspection.detail}</p></div>{inspection.generation > 0 && <span className="context-magnet-snapshot">Generation {inspection.generation}</span>}</header>
    <WorkbenchRecordPopover record={selected} popoverId={popoverId} />
    {inspection.records.length > 0 && <ol className="context-magnet-workbench-records">{inspection.records.map((record) => <li key={record.id}>
      <button type="button" className={`context-magnet-workbench-record context-magnet-outcome-${record.outcome}`} popoverTarget={popoverId} popoverTargetAction="show" onClick={() => setSelected(record)} aria-label={`Open Workbench context record ${record.id}: ${workbenchRecordLabel(record)}`}>
        <span className="context-magnet-workbench-record-main"><strong>{workbenchRecordLabel(record)}</strong><span>{record.source || record.contributor || "Workbench runtime"}</span></span>
        <span className="context-magnet-workbench-record-meta">{record.turn === "" ? `record ${record.id}` : `turn ${record.turn}`}</span>
      </button>
    </li>)}</ol>}
    {(inspection.gaps.length > 0 || inspection.partialPage || inspection.partialScan || inspection.hasMore) && <div className="context-magnet-limits"><strong>Bounded evidence</strong><ul className="context-magnet-gaps">
      {inspection.gaps.map((gap, index) => <li key={`${gap.kind}:${gap.fromRecordId}:${index}`}><strong>{gap.kind}</strong>{gap.detail === "" ? "" : ` · ${gap.detail}`}</li>)}
      {inspection.partialScan && <li>Workbench stopped at its bounded scan limit.</li>}
      {inspection.partialPage && <li>Workbench stopped at its bounded page limit.</li>}
      {inspection.hasMore && <li>More retained records are available through Workbench pagination.</li>}
    </ul></div>}
  </section>;
}

function LegacyTrace({ result, loading }: { result: InspectorResultWithHost | null; loading: boolean }) {
  if (!result) return loading ? <p className="context-magnet-detail">Loading bounded inspection…</p> : null;
  if (result.trace.length === 0) return <section className="context-magnet-audit" aria-label="Context Magnet trace status"><p className="context-magnet-detail">{result.detail}</p>{result.host.gaps.length > 0 && <ul className="context-magnet-gaps">{result.host.gaps.map(({ pageCursor, gap }, index) => <Gap key={`${pageCursor ?? "first"}:${gap.scope}:${index}`} gap={gap} />)}</ul>}</section>;
  return <details className="context-magnet-audit"><summary>Legacy delivery trace ({result.trace.length})</summary><p className="context-magnet-detail">{result.detail}</p><ol className="context-magnet-events" aria-label="Context Magnet trace events">{result.trace.map((event, index) => <li key={`${event.event}-${event.contributorId}-${index}`} className="context-magnet-event"><strong>{event.event}</strong><TraceFields event={event} /></li>)}</ol></details>;
}

function InspectorPanel({ threadId }: { threadId: string }) {
  const rpc = useRpc<typeof rpcContract>();
  const [result, setResult] = useState<InspectorResultWithHost | null>(null);
  const [hostTrace, setHostTrace] = useState<HostProjectionAccumulator | null>(null);
  const [loading, setLoading] = useState(true);
  const [loadingMore, setLoadingMore] = useState(false);
  const [loadError, setLoadError] = useState<string | null>(null);
  const generation = useRef(0);
  const continuationInFlight = useRef(false);
  const continuationGeneration = useRef(0);
  const refreshWithFirstPage = useCallback(async () => {
    const current = ++generation.current;
    continuationGeneration.current += 1;
    continuationInFlight.current = false;
    setLoading(true);
    setLoadingMore(false);
    setLoadError(null);
    try {
      const next = await rpc.call("inspect", { threadId });
      if (generation.current !== current) return;
      setResult(next);
      if (next.host.projection !== null) {
        try { setHostTrace(accumulateHostProjection(null, next.host.projection)); }
        catch { setLoadError("The replacement authoritative host page could not be accumulated safely; the prior trace remains visible."); }
      } else {
        setLoadError("The authoritative host trace is unavailable; the last valid trace remains visible.");
      }
    } catch {
      if (generation.current === current) { setResult({ state: "unavailable", detail: "The inspector could not read this thread.", trace: [], consumption: { state: "invalid", detail: "Consumption evidence could not be read." }, workbench: { state: "unavailable", detail: "Workbench context inspection failed.", generation: 0, records: [], gaps: [], hasMore: false, partialPage: false, partialScan: false, target: null }, host: { state: "unavailable", detail: "The authoritative Context Magnet host trace could not be read.", projection: null, cursor: null, nextCursor: null, gaps: [] } }); }
    } finally { if (generation.current === current) setLoading(false); }
  }, [rpc, threadId]);
  const loadMore = useCallback(async () => {
    if (hostTrace === null || hostTrace.nextCursor === null || continuationInFlight.current) return;
    continuationInFlight.current = true;
    const continuationId = ++continuationGeneration.current;
    const cursor = hostTrace.nextCursor;
    const snapshotId = hostTrace.snapshot.id;
    const current = generation.current;
    setLoadingMore(true);
    setLoadError(null);
    try {
      const next = await rpc.call("inspect", { threadId, hostCursor: cursor });
      if (generation.current !== current || continuationGeneration.current !== continuationId) return;
      if (next.host.projection === null) {
        setLoadError("The next authoritative host page was unavailable. Previous pages remain visible.");
        return;
      }
      const merged = accumulateHostProjection(hostTrace, next.host.projection);
      if (merged.snapshot.id !== snapshotId) throw new HostPageAccumulatorError("Host continuation changed snapshot identity.");
      setResult(next);
      setHostTrace(merged);
    } catch (error) {
      if (generation.current === current && continuationGeneration.current === continuationId) setLoadError(error instanceof HostPageAccumulatorError ? error.message : "The next authoritative host page could not be loaded. Previous pages remain visible.");
    } finally {
      if (continuationGeneration.current === continuationId) {
        continuationInFlight.current = false;
        if (generation.current === current) setLoadingMore(false);
      }
    }
  }, [hostTrace, rpc, threadId]);
  useEffect(() => { void refreshWithFirstPage(); }, [refreshWithFirstPage]);
  useRealtime(CHANNEL, useCallback((signal) => { if (isThreadSignal(signal, threadId)) void refreshWithFirstPage(); }, [refreshWithFirstPage, threadId]));
  const projection = projectionFromResult(result);
  const visibleHostTrace = hostTrace?.threadId === threadId ? hostTrace : null;
  return <div className="context-magnet-panel">
    <div className="context-magnet-chat" aria-label="Selected thread"><ThreadChat threadId={threadId} variant="timeline" layout="contained" /></div>
    {result?.workbench.state !== "not-configured"
      ? <WorkbenchTraceLane inspection={result?.workbench ?? null} loading={loading} />
      : visibleHostTrace
        ? <HostTraceLane trace={visibleHostTrace} loadingMore={loadingMore} refreshing={loading} loadError={loadError} onLoadMore={loadMore} />
        : projection
          ? <TraceSpine projection={projection} />
          : <LegacyTrace result={result} loading={loading} />}
  </div>;
}

export default definePluginApp((app) => {
  app.slots.threadPanelAction({ id: ACTION_ID, title: "Context Magnet", icon: "Magnet", component: InspectorPanel, layout: "flush" });
});
