+
+/** The declaration stays distinct from provider admission and model use. */
+export function declarationStatusLabel(contribution: TraceContribution): ContributionStatusLabel {
+  const admissions = contribution.admissions;
+  const retentionGap = contribution.admissionGaps?.length ?? 0;
+  if (admissions === undefined) return { glyph: "?", label: retentionGap > 0 ? "Declaration unavailable (admission retention gap)" : "Declaration unavailable" };
+  const declared = admissions.some((admission) => admission.declaration === "declared");
+  const unavailable = admissions.some((admission) => admission.declaration === "unavailable");
+  const historyNote = retentionGap > 0 ? " (admission history retention gap)" : "";
+  if (declared && unavailable) return { glyph: "◈", label: `Declaration partial/unavailable (some declaration evidence retained)${historyNote}` };
+  if (unavailable) return { glyph: "?", label: `Declaration unavailable${historyNote}` };
