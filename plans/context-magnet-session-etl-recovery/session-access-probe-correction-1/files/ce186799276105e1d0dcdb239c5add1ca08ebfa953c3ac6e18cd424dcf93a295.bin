/**
 * Deliberately standalone. This probe is an evidence producer, not plugin runtime
 * code. It never writes router, BB, account, or Codex state, and prints only a
 * redacted receipt. The full thread/read response is confined to this process.
 */
import { createHash } from "node:crypto";
import { spawn } from "node:child_process";
import { realpathSync } from "node:fs";
import { resolve } from "node:path";

const TARGET = "thr_c9xdr46tjs";
const MAX_STDOUT_BYTES = 1_048_576;
const MAX_STDERR_BYTES = 65_536;
const MAX_LINE_BYTES = 262_144;
const MAX_TURNS = 128;
const MAX_ITEMS = 4_096;
const MAX_FRAGMENTS = 4_096;
const MAX_WALL_MS = 15_000;
const MAX_CONCURRENCY = 1;

type ObjectValue = Record<string, unknown>;
type Receipt = { threadId: string; sessionId: string; turns: Array<{ id: string; items: Array<{ id: string; fragments: Array<{ ordinal: number; hookRunId: string; bytes: number; sha256: string }> }> }> };
const object = (value: unknown): ObjectValue | null => value !== null && typeof value === "object" && !Array.isArray(value) ? value as ObjectValue : null;
const sha256 = (value: string | Buffer) => createHash("sha256").update(value).digest("hex");
const redactedSlot = (owner: string) => `sha256:${sha256(owner)}`;

/** Capture raw bytes before either line buffering or JSON parsing. */
async function bounded(command: string, args: string[], env = process.env, input?: string): Promise<{ stdout: Buffer; stderr: Buffer }> {
  return await new Promise((resolveResult, reject) => {
    const child = spawn(command, args, { cwd: resolve(import.meta.dirname, ".."), env, detached: true, stdio: ["pipe", "pipe", "pipe"] });
    let stdout = Buffer.alloc(0), stderr = Buffer.alloc(0), settled = false;
    let failure: Error | undefined;
    const stop = (error: Error) => {
      if (settled || failure) return; failure = error;
      try { process.kill(-child.pid!, "SIGTERM"); } catch {}
    };
    const append = (which: "stdout" | "stderr", chunk: Buffer) => {
      const limit = which === "stdout" ? MAX_STDOUT_BYTES : MAX_STDERR_BYTES;
      const next = Buffer.concat([which === "stdout" ? stdout : stderr, chunk]);
      if (next.length > limit) return stop(new Error(`${which} exceeds bounded limit`));
      if (which === "stdout") stdout = next; else stderr = next;
      if (chunk.indexOf(10) < 0 && next.length > MAX_LINE_BYTES) return stop(new Error("line exceeds bounded limit"));
      for (const line of next.toString("utf8").split("\n")) if (Buffer.byteLength(line) > MAX_LINE_BYTES) return stop(new Error("line exceeds bounded limit"));
    };
    child.stdout!.on("data", (chunk: Buffer) => append("stdout", chunk));
    child.stderr!.on("data", (chunk: Buffer) => append("stderr", chunk));
    child.on("error", stop);
    child.on("close", (code) => {
      if (settled) return; settled = true; clearTimeout(timer);
      if (failure) reject(failure); else if (code === 0) resolveResult({ stdout, stderr }); else reject(new Error("child failed without retaining stderr"));
    });
    const timer = setTimeout(() => stop(new Error("probe timeout")), MAX_WALL_MS);
    const reap = setTimeout(() => { if (failure) try { process.kill(-child.pid!, "SIGKILL"); } catch {} }, MAX_WALL_MS + 500);
    child.once("close", () => clearTimeout(reap));
    if (input !== undefined) child.stdin!.end(input); else child.stdin!.end();
  });
}

function parseLines(bytes: Buffer): unknown[] {
  return bytes.toString("utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line));
}

/**
 * Admit only a server-filtered, identity-only response. The public SDK exposes
 * type filtering but not a body-stripping CLI endpoint, so this runner never
 * fetches a general event log. providerThreadId is unusable until codex is proved.
 */
function identity(value: unknown): { highWatermark: number; providerThreadId: string; checkpointId: string | null } {
  const record = object(value);
  if (!record || Object.keys(record).some((key) => !["format", "highWatermark", "providerId", "providerThreadId", "providerCheckpointId", "threadStatus"].includes(key))
    || record.format !== "bb-thread-identity-projection/v1" || record.providerId !== "codex" || typeof record.providerThreadId !== "string"
    || !Number.isSafeInteger(record.highWatermark) || (record.providerCheckpointId !== null && typeof record.providerCheckpointId !== "string")) {
    throw new Error("server-filtered identity projection is absent or invalid");
  }
  return { highWatermark: record.highWatermark as number, providerThreadId: record.providerThreadId as string, checkpointId: record.providerCheckpointId as string | null };
}

function projectThreadRead(payload: unknown): Receipt {
  const root = object(payload), result = object(root?.result), response = object(result?.thread ?? root?.thread);
  if (!response || typeof response.id !== "string" || typeof response.sessionId !== "string" || !Array.isArray(response.turns)) throw new Error("only vendored 0.153.2 thread/read shape is accepted");
  if (response.turns.length > MAX_TURNS) throw new Error("turn count exceeds bounded limit");
  let items = 0, fragments = 0;
  const turns = response.turns.map((turn) => {
    const t = object(turn); if (!t || typeof t.id !== "string" || !Array.isArray(t.items)) throw new Error("invalid turn");
    return { id: t.id, items: t.items.flatMap((item) => {
      if (++items > MAX_ITEMS) throw new Error("item count exceeds bounded limit");
      const i = object(item); if (!i || typeof i.id !== "string" || i.type !== "hookPrompt") return [];
      if (!Array.isArray(i.fragments)) throw new Error("invalid hookPrompt fragments");
      return [{ id: i.id, fragments: i.fragments.map((fragment, ordinal) => {
        if (++fragments > MAX_FRAGMENTS) throw new Error("fragment count exceeds bounded limit");
        const f = object(fragment); if (!f || typeof f.hookRunId !== "string" || typeof f.text !== "string") throw new Error("invalid HookPromptFragment");
        return { ordinal, hookRunId: f.hookRunId, bytes: Buffer.byteLength(f.text), sha256: sha256(f.text) };
      }) }];
    }) };
  });
  // Thread.id and sessionId are separately bound; neither aliases the other.
  return { threadId: response.id, sessionId: response.sessionId, turns };
}

/** Reject every server request; a reader accepts responses/notifications only. */
function rejectUnknownAppServerRequest(message: unknown): void {
  const value = object(message);
  if (value && typeof value.method === "string" && value.id !== undefined) throw new Error("unknown app-server request");
}

async function directRead(attestation: { executable: string; codexHome: string; owner: string; revision: number; threadId: string }): Promise<Receipt> {
  const beforeRevision = attestation.revision;
  const command = realpathSync(attestation.executable);
  const requests = [
    { id: 1, method: "initialize", params: { clientInfo: { name: "context-magnet-session-access-probe", version: "1" }, capabilities: {} } },
    { method: "initialized", params: {} },
    { id: 2, method: "thread/read", params: { threadId: attestation.threadId, includeTurns: true } },
  ];
  const { stdout } = await bounded(command, ["app-server"], { ...process.env, CODEX_HOME: attestation.codexHome, CODEX_SQLITE_HOME: attestation.codexHome }, requests.map((request) => JSON.stringify(request)).join("\n") + "\n");
  const messages = parseLines(stdout); for (const message of messages) rejectUnknownAppServerRequest(message);
  const response = messages.find((message) => object(message)?.id === 2); const receipt = projectThreadRead(response);
  if (beforeRevision !== attestation.revision) throw new Error("route revision changed");
  return receipt; // raw turns are never retained after this return projection.
}

async function main(): Promise<void> {
  if (MAX_CONCURRENCY !== 1) throw new Error("concurrency must remain one");
  if (process.env.BB_THREAD_ID === TARGET) throw new Error("active probe thread cannot be target");
  const identityProjection = process.env.CM_SESSION_ACCESS_PUBLIC_IDENTITY_PROJECTION;
  if (!identityProjection) {
    process.stdout.write(JSON.stringify({ format: "context-magnet-codex-session-access-probe/v1", status: "unavailable", target: TARGET, blocker: "server-filtered identity projection unavailable", protectedStateChanged: false, rawTurnsRetained: false }) + "\n");
    return;
  }
  const publicIdentity = identity(JSON.parse(identityProjection));
  // router status is intentionally excluded: it can chmod/reap state. An owner
  // attestation must be supplied by an already-existing read-only authority.
  const encoded = process.env.CM_SESSION_ACCESS_READONLY_OWNER_ATTESTATION;
  if (!encoded) {
    process.stdout.write(JSON.stringify({ format: "context-magnet-codex-session-access-probe/v1", status: "unavailable", target: TARGET, highWatermark: publicIdentity.highWatermark, checkpointPresent: publicIdentity.checkpointId !== null, blocker: "no authoritative read-only unambiguous owner route", protectedStateChanged: false, rawTurnsRetained: false }) + "\n");
    return;
  }
  const attestation = JSON.parse(encoded) as { owner: string; enabled: boolean; ambiguous: boolean; revision: number; executable: string; codexHome: string; threadId: string };
  if (!attestation.enabled || attestation.ambiguous || attestation.threadId !== publicIdentity.providerThreadId) throw new Error("ambiguous owner");
  const receipt = await directRead(attestation);
  process.stdout.write(JSON.stringify({ format: "context-magnet-codex-session-access-probe/v1", status: "passed", target: TARGET, highWatermark: publicIdentity.highWatermark, terminalCheckpointPresent: publicIdentity.checkpointId !== null, accountSlot: redactedSlot(attestation.owner), routeRevision: attestation.revision, thread: { id: receipt.threadId, sessionId: receipt.sessionId }, receipt, protectedStateChanged: false, rawTurnsRetained: false }) + "\n");
}
main().catch((error) => { process.stderr.write(`session-access-probe failed: ${error instanceof Error ? error.message : "unknown"}\n`); process.exitCode = 1; });
