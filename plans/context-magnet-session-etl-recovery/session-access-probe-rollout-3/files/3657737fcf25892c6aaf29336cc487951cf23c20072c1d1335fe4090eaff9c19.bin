import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import { spawnSync } from "node:child_process";
import { closeSync, mkdtempSync, renameSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import test from "node:test";

process.env.CM_PROBE_UNIT = "1";
const root = resolve(import.meta.dirname, "..");
const runner = resolve(root, "test/run-codex-session-access-probe.mts");
const probe = await import(runner);
const sha = (body: string) => createHash("sha256").update(body).digest("hex");
const record = (ordinal: number, type: string, payload: object) => ({ ordinal, timestamp: "2026-09-21T00:00:00Z", type, payload });
const session = () => record(0, "session_meta", { cli_version: "0.153.2" });
const jsonl = (...records: object[]) => Buffer.from(records.map((value) => JSON.stringify(value)).join("\n"));
const carrier = (text: string, kind = "hooks.additional_context", turnId = "turn-1") => ({ type: "message", role: "developer", id: "native-item-1", internal_chat_message_metadata_passthrough: { turn_id: turnId, content_item_kinds: [kind] }, content: [{ type: "input_text", text }] });
const route = (home: string, rollout: string) => ({ owner: "redacted", home, rollout, revision: 1, slot: "slot", routeDigest: "digest" });

test("admits only the aligned native hook carrier with an exact provisional envelope", () => {
  const body = "provisional body";
  const envelope = JSON.stringify({ format: "context-magnet-receipt/v1", receiptId: "receipt-1", bytes: Buffer.byteLength(body), sha256: sha(body), threadId: "thread-1", turnId: "turn-1", body });
  assert.equal(probe.classifyHookCarrier(carrier(envelope), "thread-1"), "context-receipt");
  assert.equal(probe.classifyHookCarrier(carrier(JSON.stringify({ format: "context-magnet-receipt/v1", receiptId: "receipt-1", bytes: Buffer.byteLength(body) + 1, sha256: sha(body), threadId: "thread-1", turnId: "turn-1", body })), "thread-1"), "unbound-hook-context");
  assert.equal(probe.classifyHookCarrier(carrier(JSON.stringify({ format: "context-magnet-receipt/v1", receiptId: "receipt-1", bytes: Buffer.byteLength(body), sha256: sha("different"), threadId: "thread-1", turnId: "turn-1", body })), "thread-1"), "unbound-hook-context");
  assert.equal(probe.classifyHookCarrier({ ...carrier(envelope), internal_chat_message_metadata_passthrough: { turn_id: "turn-1", content_item_kinds: ["hooks.additional_context", "extra"] } }), "not-hook");
  assert.equal(probe.classifyHookCarrier(carrier(envelope, "generic.developer_instructions")), "not-hook");
  assert.equal(probe.classifyHookCarrier(carrier("unwrapped hook text")), "unbound-hook-context");
  assert.equal(probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", carrier("ordinary developer text", "generic.developer_instructions")))).receiptGap, "zero-exact-context-receipts");
});

test("validates UTF-8 JSONL, exact dialect, and all resource bounds", () => {
  const valid = jsonl(session(), record(1, "response_item", carrier("ordinary developer text", "generic.developer_instructions")), record(2, "turn_context", {}));
  assert.deepEqual(probe.parseRolloutJsonl(valid), { records: 3, turns: 1, contexts: 1, receiptGap: "zero-exact-context-receipts" });
  assert.throws(() => probe.parseRolloutJsonl(Buffer.from([0xff])));
  assert.throws(() => probe.parseRolloutJsonl(Buffer.from("{not-json")));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "future_type", {}))));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(record(0, "session_meta", { cli_version: "codex-cli 0.153.20" }))));
  assert.throws(() => probe.parseRolloutJsonl(valid, { bytes: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(valid, { lineBytes: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(valid, { records: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", carrier("x", "generic.developer_instructions", "a")), record(2, "response_item", carrier("x", "generic.developer_instructions", "b"))), { turns: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "turn_context", {}), record(2, "turn_context", {})), { contexts: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(valid, { deadline: 0 }));
});

test("rejects unsafe route paths and detects a post-open parser/read race without opening a FIFO", async () => {
  const home = mkdtempSync(join(tmpdir(), "cm-rollout-home-"));
  const outside = mkdtempSync(join(tmpdir(), "cm-rollout-outside-"));
  try {
    const regular = join(home, "rollout.jsonl"); writeFileSync(regular, jsonl(session()));
    const opened = probe.safeRollout(route(home, regular)); closeSync(opened.fd);
    const before = opened.before; const replacement = join(home, "replacement.jsonl"); writeFileSync(replacement, jsonl(session(), record(1, "world_state", {}))); renameSync(replacement, regular);
    assert.notEqual(probe.rolloutIdentity(route(home, regular)), before, "post-stream identity fence catches replacement");
    writeFileSync(regular, jsonl(session(), record(1, "response_item", carrier("x", "generic.developer_instructions"))));
    assert.rejects(probe.readRollout(route(home, regular), "turn-1", () => { const racing = join(home, "racing.jsonl"); writeFileSync(racing, jsonl(session())); renameSync(racing, regular); }), /raced during stream/);
    const symlink = join(home, "rollout-link"); symlinkSync(regular, symlink); assert.throws(() => probe.safeRollout(route(home, symlink)));
    const fifo = join(home, "rollout-fifo"); assert.equal(spawnSync("mkfifo", [fifo]).status, 0); assert.throws(() => probe.safeRollout(route(home, fifo)), "lstat rejects FIFO before open");
    const escaped = join(outside, "rollout.jsonl"); writeFileSync(escaped, jsonl(session())); assert.throws(() => probe.safeRollout(route(home, escaped)));
  } finally { rmSync(home, { recursive: true, force: true }); rmSync(outside, { recursive: true, force: true }); }
});

const metadata = (overrides: Record<string, unknown> = {}) => ({ id: "thread-1", providerId: "codex", archivedAt: null, deletedAt: null, updatedAt: 10, status: "idle", ...overrides });
const identityEvent = (providerThreadId = "provider-1") => ({ id: "event-1", threadId: "thread-1", seq: 1, createdAt: "now", type: "thread/identity", scope: { kind: "thread" }, data: { providerThreadId } });
const completedEvent = (providerThreadId = "provider-1") => ({ id: "event-2", threadId: "thread-1", seq: 2, createdAt: "now", type: "turn/completed", scope: { kind: "turn" }, data: { providerThreadId, status: "completed", providerCheckpointId: "turn-1" } });

test("fails closed for conflicting or unsafe BB ownership projections", () => {
  assert.equal(probe.validateIdentityProjection(metadata(), [identityEvent(), completedEvent()], "thread-1", "provider-1").checkpointId, "turn-1");
  assert.throws(() => probe.validateIdentityProjection(metadata({ archivedAt: "now" }), [identityEvent()], "thread-1", "provider-1"));
  assert.throws(() => probe.validateIdentityProjection(metadata(), [identityEvent(), completedEvent("provider-2")], "thread-1", "provider-1"));
  assert.throws(() => probe.validateIdentityProjection(metadata(), Array.from({ length: 100 }, () => identityEvent()), "thread-1", "provider-1"));
  assert.doesNotThrow(() => probe.requireUnambiguousOwner([{ enabled: true, draining: false }], 0));
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: false, draining: false }], 0), "disabled owner");
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: true, draining: false }, { enabled: true, draining: false }], 0));
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: true, draining: false }], 1), "migration claim");
});

test("live rollout probe emits only the compact passed receipt", () => {
  const execution = spawnSync(process.execPath, ["--experimental-strip-types", runner], { encoding: "utf8", timeout: 30_000, env: { ...process.env, CM_PROBE_UNIT: "0" } });
  assert.equal(execution.status, 0, execution.stderr); const receipt = JSON.parse(execution.stdout.trim()) as Record<string, unknown>;
  assert.equal(receipt.format, "context-magnet-session-rollout-probe/v1"); assert.equal(receipt.status, "passed"); assert.equal(receipt.protectedStateChanged, false); assert.equal(receipt.rawBodiesRetained, false); assert.equal(/CODEX_HOME|app-server|thread\/read|rollout_path|commandExecution|aggregatedOutput/i.test(execution.stdout), false);
});
