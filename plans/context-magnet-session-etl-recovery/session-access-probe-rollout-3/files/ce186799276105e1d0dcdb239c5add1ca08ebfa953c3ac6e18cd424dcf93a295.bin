/** Original-rollout-only probe. It never launches a provider executable. */
import { createHash } from "node:crypto";
import { spawnSync } from "node:child_process";
import { constants, createReadStream, lstatSync, openSync, closeSync, fstatSync, readdirSync, readFileSync, readlinkSync, realpathSync } from "node:fs";
import { isAbsolute, relative, resolve } from "node:path";

const TARGET = "thr_urmi56uqw8", EXPECTED_PROVIDER_THREAD_ID = "01a0c559-c1d2-74d0-b3dc-19e2528904c9", DB = "/home/ubuntu/.codex-subscription-router/state.db", BUN = "/home/ubuntu/.local/share/mise/installs/bun/1.3.14/bin/bun", BUN_SHA256 = "9fd36f87e4b90b07632b987a2e4ec81ca15a62c81bf983190cea6d715be2ad74";
const MAX_HTTP_BYTES = 262_144, MAX_ROLLOUT_BYTES = 8_388_608, MAX_LINE_BYTES = 4_194_304, MAX_RECORDS = 512, MAX_TURNS = 256, MAX_CONTEXT_RECORDS = 128, MAX_WALL_MS = 15_000;
const DIALECT = "codex-rollout-jsonl/0.153.2", KNOWN = new Set(["session_meta", "event_msg", "response_item", "world_state", "turn_context", "token_usage_record"]);
type Row = Record<string, unknown>;
type Identity = { updatedAt: number; status: string; highWatermark: number; providerThreadId: string; checkpointId: string | null };
export type Route = { owner: string; home: string; rollout: string; revision: number; slot: string; routeDigest: string };
type Rollout = { digest: string; identity: string; size: number; records: number; turns: number; contextRecords: number; dialect: string; receiptGap: string };
type Snapshot = { identity: Identity; route: Route; processes: string; workspace: string; rollout?: Rollout };
const hash = (value: string | Buffer) => createHash("sha256").update(value).digest("hex");
const row = (value: unknown): Row | null => value !== null && typeof value === "object" && !Array.isArray(value) ? value as Row : null;
const only = (value: Row, allowed: readonly string[]) => Object.keys(value).every((key) => allowed.includes(key));
const text = (value: unknown, name: string, maximum = 512) => { if (typeof value !== "string" || value.length === 0 || value.length > maximum) throw new Error(`invalid ${name}`); return value; };
const statIdentity = (stat: ReturnType<typeof lstatSync>) => `${stat.dev}:${stat.ino}:${stat.size}:${stat.mtimeMs}:${stat.ctimeMs}`;
export function requireUnambiguousOwner(candidates: Array<{ enabled: boolean; draining: boolean }>, migrationClaims: number): void { if (!Number.isSafeInteger(migrationClaims) || migrationClaims !== 0 || candidates.length !== 1 || candidates[0]?.enabled !== true || candidates[0]?.draining !== false) throw new Error("ambiguous owner"); }

async function json(url: string): Promise<unknown> {
  const controller = new AbortController(), timer = setTimeout(() => controller.abort(), MAX_WALL_MS);
  try { const response = await fetch(url, { signal: controller.signal, headers: { accept: "application/json" } }); if (!response.ok) throw new Error(`BB REST ${response.status}`); const reader = response.body?.getReader(); if (!reader) throw new Error("missing REST body"); const chunks: Uint8Array[] = []; let bytes = 0; for (;;) { const part = await reader.read(); if (part.done) break; bytes += part.value.byteLength; if (bytes > MAX_HTTP_BYTES) { await reader.cancel(); throw new Error("REST body exceeds bound"); } chunks.push(part.value); } return JSON.parse(Buffer.concat(chunks).toString("utf8")); } finally { clearTimeout(timer); }
}
export function validateIdentityProjection(metadata: unknown, eventsValue: unknown, target = TARGET, expectedProvider = EXPECTED_PROVIDER_THREAD_ID): Identity {
  const meta = row(metadata); if (!meta || !only(meta, ["id", "projectId", "environmentId", "providerId", "title", "titleFallback", "sectionId", "status", "parentThreadId", "sourceThreadId", "originKind", "originPluginId", "visibility", "archivedAt", "pinnedAt", "deletedAt", "lastReadAt", "latestAttentionAt", "createdAt", "updatedAt", "runtime", "activeBackgroundAgentCount", "canSpawnChild", "queuedMessageCount"]) || meta.id !== target || meta.providerId !== "codex" || meta.archivedAt !== null || meta.deletedAt !== null || typeof meta.updatedAt !== "number" || typeof meta.status !== "string") throw new Error("invalid bodyless thread metadata"); const result: Identity = { updatedAt: meta.updatedAt, status: meta.status, highWatermark: -1, providerThreadId: "", checkpointId: null };
  const events = eventsValue; if (!Array.isArray(events) || events.length === 0 || events.length >= 100) throw new Error("invalid or saturated event page"); let provider: string | null = null;
  for (const event of events) { const e = row(event), data = row(e?.data), scope = row(e?.scope); if (!e || !data || !scope || !only(e, ["id", "scope", "threadId", "seq", "createdAt", "type", "data"]) || e.threadId !== target || !Number.isSafeInteger(e.seq)) throw new Error("invalid event envelope"); if (e.type === "thread/identity") { if (scope.kind !== "thread" || !only(data, ["providerThreadId"])) throw new Error("invalid identity event"); provider = provider === null ? text(data.providerThreadId, "providerThreadId") : provider; if (provider !== data.providerThreadId) throw new Error("divergent provider identity"); } else if (e.type === "turn/completed") { if (scope.kind !== "turn" || !only(data, ["providerThreadId", "status", "providerCheckpointId"]) || !["completed", "failed", "interrupted"].includes(data.status as string)) throw new Error("invalid terminal event"); const current = text(data.providerThreadId, "providerThreadId"); if (provider !== null && provider !== current) throw new Error("divergent provider identity"); provider = current; if (data.status === "completed" && data.providerCheckpointId !== undefined) result.checkpointId = text(data.providerCheckpointId, "providerCheckpointId"); } else throw new Error("unallowlisted event type"); result.highWatermark = Math.max(result.highWatermark, e.seq as number); }
  if (!provider || provider !== expectedProvider) throw new Error("unexpected provider identity"); result.providerThreadId = provider; return result;
}
async function identity(): Promise<Identity> {
  const base = process.env.BB_SERVER_URL; if (!base) throw new Error("BB_SERVER_URL absent"); const metadata = await json(`${base}/api/v1/threads/${TARGET}`);
  const events = await json(`${base}/api/v1/threads/${TARGET}/events?types=thread%2Fidentity%2Cturn%2Fcompleted&order=asc&limit=100`); return validateIdentityProjection(metadata, events);
}
async function route(providerThreadId: string): Promise<Route> {
  const helper = lstatSync(BUN); if (!helper.isFile() || helper.isSymbolicLink() || helper.size > 134_217_728 || hash(readFileSync(BUN)) !== BUN_SHA256) throw new Error("readonly SQLite helper attestation failed");
  const script = `import { Database } from "bun:sqlite"; import { createHash } from "node:crypto"; const db=new Database(${JSON.stringify(DB)},{readonly:true,create:false}); try { const rows=db.query(\`select r.account_id owner,a.codex_home home,r.rollout_path rollout,r.revision revision from routes r join accounts a on a.id=r.account_id where r.thread_id=? and a.enabled=1 and a.draining=0\`).all(process.argv[1]); const claim=db.query('select count(*) count from migration_claims where thread_id=?').get(process.argv[1]); if(rows.length!==1||Number(claim.count)!==0)throw new Error('ambiguous owner'); const x=rows[0],h=(v)=>createHash('sha256').update(String(v)).digest('hex'); console.log(JSON.stringify({owner:x.owner,home:x.home,rollout:x.rollout,revision:x.revision,slot:h(x.owner),routeDigest:h(JSON.stringify({owner:x.owner,revision:x.revision,rollout:h(x.rollout)}))})); } finally {db.close()}`;
  const child = spawnSync(BUN, ["--eval", script, providerThreadId], { encoding: "buffer", maxBuffer: MAX_HTTP_BYTES }); if (child.status !== 0 || !child.stdout || child.stdout.length > MAX_HTTP_BYTES) throw new Error("readonly route projection failed"); const value = row(JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(child.stdout))); if (!value || !only(value, ["owner", "home", "rollout", "revision", "slot", "routeDigest"]) || !Number.isSafeInteger(value.revision)) throw new Error("invalid route projection"); return { owner: text(value.owner, "owner"), home: text(value.home, "home", 4096), rollout: text(value.rollout, "rollout", 4096), revision: value.revision as number, slot: text(value.slot, "slot"), routeDigest: text(value.routeDigest, "routeDigest") };
}
function processes(): string { const names: string[] = []; for (const entry of readdirSync("/proc", { withFileTypes: true })) if (/^\d+$/.test(entry.name)) try { const name = readFileSync(`/proc/${entry.name}/comm`, "utf8").trim(); if (name === "codex") names.push(entry.name); } catch {} return hash(names.sort().join("\n")); }
function workspace(): string { const result = spawnSync("git", ["-C", resolve(import.meta.dirname, "../../../.."), "status", "--porcelain=v1", "-uno"], { encoding: "buffer", maxBuffer: MAX_HTTP_BYTES }); if (result.status !== 0 || !result.stdout) throw new Error("workspace fingerprint failed"); return hash(result.stdout); }
async function snapshot(): Promise<Snapshot> { const i = await identity(), r = await route(i.providerThreadId); return { identity: i, route: r, processes: processes(), workspace: workspace() }; }
export function safeRollout(route: Route): { fd: number; before: string } { const home = realpathSync(route.home); let fd: number | undefined; try { const link = lstatSync(route.rollout); if (!link.isFile() || link.isSymbolicLink() || link.size > MAX_ROLLOUT_BYTES) throw new Error("unsafe rollout file"); fd = openSync(route.rollout, constants.O_RDONLY | constants.O_NOFOLLOW); const stat = fstatSync(fd), opened = realpathSync(`/proc/self/fd/${fd}`), rel = relative(home, opened); if (!stat.isFile() || stat.size > MAX_ROLLOUT_BYTES || rel === "" || rel.startsWith("..") || isAbsolute(rel) || statIdentity(link) !== statIdentity(stat)) throw new Error("rollout identity raced or escaped"); return { fd, before: statIdentity(stat) }; } catch (error) { if (fd !== undefined) closeSync(fd); throw error; } }
export function rolloutIdentity(route: Route): string { const file = safeRollout(route); try { return file.before; } finally { closeSync(file.fd); } }
/** Exact native Codex hook carrier; all other developer content is non-hook. */
/** Isolated provisional format; the eventual ETL owns the durable receipt contract. */
export function parseProvisionalContextMagnetReceipt(serialized: string, expectedTurnId: string, expectedThreadId = TARGET): boolean {
  try { const envelope = row(JSON.parse(serialized)); if (!envelope || envelope.format !== "context-magnet-receipt/v1" || typeof envelope.receiptId !== "string" || !Number.isSafeInteger(envelope.bytes) || envelope.bytes < 0 || !/^[a-f0-9]{64}$/.test(envelope.sha256 as string) || typeof envelope.threadId !== "string" || envelope.threadId !== expectedThreadId || typeof envelope.turnId !== "string" || envelope.turnId !== expectedTurnId || typeof envelope.body !== "string") return false; return Buffer.byteLength(envelope.body) === envelope.bytes && hash(envelope.body) === envelope.sha256; } catch { return false; }
}
export function classifyHookCarrier(payload: unknown, expectedThreadId = TARGET): "not-hook" | "unbound-hook-context" | "context-receipt" {
  const item = row(payload), metadata = row(item?.internal_chat_message_metadata_passthrough); if (!item || item.type !== "message" || item.role !== "developer" || !metadata || typeof item.id !== "string" || typeof metadata.turn_id !== "string" || !Array.isArray(item.content) || !Array.isArray(metadata.content_item_kinds) || item.content.length !== metadata.content_item_kinds.length) return "not-hook";
  for (let index = 0; index < item.content.length; index++) { if (metadata.content_item_kinds[index] !== "hooks.additional_context") continue; const part = row(item.content[index]); if (!part || part.type !== "input_text" || typeof part.text !== "string" || part.text.length === 0) return "unbound-hook-context"; return parseProvisionalContextMagnetReceipt(part.text, metadata.turn_id, expectedThreadId) ? "context-receipt" : "unbound-hook-context"; }
  return "not-hook";
}
function nativeResponseTurnId(payload: unknown): string | null { const item = row(payload), metadata = row(item?.internal_chat_message_metadata_passthrough); return item?.type === "message" && typeof item.id === "string" && typeof metadata?.turn_id === "string" ? metadata.turn_id : null; }
export function parseRolloutJsonl(input: Buffer, limits: Partial<{ bytes: number; lineBytes: number; records: number; turns: number; contexts: number; deadline: number }> = {}): { records: number; turns: number; contexts: number; receiptGap: string } {
  const maxBytes = limits.bytes ?? MAX_ROLLOUT_BYTES, maxLine = limits.lineBytes ?? MAX_LINE_BYTES, maxRecords = limits.records ?? MAX_RECORDS, maxTurns = limits.turns ?? MAX_TURNS, maxContexts = limits.contexts ?? MAX_CONTEXT_RECORDS, deadline = limits.deadline ?? (Date.now() + MAX_WALL_MS);
  if (Date.now() > deadline || input.length > maxBytes) throw new Error("rollout byte or deadline bound exceeded");
  const source = new TextDecoder("utf-8", { fatal: true }).decode(input); const lines = source.split("\n"); if (lines.at(-1) === "") lines.pop(); if (lines.length === 0) throw new Error("incomplete rollout");
  let meta = false, records = 0, contexts = 0, receipts = 0, hooks = 0; const turns = new Set<string>();
  for (const line of lines) { if (Date.now() > deadline) throw new Error("rollout deadline exceeded"); if (!line || Buffer.byteLength(line) > maxLine) throw new Error("rollout line exceeds bound"); const value = row(JSON.parse(line)); if (!value || !only(value, ["ordinal", "timestamp", "type", "payload"]) || !Number.isSafeInteger(value.ordinal) || value.ordinal !== records || typeof value.timestamp !== "string" || !KNOWN.has(value.type as string)) throw new Error("unknown or malformed rollout dialect"); const payload = row(value.payload); if (!payload) throw new Error("invalid rollout payload"); if (value.type === "session_meta") { if (meta || payload.cli_version !== "0.153.2") throw new Error("unsupported rollout version"); meta = true; } if (value.type === "turn_context") { contexts++; if (contexts > maxContexts) throw new Error("context bound exceeded"); } if (value.type === "response_item") { const nativeTurnId = nativeResponseTurnId(payload); if (nativeTurnId) { turns.add(nativeTurnId); if (turns.size > maxTurns) throw new Error("turn bound exceeded"); } const carrier = classifyHookCarrier(payload); if (carrier === "context-receipt") receipts++; if (carrier !== "not-hook") hooks++; } records++; if (records > maxRecords) throw new Error("record bound exceeded"); }
  if (!meta) throw new Error("missing session metadata"); return { records, turns: turns.size, contexts, receiptGap: receipts > 0 ? "receipt-present" : hooks > 0 ? "unbound-hook-context" : "zero-exact-context-receipts" };
}
export async function readRollout(route: Route, checkpointId: string | null, onOpened?: () => void): Promise<Rollout> {
  const file = safeRollout(route); const digest = createHash("sha256"), decoder = new TextDecoder("utf-8", { fatal: true }); let pending = "", bytes = 0, records = 0, turns = 0, contextRecords = 0, meta = false, receipt = 0, hook = 0; const turnIds = new Set<string>(); const deadline = Date.now() + MAX_WALL_MS;
  const consume = (line: string) => { if (Date.now() > deadline) throw new Error("rollout deadline exceeded"); if (Buffer.byteLength(line) > MAX_LINE_BYTES) throw new Error("rollout line exceeds bound"); if (!line) throw new Error("truncated rollout line"); const value = row(JSON.parse(line)); if (!value || !only(value, ["ordinal", "timestamp", "type", "payload"]) || !Number.isSafeInteger(value.ordinal) || value.ordinal !== records || typeof value.timestamp !== "string" || !KNOWN.has(value.type as string)) throw new Error("unknown or malformed rollout dialect"); const payload = row(value.payload); if (!payload) throw new Error("invalid rollout payload"); if (value.type === "session_meta") { if (meta || payload.cli_version !== "0.153.2") throw new Error("unsupported rollout version"); meta = true; } if (value.type === "turn_context") { contextRecords++; if (contextRecords > MAX_CONTEXT_RECORDS) throw new Error("context bound exceeded"); } if (value.type === "response_item") { const nativeTurnId = nativeResponseTurnId(payload); if (nativeTurnId) { turnIds.add(nativeTurnId); turns = turnIds.size; if (turns > MAX_TURNS) throw new Error("turn bound exceeded"); } const carrier = classifyHookCarrier(payload); if (carrier === "context-receipt") receipt++; if (carrier !== "not-hook") hook++; } records++; if (records > MAX_RECORDS) throw new Error("record bound exceeded"); };
  try { onOpened?.(); for await (const chunk of createReadStream(route.rollout, { fd: file.fd, autoClose: false })) { if (Date.now() > deadline) throw new Error("rollout deadline exceeded"); const raw = Buffer.from(chunk); bytes += raw.length; if (bytes > MAX_ROLLOUT_BYTES) throw new Error("rollout byte bound exceeded"); digest.update(raw); pending += decoder.decode(raw, { stream: true }); if (Buffer.byteLength(pending) > MAX_LINE_BYTES) throw new Error("rollout line exceeds bound"); for (;;) { const index = pending.indexOf("\n"); if (index < 0) break; consume(pending.slice(0, index)); pending = pending.slice(index + 1); } } pending += decoder.decode(); if (pending !== "") consume(pending); if (!meta || records === 0) throw new Error("incomplete rollout"); if (checkpointId === null || !turnIds.has(checkpointId)) throw new Error("completed checkpoint absent from native rollout turns"); const after = fstatSync(file.fd); if (file.before !== statIdentity(after) || rolloutIdentity(route) !== file.before) throw new Error("rollout raced during stream"); return { digest: digest.digest("hex"), identity: file.before, size: bytes, records, turns, contextRecords, dialect: DIALECT, receiptGap: receipt > 0 ? "receipt-present" : hook > 0 ? "unbound-hook-context" : "zero-exact-context-receipts" }; } finally { closeSync(file.fd); }
}
function same(before: Snapshot, after: Snapshot): boolean { return before.identity.updatedAt === after.identity.updatedAt && before.identity.status === after.identity.status && before.identity.highWatermark === after.identity.highWatermark && before.identity.providerThreadId === after.identity.providerThreadId && before.identity.checkpointId === after.identity.checkpointId && before.route.routeDigest === after.route.routeDigest && before.route.revision === after.route.revision && before.processes === after.processes && before.workspace === after.workspace; }
async function main(): Promise<void> { if (process.env.BB_THREAD_ID === TARGET) throw new Error("probe thread cannot target itself"); const before = await snapshot(), rollout = await readRollout(before.route, before.identity.checkpointId); const after = await snapshot(); if (rolloutIdentity(after.route) !== rollout.identity || !same(before, after)) throw new Error("protected state changed"); process.stdout.write(JSON.stringify({ format: "context-magnet-session-rollout-probe/v1", status: "passed", target: TARGET, highWatermark: before.identity.highWatermark, accountSlot: `sha256:${before.route.slot}`, routeRevision: before.route.revision, rollout: { sha256: rollout.digest, bytes: rollout.size, records: rollout.records, turns: rollout.turns, contextRecords: rollout.contextRecords, dialect: rollout.dialect }, receiptGap: rollout.receiptGap, protectedStateChanged: false, rawBodiesRetained: false }) + "\n"); }
if (process.env.CM_PROBE_UNIT !== "1") main().catch((error) => { process.stderr.write(`session-rollout-probe failed: ${error instanceof Error ? error.message : "unknown"}\n`); process.exitCode = 1; });
