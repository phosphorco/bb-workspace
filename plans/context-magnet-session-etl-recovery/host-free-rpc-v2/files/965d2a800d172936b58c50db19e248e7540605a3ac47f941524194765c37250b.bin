import assert from "node:assert/strict";
import test from "node:test";
import type { BbPluginApi } from "@get-bb/plugin-sdk";
import plugin, { rpcContract } from "../server.ts";
import {
  armWitnessForTrace,
  witnessStepSelectionFromPluginMetadata,
  WITNESS_METADATA_KEY,
  WITNESS_TOOL_NAME,
  witnessTraceEvidenceCorrelation,
} from "../witness.ts";

const THREAD = "thread-inspector-payload";
const OTHER_THREAD = "another-thread";
const snapshot = {
  id: "host-snapshot-01",
  capturedAt: "2026-09-20T16:40:00.000Z",
  operationSeqHighWatermark: 30,
  admissionAttemptSeqHighWatermark: 2,
  admissionObservationSeqHighWatermark: 4,
  admissionRetentionHighWatermark: 0,
};
const key = (operationId: string, eventSeq: number) => ({ threadId: THREAD, operationId, eventSeq, turnId: "turn-01" });
const selection = armWitnessForTrace(THREAD, "selection-inspector-01", "cmw:00000000-0000-4000-8000-000000000000");
const acceptedAdmission = {
  version: "context-magnet.provider-admission/v1",
  contributionKey: { threadId: THREAD, id: "later" },
  admissionKey: { threadId: THREAD, id: "admission-later" },
  declaration: "declared",
  attempt: { id: "attempt-later", requestKind: "start", providerKind: "codex", instructionMode: "append", selectedToolSummary: "one-or-more" },
  observations: [
    { admissionObservationSequence: 3, at: "2026-09-20T16:40:01.000Z", kind: "constructed" },
    { admissionObservationSequence: 4, at: "2026-09-20T16:40:02.000Z", kind: "accepted" },
  ],
  gaps: [],
};

function contribution(id: string, eventSeq: number, overrides: Record<string, unknown> = {}) {
  const operation = key(`operation-${id}`, eventSeq);
  return {
    contributionKey: { threadId: THREAD, id },
    operation: { kind: "exact", target: operation, renderedAnchor: operation },
    trigger: { factKey: { threadId: THREAD, id: `fact-${id}` }, renderState: "unrendered", locator: "host-fact" },
    inclusionReason: { category: "relevant-tool-result", detail: `retained reason for ${id}` },
    outcome: { kind: "delivered" },
    consumption: { state: "not-observed" },
    evidence: { source: "context-magnet-host", sourceSchemaVersion: "host-trace/v1", original: { retainedId: id }, unknownFields: {}, redactions: [] },
    ...overrides,
  };
}

function page(
  cursor: string | null,
  nextCursor: string | null,
  contributions: readonly object[],
  completeness: "complete" | "partial" | "unavailable" = "complete",
  gaps: readonly object[] = [],
) {
  return {
    version: "context-magnet.trace-carrier/v1",
    threadId: THREAD,
    snapshot,
    cursor,
    nextCursor,
    contributions,
    retainedFrom: { contributionEventSeq: 1, operationEventSeq: 1, state: "known" },
    completeness,
    gaps,
  };
}

function registerInspector(pages: readonly object[], metadata: unknown = {}) {
  const hostCalls: unknown[] = [];
  const threadReads: string[] = [];
  const eventReads: string[] = [];
  let index = 0;
  let handlers: { inspect(input: { threadId: string; hostCursor?: string }): Promise<unknown> } | undefined;
  plugin({
    agents: { configure() {}, registerTool() {} },
    cli: { register() {} },
    events: { on() {} },
    realtime: { publish() {} },
    rpc: { register(_contract: unknown, registered: unknown) { handlers = registered as typeof handlers; } },
    sdk: {
      threads: {
        get: async ({ threadId }: { threadId: string }) => { threadReads.push(threadId); return { id: threadId }; },
        events: { list: async ({ threadId }: { threadId: string }) => { eventReads.push(threadId); return []; } },
        getPluginMetadata: async ({ threadId }: { threadId: string }) => { threadReads.push(threadId); return metadata; },
        experimental_contextMagnetContributions: async (args: unknown) => {
          hostCalls.push(args);
          const result = pages[index++];
          if (result === undefined) throw new Error("unexpected extra host page read");
          return result;
        },
      },
    },
  } as unknown as BbPluginApi);
  assert.ok(handlers, "the inspector RPC handler is registered");
  return { inspect: handlers.inspect, hostCalls, threadReads, eventReads };
}

function registerLivePath(options: Readonly<{
  staleRows?: readonly unknown[] | ((sendAt: number) => readonly unknown[]);
  childBindingMismatch?: boolean;
  armFails?: boolean;
  staleDeleteFails?: boolean;
  postarmSendFails?: boolean;
  postarmSendQueues?: boolean;
  postarmQueuedResult?: unknown;
  cleanupFails?: boolean;
}> = {}) {
  const metadata = new Map<string, unknown>();
  const updates: unknown[] = [];
  const spawnCalls: unknown[] = [];
  const threadSendCalls: unknown[] = [];
  const queuedSendCalls: unknown[] = [];
  const deleteCalls: unknown[] = [];
  const lifecycle: string[] = [];
  const configurationsAtDispatch: unknown[] = [];
  let staleRows: readonly unknown[] = [];
  let tool: { execute(input: { proof: string }, context: { threadId: string }): Promise<unknown> } | undefined;
  let cli: { run(argv: readonly string[]): Promise<{ exitCode: number; stdout?: string; stderr?: string }> } | undefined;
  let configure: ((context: { pluginMetadata: unknown; thread: { id: string } }) => unknown) | undefined;
  plugin({
    agents: {
      configure(callback: unknown) { configure = callback as typeof configure; },
      registerTool(registration: unknown) { tool = registration as typeof tool; },
    },
    cli: { register(registration: unknown) { cli = registration as typeof cli; } },
    events: { on() {} },
    realtime: { publish() {} },
    rpc: { register() {} },
    sdk: {
      threads: {
        get: async ({ threadId }: { threadId: string }) => {
          lifecycle.push(`get:${threadId}`);
          return threadId === "child-v2"
            ? { id: threadId, projectId: "project-01", parentThreadId: options.childBindingMismatch ? OTHER_THREAD : THREAD, environmentId: "environment-01" }
            : { id: threadId, projectId: "project-01", parentThreadId: null, environmentId: "environment-01" };
        },
        getPluginMetadata: async ({ threadId }: { threadId: string }) => metadata.get(threadId) ?? {},
        updatePluginMetadata: async ({ threadId, set }: { threadId: string; set: unknown }) => {
          lifecycle.push(`arm:${threadId}`);
          if (options.armFails) throw new Error("arm failed");
          updates.push({ threadId, set });
          metadata.set(threadId, set);
          return {};
        },
        spawn: async (args: unknown) => {
          lifecycle.push("spawn");
          spawnCalls.push(args);
          const sendAt = (args as { sendAt: number }).sendAt;
          staleRows = typeof options.staleRows === "function"
            ? options.staleRows(sendAt)
            : options.staleRows ?? [{
              id: "stale-exact",
              threadId: "child-v2",
              sendAt,
              content: [{ type: "text", text: "How hard would it be to implement a small Context Magnet contributor in this Monorepo? Give a concise, evidence-based implementation approach and inspect only files necessary to ground the answer." }],
            }];
          return { id: "child-v2" };
        },
        queuedMessages: {
          list: async () => {
            lifecycle.push("list:stale");
            return staleRows;
          },
          send: async (args: unknown) => {
            lifecycle.push("send:queued");
            queuedSendCalls.push(args);
            return { ok: true, delivery: "sent" };
          },
          delete: async (args: unknown) => {
            lifecycle.push("delete:queued");
            deleteCalls.push(args);
            if (options.staleDeleteFails) throw new Error("stale delete failed");
            return { ok: true };
          },
        },
        send: async (args: unknown) => {
          lifecycle.push("send:postarm");
          threadSendCalls.push(args);
          if (options.postarmSendFails) throw new Error("postarm send failed");
          if (options.postarmSendQueues) {
            return {
              ok: true,
              delivery: "queued",
              queuedMessage: options.postarmQueuedResult ?? {
                id: "postarm-queued",
                threadId: "child-v2",
                content: [{ type: "text", text: "How hard would it be to implement a small Context Magnet contributor in this Monorepo? Give a concise, evidence-based implementation approach and inspect only files necessary to ground the answer." }],
              },
            };
          }
          configurationsAtDispatch.push(configure!({ pluginMetadata: metadata.get("child-v2"), thread: { id: "child-v2" } }));
          return { ok: true, delivery: "sent" };
        },
        delete: async (args: unknown) => {
          lifecycle.push("delete:child");
          deleteCalls.push(args);
          if (options.cleanupFails) throw new Error("cleanup failed");
          return { ok: true };
        },
      },
    },
  } as unknown as BbPluginApi);
  assert.ok(tool, "the witness tool is registered");
  assert.ok(cli, "the witness CLI is registered");
  assert.ok(configure, "the agent configuration callback is registered");
  return { metadata, updates, spawnCalls, threadSendCalls, queuedSendCalls, deleteCalls, lifecycle, configurationsAtDispatch, tool, cli, configure };
}

test("returns exactly one authoritative host page and continues only with the supplied opaque cursor", async () => {
  const first = page(null, "cursor-2", [contribution("later", 20, {
    admissions: [acceptedAdmission],
    admissionGaps: [{ kind: "retention", scope: "admissions", reason: "No earlier admission rows are retained." }],
  })]);
  const second = page("cursor-2", null, [contribution("earlier", 5)], "partial", [
    { kind: "retention", scope: "contributions", afterEventSeq: 7, beforeEventSeq: 9, reason: "retention boundary" },
  ]);
  const registered = registerInspector([first, second]);
  const firstResult = await registered.inspect({ threadId: THREAD }) as Record<string, any>;

  assert.deepEqual(registered.hostCalls, [{ threadId: THREAD, limit: 100 }], "the first RPC makes one SDK call");
  assert.equal(firstResult.host.projection.page.cursor, null);
  assert.equal(firstResult.host.nextCursor, "cursor-2");
  assert.deepEqual(firstResult.host.projection.snapshot, snapshot, "the selected provider-admission snapshot watermarks survive strict RPC validation");
  assert.deepEqual(firstResult.host.projection.page.contributions[0].admissions[0].observations.map((entry: { kind: string }) => entry.kind), ["constructed", "accepted"], "accepted admission observations survive the strict RPC boundary");
  assert.equal(firstResult.host.projection.page.contributions[0].admissionGaps[0].scope, "admissions");
  assert.deepEqual(firstResult.host.projection.operations.map((entry: { anchor: { eventSeq: number } }) => entry.anchor.eventSeq), [20]);
  assert.deepEqual(rpcContract.inspect.output.parse(firstResult), firstResult, "the first page payload is schema-valid");
  assert.throws(
    () => rpcContract.inspect.output.parse({
      ...firstResult,
      host: {
        ...firstResult.host,
        projection: {
          ...firstResult.host.projection,
          snapshot: { ...snapshot, unrecognisedSnapshotField: 1 },
        },
      },
    }),
    /unrecognisedSnapshotField/u,
    "the repaired schema remains strict for keys outside the selected host contract",
  );

  const continuationResult = await registered.inspect({ threadId: THREAD, hostCursor: "cursor-2" }) as Record<string, any>;
  assert.deepEqual(registered.hostCalls, [
    { threadId: THREAD, limit: 100 },
    { threadId: THREAD, cursor: "cursor-2", limit: 100 },
  ], "the continuation makes exactly one new SDK call and never restarts page one");
  assert.equal(continuationResult.host.projection.page.cursor, "cursor-2");
  assert.equal(continuationResult.host.nextCursor, null);
  assert.equal(firstResult.host.projection.snapshot.id, continuationResult.host.projection.snapshot.id, "the host cursor retains the same snapshot identity");
  assert.deepEqual(registered.threadReads, [THREAD, THREAD, THREAD, THREAD], "only the authorized requested thread is read");
  assert.deepEqual(registered.eventReads, [THREAD]);
  assert.equal(continuationResult.state, "partial");
  assert.equal(continuationResult.host.state, "partial");
  assert.deepEqual(
    continuationResult.host.projection.operations.map((entry: { anchor: { eventSeq: number }; contributions: { contributionKey: { id: string }; inclusionReason: { detail: string } }[] }) =>
      [entry.anchor.eventSeq, entry.contributions.map((item) => [item.contributionKey.id, item.inclusionReason.detail])]),
    [[5, [["earlier", "retained reason for earlier"]]]],
  );
  assert.equal(continuationResult.host.gaps[0].gap.kind, "retention");
  assert.equal(continuationResult.trace.length, 0, "legacy disclosure is not re-read on continuation");
  assert.deepEqual(rpcContract.inspect.output.parse(continuationResult), continuationResult, "the continuation payload is schema-valid");
});

test("keeps unavailable pages and a model-owned witness receipt explicit", async () => {
  const operation = key("operation-witness", 11);
  const witnessContribution = contribution("host-assigned-contribution", 11, {
    operation: { kind: "exact", target: operation, renderedAnchor: operation },
    consumption: { state: "consumed", kind: "model-owned-receipt", observedAt: "2026-09-20T16:40:01.000Z" },
    evidence: {
      source: "context-magnet-host",
      ...witnessTraceEvidenceCorrelation(selection),
      unknownFields: {},
      redactions: [],
    },
  });
  const registered = registerInspector([page(null, null, [witnessContribution])], { [WITNESS_METADATA_KEY]: selection });
  const result = await registered.inspect({ threadId: THREAD }) as Record<string, any>;
  assert.equal(result.host.witness.state, "consumed");
  assert.equal(result.host.witness.contributionId, "host-assigned-contribution");
  assert.deepEqual(result.host.witness.operation, operation);
  assert.doesNotMatch(JSON.stringify(result.host.witness), /00000000-0000-4000-8000-000000000000/u, "the proof never enters the payload");

  const unavailable = registerInspector([page(null, null, [], "unavailable", [
    { kind: "authorization", scope: "contributions", reason: "host authorization unavailable" },
  ])]);
  const unavailableResult = await unavailable.inspect({ threadId: THREAD }) as Record<string, any>;
  assert.equal(unavailableResult.state, "unavailable");
  assert.equal(unavailableResult.host.projection.completeness, "unavailable");
  assert.equal(unavailableResult.host.gaps[0].gap.kind, "authorization");
});

test("fails closed to an explicit host-carrier gap and leaves legacy status disclosed", async () => {
  const malformed = page(null, null, [contribution("unsafe", 1, {
    evidence: { source: "context-magnet-host", sourceSchemaVersion: "host-trace/v1", original: { providerRequest: "must-not-project" }, unknownFields: {}, redactions: [] },
  })]);
  const registered = registerInspector([malformed]);
  const result = await registered.inspect({ threadId: THREAD }) as Record<string, any>;
  assert.equal(result.host.state, "unavailable");
  assert.equal(result.host.projection, null);
  assert.equal(result.host.gaps[0].gap.kind, "carrier");
  assert.equal(result.state, "inactive", "the legacy carrier remains a disclosed fallback when host validation fails");
  assert.match(result.detail, /legacy agent-cli/i);
  assert.equal(registered.threadReads.includes(OTHER_THREAD), false);
});

test("v2 arm and receipt tool preserve the thread-bound selection and keep the proof out of output", async () => {
  const live = registerLivePath();
  const armed = await live.cli.run(["arm", THREAD]);
  assert.equal(armed.exitCode, 0);
  assert.doesNotMatch(armed.stdout ?? "", /cmw:/u);
  assert.equal(live.updates.length, 1);
  const selection = witnessStepSelectionFromPluginMetadata(live.metadata.get(THREAD));
  assert.ok(selection);
  assert.equal(selection.threadId, THREAD);
  assert.equal(selection.receiptTool, WITNESS_TOOL_NAME);
  const configuration = live.configure({ pluginMetadata: live.metadata.get(THREAD), thread: { id: THREAD } }) as { experimental_contextMagnetTrace?: unknown };
  assert.ok(configuration.experimental_contextMagnetTrace, "the v2 arm reaches the explicit host trace producer");
  assert.doesNotMatch(JSON.stringify(configuration.experimental_contextMagnetTrace), new RegExp(selection.proof, "u"));

  const accepted = await live.tool.execute({ proof: selection.proof }, { threadId: THREAD }) as { isError?: boolean; content: readonly { text: string }[] };
  assert.equal(accepted.isError, undefined);
  assert.equal(live.updates.length, 1, "the tool must not overwrite v2 selection metadata; the host receipt is authoritative");
  assert.doesNotMatch(JSON.stringify(accepted), new RegExp(selection.proof, "u"));

  const rejected = await live.tool.execute({ proof: "cmw:00000000-0000-4000-8000-000000000001" }, { threadId: THREAD }) as { isError?: boolean };
  assert.equal(rejected.isError, true, "a wrong v2 proof remains an application error");
  assert.equal(live.updates.length, 1);
});

test("start uses post-arm threads.send so configure sees armed v2 metadata at dispatch", async () => {
  const live = registerLivePath();
  const started = await live.cli.run(["start", THREAD]);
  assert.equal(started.exitCode, 0);
  assert.doesNotMatch(started.stdout ?? "", /cmw:/u);
  assert.equal(live.spawnCalls.length, 1);
  const spawn = live.spawnCalls[0] as { sendAt: number; pluginMetadata?: unknown };
  assert.ok(spawn.sendAt > Date.now(), "the child is safely queued before its id is known");
  assert.equal(spawn.pluginMetadata, undefined, "spawn cannot carry an incorrectly parent-bound v2 selection");
  const childSelection = witnessStepSelectionFromPluginMetadata(live.metadata.get("child-v2"));
  assert.ok(childSelection);
  assert.equal(childSelection.threadId, "child-v2");
  assert.deepEqual(live.lifecycle.slice(0, 7), [
    `get:${THREAD}`,
    "spawn",
    "get:child-v2",
    "arm:child-v2",
    "list:stale",
    "delete:queued",
    "send:postarm",
  ], "the exact child is verified and armed before its first post-arm send");
  assert.deepEqual(live.threadSendCalls, [{
    threadId: "child-v2",
    input: [{ type: "text", text: "How hard would it be to implement a small Context Magnet contributor in this Monorepo? Give a concise, evidence-based implementation approach and inspect only files necessary to ground the answer.", mentions: [] }],
    model: "gpt-5.6-terra",
    reasoningLevel: "high",
    serviceTier: "fast",
    permissionMode: "accept-edits",
    executionInputSources: {
      model: "explicit",
      reasoningLevel: "explicit",
      serviceTier: "explicit",
      permissionMode: "explicit",
    },
    mode: "start",
  }]);
  assert.equal(live.queuedSendCalls.length, 0, "the stale spawn row is never sent");
  assert.deepEqual(live.deleteCalls, [{ threadId: "child-v2", queuedMessageId: "stale-exact" }]);
  const configuration = live.configurationsAtDispatch[0] as { experimental_contextMagnetTrace?: unknown };
  assert.ok(configuration.experimental_contextMagnetTrace, "the post-arm command is configured from the armed child metadata");
});

test("start cleans up rather than dispatching when the stale spawn-time message is ambiguous", async () => {
  const live = registerLivePath({
    staleRows: (sendAt) => ["queued-one", "queued-two"].map((id) => ({
      id,
      threadId: "child-v2",
      sendAt,
      content: [{ type: "text", text: "How hard would it be to implement a small Context Magnet contributor in this Monorepo? Give a concise, evidence-based implementation approach and inspect only files necessary to ground the answer." }],
    })),
  });
  const failed = await live.cli.run(["start", THREAD]);
  assert.equal(failed.exitCode, 1);
  assert.match(failed.stderr ?? "", /stage=stale-list/u);
  assert.equal(live.threadSendCalls.length, 0);
  assert.equal(live.queuedSendCalls.length, 0);
  assert.deepEqual(live.deleteCalls, [{ threadId: "child-v2", childThreadsConfirmed: false }]);
});

test("start rejects an ambiguous queued post-arm result without a second dispatch", async () => {
  const live = registerLivePath({
    postarmSendQueues: true,
    postarmQueuedResult: {
      id: "postarm-queued",
      threadId: "child-v2",
      content: [{ type: "text", text: "ambiguous post-arm response" }],
    },
  });
  const failed = await live.cli.run(["start", THREAD]);
  assert.equal(failed.exitCode, 1);
  assert.match(failed.stderr ?? "", /stage=postarm-send/u);
  assert.equal(live.threadSendCalls.length, 1);
  assert.equal(live.queuedSendCalls.length, 0, "the returned queued row is never sent again");
  assert.equal(live.configurationsAtDispatch.length, 0, "an ambiguous queued response produces no consumption claim");
  assert.deepEqual(live.deleteCalls, [
    { threadId: "child-v2", queuedMessageId: "stale-exact" },
    { threadId: "child-v2", childThreadsConfirmed: false },
  ]);
});

test("start reports a rejected post-arm send without a consumption claim or stale dispatch", async () => {
  const live = registerLivePath({ postarmSendFails: true });
  const failed = await live.cli.run(["start", THREAD]);
  assert.equal(failed.exitCode, 1);
  assert.match(failed.stderr ?? "", /stage=postarm-send/u);
  assert.equal(live.threadSendCalls.length, 1);
  assert.equal(live.queuedSendCalls.length, 0);
  assert.equal(live.configurationsAtDispatch.length, 0);
  assert.deepEqual(live.deleteCalls, [
    { threadId: "child-v2", queuedMessageId: "stale-exact" },
    { threadId: "child-v2", childThreadsConfirmed: false },
  ]);
});

test("start accepts only an exactly identified queued post-arm result without follow-up dispatch", async () => {
  const live = registerLivePath({ postarmSendQueues: true });
  const started = await live.cli.run(["start", THREAD]);
  assert.equal(started.exitCode, 0);
  assert.match(started.stdout ?? "", /"delivery":"queued"/u);
  assert.equal(live.threadSendCalls.length, 1);
  assert.equal(live.queuedSendCalls.length, 0);
  assert.equal(live.configurationsAtDispatch.length, 0);
});

test("start reports bounded non-secret lifecycle stages including cleanup failure", async () => {
  const binding = registerLivePath({ childBindingMismatch: true });
  const bindingFailure = await binding.cli.run(["start", THREAD]);
  assert.match(bindingFailure.stderr ?? "", /stage=child-binding/u);

  const arm = registerLivePath({ armFails: true });
  const armFailure = await arm.cli.run(["start", THREAD]);
  assert.match(armFailure.stderr ?? "", /stage=arm/u);

  const staleDelete = registerLivePath({ staleDeleteFails: true });
  const staleDeleteFailure = await staleDelete.cli.run(["start", THREAD]);
  assert.match(staleDeleteFailure.stderr ?? "", /stage=stale-delete; cleanup=failed/u);
  assert.doesNotMatch(staleDeleteFailure.stderr ?? "", /stale delete failed/u, "raw failure text is never exposed");
});

test("rejects a host page over the published 100-record bound without claiming a result", async () => {
  const tooLarge = page(null, null, Array.from({ length: 101 }, (_, index) => contribution(`overflow-${index}`, index)));
  const registered = registerInspector([tooLarge]);
  const result = await registered.inspect({ threadId: THREAD }) as Record<string, any>;
  assert.deepEqual(registered.hostCalls, [{ threadId: THREAD, limit: 100 }]);
  assert.equal(result.host.state, "unavailable");
  assert.equal(result.host.projection, null, "the inspector never truncates or claims a complete page above its bound");
  assert.equal(result.host.gaps[0].gap.kind, "carrier");
});
