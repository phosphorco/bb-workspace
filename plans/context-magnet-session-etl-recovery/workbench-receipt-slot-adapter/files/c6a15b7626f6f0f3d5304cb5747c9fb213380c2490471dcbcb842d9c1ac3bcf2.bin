import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import test from "node:test";
import {
  inspectWorkbenchDecision,
  type WorkbenchDecisionRequest,
  type WorkbenchFixedProcess,
} from "../workbench-adapter.ts";

const PROJECT = "/home/ubuntu/phosphor/monorepo";
const SESSION = "native-session-redacted";
const TURN = "bb-turn-07";
const EXECUTABLE = "e".repeat(64);
const SOURCE = "a".repeat(40);
const BODY = "bounded evidence";
const BODY_SHA256 = "30093e91ea5f5bf22aeff70004c2b7f29608ce396d42817d76803104fa0a40e7";
const ENV = Object.freeze({ LANG: "C", LC_ALL: "C", PATH: "/opt/workbench/bin", HOME: "/home/fixed", XDG_CONFIG_HOME: "/home/fixed/.config", XDG_RUNTIME_DIR: "/run/user/1000", XDG_CACHE_HOME: "/home/fixed/.cache" });

const slot = (value: string) => `sha256:${createHash("sha256").update(value, "utf8").digest("hex")}`;

const request = (): WorkbenchDecisionRequest => ({
  projectPath: PROJECT,
  nativeSessionId: SESSION,
  nativeTurnId: TURN,
  bbCheckpointTurnId: TURN,
  sourceFence: { storeInstanceSlot: slot("workbench-store-redacted"), generationSlot: slot("generation-redacted") },
});

/** This fixture uses the receipt-v1 names/values used by the session ETL lane. */
function record(overrides: Record<string, unknown> = {}) {
  return {
    Audience: `codex:${SESSION}`,
    TurnID: TURN,
    ContributionID: "7",
    ContributionCount: 1,
    Content: BODY,
    Outcome: "emitted",
    Reason: "exact-decision",
    Receipt: {
      Version: "context-magnet.receipt/v1",
      Nonce: "opaque-nonce-redacted",
      NativeSessionID: SESSION,
      TurnID: TURN,
      StoreInstance: "workbench-store-redacted",
      Generation: "generation-redacted",
      GenerationKeys: ["generation-key-1"],
      RecordKeys: ["record-key-10", "record-key-11"],
      ContributionKeys: ["contribution-key-1"],
      EmittedUTF8Bytes: Buffer.byteLength(BODY, "utf8"),
      EmittedSHA256: BODY_SHA256,
      ExecutableIdentity: EXECUTABLE,
      SourceIdentity: SOURCE,
    },
    ...overrides,
  };
}

function zeroRecord(overrides: Record<string, unknown> = {}) {
  return record({ ContributionID: null, ContributionCount: 0, Content: null, Receipt: null, Outcome: "none", Reason: "no-selection", ...overrides });
}

function envelope(records: readonly object[], overrides: Record<string, unknown> = {}) {
  return {
    StoreInstance: "workbench-store-redacted",
    Generation: "generation-redacted",
    Complete: true,
    PartialPage: false,
    PartialScan: false,
    HasMore: false,
    Gaps: [],
    Records: records,
    ...overrides,
  };
}

function process(outputs: Readonly<{ history: object; turn: object; contribution?: object }>, options: Readonly<{ stderr?: string; stdout?: string; reject?: boolean; driftAfterRecheck?: number }> = {}) {
  const calls: Array<{ argv: readonly string[]; options: unknown }> = [];
  const attestation = { realpath: "/opt/workbench/bin/workbench", version: `workbench 0.8.1 (${SOURCE})`, executableIdentity: EXECUTABLE, sourceIdentity: SOURCE } as const;
  let rechecks = 0;
  const fixed: WorkbenchFixedProcess = {
    attestation,
    environment: ENV,
    recheckIdentity: async () => {
      rechecks += 1;
      return options.driftAfterRecheck !== undefined && rechecks >= options.driftAfterRecheck
        ? { ...attestation, executableIdentity: "d".repeat(64) }
        : attestation;
    },
    invoke: async (argv, invocation) => {
      calls.push({ argv, options: invocation });
      if (options.reject) throw new Error("runtime unavailable");
      const output = argv[1] === "history" ? outputs.history : argv[3] === "contribution" ? outputs.contribution : outputs.turn;
      return { stdout: options.stdout ?? JSON.stringify(output), stderr: options.stderr ?? "" };
    },
  };
  return { fixed, calls };
}

test("uses a fixed shell-free history/turn/contribution sequence and retains one cross-source-compatible bounded authority", async () => {
  const response = envelope([record()]);
  const fake = process({ history: response, turn: response, contribution: response });
  const result = await inspectWorkbenchDecision(request(), fake.fixed);

  assert.equal(result.state, "ready");
  assert.equal(result.reason, "complete-unique-receipt");
  assert.equal(result.authority?.body, BODY);
  assert.equal(result.authority?.bodySha256, BODY_SHA256, "fixed UTF-8 digest witness");
  assert.equal(result.authority?.receipt.nativeSessionIdSlot, slot(SESSION));
  assert.equal(result.authority?.receipt.turnIdSlot, slot(TURN));
  assert.equal(result.nativeTurnSlot, slot(TURN));
  assert.equal(result.bbCheckpointTurnSlot, slot(TURN));
  assert.deepEqual(result.authority?.receipt.recordKeySlots, [slot("record-key-10"), slot("record-key-11")], "ordered receipt keys remain ordered slots");
  assert.deepEqual(Object.keys(result.authority?.receipt ?? {}).sort(), ["receiptVersion", "nonceSlot", "nativeSessionIdSlot", "turnIdSlot", "storeInstanceSlot", "generationSlot", "generationKeySlots", "recordKeySlots", "contributionKeySlots", "emittedUtf8Bytes", "emittedSha256", "executableIdentitySlot", "sourceIdentitySlot"].sort(), "receipt details exactly match the persisted-rollout-receipt projection shape");
  assert.equal(result.process?.executableSlot, slot(EXECUTABLE));
  assert.equal(result.process?.sourceSlot, slot(SOURCE));
  assert.ok(!JSON.stringify(result).includes(SESSION), "raw native identity never crosses the adapter boundary");
  assert.ok(!JSON.stringify(result).includes(TURN), "raw BB checkpoint identity never crosses the adapter boundary");
  assert.deepEqual(fake.calls.map(({ argv }) => argv), [
    ["context", "history", "--path", PROJECT, "--audience", `codex:${SESSION}`, "--limit", "64", "--max-bytes", "262144", "--json"],
    ["context", "inspect", "turn", TURN, "--path", PROJECT, "--audience", `codex:${SESSION}`, "--limit", "64", "--max-bytes", "262144", "--json"],
    ["context", "inspect", "contribution", "7", "--path", PROJECT, "--audience", `codex:${SESSION}`, "--limit", "64", "--max-bytes", "262144", "--json"],
  ]);
  for (const call of fake.calls) assert.deepEqual(call.options, { cwd: PROJECT, env: ENV, timeoutMs: 1_500, maxOutputBytes: 262_144, maxStderrBytes: 4_096 });
});

test("a complete null body with contribution count zero is an explicit no-contribution result", async () => {
  const zero = zeroRecord();
  const unrelated = zeroRecord({ Audience: "codex:another-native-session", TurnID: "another-turn" });
  const fake = process({ history: envelope([unrelated, zero]), turn: envelope([zero]) });
  const result = await inspectWorkbenchDecision(request(), fake.fixed);
  assert.equal(result.state, "no-contribution");
  assert.equal(result.reason, "complete-zero-contribution");
  assert.equal(result.authority, null);
  assert.equal(fake.calls.length, 2, "zero contribution does not manufacture an inspect-contribution call");
});

test("fails closed for partial, duplicate, cross-session, stale, receipt, body, and unsafe-schema evidence", async () => {
  const valid = envelope([record()]);
  const cases: Array<readonly [string, WorkbenchDecisionRequest, object, object, object | undefined, string]> = [
    ["partial", request(), envelope([record()], { PartialScan: true }), valid, valid, "incomplete-or-invalid-query"],
    ["duplicate", request(), envelope([record(), record()]), envelope([record(), record()]), valid, "duplicate-or-missing-decision-record"],
    ["ambiguous count", request(), envelope([record({ ContributionCount: 2 })]), envelope([record({ ContributionCount: 2 })]), valid, "ambiguous-contribution-count"],
    ["cross session", request(), valid, envelope([record({ Audience: "codex:other-session" })]), valid, "cross-session-or-cross-turn-mismatch"],
    ["cross turn", { ...request(), nativeTurnId: "native-turn-other" }, valid, valid, valid, "cross-session-or-cross-turn-mismatch"],
    ["stale fence", { ...request(), sourceFence: { ...request().sourceFence, generationSlot: slot("other-generation") } }, valid, valid, valid, "store-or-generation-fence-mismatch"],
    ["identity", request(), envelope([record({ Receipt: { ...(record().Receipt as object), ExecutableIdentity: "d".repeat(64) } })]), envelope([record({ Receipt: { ...(record().Receipt as object), ExecutableIdentity: "d".repeat(64) } })]), valid, "receipt-or-executable-identity-mismatch"],
    ["body digest", request(), envelope([record({ Content: "altered evidence" })]), envelope([record({ Content: "altered evidence" })]), envelope([record({ Content: "altered evidence" })]), "body-byte-or-digest-mismatch"],
    ["extra receipt key", request(), envelope([record({ Receipt: { ...(record().Receipt as object), EnvelopeKeys: ["must-not-cross-source"] } })]), envelope([record({ Receipt: { ...(record().Receipt as object), EnvelopeKeys: ["must-not-cross-source"] } })]), valid, "incomplete-or-invalid-query"],
    ["wrong receipt version", request(), envelope([record({ Receipt: { ...(record().Receipt as object), Version: "context-magnet.receipt/v2" } })]), envelope([record({ Receipt: { ...(record().Receipt as object), Version: "context-magnet.receipt/v2" } })]), valid, "incomplete-or-invalid-query"],
    ["forbidden message", request(), envelope([{ ...record(), Message: "provider transcript" }]), envelope([{ ...record(), Message: "provider transcript" }]), valid, "incomplete-or-invalid-query"],
  ];
  for (const [label, input, history, turn, contribution, reason] of cases) {
    const fake = process({ history, turn, contribution });
    const result = await inspectWorkbenchDecision(input, fake.fixed);
    assert.equal(result.state, "gap", label);
    assert.equal(result.reason, reason, label);
    assert.equal(result.authority, null, label);
  }
});

test("refuses inferred bindings and runtime failures without a fallback read", async () => {
  const fake = process({ history: envelope([record()]), turn: envelope([record()]) }, { reject: true });
  const missing = await inspectWorkbenchDecision(null, fake.fixed);
  assert.equal(missing.state, "unavailable");
  assert.equal(missing.reason, "missing-explicit-native-binding");
  assert.equal(fake.calls.length, 0);

  const traversal = await inspectWorkbenchDecision({ ...request(), projectPath: `${PROJECT}/../../escape` }, fake.fixed);
  assert.equal(traversal.state, "unavailable");
  assert.equal(traversal.reason, "invalid-binding-or-process");
  assert.equal(fake.calls.length, 0, "a traversal-shaped scope cannot cause a Workbench read");

  const bbThread = await inspectWorkbenchDecision({ ...request(), nativeSessionId: "thr_6m53rk7vvv" }, fake.fixed);
  assert.equal(bbThread.state, "unavailable");
  assert.equal(bbThread.reason, "invalid-binding-or-process");
  assert.equal(fake.calls.length, 0, "a BB thread-shaped value cannot be used as a native session even at the canonical root");

  const unavailable = await inspectWorkbenchDecision(request(), fake.fixed);
  assert.equal(unavailable.state, "unavailable");
  assert.equal(unavailable.reason, "workbench-process-unavailable");
  assert.equal(fake.calls.length, 1, "the documented runtime failure has no host-trace fallback");
});

test("requires attestation consistency plus 256 KiB transport and 4 KiB accepted stderr bounds", async () => {
  const response = envelope([record()]);
  const invalid = process({ history: response, turn: response });
  const badAttestation: WorkbenchFixedProcess = { ...invalid.fixed, attestation: { ...invalid.fixed.attestation, sourceIdentity: "b".repeat(40) } };
  const rejected = await inspectWorkbenchDecision(request(), badAttestation);
  assert.equal(rejected.state, "unavailable");
  assert.equal(rejected.reason, "invalid-executable-attestation");
  assert.equal(invalid.calls.length, 0);

  const noisy = process({ history: response, turn: response }, { stderr: "x".repeat(4_097) });
  const bounded = await inspectWorkbenchDecision(request(), noisy.fixed);
  assert.equal(bounded.state, "gap");
  assert.equal(bounded.reason, "incomplete-or-invalid-query");

  const oversized = process({ history: response, turn: response }, { stdout: "x".repeat(262_145) });
  assert.equal((await inspectWorkbenchDecision(request(), oversized.fixed)).reason, "incomplete-or-invalid-query");
  assert.deepEqual(noisy.calls[0]?.options, { cwd: PROJECT, env: ENV, timeoutMs: 1_500, maxOutputBytes: 262_144, maxStderrBytes: 4_096 }, "the process seam distinguishes transport capture from accepted diagnostic stderr");
});

test("accepts live-compatible body and history boundaries, but refuses executable identity drift", async () => {
  const boundedBody = "x".repeat(65_536);
  const boundedDigest = createHash("sha256").update(boundedBody, "utf8").digest("hex");
  const bounded = record({ Content: boundedBody, Receipt: { ...(record().Receipt as object), EmittedUTF8Bytes: 65_536, EmittedSHA256: boundedDigest } });
  const unrelated = Array.from({ length: 63 }, (_, index) => zeroRecord({ Audience: `codex:other-${index}`, TurnID: `other-turn-${index}` }));
  const stable = process({ history: envelope([bounded, ...unrelated]), turn: envelope([bounded]), contribution: envelope([bounded]) });
  const accepted = await inspectWorkbenchDecision(request(), stable.fixed);
  assert.equal(accepted.state, "ready", "one exact candidate among 64 complete retained records is admissible");
  assert.equal(accepted.authority?.bodyUtf8Bytes, 65_536);

  const drifting = process({ history: envelope([record()]), turn: envelope([record()]), contribution: envelope([record()]) }, { driftAfterRecheck: 2 });
  const refused = await inspectWorkbenchDecision(request(), drifting.fixed);
  assert.equal(refused.state, "gap");
  assert.equal(refused.reason, "executable-attestation-drift");
});
