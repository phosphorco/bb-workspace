import { execFile } from "node:child_process";
import { createHash } from "node:crypto";
import { readFile, realpath } from "node:fs/promises";
import { dirname, isAbsolute } from "node:path";
import { promisify } from "node:util";

const execFileAsync = promisify(execFile);
const MAX_OUTPUT_BYTES = 256 * 1024;
const TIMEOUT_MS = 2_000;
const PROJECT_ROOT = "/home/ubuntu/phosphor/monorepo";
const MAX_RECORDS = 48;
const MAX_COLLECTION = 64;
const MAX_TEXT = 10_000;
const SAFE_AUDIENCE = /^[A-Za-z0-9._:-]{1,200}$/u;
const SAFE_TURN = /^[A-Za-z0-9._:-]{1,240}$/u;

export type WorkbenchQuery = Readonly<{
  path: string;
  audience: string;
  target?: Readonly<{ kind: "contribution"; id: number } | { kind: "turn"; id: string }>;
}>;
export type WorkbenchScalar = string | number | boolean;
export type WorkbenchEvidence = Readonly<{ key: string; value: WorkbenchScalar }>;
export type WorkbenchReason = Readonly<{
  code: number;
  provider: string;
  rule: string;
  parameters: readonly WorkbenchEvidence[];
}>;
export type WorkbenchExcerpt = Readonly<{
  offset: number;
  bytes: number;
  omittedBefore: number;
  omittedAfter: number;
  text: string;
}>;
export type WorkbenchRecord = Readonly<{
  id: number;
  at: string;
  kind: string;
  outcome: string;
  scope: string;
  audience: string;
  epoch: number;
  turn: string;
  profile: string;
  source: string;
  contributor: string;
  contributionId: number;
  inputs: readonly WorkbenchEvidence[];
  reasons: readonly WorkbenchReason[];
  sample: Readonly<{
    originalBytes: number;
    omittedBytes: number;
    excerpts: readonly WorkbenchExcerpt[];
  }> | null;
}>;
export type WorkbenchGap = Readonly<{
  kind: string;
  generation: number;
  fromRecordId: number;
  toRecordId: number;
  detail: string;
}>;
export type WorkbenchInspection = Readonly<{
  state: "not-configured" | "ready" | "partial" | "unavailable";
  detail: string;
  generation: number;
  records: readonly WorkbenchRecord[];
  gaps: readonly WorkbenchGap[];
  hasMore: boolean;
  partialPage: boolean;
  partialScan: boolean;
  target: WorkbenchQuery["target"] | null;
}>;
export type WorkbenchRunner = (args: readonly string[], cwd: string) => Promise<string>;

/** Fixed-argument, shell-free access to Workbench's bounded query channel. */
export const runWorkbench: WorkbenchRunner = async (args, cwd) => {
  const result = await execFileAsync("workbench", [...args], {
    cwd, shell: false, timeout: TIMEOUT_MS, maxBuffer: MAX_OUTPUT_BYTES, windowsHide: true,
  });
  return result.stdout;
};

function safeQuery(query: WorkbenchQuery): boolean {
  const safeTarget = query.target === undefined
    || (query.target.kind === "contribution" && Number.isSafeInteger(query.target.id) && query.target.id > 0)
    || (query.target.kind === "turn" && SAFE_TURN.test(query.target.id));
  return (query.path === PROJECT_ROOT || query.path.startsWith(`${PROJECT_ROOT}/`))
    && SAFE_AUDIENCE.test(query.audience)
    && safeTarget;
}

function object(value: unknown): Record<string, unknown> | null {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : null;
}

function boundedString(value: unknown, maximum = 512): string | null {
  return typeof value === "string" && value.length <= maximum ? value : null;
}

function integer(value: unknown): number | null {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : null;
}

function parseJson(source: string): unknown | null {
  if (source.length === 0 || source.length > MAX_OUTPUT_BYTES) return null;
  try { return JSON.parse(source) as unknown; } catch { return null; }
}

function scalar(value: unknown): WorkbenchScalar | null {
  const item = object(value);
  const kind = integer(item?.Kind);
  if (kind === 1) return boundedString(item?.String, 4_096);
  if (kind === 2) return typeof item?.Int64 === "number" && Number.isSafeInteger(item.Int64) ? item.Int64 : null;
  if (kind === 3) return integer(item?.Uint64);
  if (kind === 4) return typeof item?.Bool === "boolean" ? item.Bool : null;
  return null;
}

function evidence(value: unknown): WorkbenchEvidence | null {
  const item = object(value);
  const key = boundedString(item?.Key, 256);
  const decoded = scalar(item?.Value);
  return key === null || decoded === null ? null : { key, value: decoded };
}

function boundedArray<T>(value: unknown, decode: (item: unknown) => T | null, maximum = MAX_COLLECTION): T[] | null {
  if (!Array.isArray(value) || value.length > maximum) return null;
  const result: T[] = [];
  for (const item of value) {
    const decoded = decode(item);
    if (decoded === null) return null;
    result.push(decoded);
  }
  return result;
}

function reason(value: unknown): WorkbenchReason | null {
  const item = object(value);
  const code = integer(item?.Code);
  const provider = boundedString(item?.Provider, 256);
  const rule = boundedString(item?.Rule, 256);
  const parameters = boundedArray(item?.Params, evidence, 256);
  return code === null || provider === null || rule === null || parameters === null
    ? null
    : { code, provider, rule, parameters };
}

function excerpt(value: unknown): WorkbenchExcerpt | null {
  const item = object(value);
  const offset = integer(item?.Offset);
  const bytes = integer(item?.Bytes);
  const omittedBefore = integer(item?.OmittedBefore);
  const omittedAfter = integer(item?.OmittedAfter);
  const text = boundedString(item?.Text, MAX_TEXT);
  if (offset === null || bytes === null || omittedBefore === null || omittedAfter === null || text === null || new TextEncoder().encode(text).length !== bytes) return null;
  return { offset, bytes, omittedBefore, omittedAfter, text };
}

const KINDS = ["unknown", "observation", "profile", "contribution", "queued", "offered", "confirmed", "suppressed", "deferred", "rejected", "failed", "withdrawn"] as const;
const OUTCOMES = ["none", "queued", "offered", "confirmed", "suppressed", "deferred", "rejected", "failed", "withdrawn"] as const;
const GAP_KINDS = ["unknown", "rotated", "dropped", "corrupt", "unreadable"] as const;

function enumLabel(value: unknown, labels: readonly string[], prefix: string): string | null {
  const decoded = integer(value);
  if (decoded === null) return null;
  return labels[decoded] ?? `${prefix}-${decoded}`;
}

function record(value: unknown): WorkbenchRecord | null {
  const item = object(value);
  if (item === null) return null;
  const id = integer(item.ID), epoch = integer(item.Epoch), contributionId = integer(item.ContributionID);
  const at = boundedString(item.At, 128), kind = enumLabel(item.Kind, KINDS, "event"), outcome = enumLabel(item.Outcome, OUTCOMES, "outcome");
  const scope = boundedString(item.Scope, 1_024), audience = boundedString(item.Audience, 256), turn = boundedString(item.Turn, 256), profile = boundedString(item.Profile, 256), source = boundedString(item.Source, 512), contributor = boundedString(item.Contributor, 256);
  const inputs = boundedArray(item.Inputs, evidence), reasons = boundedArray(item.Reasons, reason);
  const sampleValue = object(item.Sample);
  if ([id, epoch, contributionId, at, kind, outcome, scope, audience, turn, profile, source, contributor, inputs, reasons].some((entry) => entry === null) || sampleValue === null) return null;
  const originalBytes = integer(sampleValue.OriginalBytes), omittedBytes = integer(sampleValue.OmittedBytes), excerpts = boundedArray(sampleValue.Excerpts, excerpt);
  if (originalBytes === null || omittedBytes === null || excerpts === null || omittedBytes > originalBytes) return null;
  const retained = excerpts.reduce((total, entry) => total + entry.bytes, 0);
  if (retained + omittedBytes !== originalBytes || retained > MAX_TEXT) return null;
  return {
    id: id!, at: at!, kind: kind!, outcome: outcome!, scope: scope!, audience: audience!, epoch: epoch!, turn: turn!, profile: profile!, source: source!, contributor: contributor!, contributionId: contributionId!, inputs: inputs!, reasons: reasons!,
    sample: originalBytes === 0 ? null : { originalBytes, omittedBytes, excerpts },
  };
}

function gap(value: unknown): WorkbenchGap | null {
  const item = object(value);
  const kind = enumLabel(item?.Kind, GAP_KINDS, "gap");
  const generation = integer(item?.Generation), fromRecordId = integer(item?.FromRecordID), toRecordId = integer(item?.ToRecordID), detail = boundedString(item?.Detail, 512);
  return kind === null || generation === null || fromRecordId === null || toRecordId === null || detail === null
    ? null
    : { kind, generation, fromRecordId, toRecordId, detail };
}

type DecodedQueryResult = Readonly<{
  generation: number;
  records: readonly WorkbenchRecord[];
  gaps: readonly WorkbenchGap[];
  hasMore: boolean;
  partialPage: boolean;
  partialScan: boolean;
}>;

function queryResult(value: unknown): DecodedQueryResult | null {
  const item = object(value);
  const generation = integer(item?.Generation);
  const records = boundedArray(item?.Records, record, MAX_RECORDS);
  const gaps = boundedArray(item?.Gaps, gap);
  if (generation === null || records === null || gaps === null || typeof item?.HasMore !== "boolean" || typeof item.PartialPage !== "boolean" || typeof item.PartialScan !== "boolean") return null;
  return { generation, records, gaps, hasMore: item.HasMore, partialPage: item.PartialPage, partialScan: item.PartialScan };
}

const unavailable = (detail: string, target: WorkbenchQuery["target"] | null = null): WorkbenchInspection => ({
  state: "unavailable", detail, generation: 0, records: [], gaps: [], hasMore: false, partialPage: false, partialScan: false, target,
});

/**
 * Reads Workbench's public bounded decision trace without reconstructing a
 * provider payload or BB-private carrier. The exact Workbench records are the
 * authority for source, reason, outcome, turn, excerpts, and evidence gaps.
 */
export async function inspectWorkbenchQuery(query: WorkbenchQuery | null, run: WorkbenchRunner = runWorkbench): Promise<WorkbenchInspection> {
  if (query === null) return { state: "not-configured", detail: "This thread has no explicit Workbench context binding.", generation: 0, records: [], gaps: [], hasMore: false, partialPage: false, partialScan: false, target: null };
  if (!safeQuery(query)) return unavailable("The stored Workbench context binding failed validation.", query.target ?? null);
  const common = ["--path", query.path, "--audience", query.audience, "--limit", String(MAX_RECORDS), "--max-bytes", String(MAX_OUTPUT_BYTES - 16_384), "--json"];
  try {
    const history = queryResult(parseJson(await run(["context", "history", ...common], query.path)));
    if (history === null) return unavailable("Workbench returned an invalid bounded history response.", query.target ?? null);
    let current = history;
    if (query.target !== undefined) {
      const focused = queryResult(parseJson(await run(["context", "inspect", query.target.kind, String(query.target.id), ...common], query.path)));
      if (focused === null) return unavailable("Workbench returned an invalid focused inspection response.", query.target);
      current = focused;
    }
    const gaps = [...history.gaps, ...(current === history ? [] : current.gaps)];
    const partialPage = history.partialPage || current.partialPage;
    const partialScan = history.partialScan || current.partialScan;
    const partial = gaps.length > 0 || partialPage || partialScan;
    return {
      state: partial ? "partial" : "ready",
      detail: current.records.length === 0
        ? "Workbench retained no matching records; absence is not evidence that no context activity occurred."
        : `Workbench retained ${current.records.length} bounded decision record${current.records.length === 1 ? "" : "s"}${query.target === undefined ? "" : ` for this ${query.target.kind}`}.`,
      generation: current.generation,
      records: current.records,
      gaps,
      hasMore: current.hasMore,
      partialPage,
      partialScan,
      target: query.target ?? null,
    };
  } catch {
    return unavailable("Workbench context inspection is unavailable for this binding.", query.target ?? null);
  }
}

// Decision-adapter v2 deliberately has a separate entry point from the legacy
// inspection projection above.  It is the only path in this module that is
// allowed to retain a bounded emitted body, and it requires the independent
// native-session and BB-checkpoint inputs needed for an exact receipt join.

export const WORKBENCH_DECISION_ADAPTER_VERSION = "context-magnet.workbench-decision-adapter/v2";

const DECISION_MAX_OUTPUT_BYTES = 256 * 1024;
const DECISION_MAX_BODY_BYTES = 64 * 1024;
const DECISION_MAX_RECORDS = 64;
const DECISION_MAX_KEYS = 16;
const DECISION_TIMEOUT_MS = 1_500;
/** execFile's transport buffer for each captured stream. */
const STDERR_TRANSPORT_MAX_BYTES = DECISION_MAX_OUTPUT_BYTES;
/** A response is rejected unless its diagnostic stderr fits this smaller cap. */
const STDERR_ACCEPTED_MAX_BYTES = 4 * 1024;
const SLOT = /^sha256:[a-f0-9]{64}$/u;
const OPAQUE = /^[A-Za-z0-9_-]{16,200}$/u;
const HEX = /^[a-f0-9]{64}$/u;
const DECISION_TEXT = /^[A-Za-z0-9._:-]{1,256}$/u;
const FIXED_ENV = Object.freeze({ LANG: "C", LC_ALL: "C" });
const SAFE_ENV_KEYS = new Set(["HOME", "XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "XDG_CACHE_HOME", "PATH", "LANG", "LC_ALL"]);

type DecisionRow = Record<string, unknown>;

/**
 * A process has already been pinned to a real Workbench executable.  The raw
 * attestation is intentionally process-local; all adapter output uses slots.
 */
export type WorkbenchFixedProcess = Readonly<{
  attestation: Readonly<{
    realpath: string;
    version: string;
    executableIdentity: string;
    sourceIdentity: string;
  }>;
  environment: Readonly<Record<string, string>>;
  /** Re-attests the configured executable without exposing its path or environment to output. */
  recheckIdentity: () => Promise<Readonly<{
    realpath: string;
    version: string;
    executableIdentity: string;
    sourceIdentity: string;
  }>>;
  invoke: (argv: readonly string[], options: Readonly<{
    cwd: string;
    env: Readonly<Record<string, string>>;
    timeoutMs: number;
    maxOutputBytes: number;
    /** Accepted stderr cap after capture, not a streaming-process limit. */
    maxStderrBytes: number;
  }>) => Promise<Readonly<{ stdout: string; stderr: string }>>;
}>;

export type WorkbenchDecisionRequest = Readonly<{
  /** A declared project scope, never an account/home/runtime path. */
  projectPath: string;
  /** Native Codex session identity; a BB thread id is not accepted here. */
  nativeSessionId: string;
  /** Native receipt turn; never inferred from a BB thread or timestamp. */
  nativeTurnId: string;
  /** BB's independently supplied terminal checkpoint turn. */
  bbCheckpointTurnId: string;
  sourceFence: Readonly<{ storeInstanceSlot: string; generationSlot: string }>;
}>;

export type WorkbenchDecisionReceipt = Readonly<{
  receiptVersion: "context-magnet.receipt/v1";
  nonceSlot: string;
  nativeSessionIdSlot: string;
  turnIdSlot: string;
  storeInstanceSlot: string;
  generationSlot: string;
  generationKeySlots: readonly string[];
  recordKeySlots: readonly string[];
  contributionKeySlots: readonly string[];
  emittedUtf8Bytes: number;
  emittedSha256: string;
  executableIdentitySlot: string;
  sourceIdentitySlot: string;
}>;

export type WorkbenchDecisionAuthority = Readonly<{
  /** Retained solely for a later exact unique receipt join. */
  body: string;
  bodySha256: string;
  bodyUtf8Bytes: number;
  receipt: WorkbenchDecisionReceipt;
  outcome: string;
  reason: string;
}>;

export type WorkbenchDecisionResult = Readonly<{
  version: typeof WORKBENCH_DECISION_ADAPTER_VERSION;
  state: "ready" | "no-contribution" | "gap" | "unavailable";
  reason: string;
  audienceSlot: string;
  nativeTurnSlot: string;
  bbCheckpointTurnSlot: string;
  process: Readonly<{ executableSlot: string; sourceSlot: string }> | null;
  authority: WorkbenchDecisionAuthority | null;
}>;

type RawReceipt = Readonly<{
  version: "context-magnet.receipt/v1";
  nonce: string;
  nativeSessionId: string;
  turnId: string;
  storeInstance: string;
  generation: string;
  generationKeys: readonly string[];
  recordKeys: readonly string[];
  contributionKeys: readonly string[];
  emittedUtf8Bytes: number;
  emittedSha256: string;
  executableIdentity: string;
  sourceIdentity: string;
}>;

type DecisionRecord = Readonly<{
  audience: string;
  turnId: string;
  contributionId: string | null;
  contributionCount: number;
  content: string | null;
  outcome: string;
  reason: string;
  receipt: RawReceipt | null;
}>;

type DecisionEnvelope = Readonly<{
  storeInstance: string;
  generation: string;
  complete: boolean;
  records: readonly DecisionRecord[];
}>;

function slot(value: string): string {
  return `sha256:${createHash("sha256").update(value, "utf8").digest("hex")}`;
}

function decisionObject(value: unknown): DecisionRow | null {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as DecisionRow : null;
}

function hasExactKeys(value: DecisionRow, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function decisionText(value: unknown, max = 256): string | null {
  return typeof value === "string" && value.length > 0 && value.length <= max ? value : null;
}

function decisionCount(value: unknown): number | null {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : null;
}

function orderedKeys(value: unknown): readonly string[] | null {
  if (!Array.isArray(value) || value.length === 0 || value.length > DECISION_MAX_KEYS) return null;
  const keys: string[] = [];
  const seen = new Set<string>();
  for (const key of value) {
    if (typeof key !== "string" || !DECISION_TEXT.test(key) || seen.has(key)) return null;
    seen.add(key); keys.push(key);
  }
  return Object.freeze(keys);
}

function decodeReceipt(value: unknown): RawReceipt | null {
  const row = decisionObject(value);
  if (row === null || !hasExactKeys(row, ["Version", "Nonce", "NativeSessionID", "TurnID", "StoreInstance", "Generation", "GenerationKeys", "RecordKeys", "ContributionKeys", "EmittedUTF8Bytes", "EmittedSHA256", "ExecutableIdentity", "SourceIdentity"])) return null;
  if (row.Version !== "context-magnet.receipt/v1") return null;
  const nonce = decisionText(row.Nonce, 200);
  const nativeSessionId = decisionText(row.NativeSessionID);
  const turnId = decisionText(row.TurnID);
  const storeInstance = decisionText(row.StoreInstance);
  const generation = decisionText(row.Generation);
  const generationKeys = orderedKeys(row.GenerationKeys);
  const recordKeys = orderedKeys(row.RecordKeys);
  const contributionKeys = orderedKeys(row.ContributionKeys);
  const emittedUtf8Bytes = decisionCount(row.EmittedUTF8Bytes);
  const emittedSha256 = decisionText(row.EmittedSHA256, 64);
  const executableIdentity = decisionText(row.ExecutableIdentity);
  const sourceIdentity = decisionText(row.SourceIdentity);
  if (nonce === null || !OPAQUE.test(nonce) || nativeSessionId === null || turnId === null || storeInstance === null || generation === null || generationKeys === null || recordKeys === null || contributionKeys === null || emittedUtf8Bytes === null || emittedUtf8Bytes > DECISION_MAX_BODY_BYTES || emittedSha256 === null || !HEX.test(emittedSha256) || executableIdentity === null || sourceIdentity === null) return null;
  return Object.freeze({ version: row.Version, nonce, nativeSessionId, turnId, storeInstance, generation, generationKeys, recordKeys, contributionKeys, emittedUtf8Bytes, emittedSha256, executableIdentity, sourceIdentity });
}

function decodeDecisionRecord(value: unknown): DecisionRecord | null {
  const row = decisionObject(value);
  if (row === null || !hasExactKeys(row, ["Audience", "TurnID", "ContributionID", "ContributionCount", "Content", "Outcome", "Reason", "Receipt"])) return null;
  const audience = decisionText(row.Audience);
  const turnId = decisionText(row.TurnID);
  const contributionId = row.ContributionID === null ? null : decisionText(row.ContributionID);
  const contributionCount = decisionCount(row.ContributionCount);
  const content = row.Content === null ? null : typeof row.Content === "string" ? row.Content : null;
  const outcome = decisionText(row.Outcome);
  const reason = decisionText(row.Reason);
  const receipt = row.Receipt === null ? null : decodeReceipt(row.Receipt);
  if (audience === null || turnId === null || contributionCount === null || content === null && row.Content !== null || outcome === null || reason === null || receipt === null && row.Receipt !== null) return null;
  if ((contributionCount === 0) !== (contributionId === null) || (contributionCount === 0) !== (content === null) || (contributionCount === 0) !== (receipt === null)) return null;
  if (content !== null && Buffer.byteLength(content, "utf8") > DECISION_MAX_BODY_BYTES) return null;
  return Object.freeze({ audience, turnId, contributionId, contributionCount, content, outcome, reason, receipt });
}

function decodeEnvelope(source: string): DecisionEnvelope | null {
  if (source.length === 0 || Buffer.byteLength(source, "utf8") > DECISION_MAX_OUTPUT_BYTES) return null;
  let parsed: unknown;
  try { parsed = JSON.parse(source) as unknown; } catch { return null; }
  const row = decisionObject(parsed);
  if (row === null || !hasExactKeys(row, ["StoreInstance", "Generation", "Complete", "PartialPage", "PartialScan", "HasMore", "Gaps", "Records"])) return null;
  const storeInstance = decisionText(row.StoreInstance);
  const generation = decisionText(row.Generation);
  if (storeInstance === null || generation === null || row.Complete !== true || row.PartialPage !== false || row.PartialScan !== false || row.HasMore !== false || !Array.isArray(row.Gaps) || row.Gaps.length !== 0 || !Array.isArray(row.Records) || row.Records.length > DECISION_MAX_RECORDS) return null;
  const records: DecisionRecord[] = [];
  for (const candidate of row.Records) {
    const record = decodeDecisionRecord(candidate);
    if (record === null) return null;
    records.push(record);
  }
  return Object.freeze({ storeInstance, generation, complete: true, records: Object.freeze(records) });
}

function sameRawReceipt(left: RawReceipt, right: RawReceipt): boolean {
  return left.version === right.version && left.nonce === right.nonce && left.nativeSessionId === right.nativeSessionId && left.turnId === right.turnId && left.storeInstance === right.storeInstance && left.generation === right.generation && left.emittedUtf8Bytes === right.emittedUtf8Bytes && left.emittedSha256 === right.emittedSha256 && left.executableIdentity === right.executableIdentity && left.sourceIdentity === right.sourceIdentity
    && JSON.stringify(left.generationKeys) === JSON.stringify(right.generationKeys)
    && JSON.stringify(left.recordKeys) === JSON.stringify(right.recordKeys)
    && JSON.stringify(left.contributionKeys) === JSON.stringify(right.contributionKeys);
}

function sameRecord(left: DecisionRecord, right: DecisionRecord): boolean {
  return left.audience === right.audience && left.turnId === right.turnId && left.contributionId === right.contributionId && left.contributionCount === right.contributionCount && left.content === right.content && left.outcome === right.outcome && left.reason === right.reason
    && ((left.receipt === null && right.receipt === null) || (left.receipt !== null && right.receipt !== null && sameRawReceipt(left.receipt, right.receipt)));
}

function baseResult(request: WorkbenchDecisionRequest | null, process: WorkbenchFixedProcess | null, state: WorkbenchDecisionResult["state"], reason: string, authority: WorkbenchDecisionAuthority | null = null): WorkbenchDecisionResult {
  return Object.freeze({
    version: WORKBENCH_DECISION_ADAPTER_VERSION,
    state,
    reason,
    audienceSlot: request === null ? slot("unbound") : slot(`codex:${request.nativeSessionId}`),
    nativeTurnSlot: request === null ? slot("unbound") : slot(request.nativeTurnId),
    bbCheckpointTurnSlot: request === null ? slot("unbound") : slot(request.bbCheckpointTurnId),
    process: process === null ? null : Object.freeze({ executableSlot: slot(process.attestation.executableIdentity), sourceSlot: slot(process.attestation.sourceIdentity) }),
    authority,
  });
}

function validateDecisionRequest(request: WorkbenchDecisionRequest): boolean {
  return request.projectPath === PROJECT_ROOT
    && DECISION_TEXT.test(request.nativeSessionId)
    && !request.nativeSessionId.startsWith("thr_")
    && DECISION_TEXT.test(request.nativeTurnId)
    && DECISION_TEXT.test(request.bbCheckpointTurnId)
    && SLOT.test(request.sourceFence.storeInstanceSlot)
    && SLOT.test(request.sourceFence.generationSlot);
}

function fixedArgv(command: "history" | "contribution" | "turn", request: WorkbenchDecisionRequest, contributionId?: string): readonly string[] {
  const prefix = command === "history"
    ? ["context", "history"]
    : command === "contribution"
      ? ["context", "inspect", "contribution", contributionId!]
      : ["context", "inspect", "turn", request.bbCheckpointTurnId];
  return Object.freeze([...prefix, "--path", request.projectPath, "--audience", `codex:${request.nativeSessionId}`, "--limit", String(DECISION_MAX_RECORDS), "--max-bytes", String(DECISION_MAX_OUTPUT_BYTES), "--json"]);
}

async function readDecision(process: WorkbenchFixedProcess, argv: readonly string[], request: WorkbenchDecisionRequest): Promise<DecisionEnvelope | null> {
  const response = await process.invoke(argv, Object.freeze({ cwd: request.projectPath, env: process.environment, timeoutMs: DECISION_TIMEOUT_MS, maxOutputBytes: STDERR_TRANSPORT_MAX_BYTES, maxStderrBytes: STDERR_ACCEPTED_MAX_BYTES }));
  if (Buffer.byteLength(response.stdout, "utf8") > DECISION_MAX_OUTPUT_BYTES || Buffer.byteLength(response.stderr, "utf8") > STDERR_ACCEPTED_MAX_BYTES) return null;
  return decodeEnvelope(response.stdout);
}

function receiptAuthority(record: DecisionRecord): WorkbenchDecisionAuthority | null {
  if (record.content === null || record.receipt === null) return null;
  const bytes = Buffer.byteLength(record.content, "utf8");
  const digest = createHash("sha256").update(record.content, "utf8").digest("hex");
  if (bytes !== record.receipt.emittedUtf8Bytes || digest !== record.receipt.emittedSha256) return null;
  const receipt: WorkbenchDecisionReceipt = Object.freeze({
    receiptVersion: record.receipt.version, nonceSlot: slot(record.receipt.nonce), nativeSessionIdSlot: slot(record.receipt.nativeSessionId), turnIdSlot: slot(record.receipt.turnId), storeInstanceSlot: slot(record.receipt.storeInstance), generationSlot: slot(record.receipt.generation), generationKeySlots: Object.freeze(record.receipt.generationKeys.map(slot)), recordKeySlots: Object.freeze(record.receipt.recordKeys.map(slot)), contributionKeySlots: Object.freeze(record.receipt.contributionKeys.map(slot)), emittedUtf8Bytes: bytes, emittedSha256: digest, executableIdentitySlot: slot(record.receipt.executableIdentity), sourceIdentitySlot: slot(record.receipt.sourceIdentity),
  });
  return Object.freeze({ body: record.content, bodySha256: digest, bodyUtf8Bytes: bytes, receipt, outcome: record.outcome, reason: record.reason });
}

function sameAttestation(left: WorkbenchFixedProcess["attestation"], right: WorkbenchFixedProcess["attestation"]): boolean {
  return left.realpath === right.realpath && left.version === right.version && left.executableIdentity === right.executableIdentity && left.sourceIdentity === right.sourceIdentity;
}

function validFixedEnvironment(environment: Readonly<Record<string, string>>): boolean {
  if (environment.LANG !== "C" || environment.LC_ALL !== "C" || !Object.keys(environment).every((key) => SAFE_ENV_KEYS.has(key))) return false;
  const path = environment.PATH;
  if (typeof path !== "string" || path.length === 0 || path.length > 8_192 || !path.split(":").every((part) => isAbsolute(part) && part.length <= 1_024)) return false;
  return ["HOME", "XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "XDG_CACHE_HOME"].every((key) => environment[key] === undefined || (isAbsolute(environment[key]!) && environment[key]!.length <= 1_024));
}

async function inspectDecisionReads(request: WorkbenchDecisionRequest, process: WorkbenchFixedProcess): Promise<WorkbenchDecisionResult> {
  const processFence = { executableSlot: slot(process.attestation.executableIdentity), sourceSlot: slot(process.attestation.sourceIdentity) };
  const history = await readDecision(process, fixedArgv("history", request), request);
  const turn = await readDecision(process, fixedArgv("turn", request), request);
  if (history === null || turn === null) return baseResult(request, process, "gap", "incomplete-or-invalid-query");
  if (slot(history.storeInstance) !== request.sourceFence.storeInstanceSlot || slot(history.generation) !== request.sourceFence.generationSlot || history.storeInstance !== turn.storeInstance || history.generation !== turn.generation) return baseResult(request, process, "gap", "store-or-generation-fence-mismatch");
  const matches = history.records.filter((record) => record.audience === `codex:${request.nativeSessionId}` && record.turnId === request.nativeTurnId);
  if (matches.length !== 1 || turn.records.length !== 1) return baseResult(request, process, "gap", "duplicate-or-missing-decision-record");
  const observed = matches[0]!;
  const turnObserved = turn.records[0]!;
  if (!sameRecord(observed, turnObserved)) return baseResult(request, process, "gap", "cross-session-or-cross-turn-mismatch");
  if (observed.contributionCount === 0) return baseResult(request, process, "no-contribution", "complete-zero-contribution");
  if (observed.contributionCount !== 1) return baseResult(request, process, "gap", "ambiguous-contribution-count");
  if (observed.contributionId === null || observed.receipt === null) return baseResult(request, process, "gap", "missing-contribution-receipt");
  const contribution = await readDecision(process, fixedArgv("contribution", request, observed.contributionId), request);
  if (contribution === null || contribution.storeInstance !== history.storeInstance || contribution.generation !== history.generation || contribution.records.length !== 1 || !sameRecord(observed, contribution.records[0]!)) return baseResult(request, process, "gap", "contribution-query-mismatch");
  const receipt = observed.receipt;
  if (receipt.nativeSessionId !== request.nativeSessionId || receipt.turnId !== request.nativeTurnId || receipt.turnId !== request.bbCheckpointTurnId || receipt.storeInstance !== history.storeInstance || receipt.generation !== history.generation || slot(receipt.executableIdentity) !== processFence.executableSlot || slot(receipt.sourceIdentity) !== processFence.sourceSlot) return baseResult(request, process, "gap", "receipt-or-executable-identity-mismatch");
  const authority = receiptAuthority(observed);
  return authority === null
    ? baseResult(request, process, "gap", "body-byte-or-digest-mismatch")
    : baseResult(request, process, "ready", "complete-unique-receipt", authority);
}

/**
 * Query one explicitly named native session and exact checkpoint turn.  Every
 * failure is a named gap/unavailable state; this adapter never guesses a
 * session, BB thread, turn, receipt, or empty outcome.
 */
export async function inspectWorkbenchDecision(request: WorkbenchDecisionRequest | null, process: WorkbenchFixedProcess | null): Promise<WorkbenchDecisionResult> {
  if (request === null) return baseResult(null, process, "unavailable", "missing-explicit-native-binding");
  if (process === null || !validateDecisionRequest(request)) return baseResult(request, process, "unavailable", "invalid-binding-or-process");
  const sourceVersion = /^workbench 0\.8\.1 \(([a-f0-9]{40})\)$/u.exec(process.attestation.version);
  if (!isAbsolute(process.attestation.realpath) || sourceVersion === null || sourceVersion[1] !== process.attestation.sourceIdentity || !HEX.test(process.attestation.executableIdentity) || !validFixedEnvironment(process.environment)) return baseResult(request, process, "unavailable", "invalid-executable-attestation");
  if (request.nativeTurnId !== request.bbCheckpointTurnId) return baseResult(request, process, "gap", "cross-session-or-cross-turn-mismatch");
  try {
    if (!sameAttestation(process.attestation, await process.recheckIdentity())) return baseResult(request, process, "unavailable", "executable-attestation-drift");
    const result = await inspectDecisionReads(request, process);
    return sameAttestation(process.attestation, await process.recheckIdentity())
      ? result
      : baseResult(request, process, "gap", "executable-attestation-drift");
  } catch {
    return baseResult(request, process, "unavailable", "workbench-process-unavailable");
  }
}

function captureFixedEnvironment(executablePath: string): Readonly<Record<string, string>> {
  const captured: Record<string, string> = { ...FIXED_ENV, PATH: process.env.PATH ?? dirname(executablePath) };
  for (const key of ["HOME", "XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "XDG_CACHE_HOME"] as const) if (process.env[key] !== undefined) captured[key] = process.env[key]!;
  if (!validFixedEnvironment(captured)) throw new Error("Workbench environment is outside the fixed safe allowlist.");
  return Object.freeze(captured);
}

async function readExecutableIdentity(configuredPath: string, environment: Readonly<Record<string, string>>): Promise<WorkbenchFixedProcess["attestation"]> {
  const resolved = await realpath(configuredPath);
  const bytes = await readFile(resolved);
  if (bytes.length === 0 || bytes.length > 128 * 1024 * 1024) throw new Error("Workbench executable exceeds the attestation bound.");
  const executableIdentity = createHash("sha256").update(bytes).digest("hex");
  const versionResult = await execFileAsync(resolved, ["version"], { cwd: PROJECT_ROOT, env: { ...environment }, shell: false, timeout: DECISION_TIMEOUT_MS, maxBuffer: 4_096, windowsHide: true });
  const version = versionResult.stdout.trim();
  const versionMatch = /^workbench 0\.8\.1 \(([a-f0-9]{40})\)$/u.exec(version);
  if (versionMatch === null) throw new Error("Workbench version attestation did not match 0.8.1.");
  return Object.freeze({ realpath: resolved, version, executableIdentity, sourceIdentity: versionMatch[1]! });
}

/** Create a real, shell-free process only after realpath, version, digest, and environment attestation. */
export async function attestWorkbenchExecutable(executablePath: string): Promise<WorkbenchFixedProcess> {
  if (!isAbsolute(executablePath)) throw new Error("Workbench executable must be an absolute configured path.");
  const environment = captureFixedEnvironment(executablePath);
  const attestation = await readExecutableIdentity(executablePath, environment);
  return Object.freeze({
    attestation,
    environment,
    recheckIdentity: async () => readExecutableIdentity(executablePath, environment),
    invoke: async (argv, options) => {
      if (!sameAttestation(attestation, await readExecutableIdentity(executablePath, environment))) throw new Error("Workbench executable changed before invocation.");
      const result = await execFileAsync(attestation.realpath, [...argv], { cwd: options.cwd, env: { ...options.env }, shell: false, timeout: options.timeoutMs, maxBuffer: options.maxOutputBytes, windowsHide: true });
      return Object.freeze({ stdout: result.stdout, stderr: result.stderr });
    },
  });
}
