function recoveryRoot(node) { return `plans/context-magnet-session-etl-recovery/${node}`; }
function granted(path) { return GRANTS.includes(path) || path === recoveryRoot("activation-preimage-correction-1") || path.startsWith(`${recoveryRoot("activation-preimage-correction-1")}/`); }
