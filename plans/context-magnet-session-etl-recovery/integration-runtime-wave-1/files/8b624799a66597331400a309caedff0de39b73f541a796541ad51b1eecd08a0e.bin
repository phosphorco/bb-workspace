import assert from "node:assert/strict";
import { access, readFile } from "node:fs/promises";
import test from "node:test";
import { rpcContract } from "../server.ts";

const source = async (name: string) => readFile(new URL(`../${name}`, import.meta.url), "utf8");
const relativeImports = (value: string) => [...value.matchAll(/from\s+["'](\.\/[^"']+)["']/gu)].map((match) => match[1]);

test("active server graph is the canonical session ETL pipeline", async () => {
  const server = await source("server.ts");
  assert.deepEqual(relativeImports(server), ["./bb-event-adapter.ts", "./codex-session-adapter.ts", "./context-magnet.ts", "./router-reader-client.ts", "./workbench-adapter.ts"]);
  for (const forbidden of ["host-trace-adapter", "trace-producer", "agent-cli-adapter", "witness.ts", "experimental_contextMagnetContributions", "fallback-authority", "bind-workbench", "hostCursor", "nextCursor"]) assert.equal(server.includes(forbidden), false, forbidden);
  assert.match(server, /readBbEventIdentity/u);
  assert.match(server, /adaptCodexSessionProjection/u);
  assert.match(server, /readRouterOriginalSession/u);
  assert.match(server, /projectSessionEtl/u);
  assert.match(server, /inspectWorkbenchDecision/u);
});

test("active UI graph has native ThreadChat and canonical ETL only", async () => {
  const app = await source("app.tsx");
  assert.deepEqual(relativeImports(app), ["./context-magnet.ts", "./server.ts"]);
  assert.match(app, /<ThreadChat\s+threadId=\{threadId\}/u);
  assert.match(app, /sessionEtlFromResult\(result\)/u);
  assert.match(app, /sessionEtlState/u);
  for (const forbidden of ["host-trace-adapter", "trace-producer", "agent-cli-adapter", "witness.ts", "experimental_contextMagnetContributions", "fallback-authority", "HostTraceLane", "WorkbenchTraceLane", "LegacyTrace", "hostCursor", "nextCursor", "Load more", "Legacy delivery trace"]) assert.equal(app.includes(forbidden), false, forbidden);
});

test("RPC accepts only a thread identifier and returns the ETL envelope", () => {
  assert.deepEqual(rpcContract.inspect.input.parse({ threadId: "thread-1" }), { threadId: "thread-1" });
  for (const input of [{ threadId: "thread-1", cursor: "x" }, { threadId: "thread-1", hostCursor: "x" }, { threadId: "thread-1", contribution: "x" }, { threadId: "thread-1", workbench: {} }]) assert.throws(() => rpcContract.inspect.input.parse(input));
  assert.throws(() => rpcContract.inspect.output.parse({ state: "ready", detail: "ready", diagnostics: [], sessionEtl: null, sessionEtlState: "ready", trace: [], consumption: {}, workbench: {} }));
  const output = rpcContract.inspect.output.parse({ state: "ready", detail: "ready", diagnostics: [], sessionEtl: null, sessionEtlState: "ready" });
  assert.deepEqual(output, { state: "ready", detail: "ready", diagnostics: [], sessionEtl: null, sessionEtlState: "ready" });
});

test("only ETL-panel styles are reachable while rollback source remains intact", async () => {
  const [app, css] = await Promise.all([source("app.tsx"), source("app.css")]);
  const classes = [...app.matchAll(/className="([^"]+)"/gu)].flatMap((match) => match[1]!.split(/\s+/u)).filter((name) => name.startsWith("context-magnet-"));
  for (const className of classes) assert.match(css, new RegExp(`\\.${className.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&")}(?:[\\s:{,>])`, "u"), className);
  assert.equal(/context-magnet-(trace|workbench|working|operation|contribution|unmatched|load-more|audit)/u.test(css), false);
  for (const retained of ["agent-cli-adapter.ts", "host-trace-adapter.ts", "trace-producer.ts", "witness.ts", "test/host-trace-adapter.test.ts", "test/plugin-trace-producer.test.ts"]) await access(new URL(`../${retained}`, import.meta.url));
});
