#!/usr/bin/env node
/**
 * Read-only preimage verifier for the Context Magnet session ETL campaign.
 *
 * `snapshot` prints a redacted observation for receipt creation.  `baseline`
 * compares that observation with the captured receipt.  The later lifecycle
 * modes are intentionally fail-closed until their owning node supplies an
 * expected post-condition contract.
 */
import { createHash } from "node:crypto";
import { execFileSync } from "node:child_process";
import { existsSync, lstatSync, readdirSync, readFileSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { basename, join, relative, resolve } from "node:path";

const ROOT = "/home/ubuntu/bb";
const RECEIPT = join(ROOT, "plans/context-magnet-session-etl-workspace-preimage.json");
const PARENT_THREAD = "thr_6m53rk7vvv";
const SELF_THREAD = process.env.BB_THREAD_ID ?? null;
const CAMPAIGN_METADATA = new Set([
  "plans/context-magnet-session-etl-refactor.plan.pkl",
  "plans/context-magnet-session-etl-refactor.ledger.jsonl",
  "plans/context-magnet-session-etl-workspace-preimage.json",
  "plans/verify-context-magnet-session-etl-preimage.mjs",
]);

function sha256(bytes) { return createHash("sha256").update(bytes).digest("hex"); }
function stable(value) {
  if (Array.isArray(value)) return value.map(stable);
  if (value && typeof value === "object") return Object.fromEntries(Object.keys(value).sort().map((key) => [key, stable(value[key])]));
  return value;
}
function run(file, args, { allowFailure = false } = {}) {
  try {
    return execFileSync(file, args, { cwd: ROOT, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], maxBuffer: 32 * 1024 * 1024 });
  } catch (error) {
    if (allowFailure) return null;
    const stderr = String(error.stderr ?? "").replace(/\s+/g, " ").slice(0, 500);
    throw new Error(`${file} ${args.join(" ")} failed: ${stderr || error.message}`);
  }
}
function digestFile(path) {
  if (!existsSync(path)) return { path, state: "missing" };
  const stat = lstatSync(path);
  if (!stat.isFile()) return { path, state: stat.isSymbolicLink() ? "symlink" : "not-file" };
  return { path, state: "present", bytes: stat.size, sha256: sha256(readFileSync(path)) };
}
function commandIdentity(command) {
  const resolved = run("sh", ["-lc", `command -v ${command}`], { allowFailure: true });
  if (!resolved) return { command, state: "missing" };
  const invocationPath = resolved.trim();
  let executablePath;
  try { executablePath = realpathSync(invocationPath); } catch { executablePath = invocationPath; }
  return { command, invocationPath, executablePath, executable: digestFile(executablePath) };
}
function parseStatus(bytes, repoName) {
  const entries = [];
  for (const record of bytes.split("\0")) {
    if (!record) continue;
    const code = record.slice(0, 2);
    const path = record.slice(3);
    if (repoName === "workspace" && CAMPAIGN_METADATA.has(path)) continue;
    entries.push({ code, path });
  }
  return entries.sort((a, b) => `${a.code}\0${a.path}`.localeCompare(`${b.code}\0${b.path}`));
}
function repository(name, directory, recordedAt = null) {
  const head = run("git", ["-C", directory, "rev-parse", "HEAD"]).trim();
  const branch = run("git", ["-C", directory, "symbolic-ref", "--short", "-q", "HEAD"], { allowFailure: true })?.trim() ?? null;
  const status = parseStatus(run("git", ["-C", directory, "status", "--porcelain=v1", "-z", "--untracked-files=all"]), name);
  return {
    name,
    path: relative(ROOT, directory) || ".",
    head,
    branch: branch || null,
    recordedHead: recordedAt,
    recordedHeadMatches: recordedAt === null ? null : recordedAt === head,
    status,
    statusSha256: sha256(Buffer.from(status.map((entry) => `${entry.code}\0${entry.path}\0`).join(""))),
  };
}
function recordedGitlink(path) {
  const output = run("git", ["-C", ROOT, "ls-tree", "HEAD", "--", path]).trim();
  const match = output.match(/^160000 commit ([0-9a-f]{40})\t/);
  if (!match) throw new Error(`missing recorded gitlink for ${path}`);
  return match[1];
}
function filesManifest(root, matcher) {
  const entries = [];
  function walk(directory) {
    for (const name of readdirSync(directory).sort()) {
      const path = join(directory, name);
      const info = lstatSync(path);
      if (info.isDirectory()) walk(path);
      else if (info.isFile() && matcher(relative(root, path))) entries.push({ path: relative(root, path), bytes: info.size, sha256: sha256(readFileSync(path)) });
    }
  }
  if (existsSync(root)) walk(root);
  return entries;
}
function jsonShape(path) {
  const identity = digestFile(path);
  if (identity.state !== "present") return identity;
  try {
    const value = JSON.parse(readFileSync(path, "utf8"));
    const shape = (candidate, depth = 0) => {
      if (depth > 2) return Array.isArray(candidate) ? "array" : typeof candidate;
      if (Array.isArray(candidate)) return { array: candidate.length, item: candidate.length ? shape(candidate[0], depth + 1) : null };
      if (candidate && typeof candidate === "object") return Object.fromEntries(Object.keys(candidate).sort().map((key) => [key, shape(candidate[key], depth + 1)]));
      return typeof candidate;
    };
    return { ...identity, jsonShape: shape(value) };
  } catch { return { ...identity, jsonShape: "invalid-or-non-json" }; }
}
function logicalRouterState(databasePath) {
  if (!existsSync(databasePath)) return { state: "missing", path: databasePath };
  // Query only cardinalities, revisions, known metadata key names, and a digest.
  // The child process never prints the selected metadata values, which may name
  // private paths; no credentials or configuration body enters this receipt.
  const program = `import { Database } from "bun:sqlite";
import { createHash } from "node:crypto";
const db = new Database(process.argv[1], { readonly: true });
const all = (sql) => db.query(sql).all();
const values = {
  metadataKeys: all("SELECT key FROM metadata WHERE key IN ('stateVersion', 'codexSelection', 'writeFence') ORDER BY key").map((row) => row.key),
  selectionRevision: Number(all("SELECT coalesce(json_extract(value_json, '$.selectionRevision'), 0) AS revision FROM metadata WHERE key='codexSelection'")[0]?.revision ?? 0),
  schemaVersion: Number(all("SELECT max(version) AS version FROM schema_migrations")[0]?.version ?? 0),
};
console.log(JSON.stringify({ path: process.argv[1], state: "present", stateDigest: createHash("sha256").update(JSON.stringify(values)).digest("hex"), ...values }));`;
  try { return JSON.parse(run("bun", ["-e", program, "--", databasePath])); }
  catch (error) { return { path: databasePath, state: "unavailable", error: error.message.replace(/\s+/g, " ").slice(0, 240) }; }
}
function loadedPlugins() {
  const raw = JSON.parse(run("bb", ["plugin", "list", "--json"]));
  return raw.plugins.map((plugin) => ({
    id: plugin.id,
    source: plugin.source,
    rootDir: plugin.rootDir,
    provenance: plugin.provenance,
    version: plugin.version,
    enabled: plugin.enabled,
    status: plugin.status,
    services: (plugin.services ?? []).map(({ name, state }) => ({ name, state })).sort((a, b) => a.name.localeCompare(b.name)),
    app: plugin.app?.bundle === null ? null : plugin.app?.bundle ? {
      hash: plugin.app.bundle.hash,
      jsBytes: plugin.app.bundle.jsBytes,
      sdkMajor: plugin.app.bundle.sdkMajor,
      sdkVersion: plugin.app.bundle.sdkVersion,
      compatible: plugin.app.bundle.compatible,
    } : null,
  })).sort((a, b) => a.id.localeCompare(b.id));
}
function directChildren(excludedThreadIds = new Set([SELF_THREAD])) {
  const rows = JSON.parse(run("bb", ["thread", "list", "--parent-thread", PARENT_THREAD, "--json"]));
  return rows.filter((thread) => !excludedThreadIds.has(thread.id)).map((thread) => {
    const activity = thread.activity ?? {};
    const active = thread.status === "active" || Number(activity.activeBackgroundAgentCount ?? 0) > 0
      || Number(activity.activeBackgroundCommandCount ?? 0) > 0 || Number(activity.activeGoalCount ?? 0) > 0
      || Number(activity.activePlanModeCount ?? 0) > 0 || Number(activity.activeWorkflowCount ?? 0) > 0;
    return {
      id: thread.id,
      providerId: thread.providerId,
      status: thread.status,
      runtimeClass: active ? "active-runtime" : "inactive-historical",
      queuedWork: thread.queuedWork,
      environmentPath: thread.environmentPath,
      environmentHostId: thread.environmentHostId,
    };
  }).sort((a, b) => a.id.localeCompare(b.id));
}
function processInventory() {
  const entries = [];
  for (const item of readdirSync("/proc").filter((name) => /^\d+$/.test(name)).sort((a, b) => Number(a) - Number(b))) {
    const pid = Number(item);
    if (pid === process.pid) continue;
    try {
      const comm = readFileSync(`/proc/${pid}/comm`, "utf8").trim();
      if (!/^(codex|bb|bun|node)$/i.test(comm)) continue;
      let executablePath = null;
      try { executablePath = realpathSync(`/proc/${pid}/exe`); } catch { /* permission-raced process */ }
      entries.push({ comm, executablePath, executableSha256: executablePath ? digestFile(executablePath).sha256 ?? null : null });
    } catch { /* process exited during bounded observation */ }
  }
  return entries.sort((a, b) => `${a.comm}\0${a.executablePath ?? ""}`.localeCompare(`${b.comm}\0${b.executablePath ?? ""}`));
}
function listeningPorts() {
  const output = run("ss", ["-ltnH"], { allowFailure: true }) ?? "";
  return output.split("\n").filter(Boolean).map((line) => {
    const parts = line.trim().split(/\s+/);
    return { protocol: parts[0], local: parts[3] ?? null };
  }).sort((a, b) => `${a.protocol}\0${a.local}`.localeCompare(`${b.protocol}\0${b.local}`));
}
function services() {
  const output = run("systemctl", ["list-units", "--type=service", "--state=running", "--no-legend", "--no-pager"], { allowFailure: true }) ?? "";
  return output.split("\n").map((line) => line.trim().split(/\s+/)[0]).filter(Boolean).sort();
}
function observe({ excludedThreadIds = new Set([SELF_THREAD]) } = {}) {
  const fork = join(ROOT, "fork");
  const routerRoot = join(homedir(), ".codex-subscription-router");
  const workspace = repository("workspace", ROOT);
  const children = [
    repository("fork", fork, recordedGitlink("fork")),
    repository("plugins", join(ROOT, "plugins"), recordedGitlink("plugins")),
    repository("community-plugins", join(ROOT, "community-plugins"), recordedGitlink("community-plugins")),
    repository("fork/upstream", join(ROOT, "fork/upstream"), null),
  ];
  const routerState = logicalRouterState(join(routerRoot, "state.db"));
  return stable({
    observationVersion: 1,
    workspace,
    repositories: children,
    protectedPreexisting: {
      communityPluginsRecordedVsHeadMismatch: children.find((entry) => entry.name === "community-plugins").recordedHeadMatches === false,
      campaignMetadataExcludedOnly: [...CAMPAIGN_METADATA].sort(),
    },
    forkPatches: {
      manifest: filesManifest(join(fork, "patches"), () => true),
      resultTreeLock: digestFile(join(fork, "result-tree.lock")),
      verificationScripts: filesManifest(join(fork, "scripts"), (path) => path.startsWith("verify-context-magnet-")),
    },
    sdkReceipts: filesManifest(join(ROOT, "sdk-artifacts"), (path) => /(^checks\.json$|\.tgz(?:\.provenance\.json)?$|^README\.md$|^verify-context-magnet-sdk\.mjs$)/.test(path)),
    runtime: {
      bbRuntime: jsonShape(join(homedir(), ".bb", "bb-app-runtime.json")),
      loadedPlugins: loadedPlugins(),
      router: {
        source: digestFile(join(ROOT, "plugins/plugins/subscription-router/host/router.mjs")),
        sourceRevision: digestFile(join(ROOT, "plugins/plugins/subscription-router/package.json")),
        state: routerState,
      },
      sharedHooks: {
        source: digestFile(join(ROOT, "plugins/plugins/subscription-router/host/shared-hooks.mjs")),
        installation: jsonShape(join(routerRoot, "shared-hooks.json")),
      },
      executables: [commandIdentity("bb"), commandIdentity("codex"), commandIdentity("workbench")],
      services: services(),
      listeningPorts: listeningPorts(),
      providerProcesses: processInventory(),
    },
    directChildren: directChildren(excludedThreadIds),
  });
}
function validateReceipt(receipt) {
  const fail = (message) => { throw new Error(`invalid receipt: ${message}`); };
  if (!receipt || typeof receipt !== "object" || Array.isArray(receipt)) fail("must be an object");
  if (receipt.schemaVersion !== 1) fail("schemaVersion must equal 1");
  if (receipt.kind !== "context-magnet-session-etl-workspace-preimage") fail("unexpected kind");
  if (typeof receipt.capturedWorkerThreadId !== "string" || !receipt.capturedWorkerThreadId.startsWith("thr_")) fail("missing captured worker thread identity");
  if (!receipt.observation || typeof receipt.observation !== "object") fail("missing observation");
  const observation = receipt.observation;
  if (observation.observationVersion !== 1) fail("unexpected observationVersion");
  if (!Array.isArray(observation.repositories) || observation.repositories.length !== 4) fail("expected four child repositories");
  const names = observation.repositories.map((entry) => entry.name).sort().join(",");
  if (names !== "community-plugins,fork,fork/upstream,plugins") fail("child repository set differs");
  const community = observation.repositories.find((entry) => entry.name === "community-plugins");
  if (community.recordedHeadMatches !== false || observation.protectedPreexisting?.communityPluginsRecordedVsHeadMismatch !== true) fail("community gitlink mismatch must be explicit");
  if (!observation.runtime?.sharedHooks?.source?.sha256 || !observation.runtime?.executables?.some((entry) => entry.command === "codex" && entry.executable?.sha256)) fail("missing shared-hook or Codex executable digest");
  if (!observation.runtime?.router?.state?.stateDigest || !Number.isSafeInteger(observation.runtime.router.state.selectionRevision)) fail("missing redacted router state revision/digest");
  if (!Array.isArray(observation.directChildren) || observation.directChildren.some((entry) => entry.id === receipt.capturedWorkerThreadId)) fail("direct-child inventory includes the captured worker");
  if (JSON.stringify(observation.protectedPreexisting?.campaignMetadataExcludedOnly) !== JSON.stringify([...CAMPAIGN_METADATA].sort())) fail("campaign exclusion is not exact");
}
function diff(expected, actual, path = "observation") {
  if (JSON.stringify(expected) === JSON.stringify(actual)) return [];
  if (!expected || !actual || typeof expected !== "object" || typeof actual !== "object") return [path];
  const keys = new Set([...Object.keys(expected), ...Object.keys(actual)]);
  const findings = [];
  for (const key of [...keys].sort()) findings.push(...diff(expected[key], actual[key], `${path}.${key}`));
  return findings.slice(0, 40);
}
function main() {
  const mode = process.argv[2] ?? "baseline";
  if (mode === "snapshot") {
    process.stdout.write(`${JSON.stringify({ schemaVersion: 1, kind: "context-magnet-session-etl-workspace-preimage", capturedWorkerThreadId: SELF_THREAD, observation: observe() }, null, 2)}\n`);
    return;
  }
  if (mode === "preactivation" || mode === "restored") {
    process.stderr.write(`${mode}: contract reserved for its owning lifecycle node; this verifier intentionally makes no passing claim.\n`);
    process.exitCode = 2;
    return;
  }
  if (mode !== "baseline") throw new Error("usage: node plans/verify-context-magnet-session-etl-preimage.mjs [baseline|snapshot|preactivation|restored]");
  if (!existsSync(RECEIPT)) throw new Error(`missing receipt: ${RECEIPT}`);
  const receipt = JSON.parse(readFileSync(RECEIPT, "utf8"));
  validateReceipt(receipt);
  const differences = diff(stable(receipt.observation), observe({ excludedThreadIds: new Set([SELF_THREAD, receipt.capturedWorkerThreadId]) }));
  if (differences.length) throw new Error(`baseline changed at: ${differences.join(", ")}`);
  process.stdout.write("baseline preimage matches fresh bounded observation\n");
}

try { main(); } catch (error) { process.stderr.write(`${error.message}\n`); process.exitCode = 1; }
