import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import test from "node:test";
import { adaptCodexSessionProjection } from "../codex-session-adapter.ts";
import { projectSessionEtl, projectSessionEtlSummary, SessionEtlProjectionError } from "../context-magnet.ts";

const sha = (value: string) => createHash("sha256").update(value, "utf8").digest("hex");
const slot = (value: string) => `sha256:${sha(value)}`;
const body = "bounded Workbench context";
const receipt = () => ({
  receiptVersion: "context-magnet.receipt/v1", nonceSlot: slot("nonce"), nativeSessionIdSlot: slot("native-session"), turnIdSlot: slot("native-turn"), storeInstanceSlot: slot("store"), generationSlot: slot("generation"), generationKeySlots: [slot("generation-key")], recordKeySlots: [slot("record-key")], contributionKeySlots: [slot("contribution-key")], emittedUtf8Bytes: Buffer.byteLength(body, "utf8"), emittedSha256: sha(body), executableIdentitySlot: slot("executable"), sourceIdentitySlot: slot("source"),
});

function readerMeta() {
  return {
    kind: "meta", version: "context-magnet.session-reader-projection/v1", normalizerVersion: "router-reader-v1", projectorVersion: "context-magnet-session-projection/v1",
    router: { authority: "router-snapshot", providerThreadId: slot("bb-provider"), revision: slot("router-revision"), ownerSlot: slot("owner"), readonly: true },
    rollout: { dialect: "codex-rollout", digest: { algorithm: "sha256", value: sha("rollout-bytes") }, file: { identity: slot("rollout-file"), kind: "rollout" }, nativeRolloutId: slot("native-rollout") },
    identities: { nativeRolloutId: slot("native-rollout"), nativeSessionId: slot("native-session"), relation: "distinct-native-identities-recorded" },
  };
}

function input(overrides: Record<string, unknown> = {}): any {
  const currentReceipt = receipt();
  const base = {
    bb: { providerId: "codex", providerThreadSlot: slot("bb-provider"), eventHighWatermark: 9, terminalCheckpoint: { state: "succeeded", turnSlot: slot("bb-scope-turn"), checkpointSlot: slot("native-turn") }, facts: [], gaps: [] },
    native: { version: "context-magnet.session-reader-projection/v1", state: "ready", meta: readerMeta(), omittedEventCount: 0, events: [
      { seq: 1, kind: "source-fence", locator: { source: "rollout", ref: "rollout:fence:1", redacted: true }, details: { records: 2, bytes: 512, digest: sha("rollout-bytes") } },
      { seq: 2, kind: "persisted-rollout-receipt", locator: { source: "rollout", ref: "rollout:receipt:1", redacted: true }, details: currentReceipt },
    ] },
    workbench: { version: "context-magnet.workbench-decision-adapter/v2", state: "ready", reason: "complete-unique-receipt", audienceSlot: slot("codex:native-session"), nativeTurnSlot: slot("native-turn"), bbCheckpointTurnSlot: slot("bb-scope-turn"), process: { executableSlot: slot("executable"), sourceSlot: slot("source") }, authority: { body, bodySha256: sha(body), bodyUtf8Bytes: Buffer.byteLength(body, "utf8"), receipt: currentReceipt, outcome: "selected", reason: "exact-decision" } },
    source: { workbenchStoreInstanceSlot: slot("store"), workbenchGenerationSlot: slot("generation"), authorized: true, sourceFenceStable: true, sourceBounds: "bounded", truncation: "none" },
  };
  return { ...base, ...overrides };
}

function reasons(result: ReturnType<typeof projectSessionEtl>) { return result.events.filter((event) => event.kind === "gap").map((event) => event.details.reason); }

test("admits exact Workbench context only after one exact persisted native receipt", () => {
  const raw = input();
  const acceptedNative = adaptCodexSessionProjection(raw.native);
  const acceptedReceipt = acceptedNative.events.find((event) => event.kind === "persisted-rollout-receipt")?.details as Record<string, unknown> | undefined;
  assert.equal(acceptedReceipt?.receiptVersion, "context-magnet.receipt/v1", "the accepted router shape is flat");
  const result = projectSessionEtl(raw);
  const admitted = result.events.find((event) => event.kind === "context-admission");
  assert.equal(result.meta.version, "context-magnet.session-etl/v1");
  assert.equal(result.events[0]?.seq, 1);
  assert.equal(admitted?.details.admittedContext, body);
  assert.equal(admitted?.details.semanticUse, "unobserved");
  assert.equal(admitted?.associations[0]?.supportingLocators.length, 3);
  assert.notEqual(result.meta.bb.terminalCheckpoint.scopeTurnSlot, result.meta.bb.terminalCheckpoint.providerCheckpointSlot);
  assert.equal(JSON.stringify(result).includes("native-session"), false, "native raw identity is not serialized");
});

test("represents a source-fenced ready native zero plus an explicit unfenced Workbench zero without fabricating receipt fences", () => {
  const noContribution = input({ native: { ...input().native, events: [input().native.events[0]] }, workbench: { ...input().workbench, state: "no-contribution", reason: "complete-zero-contribution", authority: null }, source: { authorized: true, sourceFenceStable: true, sourceBounds: "bounded", truncation: "none" } });
  const zero = projectSessionEtl(noContribution);
  assert.ok(zero.events.some((event) => event.kind === "workbench-no-contribution"));
  assert.equal(zero.events.some((event) => event.kind === "context-admission"), false);
  assert.equal(zero.events.some((event) => event.kind === "gap"), false);
  assert.equal("storeInstance" in zero.meta.workbench, false);
  assert.equal("generation" in zero.meta.workbench, false);

  const unbound = projectSessionEtl(input({ workbench: { ...input().workbench, state: "unavailable", reason: "missing-explicit-native-binding", authority: null } }));
  assert.ok(reasons(unbound).includes("unavailable"));
  assert.equal(unbound.events.some((event) => event.kind === "context-admission"), false);

  const unavailableReader = projectSessionEtl(input({ native: { version: "context-magnet.session-reader-projection/v1", state: "unavailable", meta: null, events: [], omittedEventCount: 0 } }));
  assert.ok(reasons(unavailableReader).includes("unavailable"));
  assert.equal(unavailableReader.events.some((event) => event.kind === "context-admission"), false);
});

test("marks Workbench emission without a receipt unbound and refuses duplicate or mismatched receipts", () => {
  const withoutReceipt = projectSessionEtl(input({ native: { ...input().native, events: [input().native.events[0]] } }));
  assert.ok(reasons(withoutReceipt).includes("unbound-emission"));
  const duplicateNative = input();
  duplicateNative.native.events.push({ ...duplicateNative.native.events[1], seq: 3, locator: { source: "rollout", ref: "rollout:receipt:2", redacted: true } });
  const duplicate = projectSessionEtl(duplicateNative);
  assert.ok(reasons(duplicate).includes("duplicate-persisted-receipt"));
  assert.equal(duplicate.events.some((event) => event.kind === "context-admission"), false);
  const mismatch = input();
  mismatch.native.events[1].details = { ...receipt(), nonceSlot: slot("other-nonce") };
  assert.ok(reasons(projectSessionEtl(mismatch)).includes("receipt-or-identity-mismatch"));
});

test("uses only the provider checkpoint for receipt joins, and names a zero-plus-receipt contradiction", () => {
  const scopeOnly = input();
  const scopeTurn = slot("bb-scope-turn");
  const scopeReceipt = { ...receipt(), turnIdSlot: scopeTurn };
  scopeOnly.native.events[1].details = scopeReceipt;
  scopeOnly.workbench = { ...scopeOnly.workbench, nativeTurnSlot: scopeTurn, authority: { ...scopeOnly.workbench.authority, receipt: scopeReceipt } };
  const rejected = projectSessionEtl(scopeOnly);
  assert.ok(reasons(rejected).includes("receipt-or-identity-mismatch"));
  assert.equal(rejected.events.some((event) => event.kind === "context-admission"), false, "a BB scope-turn-only match never admits");

  const conflict = projectSessionEtl(input({ workbench: { ...input().workbench, state: "no-contribution", reason: "complete-zero-contribution", authority: null }, source: { authorized: true, sourceFenceStable: true, sourceBounds: "bounded", truncation: "none" } }));
  assert.ok(reasons(conflict).includes("zero-contribution-conflict"));
  assert.equal(conflict.events.some((event) => event.kind === "context-admission"), false);
});

test("preserves provider/native identity divergence and requires an event-specific terminal turn", () => {
  const divergent = projectSessionEtl(input());
  assert.notEqual(divergent.meta.identities.bbProviderThreadId, divergent.meta.identities.nativeSessionId);
  const missingTurn = projectSessionEtl(input({ bb: { ...input().bb, terminalCheckpoint: { state: "unknown" } } }));
  assert.ok(reasons(missingTurn).includes("missing-provider-checkpoint"));
  assert.equal(missingTurn.events.some((event) => event.kind === "context-admission"), false);
  const failed = projectSessionEtl(input({ bb: { ...input().bb, terminalCheckpoint: { state: "failed", turnSlot: slot("bb-scope-turn"), checkpointSlot: slot("native-turn") } } }));
  assert.ok(reasons(failed).includes("terminal-failed"));
  assert.equal(failed.events.some((event) => event.kind === "context-admission"), false);
});

test("fails closed for source-fence drift, bounds, unknown native shapes, and unsafe redactions", () => {
  const stale = projectSessionEtl(input({ source: { ...input().source, sourceFenceStable: false } }));
  assert.ok(reasons(stale).includes("source-fence-drift"));
  assert.equal(stale.events.some((event) => event.kind === "context-admission"), false);
  const bounded = projectSessionEtl(input({ native: { ...input().native, omittedEventCount: 1 } }));
  assert.ok(reasons(bounded).includes("compacted"));
  assert.throws(() => projectSessionEtl(input({ native: { ...input().native, events: Array.from({ length: 17 }, (_, seq) => ({ seq: seq + 1, kind: "gap", locator: { source: "rollout", ref: `rollout:gap:${seq}`, redacted: true }, details: {} })) } })), SessionEtlProjectionError);
  assert.throws(() => projectSessionEtl(input({ native: { ...input().native, events: [{ seq: 1, kind: "unknown-context", locator: { source: "rollout", ref: "rollout:unknown:1", redacted: true }, details: {} }] } })), SessionEtlProjectionError);
  assert.throws(() => projectSessionEtl(input({ native: { ...input().native, events: [{ seq: 1, kind: "gap", locator: { source: "rollout", ref: "rollout:gap:1", redacted: true }, details: { sourcePath: "/secret" } }] } })), SessionEtlProjectionError);
  assert.throws(() => projectSessionEtl(input({ native: { ...input().native, events: [...input().native.events].reverse() } })), SessionEtlProjectionError, "source event order is an authority fence");
  const fenceMismatch = projectSessionEtl(input({ source: { ...input().source, workbenchGenerationSlot: slot("other-generation") } }));
  assert.ok(reasons(fenceMismatch).includes("store-or-generation-fence-mismatch"));
});

test("has deterministic citation ordering and a lossy summary that cannot invent a join", () => {
  const first = projectSessionEtl(input());
  const second = projectSessionEtl(input());
  assert.deepEqual(first, second);
  assert.deepEqual(projectSessionEtlSummary(first), first.events.map(({ seq, kind, locator }) => ({ seq, kind, locator })));
  assert.equal(JSON.stringify(projectSessionEtlSummary(first)).includes(body), false);
  assert.equal(projectSessionEtlSummary(projectSessionEtl(input({ workbench: { ...input().workbench, authority: null, state: "gap", reason: "missing" } }))).some((event) => event.kind === "context-admission"), false);
});

test("accounts for every canonical event displaced by the 16-event cap", () => {
  const oversized = input();
  const fencesAndGaps = Array.from({ length: 14 }, (_, index) => ({ seq: index + 3, kind: "gap", locator: { source: "rollout", ref: `rollout:gap:${index}`, redacted: true }, details: { reason: "native-reader-gap" } }));
  oversized.native.events.push(...fencesAndGaps);
  const result = projectSessionEtl(oversized);
  const eventBound = result.events.at(-1);
  assert.equal(result.events.length, 16);
  assert.equal(eventBound?.kind, "gap");
  assert.equal(eventBound?.details.reason, "event-bound");
  assert.equal(eventBound?.details.droppedEventCount, 7, "all displaced semantic events are counted");
  assert.equal(result.omittedEventCount, 7);
  assert.ok((eventBound?.details.droppedKinds as readonly string[]).includes("context-admission"), "a displaced admission is reported rather than silently claimed");
});

test("serializes no raw provider carrier, rollout path, credential, or unrelated Workbench text", () => {
  const result = projectSessionEtl(input());
  const serialized = JSON.stringify(result);
  for (const forbidden of ["context-magnet.hook-text/v1", "/home/ubuntu", "credential", "unrelated Workbench text", "provider request"]) assert.equal(serialized.includes(forbidden), false, forbidden);
  assert.equal(serialized.includes(body), true, "the one admitted Workbench body is retained");
});
