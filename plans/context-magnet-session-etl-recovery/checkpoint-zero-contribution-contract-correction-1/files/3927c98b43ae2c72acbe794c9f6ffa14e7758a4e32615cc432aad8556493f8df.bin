/**
 * Read-only reducer for the original, router-recorded Codex rollout.  This is
 * deliberately independent of Router and accounts: importing either would
 * make a diagnostic read capable of opening lifecycle/provider machinery.
 */
import { createHash } from "node:crypto";
import { closeSync, constants, fstatSync, lstatSync, openSync, readFileSync, readSync, realpathSync } from "node:fs";
import { isAbsolute, join, relative } from "node:path";
import { fileURLToPath } from "node:url";

export const READER_VERSION = "context-magnet-session-reader/v1";
const MODULE_PATH = fileURLToPath(import.meta.url);
const sourceDigest = () => createHash("sha256").update(readFileSync(MODULE_PATH)).digest("hex");
/** Digest of these exact loaded helper bytes, not a forgeable version label. */
export const READER_ATTESTATION = sourceDigest();
const MAX_BYTES = 8_388_608, MAX_LINE_BYTES = 4_194_304, MAX_RECORDS = 512, MAX_TURNS = 256, MAX_CONTEXTS = 256, MAX_CONTEXT_BYTES = 65_536, MAX_EVENTS = 16, MAX_WALL_MS = 15_000;
const ROUTER_SCHEMA_VERSION = 5;
const KNOWN_RECORDS = new Set(["session_meta", "event_msg", "response_item", "world_state", "turn_context", "token_usage_record"]);
const forbidden = /(?:path|home|account|message|reasoning|tool|credential)/iu;
const digest = (value) => createHash("sha256").update(value).digest("hex");
const slot = (value) => `sha256:${digest(String(value))}`;
const object = (value) => value !== null && typeof value === "object" && !Array.isArray(value) ? value : null;
const nonempty = (value, max = 256) => typeof value === "string" && value.length > 0 && value.length <= max;
const fileIdentity = (stat) => `${stat.dev}:${stat.ino}:${stat.size}:${stat.mtimeMs}:${stat.ctimeMs}`;
const safeLocator = (tag, value) => ({ source: "rollout", ref: `${tag}:sha256:${digest(value)}`, redacted: true });

/** Attest the only helper identity this reducer accepts. */
export function attestReader(attestation, expectedDigest = READER_ATTESTATION) {
  return typeof attestation === "string" && attestation === READER_ATTESTATION && expectedDigest === READER_ATTESTATION && sourceDigest() === READER_ATTESTATION;
}

/**
 * Selects exactly the original recorded route from a caller-supplied readonly
 * state snapshot.  It intentionally has no discovery, repair, copy, or
 * resume fallback.
 */
export function selectReadonlyOriginalOwner(readonlyState, providerThreadId) {
  const state = object(readonlyState);
  if (!state || state.readonly !== true || !nonempty(providerThreadId)) throw new Error("readonly-state-required");
  const claims = Array.isArray(state.migrationClaims) ? state.migrationClaims : Object.keys(object(state.migratingThreads) ?? {});
  if (claims.some((claim) => typeof claim === "string" ? claim === providerThreadId : object(claim)?.threadId === providerThreadId)) throw new Error("migration-claim");
  const routes = Array.isArray(state.routes) ? state.routes.filter((candidate) => {
    const route = object(candidate);
    return route && (route.providerThreadId === providerThreadId || route.threadId === providerThreadId);
  }) : [];
  let route;
  if (routes.length === 1) route = routes[0];
  else if (routes.length === 0) {
    const owners = object(state.threadOwners), rollouts = object(state.threadRollouts), revisions = object(state.routeRevisions);
    if (!owners || !rollouts || !nonempty(owners[providerThreadId]) || !nonempty(rollouts[providerThreadId])) throw new Error("missing-original-route");
    route = { ownerId: owners[providerThreadId], rolloutPath: rollouts[providerThreadId], revision: revisions?.[providerThreadId] ?? 0 };
  } else throw new Error("ambiguous-owner");
  route = object(route);
  const ownerId = route?.ownerId ?? route?.accountId ?? route?.owner;
  const rolloutPath = route?.rolloutPath ?? route?.rollout;
  const revision = route?.revision;
  const accounts = Array.isArray(state.accounts) ? state.accounts : [];
  const owners = accounts.filter((candidate) => object(candidate)?.id === ownerId && object(candidate)?.enabled === true && object(candidate)?.draining === false);
  if (owners.length !== 1 || !nonempty(rolloutPath, 4096) || !Number.isSafeInteger(revision) || revision < 0) throw new Error("ambiguous-owner");
  const home = owners[0].codexHome ?? owners[0].home;
  if (!nonempty(home, 4096)) throw new Error("invalid-owner-home");
  return { ownerSlot: slot(ownerId), revision: String(revision), home, rolloutPath };
}

/*
 * This is deliberately not a RouterStateStore method.  RouterStateStore opens
 * writable handles, configures PRAGMAs and may migrate schema; a diagnostic
 * reader must never be able to do any of those things.  Keep its tiny SQL
 * surface here, next to the reducer that consumes the resulting snapshot.
 */
export async function readReadonlyOriginalOwner(root, providerThreadId, options = {}) {
  if (!nonempty(root, 4096) || !nonempty(providerThreadId, 512)) throw new Error("readonly-state-required");
  const capture = options.capture ?? captureStateIdentity;
  const before = capture(root);
  let database;
  try {
    const Database = options.Database ?? (await import("bun:sqlite")).Database;
    if (typeof Database !== "function") throw new Error("readonly-runtime");
    // Bun's readonly/create:false pair is the authority boundary.  Do not add
    // pragmas here: even ostensibly read-only pragmas can create side effects.
    database = new Database(join(root, "state.db"), { readonly: true, create: false });
    // Migrations are append-only: a healthy v5 store retains its older rows.
    // `MAX` gives the current schema without reading any state payloads.
    const versions = database.query("SELECT MAX(version) AS version FROM schema_migrations").all();
    if (!Array.isArray(versions) || versions.length !== 1 || versions[0]?.version !== ROUTER_SCHEMA_VERSION) throw new Error("unsupported-schema");
    const claims = database.query("SELECT 1 AS claimed FROM migration_claims WHERE thread_id = ? LIMIT 1").all(providerThreadId);
    if (!Array.isArray(claims) || claims.length > 1 || claims.length === 1) throw new Error("migration-claim");
    const rows = database.query(`SELECT r.thread_id AS providerThreadId, r.account_id AS ownerId,
      r.rollout_path AS rolloutPath, r.revision AS revision, a.codex_home AS codexHome,
      a.enabled AS enabled, a.draining AS draining
      FROM routes AS r JOIN accounts AS a ON a.id = r.account_id
      WHERE r.thread_id = ? LIMIT 2`).all(providerThreadId);
    if (!Array.isArray(rows) || rows.length !== 1) throw new Error(rows?.length === 0 ? "missing-original-route" : "ambiguous-owner");
    const row = rows[0];
    if (!object(row) || row.providerThreadId !== providerThreadId || !nonempty(row.ownerId) || !nonempty(row.rolloutPath, 4096)
      || !nonempty(row.codexHome, 4096) || row.enabled !== 1 || row.draining !== 0
      || !Number.isSafeInteger(row.revision) || row.revision < 0) throw new Error("ambiguous-owner");
    return {
      readonly: true,
      routes: [{ providerThreadId, ownerId: row.ownerId, rolloutPath: row.rolloutPath, revision: row.revision }],
      migrationClaims: [],
      accounts: [{ id: row.ownerId, codexHome: row.codexHome, enabled: true, draining: false }],
    };
  } finally {
    try { database?.close(); } catch { throw new Error("readonly-close"); }
    const after = capture(root);
    if (before !== after) throw new Error("state-raced");
  }
}

function captureStateIdentity(root) {
  const identity = (name, optional = false) => {
    try {
      const info = lstatSync(join(root, name));
      if (!info.isFile() || info.isSymbolicLink()) throw new Error("unsafe-state");
      return `${name}:${fileIdentity(info)}`;
    } catch (error) {
      if (optional && error?.code === "ENOENT") return `${name}:absent`;
      throw error;
    }
  };
  return [identity("state.db"), identity("state.db-wal", true), identity("state.db-shm", true)].join("|");
}

function openContainedRegular(route) {
  let fd;
  try {
    const home = realpathSync(route.home), beforePath = lstatSync(route.rolloutPath);
    if (!beforePath.isFile() || beforePath.isSymbolicLink() || beforePath.size > MAX_BYTES) throw new Error("unsafe-rollout");
    fd = openSync(route.rolloutPath, constants.O_RDONLY | constants.O_NOFOLLOW);
    const beforeFd = fstatSync(fd), opened = realpathSync(`/proc/self/fd/${fd}`), rel = relative(home, opened);
    if (!beforeFd.isFile() || beforeFd.size > MAX_BYTES || rel === "" || rel.startsWith("..") || isAbsolute(rel) || fileIdentity(beforeFd) !== fileIdentity(beforePath)) throw new Error("unsafe-rollout");
    return { fd, before: fileIdentity(beforeFd), identity: slot(fileIdentity(beforeFd)) };
  } catch (error) {
    if (fd !== undefined) closeSync(fd);
    throw error;
  }
}

function parseReceiptText(text, nativeSessionId, turnId) {
  const prefix = "context-magnet.hook-text/v1\n", divider = "\n\n--context-magnet-body--\n";
  if (!text.startsWith(prefix)) return { state: "unbound" };
  const bodyAt = text.indexOf(divider, prefix.length);
  if (bodyAt < 0 || text.indexOf(divider, bodyAt + divider.length) >= 0) return { state: "malformed" };
  const serialized = text.slice(prefix.length, bodyAt), body = text.slice(bodyAt + divider.length);
  if (serialized.includes("\n")) return { state: "malformed" };
  let receipt;
  try { receipt = JSON.parse(serialized); } catch { return { state: "malformed" }; }
  const keys = ["version", "nonce", "nativeSessionId", "turnId", "storeInstance", "generation", "generationKeys", "recordKeys", "contributionKeys", "emittedUtf8Bytes", "emittedSha256", "executableIdentity", "sourceIdentity"];
  if (!object(receipt) || Object.keys(receipt).length !== keys.length || !keys.every((key) => Object.hasOwn(receipt, key)) || receipt.version !== "context-magnet.receipt/v1") return { state: "malformed" };
  if (!/^[A-Za-z0-9._~-]{1,200}$/u.test(receipt.nonce) || receipt.nativeSessionId !== nativeSessionId || receipt.turnId !== turnId || !["storeInstance", "generation", "executableIdentity", "sourceIdentity"].every((key) => nonempty(receipt[key])) || !Number.isSafeInteger(receipt.emittedUtf8Bytes) || receipt.emittedUtf8Bytes < 0 || !/^[a-f0-9]{64}$/u.test(receipt.emittedSha256)) return { state: "malformed" };
  for (const key of ["generationKeys", "recordKeys", "contributionKeys"]) {
    if (!Array.isArray(receipt[key]) || receipt[key].length === 0 || receipt[key].length > 16 || receipt[key].some((entry) => !nonempty(entry)) || new Set(receipt[key]).size !== receipt[key].length) return { state: "malformed" };
  }
  const bytes = Buffer.byteLength(body);
  if (bytes > MAX_CONTEXT_BYTES || bytes !== receipt.emittedUtf8Bytes || digest(body) !== receipt.emittedSha256) return { state: "malformed" };
  return { state: "receipt", receipt: { ...receipt } };
}

function inspectCarrier(payload, sessionId, ordinal) {
  const item = object(payload), metadata = object(item?.internal_chat_message_metadata_passthrough), content = Array.isArray(item?.content) ? item.content : null, kinds = Array.isArray(metadata?.content_item_kinds) ? metadata.content_item_kinds : null;
  const claims = Boolean(kinds?.some((kind) => kind === "hooks.additional_context"));
  if (!claims) return { state: "ordinary", receipts: [] };
  if (!item || item.type !== "message" || item.role !== "developer" || !nonempty(item.id) || !metadata || !nonempty(metadata.turn_id) || !content || !kinds || content.length !== kinds.length) return { state: "malformed", receipts: [] };
  const receipts = [];
  for (let index = 0; index < content.length; index++) {
    if (kinds[index] !== "hooks.additional_context") continue;
    const part = object(content[index]);
    if (!part || part.type !== "input_text" || !nonempty(part.text, MAX_LINE_BYTES)) return { state: "malformed", receipts: [] };
    const parsed = parseReceiptText(part.text, sessionId, metadata.turn_id);
    if (parsed.state === "malformed") return { state: "malformed", receipts: [] };
    if (parsed.state === "unbound") return { state: "unbound", receipts: [] };
    receipts.push({ receipt: parsed.receipt, locator: safeLocator("record", `${ordinal}:${item.id}:${metadata.turn_id}:${index}`) });
  }
  return receipts.length === 1 ? { state: "receipt", receipts } : { state: "malformed", receipts: [] };
}

function scanRollout(fd, identity, clock = Date.now) {
  const decoder = new TextDecoder("utf-8", { fatal: true }), hash = createHash("sha256");
  return (async () => {
    const deadline = clock() + MAX_WALL_MS;
    let bytes = 0, pending = "", ordinal = 0, contexts = 0, meta = null, nativeSessionId = "", nativeRolloutId = "", outcome = null, turns = new Set(), receipts = [], unbound = false;
    try {
      const buffer = Buffer.allocUnsafe(16_384);
      for (;;) {
        if (clock() > deadline) throw new Error("time-bound");
        const read = readSync(fd, buffer, 0, buffer.length, null);
        if (read === 0) break;
        const chunk = buffer.subarray(0, read);
        bytes += read; if (bytes > MAX_BYTES) throw new Error("byte-bound");
        hash.update(chunk);
        pending += decoder.decode(chunk, { stream: true }); if (Buffer.byteLength(pending) > MAX_LINE_BYTES) throw new Error("line-bound");
        for (;;) { const at = pending.indexOf("\n"); if (at < 0) break; const line = pending.slice(0, at); pending = pending.slice(at + 1); consume(line); }
      }
      pending += decoder.decode(); if (pending !== "") consume(pending);
    } catch (error) {
      const code = error instanceof Error ? error.message : "decode";
      const safeCode = new Set(["byte-bound", "line-bound", "record-bound", "malformed-jsonl", "unsupported-dialect", "duplicate-session-meta", "invalid-hook-carrier", "turn-bound", "context-bound", "time-bound"]);
      return { error: safeCode.has(code) ? code : "decode", bytes, records: ordinal, digest: null, identity };
    }
    if (!meta) return { error: "missing-session-meta", bytes, records: ordinal, digest: null, identity };
    return { bytes, records: ordinal, digest: hash.digest("hex"), identity, nativeSessionId, nativeRolloutId, outcome, turns, receipts, unbound };

    function consume(line) {
      if (clock() > deadline) throw new Error("time-bound");
      if (++ordinal > MAX_RECORDS) throw new Error("record-bound");
      if (!line || Buffer.byteLength(line) > MAX_LINE_BYTES) throw new Error("line-bound");
      let record; try { record = JSON.parse(line); } catch { throw new Error("malformed-jsonl"); }
      if (!object(record) || !KNOWN_RECORDS.has(record.type) || !object(record.payload)) throw new Error("unsupported-dialect");
      if (ordinal === 1) {
        if (record.type !== "session_meta" || record.payload.cli_version !== "0.153.2" || !nonempty(record.payload.id) || !nonempty(record.payload.session_id)) throw new Error("unsupported-dialect");
        meta = record.payload; nativeSessionId = meta.session_id; nativeRolloutId = meta.id; return;
      }
      if (record.type === "session_meta") throw new Error("duplicate-session-meta");
      if (record.type === "response_item") {
        const carrier = inspectCarrier(record.payload, nativeSessionId, ordinal);
        if (carrier.state === "malformed") throw new Error("invalid-hook-carrier");
        if (carrier.state === "unbound") unbound = true;
        receipts.push(...carrier.receipts);
        const turn = object(record.payload.internal_chat_message_metadata_passthrough)?.turn_id;
        if (nonempty(turn)) { turns.add(turn); if (turns.size > MAX_TURNS) throw new Error("turn-bound"); }
      }
      if (record.type === "turn_context") { if (++contexts > MAX_CONTEXTS) throw new Error("context-bound"); outcome = outcome ?? "context-observed"; }
    }
  })();
}

function projection(meta, events, status) {
  return { version: "context-magnet.session-reader-projection/v1", state: status, meta, events: events.slice(0, MAX_EVENTS), omittedEventCount: Math.max(0, events.length - MAX_EVENTS) };
}

/**
 * Opens and scans one original rollout. Inputs are plain readonly snapshots;
 * no process, lifecycle, status, router-store, or provider APIs are opened.
 */
export async function readOriginalRolloutSession(input) {
  const value = object(input), attestation = value?.readerAttestation;
  const events = [], gap = (reason, ref = "reader") => events.push({ seq: events.length + 1, kind: "gap", locator: safeLocator("gap", `${ref}:${reason}`), details: { reason } });
  if (!attestReader(attestation, value?.expectedReaderDigest)) { gap("reader-attestation"); return projection(null, events, "unavailable"); }
  let route;
  try { route = selectReadonlyOriginalOwner(value.readonlyState, value.providerThreadId); } catch (error) { gap(error instanceof Error ? error.message : "owner-selection"); return projection(null, events, "unavailable"); }
  let opened;
  try { opened = openContainedRegular(route); } catch { gap("unsafe-rollout"); return projection(null, events, "unavailable"); }
  try {
    // Testable fence seam: it receives no descriptor, path, or source data.
    // Production callers omit it; it cannot launch a provider or mutate state.
    if (typeof value.afterOpen === "function") value.afterOpen();
    const scanned = await scanRollout(opened.fd, opened.identity, typeof value.clock === "function" ? value.clock : Date.now);
    const after = fstatSync(opened.fd);
    let pathIdentity;
    try { const reopened = openContainedRegular(route); pathIdentity = reopened.before; closeSync(reopened.fd); } catch { pathIdentity = null; }
    if (!attestReader(attestation, value?.expectedReaderDigest) || fileIdentity(after) !== opened.before || pathIdentity !== opened.before || (value.sourceFence !== undefined && value.postSourceFence !== undefined && value.sourceFence !== value.postSourceFence)) { gap("source-fence-changed"); return projection(null, events, "partial"); }
    if (scanned.error) { gap(scanned.error); return projection(null, events, "partial"); }
    const meta = {
      kind: "meta", version: "context-magnet.session-reader-projection/v1", normalizerVersion: READER_VERSION, projectorVersion: "context-magnet-session-projection/v1",
      router: { authority: "router-snapshot", providerThreadId: slot(value.providerThreadId), revision: slot(route.revision), ownerSlot: route.ownerSlot, readonly: true },
      rollout: { dialect: "codex-rollout", digest: { algorithm: "sha256", value: scanned.digest }, file: { identity: scanned.identity, kind: "rollout" }, nativeRolloutId: slot(scanned.nativeRolloutId) },
      identities: { nativeRolloutId: slot(scanned.nativeRolloutId), nativeSessionId: slot(scanned.nativeSessionId), relation: "distinct-native-identities-recorded" },
    };
    events.push({ seq: events.length + 1, kind: "source-fence", locator: safeLocator("rollout", scanned.identity), details: { records: scanned.records, bytes: scanned.bytes, digest: scanned.digest } });
    // A fully scanned, source-fenced rollout with no hook carrier is positive
    // evidence of zero native receipts.  An unbound carrier remains a gap:
    // it claimed the hook lane but did not supply an admissible receipt.
    if (scanned.receipts.length === 0) {
      if (scanned.unbound) return partialWithSingleGap(meta, events, "unbound-emission");
      return projection(meta, events, "ready");
    }
    if (scanned.receipts.length !== 1) { gap("duplicate-native-receipt"); return projection(meta, events, "partial"); }
    const candidate = scanned.receipts[0];
    const receipt = candidate.receipt;
    events.push({ seq: events.length + 1, kind: "persisted-rollout-receipt", locator: candidate.locator, details: {
      receiptVersion: receipt.version,
      nonceSlot: slot(receipt.nonce), nativeSessionIdSlot: slot(receipt.nativeSessionId), turnIdSlot: slot(receipt.turnId),
      storeInstanceSlot: slot(receipt.storeInstance), generationSlot: slot(receipt.generation),
      generationKeySlots: receipt.generationKeys.map(slot), recordKeySlots: receipt.recordKeys.map(slot), contributionKeySlots: receipt.contributionKeys.map(slot),
      emittedUtf8Bytes: receipt.emittedUtf8Bytes, emittedSha256: receipt.emittedSha256,
      executableIdentitySlot: slot(receipt.executableIdentity), sourceIdentitySlot: slot(receipt.sourceIdentity),
    } });
    return projection(meta, events, "ready");
  } finally {
    // Some Node stream implementations close an explicitly supplied fd while
    // unwinding a decoder error despite autoClose:false.  Treat that as an
    // already-closed descriptor, never as a successful read.
    try { closeSync(opened.fd); } catch (error) { if (error?.code !== "EBADF") throw error; }
  }
}

function partialWithSingleGap(meta, events, reason) {
  // Keep this one return path for the two zero-receipt states.  A consumer
  // must observe one source fence followed by exactly one diagnostic gap.
  events.push({ seq: events.length + 1, kind: "gap", locator: safeLocator("gap", `reader:${reason}`), details: { reason } });
  return projection(meta, events, "partial");
}

/** Reject projections that could have retained source bodies or local identity. */
export function assertSafeReaderProjection(value) {
  const walk = (current, key = "") => {
    if (forbidden.test(key) || /(?:body|content|raw)/iu.test(key)) throw new Error("unsafe-projection-field");
    if (typeof current === "string" && current.includes("context-magnet.hook-text/v1")) throw new Error("unsafe-projection-text");
    if (Array.isArray(current)) current.forEach((entry) => walk(entry));
    else if (object(current)) Object.entries(current).forEach(([childKey, child]) => walk(child, childKey));
  };
  walk(value); return value;
}
