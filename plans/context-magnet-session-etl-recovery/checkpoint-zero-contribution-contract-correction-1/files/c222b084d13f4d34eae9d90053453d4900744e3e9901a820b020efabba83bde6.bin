import { createHash } from "node:crypto";
import type { BbEventIdentitySnapshot } from "./bb-event-adapter.ts";
import { adaptCodexSessionProjection, type SafeReaderProjection } from "./codex-session-adapter.ts";
import type { WorkbenchDecisionReceipt, WorkbenchDecisionResult, WorkbenchInspection } from "./workbench-adapter.ts";

/**
 * A deliberately lossy projection of the agent-cli Context Magnet trace.
 * Contribution payloads and rendered context are intentionally never retained.
 */

export const MAX_TRACE_EVENTS = 48;
const MAX_TEXT = 240;
const MAX_LOG_LINES = 2_048;
const MAX_TIMESTAMP_SECONDS = 32_503_680_000; // 3000-01-01, keeps UI Date values valid.
const PROJECT_ROOT = "/home/ubuntu/phosphor/monorepo";
const SAFE_SESSION_ID = /^[A-Za-z0-9._:-]{1,200}$/u;
const SAFE_AUDIENCE = /^[A-Za-z0-9._:-]{1,80}$/u;

export type TraceState = "ready" | "inactive" | "partial" | "unavailable";

export type MagnetTraceEvent = Readonly<{
  /** Agent-cli's recorded event time, in epoch seconds. */
  at: number;
  event: "magnet:contributed" | "magnet:suppressed" | "magnet:contributor-failed" | "magnet:contributor-diagnostic" | "magnet:empty";
  contributorId: string;
  dedupKey?: string;
  sourceKind?: "File" | "AgentInbox" | "ReviewFinding" | "FrameOutput";
  sourcePath?: string;
  debugLabel?: string;
  reason?: "deduped" | "empty-body";
  message?: string;
  errorTag?: string;
  /** Optional future mapping report, accepted only when present in this trace row. */
  mappingState?: "exact" | "derived" | "partial" | "unmatched";
  rawEvidence?: "available" | "unavailable" | "withheld";
  rawLocator?: string;
}>;

export type InspectorResult = Readonly<{
  state: TraceState;
  detail: string;
  trace: MagnetTraceEvent[];
  consumption: Readonly<{
    state: "not-selected" | "awaiting-consumption" | "consumed" | "invalid";
    detail: string;
    contributionId?: string;
    selectedAt?: number;
    consumedAt?: number;
  }>;
  workbench: WorkbenchInspection;
}>;

export type StoredContextDescriptors = Readonly<{
  agentCli: Readonly<{ workspacePath: string; harness: "claude" | "codex"; sessionId: string }> | null;
  workbench: Readonly<{ path: string; audience: string; target?: Readonly<{ kind: "contribution"; id: number } | { kind: "turn"; id: string }> }> | null;
}>;

type RecordValue = Record<string, unknown>;

function record(value: unknown): RecordValue | null {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as RecordValue : null;
}

function text(value: unknown, maximum = MAX_TEXT): string | undefined {
  return typeof value === "string" && value.length > 0 && value.length <= maximum ? value : undefined;
}

function source(value: unknown): Pick<MagnetTraceEvent, "sourceKind" | "sourcePath"> {
  const item = record(value);
  const tag = text(item?._tag, 32);
  if (tag !== "File" && tag !== "AgentInbox" && tag !== "ReviewFinding" && tag !== "FrameOutput") return {};
  const path = tag === "File" ? text(item?.path, 512) : undefined;
  return { sourceKind: tag, ...(path === undefined ? {} : { sourcePath: path }) };
}

function mapping(value: unknown): Pick<MagnetTraceEvent, "mappingState" | "rawEvidence" | "rawLocator"> {
  const item = record(value);
  const state = text(item?.state, 16);
  const rawEvidence = text(item?.rawEvidence, 16);
  const candidateLocator = text(item?.rawLocator, 1_024);
  let rawLocator: string | undefined;
  if (candidateLocator !== undefined) {
    try {
      const parsed = new URL(candidateLocator);
      if (parsed.protocol === "https:") rawLocator = parsed.toString();
    } catch { /* Unrecognised locators stay absent. */ }
  }
  return {
    ...(state === "exact" || state === "derived" || state === "partial" || state === "unmatched" ? { mappingState: state } : {}),
    ...(rawEvidence === "available" || rawEvidence === "unavailable" || rawEvidence === "withheld" ? { rawEvidence } : {}),
    ...(rawLocator === undefined ? {} : { rawLocator }),
  };
}

function traceEvent(value: unknown): MagnetTraceEvent | null {
  const item = record(value);
  if (item === null || typeof item.ts !== "number" || !Number.isFinite(item.ts) || item.ts < 0 || item.ts > MAX_TIMESTAMP_SECONDS) return null;
  const event = text(item.event, 48);
  const contributorId = text(item.contributorId, 160);
  if (!event || !contributorId) return null;

  switch (event) {
    case "magnet:contributed":
      return { at: item.ts, event, contributorId, ...(text(item.dedupKey) === undefined ? {} : { dedupKey: text(item.dedupKey)! }), ...source(item.sourceRef), ...mapping(item.mapping), ...(text(item.debugLabel) === undefined ? {} : { debugLabel: text(item.debugLabel)! }) };
    case "magnet:suppressed": {
      const reason = text(item.reason, 32);
      if (reason !== "deduped" && reason !== "empty-body") return null;
      return { at: item.ts, event, contributorId, reason, ...(text(item.dedupKey) === undefined ? {} : { dedupKey: text(item.dedupKey)! }), ...source(item.sourceRef), ...mapping(item.mapping), ...(text(item.debugLabel) === undefined ? {} : { debugLabel: text(item.debugLabel)! }) };
    }
    case "magnet:contributor-failed":
    case "magnet:contributor-diagnostic":
      return { at: item.ts, event, contributorId, ...(text(item.message) === undefined ? {} : { message: text(item.message)! }), ...(text(item.errorTag, 96) === undefined ? {} : { errorTag: text(item.errorTag, 96)! }), ...mapping(item.mapping) };
    case "magnet:empty":
      return { at: item.ts, event, contributorId, ...mapping(item.mapping) };
    default:
      // Includes magnet:contribution, whose body/text must never enter the inspector.
      return null;
  }
}

/** Parses a bounded agent-cli JSONL carrier, retaining only recognised trace rows. */
export function traceFromAgentCliLog(source: string): MagnetTraceEvent[] {
  const latest: MagnetTraceEvent[] = [];
  for (const line of source.split(/\r?\n/u).slice(-MAX_LOG_LINES)) {
    if (line.length === 0 || line.length > 16 * 1024) continue;
    try {
      const parsed = traceEvent(JSON.parse(line) as unknown);
      if (parsed !== null) {
        latest.push(parsed);
        if (latest.length > MAX_TRACE_EVENTS) latest.shift();
      }
    } catch { /* A malformed log row does not invalidate the bounded projection. */ }
  }
  return latest;
}

function agentCliDescriptor(value: unknown): StoredContextDescriptors["agentCli"] {
  const item = record(value);
  const workspacePath = text(item?.workspacePath, 512);
  const sessionId = text(item?.sessionId, 200);
  const harness = text(item?.harness, 16);
  if (!workspacePath || !sessionId || !SAFE_SESSION_ID.test(sessionId) || (harness !== "claude" && harness !== "codex")) return null;
  if (!(workspacePath === PROJECT_ROOT || workspacePath.startsWith(`${PROJECT_ROOT}/`))) return null;
  return { workspacePath, sessionId, harness };
}

function workbenchDescriptor(value: unknown): StoredContextDescriptors["workbench"] {
  const item = record(value);
  if (item === null) return null;
  const path = text(item?.path, 512);
  const audience = text(item?.audience, 80);
  if (!path || !audience || !SAFE_AUDIENCE.test(audience)) return null;
  const target = record(item.target);
  if (target === null) return { path, audience };
  const kind = target.kind;
  const id = target.id;
  if (kind === "contribution" && typeof id === "number" && Number.isSafeInteger(id) && id > 0) return { path, audience, target: { kind, id } };
  if (kind === "turn" && typeof id === "string" && SAFE_SESSION_ID.test(id)) return { path, audience, target: { kind, id } };
  return null;
}

/**
 * Reads only explicit, feature-owned descriptors from stored BB event data.
 * It does not discover generic provider sessions or bridge an agent-cli session
 * to a Workbench audience.
 */
export function descriptorsFromStoredEvents(events: readonly unknown[]): StoredContextDescriptors {
  let agentCli: StoredContextDescriptors["agentCli"] = null;
  let workbench: StoredContextDescriptors["workbench"] = null;
  for (const event of events.slice(0, 64)) {
    const data = record(record(event)?.data);
    if (data === null) continue;
    if (agentCli === null) agentCli = agentCliDescriptor(data.contextMagnetAgentCli);
    if (workbench === null) workbench = workbenchDescriptor(data.contextMagnetWorkbench);
    if (agentCli !== null && workbench !== null) break;
  }
  return { agentCli, workbench };
}

/**
 * The host trace carrier is deliberately separate from agent-cli's legacy log
 * projection above. It models only explicit host links: callers must not fill
 * in an operation, trigger, receipt, or placement from timestamps or text.
 */
export const TRACE_CARRIER_VERSION = "context-magnet.trace-carrier/v1";

export type TraceOperationKey = Readonly<{
  threadId: string;
  operationId: string;
  eventSeq: number;
  turnId?: string;
}>;

export type TraceContributionKey = Readonly<{ threadId: string; id: string }>;

export type TracePlacement =
  | Readonly<{ kind: "exact"; target: TraceOperationKey; renderedAnchor: TraceOperationKey }>
  | Readonly<{
      kind: "nearest-rendered";
      target: TraceOperationKey;
      renderedAnchor: TraceOperationKey;
      direction: "before" | "after" | "containing-turn";
    }>
  | Readonly<{
      kind: "unmatched";
      target: TraceOperationKey | null;
      reason: "target-not-retained" | "target-not-renderable" | "unknown";
    }>;

export type TraceTrigger = Readonly<{
  factKey: TraceContributionKey | null;
  renderState: "rendered" | "unrendered" | "withheld" | "unknown";
  renderedAnchor?: TraceOperationKey;
  locator: "host-fact" | "host-policy" | "unknown";
}>;

export type TraceInclusionReason = Readonly<{
  category: "relevant-tool-result" | "relevant-thread-fact" | "policy-required" | "explicit-user-context" | "deduplication" | "other-safe";
  detail?: string;
}>;

export type TraceDeliveryOutcome =
  | Readonly<{ kind: "rejected"; rejection: "policy" | "validation" | "capacity" | "other-safe" }>
  | Readonly<{ kind: "delivered" }>
  | Readonly<{ kind: "deduplicated"; against: TraceContributionKey | null }>
  | Readonly<{ kind: "failed"; failure: "host" | "contributor" | "other-safe" }>
  | Readonly<{ kind: "unavailable"; unavailable: "not-retained" | "not-authorized" | "carrier" | "unknown" }>;

export type TraceConsumptionEvidence =
  | Readonly<{ state: "consumed"; kind: "model-owned-receipt" | "host-observed"; observedAt?: string }>
  | Readonly<{ state: "not-observed" }>
  | Readonly<{ state: "unknown" }>
  | Readonly<{ state: "unavailable"; reason: "not-retained" | "not-authorized" | "carrier" }>;

/** Host-approved, bounded JSON evidence. It is opaque to this projection. */
export type SafeTraceEvidence = null | boolean | number | string | readonly SafeTraceEvidence[] | Readonly<{ [key: string]: SafeTraceEvidence }>;

export type TraceEvidence = Readonly<{
  source: "context-magnet-host";
  sourceSchemaVersion: string;
  original: SafeTraceEvidence;
  unknownFields: Readonly<Record<string, SafeTraceEvidence>>;
  redactions: readonly Readonly<{
    path: string;
    reason: "authorization" | "privacy" | "retention" | "unsafe-body";
  }>[];
  /** A supplied locator remains evidence; it is never resolved or joined here. */
  rawLocators?: readonly string[];
}>;

/** Provider-admission facts are host observations, not delivery or consumption evidence. */
export type TraceAdmissionObservation =
  | Readonly<{ admissionObservationSequence: number; at: string; kind: "constructed" | "accepted" }>
  | Readonly<{ admissionObservationSequence: number; at: string; kind: "failed-settlement"; settlement: "bridge-unavailable" | "malformed-response" | "transport-not-accepted" }>;

export type TraceAdmissionAttempt = Readonly<{
  id: string;
  requestKind: "start" | "resume" | "fork";
  providerKind: string;
  instructionMode: "append" | "replace" | "none" | "unknown";
  selectedToolSummary: "one-or-more" | "none" | "unknown";
}>;

export type TraceAdmissionGap = Readonly<{
  kind: "authorization" | "bridge" | "instrumentation" | "retention" | "unknown";
  scope: "declaration" | "constructed" | "accepted" | "association" | "consumption";
  reason: string;
}>;

export type TraceProviderAdmission = Readonly<{
  version: "context-magnet.provider-admission/v1";
  contributionKey: TraceContributionKey;
  admissionKey: TraceContributionKey;
  declaration: "declared" | "unavailable";
  attempt: TraceAdmissionAttempt;
  observations: readonly TraceAdmissionObservation[];
  gaps: readonly TraceAdmissionGap[];
}>;

export type TraceAdmissionRetentionGap = Readonly<{ kind: "retention"; scope: "admissions"; reason: string }>;

export type TraceContribution = Readonly<{
  contributionKey: TraceContributionKey;
  placement: TracePlacement;
  trigger: TraceTrigger;
  inclusionReason: TraceInclusionReason;
  outcome: TraceDeliveryOutcome;
  consumption: TraceConsumptionEvidence;
  evidence: TraceEvidence;
  /** Present only when the host retained provider-admission observations. */
  admissions?: readonly TraceProviderAdmission[];
  admissionGaps?: readonly TraceAdmissionRetentionGap[];
}>;

export type TraceGap = Readonly<{
  kind: "retention" | "authorization" | "carrier" | "redaction" | "unknown";
  scope: "contributions" | "operations" | "trigger-provenance" | "consumption";
  afterEventSeq?: number;
  beforeEventSeq?: number;
  reason: string;
  /** Additive metadata remains opaque and available to a later adapter. */
  unknownFields?: Readonly<Record<string, SafeTraceEvidence>>;
}>;

export type TracePage = Readonly<{
  cursor: string | null;
  nextCursor: string | null;
  retainedFrom: Readonly<{
    contributionEventSeq: number | null;
    operationEventSeq: number | null;
    state: "known" | "unknown" | "unavailable";
  }>;
  completeness: "complete" | "partial" | "unavailable";
  gaps: readonly TraceGap[];
  contributions: readonly TraceContribution[];
}>;

export type TranscriptRole = "user" | "assistant" | "system" | "tool" | "unknown";

/** Host-supplied transcript identity; never reconstructed from content or time. */
export type TranscriptSpineMessage = Readonly<{
  threadId: string;
  id: string;
  role: TranscriptRole;
  /** Deliberately metadata-only: transcript rendering continues to be host-owned. */
  sequence: number;
}>;

/** A block's place in the native transcript is supplied by the carrier. */
export type WorkingBlockPlacement =
  | Readonly<{ kind: "before" | "after" | "within"; anchor: TranscriptSpineMessage }>
  | Readonly<{ kind: "unmatched"; reason: "anchor-not-retained" | "unknown" }>
  | Readonly<{ kind: "unavailable"; reason: "not-retained" | "not-authorized" | "carrier" | "unknown" }>;

export type WorkingOperation = Readonly<{
  key: TraceOperationKey;
  rendered: boolean;
  kind: string;
  /** `known-empty` is evidence; all other values explicitly say it is not. */
  contributionEvidence: "known-empty" | "records-retained" | "missing" | "unavailable" | "unknown";
  unknownFields?: Readonly<Record<string, SafeTraceEvidence>>;
}>;

export type WorkingBlock = Readonly<{
  id: string;
  placement: WorkingBlockPlacement;
  operations: readonly WorkingOperation[];
  unknownFields?: Readonly<Record<string, SafeTraceEvidence>>;
}>;

export type TraceCarrierProjectionInput = Readonly<{
  version: typeof TRACE_CARRIER_VERSION;
  threadId: string;
  snapshot: Readonly<{
    id: string;
    capturedAt: string;
    operationSeqHighWatermark: number;
    admissionAttemptSeqHighWatermark?: number;
    admissionObservationSeqHighWatermark?: number;
    admissionRetentionHighWatermark?: number;
  }>;
  transcript: readonly TranscriptSpineMessage[];
  workingBlocks: readonly WorkingBlock[];
  pages: readonly TracePage[];
  /** Unknown top-level carrier fields are additive evidence, never display semantics. */
  unknownFields?: Readonly<Record<string, SafeTraceEvidence>>;
}>;

export type ProjectedOperation = Readonly<{
  operation: WorkingOperation;
  contributions: readonly TraceContribution[];
}>;

export type ProjectedWorkingBlock = Readonly<{
  id: string;
  /** Retained verbatim so a renderer never guesses transcript nesting. */
  placement: WorkingBlockPlacement;
  operations: readonly ProjectedOperation[];
  unknownFields?: Readonly<Record<string, SafeTraceEvidence>>;
}>;

export type UnmatchedTraceContribution = Readonly<{
  contribution: TraceContribution;
  /** Source metadata explains this status; projection never chooses a replacement anchor. */
  state: "carrier-unmatched" | "anchor-not-projected";
}>;

export type TraceProjection = Readonly<{
  version: typeof TRACE_CARRIER_VERSION;
  threadId: string;
  snapshot: TraceCarrierProjectionInput["snapshot"];
  transcript: readonly TranscriptSpineMessage[];
  workingBlocks: readonly ProjectedWorkingBlock[];
  unmatched: readonly UnmatchedTraceContribution[];
  pages: readonly TracePage[];
  /** Flattened with page identity retained so pagination loss cannot disappear. */
  gaps: readonly Readonly<{ pageCursor: string | null; gap: TraceGap }>[];
  unknownFields?: Readonly<Record<string, SafeTraceEvidence>>;
}>;

export class TraceProjectionError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "TraceProjectionError";
  }
}

const UNSAFE_PROVIDER_EVIDENCE_KEYS = new Set([
  "body", "requestbody", "providerrequest", "prompt", "messages", "contextblocks", "toolarguments",
  "embeddings", "attachments", "rawproviderevent", "rawprovidereventjson",
]);

function operationIdentity(key: TraceOperationKey): string {
  return `${key.threadId}\u0000${key.operationId}\u0000${key.eventSeq}`;
}

function contributionIdentity(key: TraceContributionKey): string {
  return `${key.threadId}\u0000${key.id}`;
}

function sameOperation(left: TraceOperationKey, right: TraceOperationKey): boolean {
  return left.threadId === right.threadId
    && left.operationId === right.operationId
    && left.eventSeq === right.eventSeq
    && left.turnId === right.turnId;
}

function sameTranscriptMessage(left: TranscriptSpineMessage, right: TranscriptSpineMessage): boolean {
  return left.threadId === right.threadId
    && left.id === right.id
    && left.role === right.role
    && left.sequence === right.sequence;
}

function assertOperationThread(key: TraceOperationKey, threadId: string, description: string): void {
  if (key.threadId !== threadId) throw new TraceProjectionError(`${description} belongs to another thread.`);
}

function contributionOrder(left: TraceContribution, right: TraceContribution): number {
  const leftSeq = left.placement.target?.eventSeq ?? Number.POSITIVE_INFINITY;
  const rightSeq = right.placement.target?.eventSeq ?? Number.POSITIVE_INFINITY;
  return leftSeq - rightSeq || left.contributionKey.id.localeCompare(right.contributionKey.id);
}

function assertSafeEvidence(value: SafeTraceEvidence, path = "evidence"): void {
  if (Array.isArray(value)) {
    value.forEach((item, index) => assertSafeEvidence(item, `${path}[${index}]`));
    return;
  }
  if (value === null || typeof value !== "object") return;
  for (const [key, nested] of Object.entries(value)) {
    if (UNSAFE_PROVIDER_EVIDENCE_KEYS.has(key.replace(/[^a-z0-9]/giu, "").toLowerCase())) {
      throw new TraceProjectionError(`Provider request evidence is not accepted at ${path}.${key}.`);
    }
    assertSafeEvidence(nested, `${path}.${key}`);
  }
}

function assertContributionIsSafe(contribution: TraceContribution): void {
  assertSafeEvidence(contribution.evidence.original, `contribution ${contribution.contributionKey.id}.original`);
  assertSafeEvidence(contribution.evidence.unknownFields, `contribution ${contribution.contributionKey.id}.unknownFields`);
}

function renderedOperation(operations: ReadonlyMap<string, ProjectedOperation>, key: TraceOperationKey, description: string): ProjectedOperation {
  const operation = operations.get(operationIdentity(key));
  if (operation === undefined || !operation.operation.rendered) {
    throw new TraceProjectionError(`${description} must resolve to a rendered working-block operation.`);
  }
  return operation;
}

function assertTriggerIsValid(trigger: TraceTrigger, operations: ReadonlyMap<string, ProjectedOperation>, threadId: string): void {
  if (trigger.factKey !== null && trigger.factKey.threadId !== threadId) {
    throw new TraceProjectionError("Trigger fact belongs to another thread.");
  }
  if (trigger.renderedAnchor !== undefined) {
    assertOperationThread(trigger.renderedAnchor, threadId, "Trigger rendered anchor");
    renderedOperation(operations, trigger.renderedAnchor, "Trigger rendered anchor");
  }
  if (trigger.renderState === "rendered" && trigger.renderedAnchor === undefined) {
    throw new TraceProjectionError("A rendered trigger must supply its rendered anchor.");
  }
}

function assertGapIsSafe(gap: TraceGap): void {
  if (gap.unknownFields !== undefined) assertSafeEvidence(gap.unknownFields, "gap.unknownFields");
}

function transcriptMessages(input: TraceCarrierProjectionInput): ReadonlyMap<string, TranscriptSpineMessage> {
  const messages = new Map<string, TranscriptSpineMessage>();
  for (const message of input.transcript) {
    if (message.threadId !== input.threadId) throw new TraceProjectionError("Transcript message belongs to another thread.");
    if (messages.has(message.id)) throw new TraceProjectionError("Transcript message IDs must be unique.");
    messages.set(message.id, message);
  }
  return messages;
}

function assertBlockPlacementIsValid(
  placement: WorkingBlockPlacement,
  messages: ReadonlyMap<string, TranscriptSpineMessage>,
  threadId: string,
): void {
  if (placement.kind === "unmatched" || placement.kind === "unavailable") return;
  const { anchor } = placement;
  if (anchor.threadId !== threadId) throw new TraceProjectionError("Working-block transcript anchor belongs to another thread.");
  const retained = messages.get(anchor.id);
  if (retained === undefined) throw new TraceProjectionError("Working-block transcript anchor is not retained.");
  if (!sameTranscriptMessage(anchor, retained)) throw new TraceProjectionError("Working-block transcript anchor identity does not match the retained message.");
  if (placement.kind === "within" && anchor.role !== "assistant") {
    throw new TraceProjectionError("A working block can be within only a retained assistant message.");
  }
}

/**
 * Projects a host-supplied trace into a deterministic tree without changing its
 * evidence. The transcript stays the primary spine; all work stays in blocks.
 */
export function projectTraceCarrier(input: TraceCarrierProjectionInput): TraceProjection {
  if (input.version !== TRACE_CARRIER_VERSION) throw new TraceProjectionError("Unsupported Context Magnet trace carrier version.");
  if (input.unknownFields !== undefined) assertSafeEvidence(input.unknownFields, "carrier.unknownFields");
  const messages = transcriptMessages(input);
  const blockIds = new Set<string>();
  for (const block of input.workingBlocks) {
    if (blockIds.has(block.id)) throw new TraceProjectionError("Working-block IDs must be unique.");
    blockIds.add(block.id);
    assertBlockPlacementIsValid(block.placement, messages, input.threadId);
    if (block.unknownFields !== undefined) assertSafeEvidence(block.unknownFields, "working-block.unknownFields");
  }

  const operations = new Map<string, ProjectedOperation>();
  const projectedBlocks = input.workingBlocks
    .map((block) => ({
      id: block.id,
      placement: block.placement,
      unknownFields: block.unknownFields,
      operations: [...block.operations]
        .sort((left, right) => left.key.eventSeq - right.key.eventSeq || left.key.operationId.localeCompare(right.key.operationId))
        .map((operation) => {
          if (operation.key.threadId !== input.threadId) throw new TraceProjectionError("Working-block operation belongs to another thread.");
          if (operation.unknownFields !== undefined) assertSafeEvidence(operation.unknownFields, "operation.unknownFields");
          const projected: ProjectedOperation = { operation, contributions: [] };
          const identity = operationIdentity(operation.key);
          if (operations.has(identity)) throw new TraceProjectionError("Working-block operation keys must be unique.");
          operations.set(identity, projected);
          return projected;
        }),
    }));

  for (const page of input.pages) for (const gap of page.gaps) assertGapIsSafe(gap);

  const unmatched: UnmatchedTraceContribution[] = [];
  const seenContributionKeys = new Set<string>();
  const contributions = input.pages.flatMap((page) => page.contributions).sort(contributionOrder);
  for (const contribution of contributions) {
    if (contribution.contributionKey.threadId !== input.threadId) throw new TraceProjectionError("Contribution belongs to another thread.");
    const contributionKey = contributionIdentity(contribution.contributionKey);
    if (seenContributionKeys.has(contributionKey)) throw new TraceProjectionError("Contribution keys must be unique across the snapshot.");
    seenContributionKeys.add(contributionKey);
    assertContributionIsSafe(contribution);
    assertTriggerIsValid(contribution.trigger, operations, input.threadId);
    if (contribution.placement.kind === "unmatched") {
      if (contribution.placement.target !== null) assertOperationThread(contribution.placement.target, input.threadId, "Unmatched contribution target");
      unmatched.push({ contribution, state: "carrier-unmatched" });
      continue;
    }
    assertOperationThread(contribution.placement.target, input.threadId, "Contribution target");
    assertOperationThread(contribution.placement.renderedAnchor, input.threadId, "Contribution rendered anchor");
    if (contribution.placement.kind === "exact" && !sameOperation(contribution.placement.target, contribution.placement.renderedAnchor)) {
      throw new TraceProjectionError("An exact contribution must use an identical target and rendered anchor.");
    }
    const anchor = renderedOperation(operations, contribution.placement.renderedAnchor, "Contribution rendered anchor");
    // The supplied anchor is the only allowed relation. This intentionally does
    // not compare timestamps, provider IDs, session IDs, transcript text, or logs.
    (anchor.contributions as TraceContribution[]).push(contribution);
  }

  for (const block of projectedBlocks) {
    for (const operation of block.operations) {
      (operation.contributions as TraceContribution[]).sort(contributionOrder);
    }
  }

  return {
    version: input.version,
    threadId: input.threadId,
    snapshot: input.snapshot,
    transcript: [...input.transcript],
    workingBlocks: projectedBlocks,
    unmatched,
    pages: input.pages,
    gaps: input.pages.flatMap((page) => page.gaps.map((gap) => ({ pageCursor: page.cursor, gap }))),
    ...(input.unknownFields === undefined ? {} : { unknownFields: input.unknownFields }),
  };
}

// Session ETL is deliberately separate from the legacy host-trace projection
// above.  Its inputs are the three normalized adapter outputs; it never sees a
// provider record or decodes a hook frame.
export const SESSION_ETL_VERSION = "context-magnet.session-etl/v1";
export const SESSION_ETL_PROJECTOR_VERSION = "context-magnet.session-etl-projector/v1";
const SESSION_ETL_MAX_EVENTS = 16;
const SESSION_ETL_MAX_BODY_BYTES = 64 * 1024;
const SESSION_ETL_SLOT = /^sha256:[a-f0-9]{64}$/u;
const SESSION_ETL_SAFE_REF = /^(?:[a-z][a-z0-9-]{0,31}):[A-Za-z0-9._:-]{1,512}$/u;

export type SessionEtlLocator = Readonly<{ source: "bb" | "workbench" | "rollout"; ref: string; redacted: true }>;
export type SessionEtlReceipt = WorkbenchDecisionReceipt;
export type SessionEtlEventKind = "source-lifecycle" | "source-fence" | "workbench-observed" | "workbench-selection" | "workbench-emission" | "workbench-no-contribution" | "persisted-rollout-receipt" | "context-admission" | "gap";
export type SessionEtlAssociation = Readonly<{ keys: Readonly<Record<string, string | readonly string[] | null>>; derivationVersion: string; supportingLocators: readonly SessionEtlLocator[] }>;
export type SessionEtlEvent = Readonly<{ seq: number; kind: SessionEtlEventKind; locator: SessionEtlLocator; details: Readonly<Record<string, unknown>>; associations: readonly SessionEtlAssociation[] }>;
export type SessionEtlMeta = Readonly<{
  kind: "meta";
  version: typeof SESSION_ETL_VERSION;
  normalizerVersion: string;
  projectorVersion: string;
  bb: Readonly<{ providerThreadId: string; eventHighWatermark: number; terminalCheckpoint: Readonly<{ state: "succeeded" | "failed" | "interrupted" | "unknown"; scopeTurnSlot?: string; providerCheckpointSlot?: string }> }>;
  router: Readonly<{ revision: string; ownerSlot: string; readonly: true }>;
  rollout: Readonly<{ dialect: "codex-rollout" | "unsupported" | "unknown"; digest: Readonly<{ algorithm: "sha256"; value: string }>; file: Readonly<{ identity: string; kind: "rollout" }>; nativeRolloutId?: string }>;
  identities: Readonly<{ bbProviderThreadId: string; nativeRolloutId?: string; nativeSessionId?: string; relation: "distinct-identities-recorded" }>;
  workbench: Readonly<{ storeInstance?: string; generation?: string; query: Readonly<{ completeness: "complete" | "partial" | "unavailable"; sourceBounds: string; truncation: string }> }>;
}>;
export type SessionEtlProjection = Readonly<{ meta: SessionEtlMeta; events: readonly SessionEtlEvent[]; projection: readonly Readonly<{ seq: number; kind: SessionEtlEventKind; locator: SessionEtlLocator }>[]; omittedEventCount: number }>;
export type SessionEtlProjectionInput = Readonly<{
  bb: BbEventIdentitySnapshot;
  native: Readonly<SafeReaderProjection>;
  workbench: WorkbenchDecisionResult;
  source: Readonly<{
    /** Explicit RPC freshness/authorization facts, never native authority. */
    authorized: boolean;
    sourceFenceStable: boolean;
    /** Receipt-only Workbench source fence; absent for an explicit zero decision. */
    workbenchStoreInstanceSlot?: string;
    workbenchGenerationSlot?: string;
    sourceBounds: string;
    truncation: string;
  }>;
}>;

export class SessionEtlProjectionError extends Error {}

type NativeEvent = Readonly<{ seq: number; kind: string; locator: SessionEtlLocator; details?: Record<string, unknown> }>;

function sessionEtlSlot(value: string): string { return `sha256:${createHash("sha256").update(value, "utf8").digest("hex")}`; }
function sessionEtlObject(value: unknown): Record<string, unknown> | null { return value !== null && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : null; }
function sessionEtlText(value: unknown, maximum = 512): value is string { return typeof value === "string" && value.length > 0 && value.length <= maximum; }
function sessionEtlLocator(value: unknown): value is SessionEtlLocator {
  const row = sessionEtlObject(value);
  return row !== null && (row.source === "bb" || row.source === "workbench" || row.source === "rollout") && row.redacted === true && sessionEtlText(row.ref) && SESSION_ETL_SAFE_REF.test(row.ref);
}
function sessionEtlSafe(value: unknown, key = ""): boolean {
  if (/(?:path|home|account|message|reasoning|tool|credential|raw|prompt|hooktext)/iu.test(key)) return false;
  if (typeof value === "string") return !value.includes("context-magnet.hook-text/v1") && value.length <= SESSION_ETL_MAX_BODY_BYTES;
  if (Array.isArray(value)) return value.length <= 16 && value.every((entry) => sessionEtlSafe(entry));
  const row = sessionEtlObject(value);
  return row === null || Object.entries(row).every(([child, entry]) => sessionEtlSafe(entry, child));
}
function sessionEtlReceipt(value: unknown): value is SessionEtlReceipt {
  const row = sessionEtlObject(value);
  const keys = ["receiptVersion", "nonceSlot", "nativeSessionIdSlot", "turnIdSlot", "storeInstanceSlot", "generationSlot", "generationKeySlots", "recordKeySlots", "contributionKeySlots", "emittedUtf8Bytes", "emittedSha256", "executableIdentitySlot", "sourceIdentitySlot"];
  if (row === null || Object.keys(row).length !== keys.length || !keys.every((key) => Object.hasOwn(row, key)) || row.receiptVersion !== "context-magnet.receipt/v1" || ![row.nonceSlot, row.nativeSessionIdSlot, row.turnIdSlot, row.storeInstanceSlot, row.generationSlot, row.executableIdentitySlot, row.sourceIdentitySlot].every((slot) => typeof slot === "string" && SESSION_ETL_SLOT.test(slot)) || ![row.generationKeySlots, row.recordKeySlots, row.contributionKeySlots].every((slots) => Array.isArray(slots) && slots.length > 0 && slots.length <= 16 && slots.every((slot) => typeof slot === "string" && SESSION_ETL_SLOT.test(slot))) || !Number.isSafeInteger(row.emittedUtf8Bytes) || (row.emittedUtf8Bytes as number) < 0 || (row.emittedUtf8Bytes as number) > SESSION_ETL_MAX_BODY_BYTES || typeof row.emittedSha256 !== "string" || !/^[a-f0-9]{64}$/u.test(row.emittedSha256)) return false;
  return true;
}
function sessionEtlSameReceipt(left: SessionEtlReceipt, right: SessionEtlReceipt): boolean { return JSON.stringify(left) === JSON.stringify(right); }
function sessionEtlRef(source: SessionEtlLocator["source"], ref: string): SessionEtlLocator { return Object.freeze({ source, ref, redacted: true }); }
function sessionEtlAssociation(receipt: SessionEtlReceipt, locators: readonly SessionEtlLocator[]): SessionEtlAssociation {
  return Object.freeze({ keys: Object.freeze({ nonceSlot: receipt.nonceSlot, nativeSessionIdSlot: receipt.nativeSessionIdSlot, turnIdSlot: receipt.turnIdSlot, storeInstanceSlot: receipt.storeInstanceSlot, generationSlot: receipt.generationSlot, generationKeySlots: receipt.generationKeySlots, recordKeySlots: receipt.recordKeySlots, contributionKeySlots: receipt.contributionKeySlots, executableIdentitySlot: receipt.executableIdentitySlot, sourceIdentitySlot: receipt.sourceIdentitySlot }), derivationVersion: SESSION_ETL_PROJECTOR_VERSION, supportingLocators: Object.freeze([...locators]) });
}
function sessionEtlNativeMeta(value: unknown): Readonly<{
  normalizerVersion: string; routerRevision: string; routerOwnerSlot: string; routerProviderThreadSlot: string;
  dialect: "codex-rollout" | "unsupported" | "unknown"; rolloutDigest: string; rolloutFileIdentity: string; nativeRolloutId?: string; nativeSessionId?: string;
}> | null {
  const meta = sessionEtlObject(value), router = sessionEtlObject(meta?.router), rollout = sessionEtlObject(meta?.rollout), digest = sessionEtlObject(rollout?.digest), file = sessionEtlObject(rollout?.file), identities = sessionEtlObject(meta?.identities);
  if (meta === null || meta.kind !== "meta" || meta.version !== "context-magnet.session-reader-projection/v1" || !sessionEtlText(meta.normalizerVersion) || router === null || router.authority !== "router-snapshot" || router.readonly !== true || !SESSION_ETL_SLOT.test(router.providerThreadId as string) || !SESSION_ETL_SLOT.test(router.revision as string) || !SESSION_ETL_SLOT.test(router.ownerSlot as string) || rollout === null || (rollout.dialect !== "codex-rollout" && rollout.dialect !== "unsupported" && rollout.dialect !== "unknown") || digest?.algorithm !== "sha256" || typeof digest.value !== "string" || !/^[a-f0-9]{64}$/u.test(digest.value) || file?.kind !== "rollout" || !SESSION_ETL_SLOT.test(file.identity as string) || identities === null || identities.relation !== "distinct-native-identities-recorded" || (identities.nativeRolloutId !== undefined && !SESSION_ETL_SLOT.test(identities.nativeRolloutId as string)) || (identities.nativeSessionId !== undefined && !SESSION_ETL_SLOT.test(identities.nativeSessionId as string)) || (rollout.nativeRolloutId !== undefined && rollout.nativeRolloutId !== identities.nativeRolloutId)) return null;
  return Object.freeze({ normalizerVersion: meta.normalizerVersion as string, routerRevision: router.revision as string, routerOwnerSlot: router.ownerSlot as string, routerProviderThreadSlot: router.providerThreadId as string, dialect: rollout.dialect, rolloutDigest: digest.value, rolloutFileIdentity: file.identity as string, ...(identities.nativeRolloutId === undefined ? {} : { nativeRolloutId: identities.nativeRolloutId as string }), ...(identities.nativeSessionId === undefined ? {} : { nativeSessionId: identities.nativeSessionId as string }) });
}

/**
 * Produce the canonical, versioned ETL trace. The only body that may leave
 * this boundary is `details.admittedContext`, copied from a ready Workbench
 * authority after one exact persisted native-receipt match.
 */
export function projectSessionEtl(input: SessionEtlProjectionInput): SessionEtlProjection {
  const source = input.source;
  const hasStoreFence = source.workbenchStoreInstanceSlot !== undefined;
  const hasGenerationFence = source.workbenchGenerationSlot !== undefined;
  if (typeof source.authorized !== "boolean" || typeof source.sourceFenceStable !== "boolean" || hasStoreFence !== hasGenerationFence || (hasStoreFence && (!SESSION_ETL_SLOT.test(source.workbenchStoreInstanceSlot!) || !SESSION_ETL_SLOT.test(source.workbenchGenerationSlot!))) || !sessionEtlText(source.sourceBounds) || !sessionEtlText(source.truncation)) throw new SessionEtlProjectionError("Invalid explicit RPC fence facts.");
  if (input.bb.providerId !== "codex" || !SESSION_ETL_SLOT.test(input.bb.providerThreadSlot) || !Number.isSafeInteger(input.bb.eventHighWatermark) || input.bb.eventHighWatermark < 1) throw new SessionEtlProjectionError("Invalid BB identity adapter output.");
  let nativeAdapter: ReturnType<typeof adaptCodexSessionProjection>;
  try { nativeAdapter = adaptCodexSessionProjection(input.native); } catch { throw new SessionEtlProjectionError("Invalid native-session adapter output."); }
  const parsedNativeMeta = sessionEtlNativeMeta(nativeAdapter.meta);
  if (parsedNativeMeta === null && nativeAdapter.state === "ready") throw new SessionEtlProjectionError("A ready native reader result requires validated meta.");
  // An unavailable/partial reader has no native authority to repeat.  Retain a
  // deterministic sentinel meta rather than accepting caller-supplied router
  // or rollout facts, and make it ineligible for admission below.
  const nativeMeta = parsedNativeMeta ?? Object.freeze({ normalizerVersion: "unavailable", routerRevision: sessionEtlSlot("unavailable"), routerOwnerSlot: sessionEtlSlot("unavailable"), routerProviderThreadSlot: sessionEtlSlot("unavailable"), dialect: "unknown" as const, rolloutDigest: createHash("sha256").update("unavailable", "utf8").digest("hex"), rolloutFileIdentity: sessionEtlSlot("unavailable"), nativeRolloutId: undefined as string | undefined, nativeSessionId: undefined as string | undefined });
  const checkpoint = input.bb.terminalCheckpoint;
  const meta: SessionEtlMeta = Object.freeze({ kind: "meta", version: SESSION_ETL_VERSION, normalizerVersion: nativeMeta.normalizerVersion, projectorVersion: SESSION_ETL_PROJECTOR_VERSION,
    bb: Object.freeze({ providerThreadId: input.bb.providerThreadSlot, eventHighWatermark: input.bb.eventHighWatermark, terminalCheckpoint: Object.freeze({ state: checkpoint.state, ...(checkpoint.turnSlot === undefined ? {} : { scopeTurnSlot: checkpoint.turnSlot }), ...(checkpoint.checkpointSlot === undefined ? {} : { providerCheckpointSlot: checkpoint.checkpointSlot }) }) }),
    router: Object.freeze({ revision: nativeMeta.routerRevision, ownerSlot: nativeMeta.routerOwnerSlot, readonly: true }),
    rollout: Object.freeze({ dialect: nativeMeta.dialect, digest: Object.freeze({ algorithm: "sha256", value: nativeMeta.rolloutDigest }), file: Object.freeze({ identity: nativeMeta.rolloutFileIdentity, kind: "rollout" }), ...(nativeMeta.nativeRolloutId === undefined ? {} : { nativeRolloutId: nativeMeta.nativeRolloutId }) }),
    identities: Object.freeze({ bbProviderThreadId: input.bb.providerThreadSlot, ...(nativeMeta.nativeRolloutId === undefined ? {} : { nativeRolloutId: nativeMeta.nativeRolloutId }), ...(nativeMeta.nativeSessionId === undefined ? {} : { nativeSessionId: nativeMeta.nativeSessionId }), relation: "distinct-identities-recorded" }),
    workbench: Object.freeze({ ...(source.workbenchStoreInstanceSlot === undefined ? {} : { storeInstance: source.workbenchStoreInstanceSlot }), ...(source.workbenchGenerationSlot === undefined ? {} : { generation: source.workbenchGenerationSlot }), query: Object.freeze({ completeness: input.workbench.state === "ready" || input.workbench.state === "no-contribution" ? "complete" : input.workbench.state === "unavailable" ? "unavailable" : "partial", sourceBounds: source.sourceBounds, truncation: source.truncation }) }),
  });
  const events: SessionEtlEvent[] = [];
  const append = (kind: SessionEtlEventKind, locator: SessionEtlLocator, details: Record<string, unknown> = {}, associations: readonly SessionEtlAssociation[] = []): void => {
    if (!sessionEtlLocator(locator) || !sessionEtlSafe(details) || associations.some((association) => !sessionEtlSafe(association))) throw new SessionEtlProjectionError("Unsafe canonical event.");
    events.push(Object.freeze({ seq: events.length + 1, kind, locator, details: Object.freeze({ ...details }), associations: Object.freeze([...associations]) }));
  };
  const bbLocator = sessionEtlRef("bb", `thread-event:${input.bb.eventHighWatermark}`);
  append("source-lifecycle", bbLocator, { state: checkpoint.state, ...(checkpoint.turnSlot === undefined ? {} : { scopeTurnSlot: checkpoint.turnSlot }), ...(checkpoint.checkpointSlot === undefined ? {} : { providerCheckpointSlot: checkpoint.checkpointSlot }) });
  append("source-fence", bbLocator, { eventHighWatermark: input.bb.eventHighWatermark, providerThreadSlot: input.bb.providerThreadSlot });
  if (!source.authorized) append("gap", bbLocator, { reason: "unauthorized" });
  if (!source.sourceFenceStable) append("gap", bbLocator, { reason: "source-fence-drift" });
  if (checkpoint.state !== "succeeded" || checkpoint.checkpointSlot === undefined) append("gap", bbLocator, { reason: checkpoint.state === "failed" ? "terminal-failed" : checkpoint.state === "interrupted" ? "terminal-interrupted" : "missing-provider-checkpoint" });
  const native: NativeEvent[] = [];
  let previousNativeSeq = 0;
  for (const event of nativeAdapter.events) {
    const row = sessionEtlObject(event);
    if (row === null || !Number.isSafeInteger(row.seq) || (row.seq as number) <= previousNativeSeq || typeof row.kind !== "string" || !sessionEtlLocator(row.locator) || !sessionEtlSafe(row)) throw new SessionEtlProjectionError("Unsafe or out-of-order native reader event.");
    if (row.kind !== "source-fence" && row.kind !== "persisted-rollout-receipt" && row.kind !== "gap") throw new SessionEtlProjectionError("Unknown context-bearing native event.");
    previousNativeSeq = row.seq as number;
    native.push({ seq: row.seq as number, kind: row.kind, locator: row.locator, ...(sessionEtlObject(row.details) === null ? {} : { details: row.details as Record<string, unknown> }) });
  }
  const nativeFences = native.filter((event) => event.kind === "source-fence");
  for (const event of nativeFences) append("source-fence", event.locator, event.details ?? {});
  for (const event of native.filter((event) => event.kind === "gap")) append("gap", event.locator, { reason: "native-reader-gap" });
  if (nativeAdapter.state === "partial" || nativeAdapter.state === "unavailable") append("gap", sessionEtlRef("rollout", `reader:${nativeAdapter.state}`), { reason: nativeAdapter.state === "partial" ? "partial" : "unavailable" });
  if (nativeMeta.dialect !== "codex-rollout") append("gap", sessionEtlRef("rollout", `dialect:${nativeMeta.dialect}`), { reason: nativeMeta.dialect === "unsupported" ? "unsupported" : "unavailable" });
  if (nativeAdapter.omittedEventCount > 0) append("gap", sessionEtlRef("rollout", "reader:omitted"), { reason: "compacted", omittedEventCount: nativeAdapter.omittedEventCount });
  const receipts = native.filter((event) => event.kind === "persisted-rollout-receipt");
  // The router reader emits ReceiptProjectionV1 directly in event.details;
  // nesting it under `receipt` would be a parallel, incompatible authority.
  const receiptEntries = receipts.map((event) => ({ event, receipt: event.details })).filter((entry): entry is { event: NativeEvent; receipt: SessionEtlReceipt } => sessionEtlReceipt(entry.receipt));
  if (receipts.length !== receiptEntries.length) append("gap", sessionEtlRef("rollout", "receipt:malformed"), { reason: "malformed-persisted-receipt" });
  if (receipts.length > 1) append("gap", sessionEtlRef("rollout", "receipt:duplicate"), { reason: "duplicate-persisted-receipt" });
  if (receiptEntries.length === 1) append("persisted-rollout-receipt", receiptEntries[0]!.event.locator, { receipt: receiptEntries[0]!.receipt }, [sessionEtlAssociation(receiptEntries[0]!.receipt, [receiptEntries[0]!.event.locator])]);
  const workbenchLocator = sessionEtlRef("workbench", `decision:${input.workbench.audienceSlot}`);
  append("workbench-observed", workbenchLocator, { state: input.workbench.state, reason: input.workbench.reason });
  const authority = input.workbench.authority;
  if (input.workbench.state === "no-contribution") append("workbench-no-contribution", workbenchLocator, { reason: input.workbench.reason });
  if (authority !== null && authority !== undefined) {
    if (!sessionEtlReceipt(authority.receipt) || Buffer.byteLength(authority.body, "utf8") !== authority.bodyUtf8Bytes || authority.bodyUtf8Bytes > SESSION_ETL_MAX_BODY_BYTES || createHash("sha256").update(authority.body, "utf8").digest("hex") !== authority.bodySha256 || authority.bodySha256 !== authority.receipt.emittedSha256 || authority.bodyUtf8Bytes !== authority.receipt.emittedUtf8Bytes) throw new SessionEtlProjectionError("Workbench authority is not self-consistent.");
    append("workbench-selection", workbenchLocator, { outcome: authority.outcome, reason: authority.reason }, [sessionEtlAssociation(authority.receipt, [workbenchLocator])]);
    append("workbench-emission", workbenchLocator, { emittedUtf8Bytes: authority.bodyUtf8Bytes, emittedSha256: authority.bodySha256 }, [sessionEtlAssociation(authority.receipt, [workbenchLocator])]);
  } else if (input.workbench.state === "gap" || input.workbench.state === "unavailable") append("gap", workbenchLocator, { reason: input.workbench.state === "unavailable" ? "unavailable" : "workbench-gap" });
  const providerIdentityMatches = parsedNativeMeta !== null && nativeMeta.routerProviderThreadSlot === input.bb.providerThreadSlot;
  if (!providerIdentityMatches) append("gap", bbLocator, { reason: "provider-thread-identity-mismatch" });
  const workbenchFenceMatches = authority !== null && authority !== undefined && source.workbenchStoreInstanceSlot !== undefined && source.workbenchGenerationSlot !== undefined && authority.receipt.storeInstanceSlot === source.workbenchStoreInstanceSlot && authority.receipt.generationSlot === source.workbenchGenerationSlot;
  if (authority !== null && authority !== undefined && !workbenchFenceMatches) append("gap", workbenchLocator, { reason: "store-or-generation-fence-mismatch" });
  const admissible = source.authorized && source.sourceFenceStable && providerIdentityMatches && workbenchFenceMatches && checkpoint.state === "succeeded" && checkpoint.checkpointSlot !== undefined && nativeAdapter.state === "ready" && nativeMeta.dialect === "codex-rollout" && receipts.length === 1 && receiptEntries.length === 1 && input.workbench.state === "ready" && authority !== null && authority !== undefined;
  if (input.workbench.state === "no-contribution" && receipts.length > 0) append("gap", workbenchLocator, { reason: "zero-contribution-conflict" });
  if (authority !== null && authority !== undefined && receipts.length === 0) append("gap", workbenchLocator, { reason: "unbound-emission" });
  const explicitZero = input.workbench.state === "no-contribution"
    && authority === null
    && source.workbenchStoreInstanceSlot === undefined
    && source.workbenchGenerationSlot === undefined
    && source.authorized
    && source.sourceFenceStable
    && providerIdentityMatches
    && checkpoint.state === "succeeded"
    && checkpoint.checkpointSlot !== undefined
    && nativeAdapter.state === "ready"
    && nativeMeta.dialect === "codex-rollout"
    && nativeFences.length > 0
    && native.filter((event) => event.kind === "gap").length === 0
    && nativeAdapter.omittedEventCount === 0
    && receipts.length === 0;
  if (input.workbench.state === "no-contribution" && !explicitZero && receipts.length === 0) append("gap", workbenchLocator, { reason: "incomplete-zero-contribution-evidence" });
  if (admissible) {
    const nativeReceipt = receiptEntries[0]!.receipt;
    const allMatch = sessionEtlSameReceipt(nativeReceipt, authority!.receipt) && nativeReceipt.storeInstanceSlot === source.workbenchStoreInstanceSlot && nativeReceipt.generationSlot === source.workbenchGenerationSlot && authority!.receipt.storeInstanceSlot === source.workbenchStoreInstanceSlot && authority!.receipt.generationSlot === source.workbenchGenerationSlot && nativeReceipt.turnIdSlot === checkpoint.checkpointSlot && input.workbench.nativeTurnSlot === checkpoint.checkpointSlot && (nativeMeta.nativeSessionId === undefined || nativeReceipt.nativeSessionIdSlot === nativeMeta.nativeSessionId);
    if (!allMatch) append("gap", workbenchLocator, { reason: "receipt-or-identity-mismatch" });
    else append("context-admission", workbenchLocator, { admittedContext: authority!.body, emittedUtf8Bytes: authority!.bodyUtf8Bytes, emittedSha256: authority!.bodySha256, persistedReceipt: true, semanticUse: "unobserved" }, [sessionEtlAssociation(authority!.receipt, [bbLocator, workbenchLocator, receiptEntries[0]!.event.locator])]);
  }
  const dropped = Math.max(0, events.length - (SESSION_ETL_MAX_EVENTS - 1));
  const retained = dropped === 0 ? events : [
    ...events.slice(0, SESSION_ETL_MAX_EVENTS - 1),
    Object.freeze({ seq: SESSION_ETL_MAX_EVENTS, kind: "gap" as const, locator: sessionEtlRef("rollout", "projection:event-bound"), details: Object.freeze({ reason: "event-bound", droppedEventCount: dropped, droppedKinds: Object.freeze(events.slice(SESSION_ETL_MAX_EVENTS - 1).map((event) => event.kind)) }), associations: Object.freeze([]) }),
  ];
  const projection = Object.freeze(retained.map(({ seq, kind, locator }) => Object.freeze({ seq, kind, locator })));
  return Object.freeze({ meta, events: Object.freeze(retained), projection, omittedEventCount: nativeAdapter.omittedEventCount + dropped });
}

/** A lossy consumer view: it retains citations, never context or receipt data. */
export function projectSessionEtlSummary(result: SessionEtlProjection): SessionEtlProjection["projection"] { return result.projection; }
