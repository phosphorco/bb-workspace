import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import test from "node:test";

const root = resolve(import.meta.dirname, "..");
const runner = resolve(root, "test/run-codex-session-access-probe.mts");
const fixture = JSON.parse(readFileSync(resolve(root, "test/fixtures/codex-session-access-probe.json"), "utf8"));

function validateRecord(value: unknown, ordinal: number): void {
  assert.ok(value && typeof value === "object" && !Array.isArray(value)); const record = value as Record<string, unknown>;
  assert.deepEqual(Object.keys(record).sort(), ["ordinal", "payload", "timestamp", "type"]);
  assert.equal(record.ordinal, ordinal); assert.equal(typeof record.timestamp, "string"); assert.ok(fixture.knownTypes.includes(record.type));
  assert.ok(record.payload && typeof record.payload === "object" && !Array.isArray(record.payload));
}

test("fixture exercises bounded known-dialect and adversarial rollout witnesses", () => {
  assert.equal(fixture.format, "context-magnet-session-rollout-probe-fixture/v1");
  for (const limit of Object.values(fixture.limits)) assert.ok(Number.isSafeInteger(limit) && (limit as number) > 0);
  fixture.witness.records.forEach(validateRecord);
  for (const adversary of ["oversized-bytes", "oversized-line", "malformed-utf8", "malformed-json", "unknown-dialect", "unsafe-symlink", "unsafe-fifo", "outside-owner", "identity-race", "identity-divergence", "archived", "disabled", "migration-claim", "zero-receipt"]) assert.ok(fixture.adversaries.includes(adversary));
  assert.equal(fixture.witness.receiptGap, "zero-exact-context-receipts");
});

test("live rollout probe is compact, redacted, and non-launching", () => {
  const execution = spawnSync(process.execPath, ["--experimental-strip-types", runner], { encoding: "utf8", timeout: 30_000 });
  assert.equal(execution.status, 0, execution.stderr); const receipt = JSON.parse(execution.stdout.trim()) as Record<string, unknown>;
  assert.equal(receipt.format, "context-magnet-session-rollout-probe/v1"); assert.equal(receipt.status, "passed"); assert.equal(receipt.protectedStateChanged, false); assert.equal(receipt.rawBodiesRetained, false);
  assert.equal(/CODEX_HOME|app-server|thread\/read|rollout_path|commandExecution|aggregatedOutput/i.test(execution.stdout), false);
});

test("runner excludes provider lifecycle and schema-runtime paths", () => {
  const source = readFileSync(runner, "utf8");
  for (const forbidden of ["app-server", "CODEX_HOME", "thread/read", "initialize", "thread/resume", "router.mjs", "codex-schema-receipt", "readFileSync(rollout)"]) assert.equal(source.includes(forbidden), false, `forbidden ${forbidden}`);
  for (const required of ["readonly:true,create:false", "O_NOFOLLOW", "thread%2Fidentity%2Cturn%2Fcompleted", "TextDecoder(\"utf-8\", { fatal: true })", "zero-exact-context-receipts"]) assert.ok(source.includes(required), `missing ${required}`);
});
