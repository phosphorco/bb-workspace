/** Original-rollout-only probe. It never launches a provider executable. */
import { createHash } from "node:crypto";
import { spawnSync } from "node:child_process";
import { constants, createReadStream, lstatSync, openSync, closeSync, fstatSync, readdirSync, readFileSync, readlinkSync, realpathSync } from "node:fs";
import { isAbsolute, relative, resolve } from "node:path";

const TARGET = "thr_c9xdr46tjs", DB = "/home/ubuntu/.codex-subscription-router/state.db";
const MAX_HTTP_BYTES = 262_144, MAX_ROLLOUT_BYTES = 8_388_608, MAX_LINE_BYTES = 4_194_304, MAX_RECORDS = 512, MAX_TURNS = 256, MAX_CONTEXT_RECORDS = 128, MAX_WALL_MS = 15_000;
const DIALECT = "codex-rollout-jsonl/0.153.2", KNOWN = new Set(["session_meta", "event_msg", "response_item", "world_state", "turn_context", "token_usage_record"]);
type Row = Record<string, unknown>;
type Identity = { updatedAt: number; status: string; highWatermark: number; providerThreadId: string; checkpointId: string | null };
type Route = { owner: string; home: string; rollout: string; revision: number; slot: string; routeDigest: string };
type Rollout = { digest: string; identity: string; size: number; records: number; turns: number; contextRecords: number; dialect: string; receiptGap: string };
type Snapshot = { identity: Identity; route: Route; processes: string; workspace: string; rollout?: Rollout };
const hash = (value: string | Buffer) => createHash("sha256").update(value).digest("hex");
const row = (value: unknown): Row | null => value !== null && typeof value === "object" && !Array.isArray(value) ? value as Row : null;
const only = (value: Row, allowed: readonly string[]) => Object.keys(value).every((key) => allowed.includes(key));
const text = (value: unknown, name: string, maximum = 512) => { if (typeof value !== "string" || value.length === 0 || value.length > maximum) throw new Error(`invalid ${name}`); return value; };
const statIdentity = (stat: ReturnType<typeof lstatSync>) => `${stat.dev}:${stat.ino}:${stat.size}:${stat.mtimeMs}:${stat.ctimeMs}`;

async function json(url: string): Promise<unknown> {
  const controller = new AbortController(), timer = setTimeout(() => controller.abort(), MAX_WALL_MS);
  try { const response = await fetch(url, { signal: controller.signal, headers: { accept: "application/json" } }); if (!response.ok) throw new Error(`BB REST ${response.status}`); const reader = response.body?.getReader(); if (!reader) throw new Error("missing REST body"); const chunks: Uint8Array[] = []; let bytes = 0; for (;;) { const part = await reader.read(); if (part.done) break; bytes += part.value.byteLength; if (bytes > MAX_HTTP_BYTES) { await reader.cancel(); throw new Error("REST body exceeds bound"); } chunks.push(part.value); } return JSON.parse(Buffer.concat(chunks).toString("utf8")); } finally { clearTimeout(timer); }
}
function identityEvent(value: unknown): Identity {
  const meta = row(value); if (!meta || !only(meta, ["id", "projectId", "environmentId", "providerId", "title", "titleFallback", "sectionId", "status", "parentThreadId", "sourceThreadId", "originKind", "originPluginId", "visibility", "archivedAt", "pinnedAt", "deletedAt", "lastReadAt", "latestAttentionAt", "createdAt", "updatedAt", "runtime", "activeBackgroundAgentCount", "canSpawnChild", "queuedMessageCount"]) || meta.id !== TARGET || meta.providerId !== "codex" || meta.archivedAt !== null || typeof meta.updatedAt !== "number" || typeof meta.status !== "string") throw new Error("invalid bodyless thread metadata"); return { updatedAt: meta.updatedAt, status: meta.status, highWatermark: -1, providerThreadId: "", checkpointId: null };
}
async function identity(): Promise<Identity> {
  const base = process.env.BB_SERVER_URL; if (!base) throw new Error("BB_SERVER_URL absent"); const result = identityEvent(await json(`${base}/api/v1/threads/${TARGET}`));
  const events = await json(`${base}/api/v1/threads/${TARGET}/events?types=thread%2Fidentity%2Cturn%2Fcompleted&order=asc&limit=100`); if (!Array.isArray(events) || events.length === 0 || events.length > 100) throw new Error("invalid event page"); let provider: string | null = null;
  for (const event of events) { const e = row(event), data = row(e?.data), scope = row(e?.scope); if (!e || !data || !scope || !only(e, ["id", "scope", "threadId", "seq", "createdAt", "type", "data"]) || e.threadId !== TARGET || !Number.isSafeInteger(e.seq)) throw new Error("invalid event envelope"); if (e.type === "thread/identity") { if (scope.kind !== "thread" || !only(data, ["providerThreadId"])) throw new Error("invalid identity event"); provider = provider === null ? text(data.providerThreadId, "providerThreadId") : provider; if (provider !== data.providerThreadId) throw new Error("divergent provider identity"); } else if (e.type === "turn/completed") { if (scope.kind !== "turn" || !only(data, ["providerThreadId", "status", "providerCheckpointId"]) || !["completed", "failed", "interrupted"].includes(data.status as string)) throw new Error("invalid terminal event"); const current = text(data.providerThreadId, "providerThreadId"); if (provider !== null && provider !== current) throw new Error("divergent provider identity"); provider = current; if (data.status === "completed" && data.providerCheckpointId !== undefined) result.checkpointId = text(data.providerCheckpointId, "providerCheckpointId"); } else throw new Error("unallowlisted event type"); result.highWatermark = Math.max(result.highWatermark, e.seq as number); }
  if (!provider) throw new Error("missing provider identity"); result.providerThreadId = provider; return result;
}
async function route(providerThreadId: string): Promise<Route> {
  const script = `import { Database } from "bun:sqlite"; import { createHash } from "node:crypto"; const db=new Database(${JSON.stringify(DB)},{readonly:true,create:false}); try { const rows=db.query(\`select r.account_id owner,a.codex_home home,r.rollout_path rollout,r.revision revision from routes r join accounts a on a.id=r.account_id where r.thread_id=? and a.enabled=1 and a.draining=0\`).all(process.argv[1]); const claim=db.query('select count(*) count from migration_claims where thread_id=?').get(process.argv[1]); if(rows.length!==1||Number(claim.count)!==0)throw new Error('ambiguous owner'); const x=rows[0],h=(v)=>createHash('sha256').update(String(v)).digest('hex'); console.log(JSON.stringify({owner:x.owner,home:x.home,rollout:x.rollout,revision:x.revision,slot:h(x.owner),routeDigest:h(JSON.stringify({owner:x.owner,revision:x.revision,rollout:h(x.rollout)}))})); } finally {db.close()}`;
  const child = spawnSync("bun", ["--eval", script, providerThreadId], { encoding: "buffer", maxBuffer: MAX_HTTP_BYTES }); if (child.status !== 0 || !child.stdout || child.stdout.length > MAX_HTTP_BYTES) throw new Error("readonly route projection failed"); const value = row(JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(child.stdout))); if (!value || !only(value, ["owner", "home", "rollout", "revision", "slot", "routeDigest"]) || !Number.isSafeInteger(value.revision)) throw new Error("invalid route projection"); return { owner: text(value.owner, "owner"), home: text(value.home, "home", 4096), rollout: text(value.rollout, "rollout", 4096), revision: value.revision as number, slot: text(value.slot, "slot"), routeDigest: text(value.routeDigest, "routeDigest") };
}
function processes(): string { const names: string[] = []; for (const entry of readdirSync("/proc", { withFileTypes: true })) if (/^\d+$/.test(entry.name)) try { const name = readFileSync(`/proc/${entry.name}/comm`, "utf8").trim(); if (name === "codex") names.push(entry.name); } catch {} return hash(names.sort().join("\n")); }
function workspace(): string { const result = spawnSync("git", ["-C", resolve(import.meta.dirname, "../../../.."), "status", "--porcelain=v1", "-uno"], { encoding: "buffer", maxBuffer: MAX_HTTP_BYTES }); if (result.status !== 0 || !result.stdout) throw new Error("workspace fingerprint failed"); return hash(result.stdout); }
async function snapshot(): Promise<Snapshot> { const i = await identity(), r = await route(i.providerThreadId); return { identity: i, route: r, processes: processes(), workspace: workspace() }; }
function safeRollout(route: Route): { fd: number; before: string } { const home = realpathSync(route.home), link = lstatSync(route.rollout); if (!link.isFile() || link.isSymbolicLink() || link.size > MAX_ROLLOUT_BYTES) throw new Error("unsafe rollout file"); const target = realpathSync(route.rollout), rel = relative(home, target); if (rel === "" || rel.startsWith("..") || isAbsolute(rel)) throw new Error("rollout escapes owner"); const fd = openSync(target, constants.O_RDONLY | constants.O_NOFOLLOW); const stat = fstatSync(fd); if (!stat.isFile() || stat.size > MAX_ROLLOUT_BYTES || statIdentity(link) !== statIdentity(stat)) { closeSync(fd); throw new Error("rollout identity raced"); } return { fd, before: statIdentity(stat) }; }
function rolloutIdentity(route: Route): string { const home = realpathSync(route.home), link = lstatSync(route.rollout); if (!link.isFile() || link.isSymbolicLink() || link.size > MAX_ROLLOUT_BYTES) throw new Error("unsafe post-stream rollout"); const target = realpathSync(route.rollout), rel = relative(home, target); if (rel === "" || rel.startsWith("..") || isAbsolute(rel)) throw new Error("post-stream rollout escapes owner"); return statIdentity(link); }
async function readRollout(route: Route): Promise<Rollout> {
  const file = safeRollout(route); const digest = createHash("sha256"), decoder = new TextDecoder("utf-8", { fatal: true }); let pending = "", bytes = 0, records = 0, turns = 0, contextRecords = 0, meta = false, receipt = 0;
  const consume = (line: string) => { if (Buffer.byteLength(line) > MAX_LINE_BYTES) throw new Error("rollout line exceeds bound"); if (!line) throw new Error("truncated rollout line"); const value = row(JSON.parse(line)); if (!value || !only(value, ["ordinal", "timestamp", "type", "payload"]) || !Number.isSafeInteger(value.ordinal) || value.ordinal !== records || typeof value.timestamp !== "string" || !KNOWN.has(value.type as string)) throw new Error("unknown or malformed rollout dialect"); const payload = row(value.payload); if (!payload) throw new Error("invalid rollout payload"); if (value.type === "session_meta") { if (meta || typeof payload.cli_version !== "string" || !payload.cli_version.includes("0.153.2")) throw new Error("unsupported rollout version"); meta = true; } if (value.type === "event_msg") { turns++; if (turns > MAX_TURNS) throw new Error("turn bound exceeded"); } if (value.type === "turn_context") { contextRecords++; if (contextRecords > MAX_CONTEXT_RECORDS) throw new Error("context bound exceeded"); } if (value.type === "response_item" && payload.type === "context_magnet_receipt" && payload.receiptVersion === "context-magnet-receipt/v1") receipt++; records++; if (records > MAX_RECORDS) throw new Error("record bound exceeded"); };
  try { for await (const chunk of createReadStream("/dev/null", { fd: file.fd, autoClose: false })) { const raw = Buffer.from(chunk); bytes += raw.length; if (bytes > MAX_ROLLOUT_BYTES) throw new Error("rollout byte bound exceeded"); digest.update(raw); pending += decoder.decode(raw, { stream: true }); for (;;) { const index = pending.indexOf("\n"); if (index < 0) break; consume(pending.slice(0, index)); pending = pending.slice(index + 1); } } pending += decoder.decode(); if (pending !== "") consume(pending); if (!meta || records === 0) throw new Error("incomplete rollout"); const after = fstatSync(file.fd); if (file.before !== statIdentity(after)) throw new Error("rollout raced during stream"); return { digest: digest.digest("hex"), identity: file.before, size: bytes, records, turns, contextRecords, dialect: DIALECT, receiptGap: receipt === 0 ? "zero-exact-context-receipts" : "receipt-present" }; } finally { closeSync(file.fd); }
}
function same(before: Snapshot, after: Snapshot): boolean { return before.identity.updatedAt === after.identity.updatedAt && before.identity.status === after.identity.status && before.identity.highWatermark === after.identity.highWatermark && before.identity.providerThreadId === after.identity.providerThreadId && before.identity.checkpointId === after.identity.checkpointId && before.route.routeDigest === after.route.routeDigest && before.route.revision === after.route.revision && before.processes === after.processes && before.workspace === after.workspace; }
async function main(): Promise<void> { if (process.env.BB_THREAD_ID === TARGET) throw new Error("probe thread cannot target itself"); const before = await snapshot(), rollout = await readRollout(before.route); const after = await snapshot(); if (rolloutIdentity(after.route) !== rollout.identity || !same(before, after)) throw new Error("protected state changed"); process.stdout.write(JSON.stringify({ format: "context-magnet-session-rollout-probe/v1", status: "passed", target: TARGET, highWatermark: before.identity.highWatermark, accountSlot: `sha256:${before.route.slot}`, routeRevision: before.route.revision, rollout: { sha256: rollout.digest, bytes: rollout.size, records: rollout.records, turns: rollout.turns, contextRecords: rollout.contextRecords, dialect: rollout.dialect }, receiptGap: rollout.receiptGap, protectedStateChanged: false, rawBodiesRetained: false }) + "\n"); }
main().catch((error) => { process.stderr.write(`session-rollout-probe failed: ${error instanceof Error ? error.message : "unknown"}\n`); process.exitCode = 1; });
