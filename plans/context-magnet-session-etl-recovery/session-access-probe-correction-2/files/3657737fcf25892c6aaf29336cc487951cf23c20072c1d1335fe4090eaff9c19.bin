import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import { spawnSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import test from "node:test";

const root = resolve(import.meta.dirname, "..");
const fixturePath = resolve(root, "test/fixtures/codex-session-access-probe.json");
const runnerPath = resolve(root, "test/run-codex-session-access-probe.mts");
const docsPath = resolve(root, "docs/codex-session-access-probe.md");

type RecordValue = Record<string, unknown>;
const fixture = (): RecordValue => JSON.parse(readFileSync(fixturePath, "utf8"));
const sha256 = (value: string) => createHash("sha256").update(value).digest("hex");

function validate(value: RecordValue): void {
  assert.equal(value.format, "context-magnet-codex-session-access-probe/v1");
  const limits = value.limits as RecordValue;
  for (const key of ["stdoutBytes", "stderrBytes", "lineBytes", "turns", "items", "fragments", "wallMs", "concurrency"]) {
    assert.ok(Number.isSafeInteger(limits[key]) && (limits[key] as number) > 0, `invalid ${key}`);
  }
  assert.equal(limits.concurrency, 1);
  const cases = value.cases as string[];
  for (const name of ["routed-success", "native", "missing", "archived", "disabled", "divergent", "unauthorized", "forked-thread-id-not-session-id", "compacted", "interrupted", "failed", "subagent", "zero-work", "unknown-server-request", "oversized-stdout", "oversized-stderr", "oversized-line", "oversized-turn", "oversized-item", "oversized-fragment", "timeout", "process-teardown", "route-revision-race", "ambiguous-ownership"]) assert.ok(cases.includes(name), `missing ${name}`);
  const success = value.routedSuccess as RecordValue;
  assert.equal(success.providerId, "codex");
  assert.ok(typeof success.providerThreadId === "string" && success.providerThreadId.length > 0);
  assert.ok(Number.isSafeInteger(success.highWatermark));
  assert.ok(typeof success.terminalCheckpointId === "string");
  assert.match(success.accountSlot as string, /^sha256:[a-f0-9]{64}$/);
  const thread = success.thread as RecordValue;
  assert.notEqual(thread.id, thread.sessionId, "Thread.id and sessionId must be independently bound");
  const fragment = ((((success.receipt as RecordValue).turns as RecordValue[])[0].items as RecordValue[])[0].fragments as RecordValue[])[0];
  assert.equal(fragment.sha256, sha256("fixture-hook-receipt"));
  assert.equal(success.protectedStateUnchanged, true);
  const live = value.live as RecordValue;
  assert.equal(live.status, "unavailable");
  assert.equal(live.rawTurnsRetained, false);
  assert.equal(live.protectedStateChanged, false);
  assert.equal(JSON.stringify(value).match(/fragment text|commandExecution|aggregatedOutput|CODEX_HOME|rollout/i), null);
}

test("fixture is bounded, redacted, and does not confuse Thread.id with sessionId", () => validate(fixture()));

test("runner executes a bounded live probe without retaining direct-read material", () => {
  const execution = spawnSync(process.execPath, ["--experimental-strip-types", runnerPath], { encoding: "utf8", timeout: 30_000 });
  assert.equal(execution.status, 0, execution.stderr);
  const receipt = JSON.parse(execution.stdout.trim()) as RecordValue;
  assert.equal(receipt.format, "context-magnet-codex-session-access-probe/v1");
  assert.ok(receipt.status === "passed" || receipt.status === "unavailable");
  assert.equal(receipt.protectedStateChanged, false);
  assert.equal(receipt.rawTurnsRetained, false);
  assert.equal(/CODEX_HOME|rollout_path|fragment text|commandExecution|aggregatedOutput/i.test(execution.stdout), false);
});

test("runner bans lifecycle and body-bearing access paths", () => {
  const source = readFileSync(runnerPath, "utf8");
  for (const forbidden of ["thread/resume", "thread/unarchive", "thread/fork", "thread/start", "router.mjs status", "console.log(raw", "writeFile", "appendFile", "aggregatedOutput"]) assert.equal(source.includes(forbidden), false, `runner must not use ${forbidden}`);
  assert.match(source, /bun:sqlite/);
  assert.match(source, /readonly:true,create:false/);
  assert.match(source, /thread%2Fidentity%2Cturn%2Fcompleted/);
});

test("documentation records no sensitive provider material", () => {
  const docs = readFileSync(docsPath, "utf8");
  assert.match(docs, /fail closed/i);
  assert.match(docs, /stdout before newline buffering/i);
  assert.match(docs, /Thread\.id.*sessionId/i);
  assert.equal(/CODEX_HOME\s*=|Bearer\s/i.test(docs), false);
});
