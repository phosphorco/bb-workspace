+test("renders declaration, provider admission, and model receipt as separate compact states", async () => {
+  const exported = await appExports();
+  const consumptionLabel = exported.consumptionStatusLabel;
+  const declarationLabel = exported.declarationStatusLabel;
+  const admissionLabel = exported.providerAdmissionStatusLabel;
+  assert.equal(typeof consumptionLabel, "function", "app.tsx must export the compact model-use helper");
+  assert.equal(typeof declarationLabel, "function", "app.tsx must export the compact declaration helper");
+  assert.equal(typeof admissionLabel, "function", "app.tsx must export the compact provider-admission helper");
+  const consumption = consumptionLabel as (value: unknown) => Readonly<{ glyph: string; label: string }>;
+  const declaration = declarationLabel as (value: any) => Readonly<{ glyph: string; label: string }>;
+  const admission = admissionLabel as (value: any) => Readonly<{ glyph: string; label: string }>;
+  assert.deepEqual({ ...consumption({ state: "consumed", kind: "model-owned-receipt" }) }, { glyph: "●", label: "Consumed (model-owned receipt)" });
+  assert.deepEqual({ ...consumption({ state: "consumed", kind: "host-observed" }) }, { glyph: "◐", label: "Host observed; model use not verified" }, "host observation is never presented as consumed");
+  assert.deepEqual({ ...consumption({ state: "not-observed" }) }, { glyph: "○", label: "Model use not observed" });
+  assert.deepEqual({ ...consumption({ state: "unknown" }) }, { glyph: "?", label: "Model use unknown" });
+  assert.deepEqual({ ...consumption({ state: "unavailable", reason: "carrier" }) }, { glyph: "—", label: "Model use unavailable" });
+
+  const retained = (observations: readonly unknown[], declaration = "declared", gaps: readonly unknown[] = []) => ({ declaration, observations, gaps, attempt: { id: "attempt-1", providerKind: "codex", requestKind: "start", instructionMode: "append" } });
+  const contribution = (admissions: readonly unknown[] | undefined, consumption: unknown = { state: "not-observed" }, admissionGaps: readonly unknown[] = []) => ({ admissions, consumption, admissionGaps });
+  assert.deepEqual({ ...declaration(contribution([])) }, { glyph: "◇", label: "Declared" }, "a retained zero-attempt list is the carrier's declared-only state");
+  assert.deepEqual({ ...declaration(contribution([], { state: "not-observed" }, [{ kind: "retention" }])) }, { glyph: "◇", label: "Declared (admission history retention gap)" }, "a retention gap qualifies admission history without withdrawing the declaration");
+  const accepted = contribution([retained([{ kind: "constructed" }, { kind: "accepted" }])]);
+  assert.deepEqual({ ...declaration(accepted) }, { glyph: "◇", label: "Declared" });
+  assert.deepEqual({ ...admission(accepted) }, { glyph: "✓", label: "Provider accepted; model use not observed" }, "accepted remains distinguishable from consumption");
+  assert.equal(admission(contribution([retained([{ kind: "constructed" }])])).label, "Provider constructed");
