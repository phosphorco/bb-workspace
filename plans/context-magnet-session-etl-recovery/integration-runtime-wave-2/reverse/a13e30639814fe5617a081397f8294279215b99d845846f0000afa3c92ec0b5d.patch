+test("layouts before, assistant-within, and after blocks in supplied transcript and block order", async () => {
+  const user = message("user-1", "user", 90);
+  const assistant = message("assistant-1", "assistant", 10);
+  const nextUser = message("user-2", "user", 30);
+  const projection = {
+    transcript: [user, assistant, nextUser],
+    workingBlocks: [
+      block("before-user", { kind: "before", anchor: user }),
+      block("within-assistant-a", { kind: "within", anchor: assistant }),
+      block("within-assistant-b", { kind: "within", anchor: assistant }),
+      block("after-assistant", { kind: "after", anchor: assistant }),
+    ],
+  };
+  const layout = await layoutTraceProjection(projection);
+  assert.deepEqual(Array.from(layout.entries, ({ message: item }) => item.id), ["user-1", "assistant-1", "user-2"], "transcript order is carrier-supplied, never sequence-sorted");
+  assert.deepEqual(Array.from(layout.entries[0]?.before ?? [], ({ id }) => id), ["before-user"]);
+  assert.deepEqual(Array.from(layout.entries[1]?.within ?? [], ({ id }) => id), ["within-assistant-a", "within-assistant-b"]);
+  assert.deepEqual(Array.from(layout.entries[1]?.after ?? [], ({ id }) => id), ["after-assistant"]);
+  assert.deepEqual(Array.from(layout.unplaced), []);
 });
 
