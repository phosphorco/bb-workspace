import assert from "node:assert/strict";
import test from "node:test";
import type { BbPluginApi, PluginAgentConfiguration } from "@get-bb/plugin-sdk";
import { readHostTracePage, type HostTraceClient } from "../host-trace-adapter.ts";
import plugin from "../server.ts";
import { contextMagnetTraceConfiguration } from "../trace-producer.ts";
import {
  armWitness,
  armWitnessForTrace,
  linkWitnessToExactOperation,
  WITNESS_METADATA_KEY,
  WITNESS_SKILL_ID,
  WITNESS_TOOL_NAME,
  witnessTraceEvidenceCorrelation,
  type HostContributionTracePage,
} from "../witness.ts";

const THREAD = "thread-trace-producer";
const PROOF = "cmw:00000000-0000-4000-8000-000000000000";
const selection = armWitnessForTrace(THREAD, "witness-contribution-01", PROOF);
const configuration = (metadata: unknown, threadId = THREAD) =>
  contextMagnetTraceConfiguration({ pluginMetadata: metadata, threadId });

function serverConfiguration(metadata: unknown, threadId = THREAD): PluginAgentConfiguration {
  let configured: ((context: { pluginMetadata: unknown; thread: { id: string } }) => PluginAgentConfiguration) | undefined;
  plugin({
    agents: {
      configure(callback: unknown) {
        configured = callback as typeof configured;
      },
      registerTool() {},
    },
    cli: { register() {} },
    events: { on() {} },
    realtime: { publish() {} },
    rpc: { register() {} },
  } as unknown as BbPluginApi);
  assert.ok(configured);
  return configured({ pluginMetadata: metadata, thread: { id: threadId } });
}

test("declares one bounded trace only for the thread-bound v2 witness", () => {
  const result = configuration({ [WITNESS_METADATA_KEY]: selection });
  assert.deepEqual(result.tools, [WITNESS_TOOL_NAME]);
  assert.deepEqual(result.skills, [WITNESS_SKILL_ID]);
  assert.equal(result.instructions?.includes(PROOF), true, "only injected instructions receive the opaque receipt proof");
  assert.deepEqual(result.experimental_contextMagnetTrace, {
    evidence: {
      source: "context-magnet-host",
      ...witnessTraceEvidenceCorrelation(selection),
      unknownFields: {},
      redactions: [],
    },
    inclusionReason: {
      category: "other-safe",
      detail: "Explicit test-only thread-bound Context Magnet witness selection.",
    },
    operation: { kind: "unmatched", reason: "target-not-retained", target: null },
    outcome: { kind: "delivered" },
    receiptTool: WITNESS_TOOL_NAME,
    trigger: { factKey: null, locator: "host-policy", renderState: "unknown" },
  });
  const serializedTrace = JSON.stringify(result.experimental_contextMagnetTrace);
  assert.doesNotMatch(serializedTrace, new RegExp(PROOF, "u"));
  assert.equal(serializedTrace.includes("providerRequest"), false);
  assert.equal(new Set(result.tools).size, 1, "the receipt tool is selected once, never duplicated");
  assert.equal(new Set(result.skills).size, 1, "the selected skill is not duplicated");
});

test("carries the factless unknown trigger through the installed host-page adapter", async () => {
  const trace = configuration({ [WITNESS_METADATA_KEY]: selection }).experimental_contextMagnetTrace;
  assert.ok(trace);

  // This is the installed public carrier shape: the host adds its canonical
  // contribution key and observation state, while every declaration field
  // remains producer-owned and bounded.
  const page: HostContributionTracePage = {
    version: "context-magnet.trace-carrier/v1",
    threadId: THREAD,
    contributions: [{
      contributionKey: { threadId: THREAD, id: "host-generated-contribution" },
      operation: trace.operation,
      outcome: trace.outcome,
      consumption: { state: "not-observed" },
      evidence: trace.evidence,
      inclusionReason: trace.inclusionReason,
      trigger: trace.trigger,
    }],
    completeness: "complete",
    cursor: null,
    gaps: [],
    nextCursor: null,
    retainedFrom: { contributionEventSeq: 0, operationEventSeq: 0, state: "known" },
    snapshot: { id: "snapshot-01", capturedAt: "2026-09-20T00:00:00.000Z", operationSeqHighWatermark: 0 },
  };
  const client = {
    experimental_contextMagnetContributions: async () => page,
  } as unknown as HostTraceClient;

  const projection = await readHostTracePage(client, { threadId: THREAD });
  assert.equal(projection.unmatched[0]?.contribution.trigger.renderState, "unknown");
  assert.equal(projection.unmatched[0]?.contribution.trigger.factKey, null);
  assert.equal(projection.unmatched[0]?.contribution.trigger.locator, "host-policy");
  assert.deepEqual(projection.unmatched[0]?.contribution.inclusionReason, trace.inclusionReason);
  assert.deepEqual(projection.unmatched[0]?.contribution.evidence, trace.evidence);
});

test("does not relabel a model-owned receipt as exact timeline evidence without a host operation update", () => {
  const trace = configuration({ [WITNESS_METADATA_KEY]: selection }).experimental_contextMagnetTrace;
  assert.deepEqual(trace?.operation, { kind: "unmatched", reason: "target-not-retained", target: null });

  // The current host receipt writer records consumption only. Supplying its
  // receipt without a host-owned exact operation must remain invalid rather
  // than being placed by a guessed call, session, or timestamp.
  const page = {
    version: "context-magnet.trace-carrier/v1",
    threadId: THREAD,
    contributions: [{
      contributionKey: { threadId: THREAD, id: "host-generated-contribution" },
      operation: { kind: "unmatched" as const, reason: "target-not-retained" as const, target: null },
      outcome: { kind: "delivered" as const },
      consumption: { state: "consumed", kind: "model-owned-receipt" },
      evidence: {
        source: "context-magnet-host",
        ...witnessTraceEvidenceCorrelation(selection),
        unknownFields: {},
        redactions: [],
      },
      inclusionReason: { category: "other-safe" as const },
      trigger: { factKey: null, locator: "host-policy" as const, renderState: "unknown" as const },
    }],
    completeness: "complete",
    cursor: null,
    gaps: [],
    nextCursor: null,
    retainedFrom: { contributionEventSeq: 0, operationEventSeq: 0, state: "known" },
    snapshot: { id: "snapshot-01", capturedAt: "2026-09-20T00:00:00.000Z", operationSeqHighWatermark: 0 },
  } as HostContributionTracePage;
  assert.equal(
    linkWitnessToExactOperation({ [WITNESS_METADATA_KEY]: selection }, [page]).state,
    "invalid",
  );
});

test("leaves generic v1 tools, skills, and instructions outside the trace path", () => {
  const legacyArmed = armWitness("legacy-contribution", PROOF, 1_700_000_000_000);
  const result = configuration({ [WITNESS_METADATA_KEY]: legacyArmed });
  assert.deepEqual(result, { tools: [], skills: [] });
  assert.deepEqual(serverConfiguration({ [WITNESS_METADATA_KEY]: legacyArmed }), { tools: [], skills: [] });
});

test("fails closed for invalid, unarmed, cross-thread, duplicate, oversized, body-bearing, and receipt-tool mismatch selections", () => {
  const cases: readonly [string, unknown, string?][] = [
    ["invalid", { [WITNESS_METADATA_KEY]: { version: 2, state: "selected" } }],
    ["unarmed legacy witness", { [WITNESS_METADATA_KEY]: armWitness("legacy-contribution", PROOF, 1_700_000_000_000) }],
    ["cross-thread", { [WITNESS_METADATA_KEY]: selection }, "another-thread"],
    ["duplicate witness records", { [WITNESS_METADATA_KEY]: [selection, selection] }],
    ["oversized selection id", { [WITNESS_METADATA_KEY]: { ...selection, selectionId: "x".repeat(161) } }],
    ["body-bearing selection", { [WITNESS_METADATA_KEY]: { ...selection, providerRequestBody: "must-not-retain" } }],
    ["receipt-tool mismatch", { [WITNESS_METADATA_KEY]: { ...selection, receiptTool: "other_tool" } }],
  ];
  for (const [label, metadata, threadId] of cases) {
    assert.deepEqual(configuration(metadata, threadId), { tools: [], skills: [] }, label);
  }
});
