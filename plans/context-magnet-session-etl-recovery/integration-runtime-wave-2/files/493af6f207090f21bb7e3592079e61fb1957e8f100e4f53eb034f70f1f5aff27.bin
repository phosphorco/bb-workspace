import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import test from "node:test";
import { READER_ATTESTATION } from "../host/context-magnet-session-reader.mjs";
import { runContextMagnetSessionRead } from "../host/router.mjs";

const generation = "a".repeat(64);
const identity = () => ({ generationDigest: generation, runtimeExecPath: "ignored", runtimeVersion: "ignored" });
const safeProjection = { version: "context-magnet.session-reader-projection/v1", state: "ready", meta: null, events: [], omittedEventCount: 0 };

test("dispatch seam requires fixed argv and preserves only the safe command envelope", async () => {
  let reads = 0;
  const result = await runContextMagnetSessionRead(["provider-1", generation, READER_ATTESTATION], {
    deploymentIdentity: identity,
    readonlyState: async () => { reads++; return { readonly: true }; },
    reader: async () => safeProjection,
  });
  assert.equal(reads, 1);
  assert.deepEqual(Object.keys(result), ["version", "state", "generationDigest", "readerAttestation", "providerThreadSlot", "startedFence", "finishedFence", "result"]);
  assert.doesNotMatch(JSON.stringify(result), /provider-1|account|home|path|raw|content/u);
  for (const args of [[], ["provider-1"], ["provider-1", generation, READER_ATTESTATION, "extra"], ["provider-1", "x", READER_ATTESTATION]]) {
    assert.equal((await runContextMagnetSessionRead(args, { deploymentIdentity: identity })).code, "invalid-arguments");
  }
});

test("command source dispatches before router state construction", () => {
  const source = readFileSync(new URL("../host/router.mjs", import.meta.url), "utf8");
  const dispatch = source.indexOf('args[0] === "context-magnet" && args[1] === "session-read"');
  const state = source.indexOf("store = await openRouterStateStore");
  assert.ok(dispatch >= 0 && dispatch < state);
});
