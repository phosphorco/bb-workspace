import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import test from "node:test";
import { inspectHostFree } from "../server.ts";

const THREAD = "thread-host-free";
const PROVIDER = "provider-thread-private";
const TURN = "terminal-turn-private";
const SESSION = "native-session-private";
const NONCE = "nonce-private";
const generation = "a".repeat(64);
const readerAttestation = "b".repeat(64);
const sourceRevision = "c".repeat(40);
const digest = (value: string) => createHash("sha256").update(value, "utf8").digest("hex");
const slot = (value: string) => `sha256:${digest(value)}`;
const metadata = (updatedAt = 2) => ({
  id: THREAD, projectId: "project", environmentId: "environment", providerId: "codex", title: null, titleFallback: null, sectionId: null, status: "idle", parentThreadId: null, sourceThreadId: null, originKind: null, originPluginId: null, visibility: "visible", archivedAt: null, pinnedAt: null, deletedAt: null, lastReadAt: null, latestAttentionAt: 1, createdAt: 1, updatedAt,
  runtime: { displayStatus: "idle", hostReconnectGraceExpiresAt: null }, activeBackgroundAgentCount: 0, canSpawnChild: true, queuedMessageCount: 0,
});
const identity = { id: "identity", scope: { kind: "thread" }, threadId: THREAD, seq: 1, createdAt: 1, type: "thread/identity", data: { providerThreadId: PROVIDER } };
const terminal = { id: "terminal", scope: { kind: "turn", turnId: TURN }, threadId: THREAD, seq: 2, createdAt: 2, type: "turn/completed", data: { providerThreadId: PROVIDER, status: "completed", providerCheckpointId: "checkpoint" } };

function projection() {
  const receipt = { receiptVersion: "context-magnet.receipt/v1", nonceSlot: slot(NONCE), nativeSessionIdSlot: slot(SESSION), turnIdSlot: slot(TURN), storeInstanceSlot: slot("store"), generationSlot: slot("store-generation"), generationKeySlots: [slot("generation-key")], recordKeySlots: [slot("record-key")], contributionKeySlots: [slot("contribution-key")], emittedUtf8Bytes: 8, emittedSha256: digest("admitted"), executableIdentitySlot: slot(`sha256:${"d".repeat(64)}`), sourceIdentitySlot: slot(`vcs:${sourceRevision}`) };
  return { version: "context-magnet.session-reader-projection/v1", state: "ready", meta: { kind: "meta", version: "context-magnet.session-reader-projection/v1", normalizerVersion: "router-reader-v1", router: { authority: "router-snapshot", providerThreadId: slot(PROVIDER), revision: slot("router-revision"), ownerSlot: slot("router-owner"), readonly: true }, rollout: { dialect: "codex-rollout", digest: { algorithm: "sha256", value: digest("rollout") }, file: { identity: slot("rollout-file"), kind: "rollout" }, nativeRolloutId: slot("native-rollout") }, identities: { nativeRolloutId: slot("native-rollout"), nativeSessionId: slot(SESSION), relation: "distinct-native-identities-recorded" } }, events: [
    { seq: 1, kind: "source-fence", locator: { source: "rollout", ref: "reader:fence", redacted: true }, details: { records: 2, bytes: 2, digest: digest("fence") } },
    { seq: 2, kind: "persisted-rollout-receipt", locator: { source: "rollout", ref: "reader:receipt", redacted: true }, details: receipt },
  ], omittedEventCount: 0 };
}

function workbench(status: "complete" | "zero-contribution" | "not-found" | "ambiguous" | "incomplete" | "malformed" | "oversized" = "complete") {
  const executableIdentity = `sha256:${"d".repeat(64)}`;
  const attestation = { realpath: "/opt/workbench", version: `workbench 0.8.0 (${sourceRevision})`, executableIdentity, sourceIdentity: `vcs:${sourceRevision}` };
  const result = status === "complete" ? { status: "complete", receiptVersion: "context-magnet.receipt/v1", nonceSlot: slot(NONCE), nativeSessionIdSlot: slot(SESSION), turnIdSlot: slot(TURN), storeInstanceSlot: slot("store"), generationSlot: slot("store-generation"), generationKeySlots: [slot("generation-key")], recordKeySlots: [slot("record-key")], contributionKeySlots: [slot("contribution-key")], emittedUtf8Bytes: 8, emittedSha256: digest("admitted"), executableIdentitySlot: slot(executableIdentity), sourceIdentitySlot: slot(attestation.sourceIdentity), body: "admitted" } : status === "malformed" ? { status: "complete", raw: "forbidden" } : status === "oversized" ? { status: "complete", receiptVersion: "context-magnet.receipt/v1", nonceSlot: slot(NONCE), nativeSessionIdSlot: slot(SESSION), turnIdSlot: slot(TURN), storeInstanceSlot: slot("store"), generationSlot: slot("store-generation"), generationKeySlots: [slot("generation-key")], recordKeySlots: [slot("record-key")], contributionKeySlots: [slot("contribution-key")], emittedUtf8Bytes: 1, emittedSha256: digest("x"), executableIdentitySlot: slot(executableIdentity), sourceIdentitySlot: slot(attestation.sourceIdentity), body: "x".repeat(70_000) } : status === "incomplete" ? { status, gaps: [{ Kind: 1, Generation: 0, FromRecordID: 0, ToRecordID: 0, BlockSequence: 0, Detail: "bounded gap" }] } : { status };
  return { attestation, environment: { LANG: "C", LC_ALL: "C", PATH: "/usr/bin" }, recheckIdentity: async () => attestation, invoke: async () => ({ stdout: JSON.stringify(result), stderr: "" }) };
}

function routerEnvelope(result: unknown) {
  return JSON.stringify({ version: "context-magnet.session-read-command/v1", state: "ok", generationDigest: generation, readerAttestation, providerThreadSlot: slot(PROVIDER), startedFence: slot(`${generation}:${readerAttestation}`), finishedFence: slot(`${generation}:${readerAttestation}`), result });
}

function ports(options: { router?: unknown; metadataAt?: (count: number) => number; calls?: string[] } = {}) {
  let reads = 0;
  const calls = options.calls ?? [];
  const raw = options.router === undefined ? routerEnvelope(projection()) : typeof options.router === "string" ? options.router : routerEnvelope(options.router);
  return {
    getThread: async (id: string) => { assert.equal(id, THREAD); return metadata(options.metadataAt?.(reads) ?? 2); },
    getEnvironment: async () => ({ id: "environment", hostId: "host" }),
    bb: { getThreadMetadata: async () => metadata(options.metadataAt?.(++reads) ?? 2), listThreadEvents: async (request: { threadId: string; types: readonly string[]; afterSeq?: string }) => { calls.push(`events:${request.threadId}:${request.types.join(",")}:${request.afterSeq ?? "start"}`); assert.deepEqual(request.types, ["thread/identity", "turn/completed"]); const after = Number(request.afterSeq ?? 0); return [identity, terminal].filter((event) => event.seq > after); } },
    router: { hosts: { directory: async ({ hostId }: { hostId: string }) => { assert.equal(hostId, "host"); return { directory: "/host" }; } }, terminals: { create: async (value: { start: { command: string } }) => { calls.push(`router:${value.start.command}`); return { id: "router-terminal" }; }, get: async () => ({ status: "exited", exitCode: 0 }), output: async () => ({ chunks: [{ seq: 1, dataBase64: Buffer.from(raw).toString("base64") }], nextSeq: 1, truncated: false }), close: async () => undefined } },
  };
}

const runtime = (process: ReturnType<typeof workbench> | null = workbench()) => ({ router: { generation, readerAttestation }, workbench: async () => process });
const serial = (value: unknown) => JSON.stringify(value);

test("admits only the exact ready receipt through the slot-only path", async () => {
  const calls: string[] = [];
  const result = await inspectHostFree(THREAD, ports({ calls }), runtime());
  assert.equal(result.state, "ready");
  assert.equal(result.sessionEtlState, "ready");
  assert.ok((result.sessionEtl as { events: readonly { kind: string }[] } | null)?.events.some((event) => event.kind === "context-admission"));
  assert.ok(calls.some((call) => call.startsWith("router:")));
  assert.ok(calls.every((call) => !/cursor|trace|agent-cli|experimental/i.test(call)));
  const output = serial(result);
  for (const secret of [PROVIDER, SESSION, TURN, NONCE, "/host", "/opt/workbench"]) assert.equal(output.includes(secret), false);
  assert.equal(output.includes("admitted"), true, "only the exact admitted body may cross the projection");
});

test("returns canonical ready zero-contribution and bounded Workbench gaps", async () => {
  for (const status of ["zero-contribution", "not-found", "ambiguous", "incomplete", "malformed", "oversized"] as const) {
    const result = await inspectHostFree(THREAD, ports(), runtime(workbench(status)));
    assert.equal(result.state, status === "zero-contribution" ? "ready" : "partial", status);
    assert.ok(result.sessionEtl !== null, status);
  }
  const unavailable = await inspectHostFree(THREAD, ports(), runtime(null));
  assert.equal(unavailable.state, "unavailable");
});

test("rejects router partial output and before/middle/after BB source drift", async () => {
  const partial = await inspectHostFree(THREAD, ports({ router: { version: "context-magnet.session-reader-projection/v1", state: "partial", meta: null, events: [], omittedEventCount: 0 } }), runtime());
  assert.equal(partial.state, "partial");
  const malformed = await inspectHostFree(THREAD, ports({ router: "not json" }), runtime());
  assert.equal(malformed.state, "unavailable");
  const routerDrift = await inspectHostFree(THREAD, ports({ router: routerEnvelope(projection()).replace(slot(PROVIDER), slot("foreign-provider")) }), runtime());
  assert.equal(routerDrift.state, "unavailable");
  const drift = await inspectHostFree(THREAD, ports({ metadataAt: (count) => count > 8 ? 3 : 2 }), runtime());
  assert.equal(drift.state, "partial");
  assert.deepEqual(drift.diagnostics, ["source-fence-drift"]);
});

test("does not follow a stale thread request into BB events or router state", async () => {
  const result = await inspectHostFree("stale-thread", ports(), runtime());
  assert.equal(result.state, "unavailable");
  assert.equal(result.sessionEtl, null);
  assert.deepEqual(result.diagnostics, ["bb-unavailable"]);
});
