import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import { spawnSync } from "node:child_process";
import { closeSync, mkdtempSync, renameSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import test from "node:test";

process.env.CM_PROBE_UNIT = "1";
const root = resolve(import.meta.dirname, ".."), runner = resolve(root, "test/run-codex-session-access-probe.mts"), probe = await import(runner);
const sha = (body: string) => createHash("sha256").update(body).digest("hex");
const record = (ordinal: number, type: string, payload: object) => ({ ordinal, timestamp: "2026-09-21T00:00:00Z", type, payload });
const session = (id = "native-1", sessionId = "session-1") => record(0, "session_meta", { cli_version: "0.153.2", id, session_id: sessionId });
const jsonl = (...records: object[]) => Buffer.from(records.map((value) => JSON.stringify(value)).join("\n"));
const carrier = (text: string, kind = "hooks.additional_context", turnId = "turn-1") => ({ type: "message", role: "developer", id: "native-item-1", internal_chat_message_metadata_passthrough: { turn_id: turnId, content_item_kinds: [kind] }, content: [{ type: "input_text", text }] });
const receipt = (body = "provisional body", sessionId = "session-1", turnId = "turn-1", bytes = Buffer.byteLength(body), digest = sha(body)) => JSON.stringify({ format: "context-magnet-receipt/v1", receiptId: "receipt-1", bytes, sha256: digest, sessionId, turnId, body });
const route = (home: string, rollout: string) => ({ owner: "redacted", home, rollout, revision: 1, slot: "slot", routeDigest: "digest" });

test("distinguishes a valid receipt, unbound hook, malformed carrier, and malformed declared receipt", () => {
  assert.equal(probe.classifyHookCarrier(carrier(receipt()), "session-1"), "context-receipt");
  assert.equal(probe.classifyHookCarrier(carrier("ordinary hook text"), "session-1"), "unbound-hook-context");
  assert.equal(probe.classifyHookCarrier(carrier(receipt("body", "wrong-session")), "session-1"), "invalid-context-receipt");
  assert.equal(probe.classifyHookCarrier(carrier(receipt("body", "session-1", "turn-1", 5, sha("other"))), "session-1"), "invalid-context-receipt");
  assert.equal(probe.classifyHookCarrier(carrier(JSON.stringify({ format: "context-magnet-receipt/v1", receiptId: "", bytes: 4, sha256: sha("body"), sessionId: "session-1", turnId: "turn-1", body: "body" })), "session-1"), "invalid-context-receipt");
  assert.equal(probe.classifyHookCarrier({ ...carrier(receipt()), id: "" }, "session-1"), "invalid-hook-carrier");
  assert.equal(probe.classifyHookCarrier({ ...carrier(receipt()), internal_chat_message_metadata_passthrough: { turn_id: "turn-1", content_item_kinds: ["hooks.additional_context", "extra"] } }, "session-1"), "invalid-hook-carrier");
  assert.equal(probe.classifyHookCarrier({ ...carrier(receipt()), content: [{ type: "output_text", text: "x" }] }, "session-1"), "invalid-hook-carrier");
  assert.equal(probe.classifyHookCarrier({ ...carrier(receipt()), content: [{ type: "input_text", text: "x", kind: "hooks.additional_context" }], internal_chat_message_metadata_passthrough: { turn_id: "turn-1", content_item_kinds: ["generic.developer_instructions"] } }, "session-1"), "invalid-hook-carrier");
  assert.equal(probe.classifyHookCarrier(carrier(receipt(), "generic.developer_instructions"), "session-1"), "not-hook");
  assert.equal(probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", carrier("ordinary hook text")))).receiptGap, "unbound-hook-context");
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", carrier(receipt("x", "wrong-session")))), /invalid-context-receipt/));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", { ...carrier("x"), id: "" })), /invalid-hook-carrier/));
  const multi = (texts: string[]) => ({ type: "message", role: "developer", id: "native-multi", internal_chat_message_metadata_passthrough: { turn_id: "turn-1", content_item_kinds: texts.map(() => "hooks.additional_context") }, content: texts.map((text) => ({ type: "input_text", text })) });
  assert.equal(probe.classifyHookCarrier(multi(["ordinary hook text", receipt("x", "wrong-session")]), "session-1"), "invalid-context-receipt");
  assert.equal(probe.classifyHookCarrier(multi([receipt(), receipt("x", "wrong-session")]), "session-1"), "invalid-context-receipt");
  assert.equal(probe.classifyHookCarrier(multi([receipt(), receipt("second")]), "session-1"), "multiple-context-receipts");
  const two = probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", multi([receipt(), receipt("second")])))); assert.equal(two.hookCarriers, 2); assert.equal(two.receiptCount, 2); assert.equal(two.receiptGap, "multiple-context-receipts");
});

test("validates session identity, exact dialect, unsupported compaction, UTF-8, and resource bounds", () => {
  const valid = jsonl(session("native-1", "session-1"), record(1, "response_item", carrier("ordinary developer text", "generic.developer_instructions")), record(2, "turn_context", {}));
  assert.deepEqual(probe.parseRolloutJsonl(valid), { records: 3, turns: 1, contexts: 1, hookCarriers: 0, receiptCount: 0, receiptGap: "zero-exact-context-receipts", sessionId: "session-1", nativeId: "native-1" });
  assert.throws(() => probe.parseRolloutJsonl(jsonl(record(0, "session_meta", { cli_version: "0.153.2", id: "", session_id: "session-1" }))));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(record(0, "session_meta", { cli_version: "0.153.2", id: "native-1", session_id: "" }))));
  assert.throws(() => probe.parseRolloutJsonl(Buffer.from([0xff])));
  assert.throws(() => probe.parseRolloutJsonl(Buffer.from("{not-json")));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "compacted", {}))));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(record(0, "session_meta", { cli_version: "0.153.20", id: "native-1", session_id: "session-1" }))));
  assert.throws(() => probe.parseRolloutJsonl(valid, { bytes: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(valid, { lineBytes: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(valid, { records: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "response_item", carrier("x", "generic.developer_instructions", "a")), record(2, "response_item", carrier("x", "generic.developer_instructions", "b"))), { turns: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(jsonl(session(), record(1, "turn_context", {}), record(2, "turn_context", {})), { contexts: 1 }));
  assert.throws(() => probe.parseRolloutJsonl(valid, { deadline: 0 }));
});

test("rejects unsafe files and a parser/read replacement race without opening a FIFO", async () => {
  const home = mkdtempSync(join(tmpdir(), "cm-rollout-home-")), outside = mkdtempSync(join(tmpdir(), "cm-rollout-outside-"));
  try {
    const regular = join(home, "rollout.jsonl"); writeFileSync(regular, jsonl(session(), record(1, "response_item", carrier("x", "generic.developer_instructions"))));
    await assert.rejects(probe.readRollout(route(home, regular), null), /absent completed checkpoint/);
    const opened = probe.safeRollout(route(home, regular)); closeSync(opened.fd); const before = opened.before, replacement = join(home, "replacement.jsonl"); writeFileSync(replacement, jsonl(session())); renameSync(replacement, regular); assert.notEqual(probe.rolloutIdentity(route(home, regular)), before);
    writeFileSync(regular, jsonl(session(), record(1, "response_item", carrier("x", "generic.developer_instructions"))));
    await assert.rejects(probe.readRollout(route(home, regular), "turn-1", () => { const racing = join(home, "racing.jsonl"); writeFileSync(racing, jsonl(session())); renameSync(racing, regular); }), /raced during stream/);
    const symlink = join(home, "rollout-link"); symlinkSync(regular, symlink); assert.throws(() => probe.safeRollout(route(home, symlink)));
    const fifo = join(home, "rollout-fifo"); assert.equal(spawnSync("mkfifo", [fifo]).status, 0); assert.throws(() => probe.safeRollout(route(home, fifo)));
    const escaped = join(outside, "rollout.jsonl"); writeFileSync(escaped, jsonl(session())); assert.throws(() => probe.safeRollout(route(home, escaped)));
  } finally { rmSync(home, { recursive: true, force: true }); rmSync(outside, { recursive: true, force: true }); }
});

const metadata = (overrides: Record<string, unknown> = {}) => ({ id: "thread-1", providerId: "codex", archivedAt: null, deletedAt: null, updatedAt: 10, status: "idle", ...overrides });
const identityEvent = (providerThreadId = "provider-1") => ({ id: "event-1", threadId: "thread-1", seq: 1, createdAt: "now", type: "thread/identity", scope: { kind: "thread" }, data: { providerThreadId } });
const terminalEvent = (status: "completed" | "failed" | "interrupted", providerThreadId = "provider-1") => ({ id: "event-2", threadId: "thread-1", seq: 2, createdAt: "now", type: "turn/completed", scope: { kind: "turn" }, data: { providerThreadId, status, providerCheckpointId: "turn-1" } });

test("fails closed for BB identity and route ambiguity while preserving provider/session divergence", () => {
  assert.equal(probe.validateIdentityProjection(metadata(), [identityEvent(), terminalEvent("completed")], "thread-1", "provider-1").checkpointId, "turn-1");
  assert.equal(probe.validateIdentityProjection(metadata(), [identityEvent(), terminalEvent("failed")], "thread-1", "provider-1").checkpointId, null);
  assert.equal(probe.validateIdentityProjection(metadata(), [identityEvent(), terminalEvent("interrupted")], "thread-1", "provider-1").checkpointId, null);
  assert.throws(() => probe.validateIdentityProjection(metadata(), [terminalEvent("completed")], "thread-1", "provider-1"), /missing/);
  assert.throws(() => probe.validateIdentityProjection(metadata({ providerId: "other" }), [identityEvent()], "thread-1", "provider-1"));
  assert.throws(() => probe.validateIdentityProjection(metadata({ archivedAt: "now" }), [identityEvent()], "thread-1", "provider-1"));
  assert.throws(() => probe.validateIdentityProjection(metadata({ deletedAt: "now" }), [identityEvent()], "thread-1", "provider-1"));
  assert.throws(() => probe.validateIdentityProjection(metadata(), [identityEvent("provider-1"), terminalEvent("completed", "provider-2")], "thread-1", "provider-1"));
  assert.throws(() => probe.validateIdentityProjection(metadata(), [identityEvent("wrong")], "thread-1", "provider-1"));
  assert.doesNotThrow(() => probe.requireUnambiguousOwner([{ enabled: true, draining: false }], 0));
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: false, draining: false }], 0));
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: true, draining: true }], 0));
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: true, draining: false }, { enabled: true, draining: false }], 0));
  assert.throws(() => probe.requireUnambiguousOwner([{ enabled: true, draining: false }], 1));
  const forked = probe.redactedIdentityRelation("provider-parent", "session-child", "native-child"); assert.equal(forked.providerEqualsSession, false); assert.equal(forked.providerDivergesFromSession, true); assert.equal(forked.nativeIdEqualsSession, false); assert.match(forked.providerSlot, /^sha256:/);
  assert.equal(probe.parseProvisionalContextMagnetReceipt(receipt("x", "parent-session"), "child-session", "turn-1"), "invalid-context-receipt");
});

function assertRedacted(value: unknown): void {
  if (!value || typeof value !== "object") return;
  for (const [key, child] of Object.entries(value as Record<string, unknown>)) { assert.equal(/path|home|account|message|reasoning|tool|credential/i.test(key) && key !== "rawBodiesRetained", false, "sensitive key " + key); assertRedacted(child); }
}
test("live rollout receipt has the exact redacted oracle shape and known zero-hook result", () => {
  const execution = spawnSync(process.execPath, ["--experimental-strip-types", runner], { encoding: "utf8", timeout: 30_000, env: { ...process.env, CM_PROBE_UNIT: "0" } });
  assert.equal(execution.status, 0, execution.stderr); const receiptValue = JSON.parse(execution.stdout.trim()) as Record<string, unknown>;
  assert.deepEqual(Object.keys(receiptValue).sort(), ["format", "highWatermark", "identities", "protectedStateChanged", "rawBodiesRetained", "receiptGap", "rollout", "routeRevision", "status", "target"]);
  assert.equal(receiptValue.format, "context-magnet-session-rollout-probe/v1"); assert.equal(receiptValue.status, "passed"); assert.equal(receiptValue.target, "thr_urmi56uqw8"); assert.equal(receiptValue.receiptGap, "zero-exact-context-receipts"); assert.equal(receiptValue.protectedStateChanged, false); assert.equal(receiptValue.rawBodiesRetained, false);
  const rollout = receiptValue.rollout as Record<string, unknown>, identities = receiptValue.identities as Record<string, unknown>;
  assert.deepEqual(Object.keys(rollout).sort(), ["bytes", "contextRecords", "dialect", "hookCarriers", "receiptCount", "records", "sha256", "turns"]); assert.equal(rollout.dialect, "codex-rollout-jsonl/0.153.2"); assert.equal(rollout.records, 133); assert.equal(rollout.bytes, 844550); assert.equal(rollout.turns, 1); assert.equal(rollout.contextRecords, 1); assert.equal(rollout.hookCarriers, 0); assert.equal(rollout.receiptCount, 0);
  assert.deepEqual(Object.keys(identities).sort(), ["nativeIdEqualsSession", "nativeIdSlot", "providerDivergesFromSession", "providerEqualsSession", "providerSlot", "sessionSlot"]); for (const key of ["providerSlot", "sessionSlot", "nativeIdSlot"]) assert.match(identities[key] as string, /^sha256:[a-f0-9]{64}$/); assert.equal(identities.providerEqualsSession, true); assert.equal(identities.providerDivergesFromSession, false); assert.equal(identities.nativeIdEqualsSession, true); assertRedacted(receiptValue);
});
