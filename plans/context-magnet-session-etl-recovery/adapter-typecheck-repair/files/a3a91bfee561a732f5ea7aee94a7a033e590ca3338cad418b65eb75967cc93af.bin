import assert from "node:assert/strict";
import test from "node:test";
import { BB_IDENTITY_EVENT_TYPES, BbEventIdentityAdapterError, readBbEventIdentity, type BbEventIdentityPort } from "../bb-event-adapter.ts";

const THREAD = "thr_identity";
const PROVIDER = "provider-thread-1";
const metadata = (overrides: object = {}) => ({
  id: THREAD, projectId: "project", environmentId: "env", providerId: "codex", title: null, titleFallback: null, sectionId: null, status: "idle", parentThreadId: null, sourceThreadId: null, originKind: "normal", originPluginId: null, visibility: "visible", archivedAt: null, pinnedAt: null, deletedAt: null, lastReadAt: null, latestAttentionAt: null, createdAt: 1, updatedAt: 2, runtime: null, activeBackgroundAgentCount: 0, canSpawnChild: true, queuedMessageCount: 0,
  ...overrides,
});
const identity = (seq = 1, provider = PROVIDER) => ({ id: `event-${seq}`, scope: { kind: "thread" }, threadId: THREAD, seq, createdAt: seq, type: "thread/identity", data: { providerThreadId: provider } });
const terminal = (seq = 2, status = "completed", checkpoint: string | null = "checkpoint-2", turnId = "turn-2") => ({ id: `event-${seq}`, scope: { kind: "turn", turnId }, threadId: THREAD, seq, createdAt: seq, type: "turn/completed", data: { providerThreadId: PROVIDER, status, ...(checkpoint === null ? {} : { providerCheckpointId: checkpoint }) } });

function port(events: readonly object[], options: { metas?: readonly object[]; mutateReread?: boolean } = {}): BbEventIdentityPort & { calls: unknown[] } {
  const calls: unknown[] = []; let metadataRead = 0; let eventRead = 0;
  return {
    calls,
    getThreadMetadata: async () => options.metas?.[metadataRead++] ?? metadata(),
    listThreadEvents: async (request) => {
      calls.push(request); eventRead++;
      const after = Number(request.afterSeq ?? "0");
      const source = options.mutateReread && eventRead > 1 ? [...events, terminal(99)] : events;
      return source.filter((event) => (event as { seq: number }).seq > after).slice(0, Number(request.limit));
    },
  };
}

test("reads a stable, bodyless Codex identity snapshot and keeps identities distinct", async () => {
  const client = port([identity(), terminal()]);
  const result = await readBbEventIdentity(client, { threadId: THREAD, expectedProviderThreadId: PROVIDER });
  assert.match(result.threadSlot, /^sha256:[a-f0-9]{64}$/u);
  assert.match(result.providerThreadSlot, /^sha256:[a-f0-9]{64}$/u);
  assert.equal(result.providerThreadSlot, "sha256:8cd7e94a8d6a4c666dd2da0a82b8abd44c87a8560ae008c0ce65a38960b4e9a4", "slots use the shared canonical SHA-256 encoding");
  assert.equal(result.facts[0]?.providerThreadSlot, result.providerThreadSlot, "same provider identity has the same slot");
  assert.equal(result.eventHighWatermark, 2);
  assert.equal(result.terminalCheckpoint.state, "succeeded");
  assert.notEqual(result.terminalCheckpoint.turnSlot, result.terminalCheckpoint.checkpointSlot, "turn and checkpoint remain distinct identities");
  assert.equal(result.facts[1]?.locator.ref, "thread-event:2");
  assert.equal(result.gaps.length, 0);
  for (const call of client.calls) {
    assert.deepEqual((call as { types: unknown }).types, BB_IDENTITY_EVENT_TYPES, "only server-filtered event types are requested");
    assert.equal(typeof (call as { limit: unknown }).limit, "string", "the narrow port matches the public SDK list arguments");
  }
  const serialized = JSON.stringify(result);
  for (const raw of [THREAD, PROVIDER, "turn-2", "checkpoint-2"]) assert.ok(!serialized.includes(raw), `raw identity ${raw} must not cross the adapter boundary`);
});

test("canonical slots may compare equal across roles without merging their typed identities", async () => {
  const result = await readBbEventIdentity(port([identity(), terminal(2, "completed", PROVIDER, PROVIDER)]), { threadId: THREAD });
  assert.equal(result.providerThreadSlot, result.terminalCheckpoint.turnSlot);
  assert.equal(result.providerThreadSlot, result.terminalCheckpoint.checkpointSlot);
  assert.equal(result.terminalCheckpoint.turnSlot, result.terminalCheckpoint.checkpointSlot);
  assert.ok("providerThreadSlot" in result && "turnSlot" in result.terminalCheckpoint && "checkpointSlot" in result.terminalCheckpoint, "equal slot values do not erase their separately typed source roles");
});

test("uses continuation pages in strict sequence and refuses a saturated completion", async () => {
  const client = port([identity(1), terminal(2), terminal(3, "failed", null, "turn-3")]);
  const result = await readBbEventIdentity(client, { threadId: THREAD, pageSize: 2 });
  assert.equal(result.eventHighWatermark, 3);
  assert.equal(result.terminalCheckpoint.state, "failed");
  assert.deepEqual(result.gaps, [{ reason: "terminal-failed", eventSeq: 3 }]);
  assert.deepEqual(client.calls.map((call) => (call as { afterSeq?: string }).afterSeq), [undefined, "2", undefined, "2"]);
  await assert.rejects(() => readBbEventIdentity(port([identity(), terminal()]), { threadId: THREAD, pageSize: 2 }), BbEventIdentityAdapterError, "an exactly full terminal page is not assumed complete");
});

test("keeps failed, interrupted, and missing-checkpoint terminals explicit rather than joining them", async () => {
  for (const [status, checkpoint, state, gap] of [
    ["completed", null, "unknown", "missing-checkpoint"],
    ["failed", null, "failed", "terminal-failed"],
    ["interrupted", null, "interrupted", "terminal-interrupted"],
  ] as const) {
    const result = await readBbEventIdentity(port([identity(), terminal(2, status, checkpoint)]), { threadId: THREAD });
    assert.equal(result.terminalCheckpoint.state, state);
    assert.equal(result.terminalCheckpoint.checkpointSlot, undefined);
    assert.equal(result.gaps[0]?.reason, gap);
  }
});

test("rejects unauthorized, archived, deleted, non-Codex, foreign, missing, and body-bearing identities", async () => {
  for (const badMetadata of [
    metadata({ providerId: "claude" }), metadata({ archivedAt: 3 }), metadata({ deletedAt: 3 }), metadata({ visibility: "hidden" }), metadata({ prompt: "body" }),
  ]) await assert.rejects(() => readBbEventIdentity(port([identity(), terminal()], { metas: [badMetadata] }), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(), terminal()]), { threadId: THREAD, expectedProviderThreadId: "native-session-id" }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(), terminal(2, "completed", "checkpoint", "turn"), identity(3, "foreign")]), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([terminal()]), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([{ ...identity(), data: { providerThreadId: PROVIDER, message: "body" } }]), { threadId: THREAD }), BbEventIdentityAdapterError);
});

test("rejects unallowlisted events, malformed terminal shapes, duplicate/reordered/cross-thread pages, and source changes", async () => {
  const invalid = [
    { ...identity(), type: "item/completed" },
    { ...identity(), threadId: "other-thread" },
    { ...identity(), scope: { kind: "thread", body: "no" } },
    { ...terminal(), data: { providerThreadId: PROVIDER, status: "completed", providerCheckpointId: "ok", nativeSessionId: "must-not-pass" } },
    terminal(2, "failed", "forbidden"),
  ];
  for (const event of invalid) await assert.rejects(() => readBbEventIdentity(port([identity(), event]), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(2), terminal(1)]), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(), identity(), terminal()]), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(), terminal()], { mutateReread: true }), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(), terminal()], { metas: [metadata(), metadata({ updatedAt: 3 })] }), { threadId: THREAD }), BbEventIdentityAdapterError);
  await assert.rejects(() => readBbEventIdentity(port([identity(), terminal()], { metas: [metadata(), metadata(), metadata({ updatedAt: 3 })] }), { threadId: THREAD }), BbEventIdentityAdapterError, "a change after scan two is fenced");
});

test("rejects empty, oversized, and bounded-out event scans", async () => {
  await assert.rejects(() => readBbEventIdentity(port([]), { threadId: THREAD }), BbEventIdentityAdapterError);
  const tooMany = Array.from({ length: 17 }, (_, index) => index === 0 ? identity(1) : terminal(index + 1));
  await assert.rejects(() => readBbEventIdentity(port(tooMany), { threadId: THREAD, pageSize: 1, maxPages: 16 }), BbEventIdentityAdapterError);
});
