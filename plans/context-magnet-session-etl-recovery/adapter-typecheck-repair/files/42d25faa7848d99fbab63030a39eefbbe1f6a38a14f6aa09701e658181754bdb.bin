/**
 * Bounded, bodyless reader for the two BB events that establish a Codex
 * provider-thread identity and terminal checkpoint.  This intentionally owns
 * no HTTP transport: the host supplies an authorized, server-filtered port.
 */
import { createHash } from "node:crypto";

export const BB_IDENTITY_EVENT_TYPES = ["thread/identity", "turn/completed"] as const;

const MAX_PAGE_SIZE = 100;
const DEFAULT_PAGE_SIZE = 64;
const DEFAULT_MAX_PAGES = 16;
const MAX_TEXT = 512;

type Row = Record<string, unknown>;
type Lifecycle = "completed" | "failed" | "interrupted";

export type BbEventIdentityPort = Readonly<{
  getThreadMetadata(threadId: string): Promise<unknown>;
  listThreadEvents(request: Readonly<{
    threadId: string;
    types: readonly ["thread/identity", "turn/completed"];
    order: "asc";
    limit: string;
    afterSeq?: string;
  }>): Promise<unknown>;
}>;

export type BbEventIdentityOptions = Readonly<{
  threadId: string;
  /** An independently obtained provider-thread id; never inferred from a native session. */
  expectedProviderThreadId?: string;
  pageSize?: number;
  maxPages?: number;
}>;

export type BbEventIdentityFact = Readonly<{
  kind: "identity" | "terminal";
  eventSeq: number;
  providerThreadSlot: string;
  lifecycle?: Lifecycle;
  turnSlot?: string;
  checkpointSlot?: string;
  locator: Readonly<{ source: "bb"; ref: string; redacted: true }>;
}>;

export type BbTerminalCheckpoint = Readonly<{
  state: "succeeded" | "failed" | "interrupted" | "unknown";
  lifecycle?: Lifecycle;
  eventSeq?: number;
  turnSlot?: string;
  /** Present only for a completed terminal event that actually carried it. */
  checkpointSlot?: string;
}>;

export type BbEventIdentitySnapshot = Readonly<{
  threadSlot: string;
  providerId: "codex";
  providerThreadSlot: string;
  eventHighWatermark: number;
  terminalCheckpoint: BbTerminalCheckpoint;
  facts: readonly BbEventIdentityFact[];
  gaps: readonly Readonly<{ reason: "missing-terminal-event" | "missing-checkpoint" | "terminal-failed" | "terminal-interrupted"; eventSeq?: number }>[];
}>;

export class BbEventIdentityAdapterError extends Error {}

type Metadata = Readonly<{ id: string; providerId: "codex"; status: string; updatedAt: number; visibility: "visible" }>;
type Event = Readonly<{
  seq: number;
  type: "thread/identity" | "turn/completed";
  providerThreadId: string;
  turnId?: string;
  lifecycle?: Lifecycle;
  checkpointId?: string;
}>;

const metadataKeys = new Set([
  "id", "projectId", "environmentId", "providerId", "title", "titleFallback", "sectionId", "status", "parentThreadId", "sourceThreadId", "originKind", "originPluginId", "visibility", "archivedAt", "pinnedAt", "deletedAt", "lastReadAt", "latestAttentionAt", "createdAt", "updatedAt", "runtime", "activeBackgroundAgentCount", "canSpawnChild", "queuedMessageCount",
]);
const envelopeKeys = new Set(["id", "scope", "threadId", "seq", "createdAt", "type", "data"]);

/** Read an exhaustive, stable bounded identity snapshot. Any ambiguity rejects. */
export async function readBbEventIdentity(port: BbEventIdentityPort, options: BbEventIdentityOptions): Promise<BbEventIdentitySnapshot> {
  const request = validateOptions(options);
  const before = decodeMetadata(await port.getThreadMetadata(request.threadId), request.threadId);
  const first = await scan(port, request);
  const middle = decodeMetadata(await port.getThreadMetadata(request.threadId), request.threadId);
  if (!sameMetadata(before, middle)) fail("Thread metadata changed during event read.");
  const reread = await scan(port, request);
  const after = decodeMetadata(await port.getThreadMetadata(request.threadId), request.threadId);
  if (!sameMetadata(middle, after)) fail("Thread metadata changed during reread.");
  if (!sameEvents(first, reread)) fail("Event source changed during reread.");

  const identityEvents = first.filter((event) => event.type === "thread/identity");
  if (!identityEvents.length) fail("Missing thread identity event.");
  const providerThreadId = identityEvents[0]!.providerThreadId;
  for (const event of first) if (event.providerThreadId !== providerThreadId) fail("Conflicting or foreign provider identity.");
  if (request.expectedProviderThreadId !== undefined && request.expectedProviderThreadId !== providerThreadId) fail("Provider identity differs from the independently supplied identity.");

  const facts: BbEventIdentityFact[] = first.map((event) => Object.freeze({
    kind: event.type === "thread/identity" ? "identity" : "terminal",
    eventSeq: event.seq,
    providerThreadSlot: slot(event.providerThreadId),
    ...(event.lifecycle === undefined ? {} : { lifecycle: event.lifecycle }),
    ...(event.turnId === undefined ? {} : { turnSlot: slot(event.turnId) }),
    ...(event.checkpointId === undefined ? {} : { checkpointSlot: slot(event.checkpointId) }),
    locator: Object.freeze({ source: "bb" as const, ref: `thread-event:${event.seq}`, redacted: true as const }),
  }));
  const terminal = [...first].reverse().find((event) => event.type === "turn/completed");
  const gaps: Array<{ reason: "missing-terminal-event" | "missing-checkpoint" | "terminal-failed" | "terminal-interrupted"; eventSeq?: number }> = [];
  let terminalCheckpoint: BbTerminalCheckpoint;
  if (!terminal) {
    gaps.push(Object.freeze({ reason: "missing-terminal-event" }));
    terminalCheckpoint = Object.freeze({ state: "unknown" });
  } else if (terminal.lifecycle === "completed" && terminal.checkpointId !== undefined) {
    terminalCheckpoint = Object.freeze({ state: "succeeded", lifecycle: terminal.lifecycle, eventSeq: terminal.seq, ...(terminal.turnId === undefined ? {} : { turnSlot: slot(terminal.turnId) }), checkpointSlot: slot(terminal.checkpointId) });
  } else if (terminal.lifecycle === "completed") {
    gaps.push(Object.freeze({ reason: "missing-checkpoint", eventSeq: terminal.seq }));
    terminalCheckpoint = Object.freeze({ state: "unknown", lifecycle: terminal.lifecycle, eventSeq: terminal.seq, ...(terminal.turnId === undefined ? {} : { turnSlot: slot(terminal.turnId) }) });
  } else {
    const reason = terminal.lifecycle === "failed" ? "terminal-failed" : "terminal-interrupted";
    gaps.push(Object.freeze({ reason, eventSeq: terminal.seq }));
    terminalCheckpoint = Object.freeze({ state: terminal.lifecycle, lifecycle: terminal.lifecycle, eventSeq: terminal.seq, ...(terminal.turnId === undefined ? {} : { turnSlot: slot(terminal.turnId) }) });
  }
  return Object.freeze({
    threadSlot: slot(request.threadId), providerId: "codex", providerThreadSlot: slot(providerThreadId),
    eventHighWatermark: first.at(-1)!.seq, terminalCheckpoint,
    facts: Object.freeze(facts), gaps: Object.freeze(gaps),
  });
}

/** Alias retained for callers that name this boundary after its output. */
export const readBbEventIdentitySnapshot = readBbEventIdentity;

function validateOptions(options: BbEventIdentityOptions) {
  if (!isText(options.threadId) || (options.expectedProviderThreadId !== undefined && !isText(options.expectedProviderThreadId))) fail("Invalid identity read request.");
  const pageSize = options.pageSize ?? DEFAULT_PAGE_SIZE;
  const maxPages = options.maxPages ?? DEFAULT_MAX_PAGES;
  if (!Number.isSafeInteger(pageSize) || pageSize < 1 || pageSize > MAX_PAGE_SIZE || !Number.isSafeInteger(maxPages) || maxPages < 1 || maxPages > DEFAULT_MAX_PAGES) fail("Invalid identity read bounds.");
  return { threadId: options.threadId, expectedProviderThreadId: options.expectedProviderThreadId, pageSize, maxPages };
}

async function scan(port: BbEventIdentityPort, request: ReturnType<typeof validateOptions>): Promise<readonly Event[]> {
  const events: Event[] = [];
  let afterSeq: number | undefined;
  for (let pageNumber = 0; pageNumber < request.maxPages; pageNumber++) {
    const raw = await port.listThreadEvents({ threadId: request.threadId, types: BB_IDENTITY_EVENT_TYPES, order: "asc", limit: String(request.pageSize), ...(afterSeq === undefined ? {} : { afterSeq: String(afterSeq) }) });
    if (!Array.isArray(raw) || raw.length > request.pageSize) fail("Invalid or oversized event page.");
    if (raw.length === 0) {
      if (events.length === 0 || events.length % request.pageSize === 0) fail("Empty or saturated event page cannot prove completeness.");
      return Object.freeze(events);
    }
    for (const value of raw) {
      const event = decodeEvent(value, request.threadId);
      if (afterSeq !== undefined && event.seq <= afterSeq) fail("Reordered, duplicate, or cross-page event sequence.");
      if (events.length && event.seq <= events.at(-1)!.seq) fail("Reordered or duplicate event sequence.");
      events.push(event);
      afterSeq = event.seq;
    }
    if (raw.length < request.pageSize) return Object.freeze(events);
  }
  fail("Event page bound exceeded or saturated.");
}

function decodeMetadata(value: unknown, threadId: string): Metadata {
  const row = object(value, "Invalid bodyless thread metadata.");
  exactKeys(row, metadataKeys, "Unexpected thread metadata field.");
  const id = row.id, status = row.status, updatedAt = row.updatedAt;
  if (id !== threadId || row.providerId !== "codex" || row.archivedAt !== null || row.deletedAt !== null || row.visibility !== "visible" || !isText(status) || !isFiniteNumber(updatedAt)) fail("Missing, unauthorized, archived, deleted, provider-neutral, or foreign thread metadata.");
  return Object.freeze({ id, providerId: "codex", status, updatedAt, visibility: "visible" });
}

function decodeEvent(value: unknown, threadId: string): Event {
  const row = object(value, "Invalid event envelope.");
  exactKeys(row, envelopeKeys, "Unexpected event envelope field.");
  const seq = row.seq;
  if (!isText(row.id) || row.threadId !== threadId || !isPositiveSafeInteger(seq) || !isFiniteNumber(row.createdAt) || (row.type !== "thread/identity" && row.type !== "turn/completed")) fail("Invalid event identity or sequence.");
  const scope = object(row.scope, "Invalid event scope.");
  const data = object(row.data, "Invalid event data.");
  if (row.type === "thread/identity") {
    exactKeys(scope, new Set(["kind"]), "Unexpected identity scope field.");
    exactKeys(data, new Set(["providerThreadId"]), "Unexpected identity data field.");
    const providerThreadId = data.providerThreadId;
    if (scope.kind !== "thread" || !isText(providerThreadId)) fail("Invalid provider-neutral identity event.");
    return Object.freeze({ seq, type: row.type, providerThreadId });
  }
  exactKeys(scope, new Set(["kind", "turnId"]), "Unexpected terminal scope field.");
  exactKeys(data, new Set(["providerThreadId", "status", "providerCheckpointId"]), "Unexpected terminal data field.");
  const turnId = scope.turnId, providerThreadId = data.providerThreadId, lifecycle = data.status, checkpointId = data.providerCheckpointId;
  if (scope.kind !== "turn" || !isText(turnId) || !isText(providerThreadId) || !isLifecycle(lifecycle)) fail("Invalid terminal identity event.");
  let checkpoint: string | undefined;
  if (checkpointId !== undefined) {
    if (!isText(checkpointId)) fail("Invalid terminal checkpoint.");
    checkpoint = checkpointId;
  }
  if (lifecycle !== "completed" && checkpoint !== undefined) fail("A non-completed terminal event cannot carry a checkpoint.");
  return Object.freeze({ seq, type: row.type, providerThreadId, turnId, lifecycle, ...(checkpoint === undefined ? {} : { checkpointId: checkpoint }) });
}

function sameMetadata(left: Metadata, right: Metadata): boolean { return left.id === right.id && left.providerId === right.providerId && left.status === right.status && left.updatedAt === right.updatedAt && left.visibility === right.visibility; }
function sameEvents(left: readonly Event[], right: readonly Event[]): boolean { return left.length === right.length && left.every((event, index) => JSON.stringify(event) === JSON.stringify(right[index])); }
function object(value: unknown, message: string): Row { if (value === null || typeof value !== "object" || Array.isArray(value)) fail(message); return value as Row; }
function exactKeys(value: Row, allowed: ReadonlySet<string>, message: string): void { if (!Object.keys(value).every((key) => allowed.has(key))) fail(message); }
function isText(value: unknown): value is string { return typeof value === "string" && value.length > 0 && value.length <= MAX_TEXT; }
function isFiniteNumber(value: unknown): value is number { return typeof value === "number" && Number.isFinite(value); }
function isPositiveSafeInteger(value: unknown): value is number { return typeof value === "number" && Number.isSafeInteger(value) && value > 0; }
function isLifecycle(value: unknown): value is Lifecycle { return value === "completed" || value === "failed" || value === "interrupted"; }
/** Shared canonical identifier encoding; typed fields preserve semantic roles. */
function slot(value: string): string { return `sha256:${createHash("sha256").update(value, "utf8").digest("hex")}`; }
function fail(message: string): never { throw new BbEventIdentityAdapterError(message); }
