export function requireUnambiguousOwner(candidates: Array<{ enabled: boolean; draining: boolean }>, migrationClaims: number): void { if (!Number.isSafeInteger(migrationClaims) || migrationClaims !== 0 || candidates.length !== 1 || candidates[0]?.enabled !== true || candidates[0]?.draining !== false) throw new Error("ambiguous owner"); }

async function json(url: string): Promise<unknown> {
  const controller = new AbortController(), timer = setTimeout(() => controller.abort(), MAX_WALL_MS);
  try { const response = await fetch(url, { signal: controller.signal, headers: { accept: "application/json" } }); if (!response.ok) throw new Error("BB REST " + response.status); const reader = response.body?.getReader(); if (!reader) throw new Error("missing REST body"); const chunks: Uint8Array[] = []; let bytes = 0; for (;;) { const part = await reader.read(); if (part.done) break; bytes += part.value.byteLength; if (bytes > MAX_HTTP_BYTES) { await reader.cancel(); throw new Error("REST body exceeds bound"); } chunks.push(part.value); } return JSON.parse(Buffer.concat(chunks).toString("utf8")); } finally { clearTimeout(timer); }
