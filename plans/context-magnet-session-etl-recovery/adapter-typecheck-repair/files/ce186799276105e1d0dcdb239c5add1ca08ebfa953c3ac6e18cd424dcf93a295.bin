async function identity(): Promise<Identity> { const base = process.env.BB_SERVER_URL; if (!base) throw new Error("BB_SERVER_URL absent"); return validateIdentityProjection(await json(base + "/api/v1/threads/" + TARGET), await json(base + "/api/v1/threads/" + TARGET + "/events?types=thread%2Fidentity%2Cturn%2Fcompleted&order=asc&limit=100")); }
async function route(providerThreadId: string): Promise<Route> {
