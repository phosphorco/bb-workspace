  const script = 'import { Database } from "bun:sqlite"; import { createHash } from "node:crypto"; const db=new Database(' + JSON.stringify(DB) + ',{readonly:true,create:false}); try { const rows=db.query("select r.account_id owner,a.codex_home home,r.rollout_path rollout,r.revision revision,a.enabled enabled,a.draining draining from routes r join accounts a on a.id=r.account_id where r.thread_id=?").all(process.argv[1]); const claim=db.query("select count(*) count from migration_claims where thread_id=?").get(process.argv[1]); if(rows.length!==1||rows[0].enabled!==1||rows[0].draining!==0||Number(claim.count)!==0)throw new Error("ambiguous owner"); const x=rows[0],h=(v)=>createHash("sha256").update(String(v)).digest("hex"); console.log(JSON.stringify({owner:x.owner,home:x.home,rollout:x.rollout,revision:x.revision,slot:h(x.owner),routeDigest:h(JSON.stringify({owner:x.owner,revision:x.revision,rollout:h(x.rollout)}))})); } finally {db.close()}';
  const child = spawnSync(BUN, ["--eval", script, providerThreadId], { encoding: "buffer", maxBuffer: MAX_HTTP_BYTES }); if (child.status !== 0 || !child.stdout || child.stdout.length > MAX_HTTP_BYTES) throw new Error("readonly route projection failed"); const value = row(JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(child.stdout))); if (!value || !only(value, ["owner", "home", "rollout", "revision", "slot", "routeDigest"]) || !Number.isSafeInteger(value.revision)) throw new Error("invalid route projection"); return { owner: text(value.owner, "owner"), home: text(value.home, "home", 4096), rollout: text(value.rollout, "rollout", 4096), revision: value.revision as number, slot: text(value.slot, "slot"), routeDigest: text(value.routeDigest, "routeDigest") };
}
function processes(): string { const names: string[] = []; for (const entry of readdirSync("/proc", { withFileTypes: true })) if (/^\d+$/.test(entry.name)) try { if (readFileSync("/proc/" + entry.name + "/comm", "utf8").trim() === "codex") names.push(entry.name); } catch {} return hash(names.sort().join("\n")); }
function workspace(): string { const result = spawnSync("git", ["-C", resolve(import.meta.dirname, "../../../.."), "status", "--porcelain=v1", "-uno"], { encoding: "buffer", maxBuffer: MAX_HTTP_BYTES }); if (result.status !== 0 || !result.stdout) throw new Error("workspace fingerprint failed"); return hash(result.stdout); }
async function snapshot(): Promise<Snapshot> { const i = await identity(), r = await route(i.providerThreadId); return { identity: i, route: r, processes: processes(), workspace: workspace() }; }
export function safeRollout(route: Route): { fd: number; before: string } { const home = realpathSync(route.home); let fd: number | undefined; try { const link = lstatSync(route.rollout); if (!link.isFile() || link.isSymbolicLink() || link.size > MAX_ROLLOUT_BYTES) throw new Error("unsafe rollout file"); fd = openSync(route.rollout, constants.O_RDONLY | constants.O_NOFOLLOW); const stat = fstatSync(fd), opened = realpathSync("/proc/self/fd/" + fd), rel = relative(home, opened); if (!stat.isFile() || stat.size > MAX_ROLLOUT_BYTES || rel === "" || rel.startsWith("..") || isAbsolute(rel) || statIdentity(link) !== statIdentity(stat)) throw new Error("rollout identity raced or escaped"); return { fd, before: statIdentity(stat) }; } catch (error) { if (fd !== undefined) closeSync(fd); throw error; } }
export function rolloutIdentity(route: Route): string { const file = safeRollout(route); try { return file.before; } finally { closeSync(file.fd); } }
/** Isolated provisional parser: the eventual ETL owns its durable format. */
export function parseProvisionalContextMagnetReceipt(serialized: string, expectedSessionId: string, expectedTurnId: string): "context-receipt" | "not-provisional" | "invalid-context-receipt" {
