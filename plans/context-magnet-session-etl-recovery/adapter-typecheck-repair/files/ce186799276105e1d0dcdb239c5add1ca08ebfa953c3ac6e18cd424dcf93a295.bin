export function redactedIdentityRelation(providerThreadId: string, sessionId: string, nativeId: string): { providerSlot: string; sessionSlot: string; nativeIdSlot: string; providerEqualsSession: boolean; providerDivergesFromSession: boolean; nativeIdEqualsSession: boolean } { const providerEqualsSession = providerThreadId === sessionId; return { providerSlot: "sha256:" + hash(providerThreadId), sessionSlot: "sha256:" + hash(sessionId), nativeIdSlot: "sha256:" + hash(nativeId), providerEqualsSession, providerDivergesFromSession: !providerEqualsSession, nativeIdEqualsSession: nativeId === sessionId }; }
