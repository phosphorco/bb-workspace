type Parse = { records: number; turns: number; contexts: number; hookCarriers: number; receiptCount: number; receiptGap: string; sessionId: string; nativeId: string };
function consumeRecord(line: string, ordinal: number, state: { meta: boolean; sessionId: string; nativeId: string; contexts: number; hooks: number; receipts: number; turns: Set<string> }, limits: { line: number; records: number; turns: number; contexts: number; deadline: number }): void {
