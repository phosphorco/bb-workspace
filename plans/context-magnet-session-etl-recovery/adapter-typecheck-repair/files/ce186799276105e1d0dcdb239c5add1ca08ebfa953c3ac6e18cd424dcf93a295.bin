  const result: Identity = { updatedAt: meta.updatedAt, status: meta.status, highWatermark: -1, providerThreadId: "", checkpointId: null }; let provider: string | null = null, sawIdentity = false;
  for (const event of events) { const e = row(event), data = row(e?.data), scope = row(e?.scope); if (!e || !data || !scope || !only(e, ["id", "scope", "threadId", "seq", "createdAt", "type", "data"]) || e.threadId !== target || !Number.isSafeInteger(e.seq)) throw new Error("invalid event envelope");
