{
  "kind": "context-magnet-session-etl-plugin-runtime-preimage",
  "version": 3,
  "fixtureOnly": true,
  "actionableLivePreimage": false,
  "liveMutatorsExecuted": false,
  "assertion": "full backup-v1 capture and identity were validated in memory only",
  "controlledSet": {
    "plugins": [
      "context-magnet-inspector",
      "subscription-router"
    ],
    "requiredDistArtifacts": [
      "app.css",
      "app.js",
      "app.meta.json",
      "server.js",
      "server.js.map",
      "server.meta.json"
    ],
    "router": "launcher-manifest-active-generation",
    "hook": "shared-record-authoritative-status"
  },
  "commandAllowlist": [
    "build-inspector",
    "build-router",
    "reload-inspector",
    "reload-router",
    "install-router",
    "install-hooks",
    "status-hooks"
  ]
}
