    module.produced(forkFreeLiveCaptureRepair); module.verified(forkFreeLiveCaptureRepair)
    module.produced(forkFreeLifecycleAwaitRepair); module.verified(forkFreeLifecycleAwaitRepair)
  }
  observes {
    "\(p)/**"; "/home/ubuntu/.bb/bb.db"; "/home/ubuntu/.bb/plugins/analytics/data.db"
  }
  outcome = "Using only the existing public SDK and retained BB events, refresh Analytics and prove that probe thread thr_tn5pxvdf7j contributes bb-performant-react prompt mention and registered-path command candidates, including its reference-path candidate and enclosing execution outcome. Prove the current BB-visible catalog snapshot contains the exact skill revision. Do not upgrade the joined shell command into an individual successful read, staged runtime membership, provider access/use or injected tokens."
  oracle = module.adjudicated("The live Analytics result is non-empty and traceable to public source event IDs from thr_tn5pxvdf7j plus a current sdk.skills snapshot. Raw drilldown shows seq 1 and the correlated seq 32/33 command item, retains the joined/shell-wrapped attribution limitation, and does not depend on skill/observed. The reviewer distinguishes a BB-visible current snapshot from private staged runtime membership and unknown historical revision, treats absence of a matching command as incomplete/unsupported provider access coverage, and confirms aggregate token snapshots were not apportioned.", "reviewer")
}

local forkFreeCompatibility = new Guard {
  id = "skills-fork-free-compatibility"
  owner = "implementer"
  needs {
    module.verified(forkFreeLive)
    module.produced(forkFreeStaleWhileRefresh); module.verified(forkFreeStaleWhileRefresh)
  }
  observes { "fork/**"; "community-plugins/**"; "bin/check" }
  outcome = "Verify the fork-free plugin at final identities: the core fork has no Skills Analytics campaign changes or patch 0022, community tests/typecheck/build pass, existing Analytics dashboards remain compatible, and the normal workspace contract passes."
  oracle = module.mechanical("git -C fork/upstream diff --quiet && test -z \"$(git -C fork/upstream ls-files --others --exclude-standard)\" && test ! -e fork/patches/0022-feat-skills-observe-runtime-and-provider-lifecycle.patch && node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite fork-free-composition --timeout-ms 120000 --total-timeout-ms 300000 && npm --prefix community-plugins run test && npm --prefix community-plugins run typecheck && npm --prefix community-plugins run build && ./bin/check --role normal")
}

local forkFreeStaleWhileRefresh = new Action {
  id = "skills-fork-free-stale-while-refresh"
  owner = "implementer"
  needs { module.verified(forkFreeLive) }
  grant {
    "\(p)/server.ts"; "\(s)/composition/fork-free/**"
    "\(s)/suites/fork-free-composition.mjs"
  }
  outcome = "When a selected partition already has a complete retained catalog snapshot, return the bounded Skills query from SQLite immediately without starting database-backed work that can outlive the RPC invocation. Refresh that partition through the existing awaited lifecycle/manual-refresh paths, which preserve bounded degraded/error status and last-good rows. An empty selection may still await its first bounded bootstrap. Prove a slow or failed source refresh cannot make a populated page hang, clear the retained snapshot, leak an unhandled rejection, or touch SQLite after the handler returns."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite fork-free-composition --negative-control core-event-dependency,false-read,false-unused,cross-partition-concurrency,repeated-active-rescan,selected-snapshot-coverage,detached-lifecycle-capture,blocking-stale-query --timeout-ms 120000 --total-timeout-ms 300000 && npm --prefix community-plugins run typecheck && npm --prefix community-plugins run test && npm --prefix community-plugins run build")
}

local forkFreeHandoff = new Action {
  id = "skills-fork-free-handoff"
  owner = "implementer"
  needs { module.verified(forkFreeLive); module.verified(forkFreeCompatibility) }
  grant { "\(p)/README.md"; "\(p)/docs/skills-analytics.md"; "\(e)/final/fork-free-*.md" }
  outcome = "Document the fork-free evidence model, exact public SDK calls, live probe result, current-versus-historical catalog boundary, shell attribution caveats, content-footprint estimates, reproduction commands and unsupported claims. Explicitly supersede the earlier fork-dependent handoff."
  oracle = module.adjudicated("The documentation matches the live non-empty page and can reconstruct every claim from public SDK catalog snapshots and retained public thread events. It explicitly says the joined probe command proves lexical attempts and an enclosing execution outcome, not individual reads, activation, provider delivery or per-skill token consumption. The BB core fork remains unchanged.", "reviewer")
}

local forkFreeFinalReview = new Guard {
  id = "skills-fork-free-outcome-review"
  owner = "reviewer"
  needs {
    module.produced(forkFreeHandoff); module.verified(forkFreeHandoff)
    module.verified(forkFreeLive); module.verified(forkFreeCompatibility)
  }
  observes {
    "plans/skills-analytics.plan.pkl"; "plans/skills-analytics.ledger.jsonl"
    "\(e)/**"; "fork/**"; "\(p)/**"
  }
  outcome = "Judge the superseding fork-free Skills Analytics outcome. This review does not publish, deploy or promote a host."
  oracle = module.adjudicated("The live page is populated from existing public BB data; shows exact BB-visible current catalog revisions and conservative Codex prompt/registered-path command evidence with raw thread/event drilldown; labels missing matching commands as incomplete provider-access coverage rather than not-used; never upgrades shell execution into individual file-read, staged membership, provider delivery/use, activation, instruction-effect or token-consumption claims; reports content footprint separately from aggregate thread token usage; preserves existing Analytics; and leaves fork/upstream and the durable patch queue free of Skills Analytics core changes.", "reviewer")
}

