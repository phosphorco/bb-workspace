amends "workbench:plan"

meta {
  title = "Skills analytics: fork-free catalog and access evidence"
  goal = "Deliver an internal Analytics page using only the existing public BB plugin SDK: snapshot the current BB-visible skill catalog, backfill and retain conservative Codex prompt and registered-path command evidence from thread events, show exact evidence limits and content-footprint estimates, and leave the BB core fork unchanged."
}

// This is a delivery plan, not an execution receipt. The sibling ledger owns
// observations and decisions. Existing Analytics delivery evidence is an input;
// it is not copied into this campaign.
local p = "community-plugins/plugins/analytics"
local s = "community-plugins/plugins/analytics/test/skills"
local u = "fork/upstream"
local e = "plans/skills-analytics"

local foundation = new Guard {
  id = "analytics-foundation-review"
  owner = "reviewer"
  observes {
    "plans/analytics-delivery.plan.pkl"; "plans/analytics-delivery.ledger.jsonl"
    "plans/analytics.plan.pkl"; "plans/analytics.ledger.jsonl"
    "\(p)/**"; "\(u)/apps/server/src/services/threads/**"
    "\(u)/packages/agent-runtime/**"; "\(u)/plugins/provider-codex/**"
    "\(u)/plugins/provider-claude-code/**"
  }
  outcome = "Establish the exact Analytics and BB runtime revisions this campaign extends, the current retained-fact/query/UI path, outstanding work in analytics-delivery, and one coordinated writer for every shared file. Record which existing contracts and evidence remain valid and which skills work must wait for or amend them."
  oracle = module.adjudicated("The review maps every shared write footprint to the active Analytics delivery graph and current source. It identifies the usable retained-fact, query, reference and UI seams; does not import historical green states; and names an ordering or narrower ownership rule for every overlap. Current dirty work remains preserved.", "reviewer")
}

local historyPolicy = new Selector {
  id = "skills-history-policy"
  owner = "reviewer"
  needs { module.verified(foundation) }
  question = "How should sessions created before skill-observation instrumentation be represented?"
  options { "prospective-only-with-explicit-preinstrumentation-coverage"; "bounded-historical-reconstruction" }
}

// These receipts make the active analytics-delivery campaign an executable
// dependency instead of relying on reviewer prose to prevent concurrent edits.
local retentionRelease = new Guard {
  id = "analytics-retention-seam-release"
  owner = "reviewer"
  needs { module.verified(foundation) }
  observes { "plans/analytics-delivery.plan.pkl"; "plans/analytics-delivery.ledger.jsonl"; "\(p)/store.ts"; "\(p)/extraction/**" }
  outcome = "Accept the completed analytics-delivery retained-fact source identity or a precise additive ownership transfer for skill tables, migrations and extraction."
  oracle = module.adjudicated("The analytics-delivery retained-fact-projection has a current pass or its owner records an explicit non-overlapping seam. The receipt names source hashes, allowed skill-only files, migration allocation and required revalidation. There is one writer for store/extraction files.", "reviewer")
}

local queryRelease = new Guard {
  id = "analytics-query-seam-release"
  owner = "reviewer"
  needs { module.verified(foundation) }
  observes { "plans/analytics-delivery.plan.pkl"; "plans/analytics-delivery.ledger.jsonl"; "\(p)/query-runtime/**"; "\(p)/builtin-bundles.ts"; "\(p)/bundle-contract.ts" }
  outcome = "Accept the completed analytics-delivery query/cutover identity or an additive Skills bundle seam that does not change shared query contracts."
  oracle = module.adjudicated("The receipt names the released source identity and owner. Early Skills work is limited to additive bundle definitions and isolated fixtures; any core runtime, policy, verifier or execution-contract change is serialized and reruns affected delivery proofs.", "reviewer")
}

local uiComposeRelease = new Guard {
  id = "analytics-ui-compose-seam-release"
  owner = "reviewer"
  needs { module.verified(foundation) }
  observes { "plans/analytics-delivery.plan.pkl"; "plans/analytics-delivery.ledger.jsonl"; "\(p)/app.tsx"; "\(p)/app.css"; "\(p)/server.ts"; "\(p)/rpc-contract.ts"; "\(p)/package.json" }
  outcome = "Accept either the analytics-delivery execution-backed UI/cutover handoff or a precise additive internal-Skills ownership transfer before Skills changes shared application, RPC or dependency files."
  oracle = module.adjudicated("The receipt names the released source identity, app/server/package owner and revalidation commands. If the broader Analytics cutover remains externally blocked, a narrow Skills-only transfer is allowed only while shared files are clean and unclaimed, uses the bounded direct-store contract selected by this plan, preserves the existing tool dashboard path, and assigns exactly one compose writer. The final composition must rerun the current Analytics execution-backed UI oracle plus community typecheck/test/build.", "reviewer")
}

local compositionPolicy = new Selector {
  id = "skills-composition-policy"
  owner = "reviewer"
  needs { module.verified(foundation) }
  question = "Should the internal Skills page compose through a bounded direct SQLite/RPC surface now, or wait for the broader Analytics shared execution/reference cutover?"
  options { "additive-internal-direct-store"; "wait-for-shared-execution-cutover" }
}

local bootstrap = new Action {
  id = "skills-acceptance-bootstrap"
  owner = "implementer"
  needs { module.verified(foundation) }
  grant {
    "\(s)/acceptance.mjs"; "\(s)/runner/**"
    "\(s)/suites/observability-probe.mjs"; "\(s)/suites/runtime-contract.mjs"
    "\(s)/suites/analytics-contract.mjs"; "\(s)/fixtures/bootstrap/**"
  }
  outcome = "Create the bounded Skills acceptance runner and the initial discovery/contract suite entrypoints before any node invokes them. Missing suites, rejected imports, malformed observations, timeouts and controlled wrong values fail closed."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --self-check --negative-control missing-suite,rejected-import,wrong-value --timeout-ms 30000")
}

local probeBuild = new Action {
  id = "skills-observability-probe"
  owner = "implementer"
  needs { module.verified(foundation); module.produced(bootstrap); module.verified(bootstrap) }
  grant {
    "\(s)/probes/**"; "\(e)/evidence/provider-observability.md"
  }
  outcome = "Build bounded probes for Codex and Claude Code that capture resolved catalogs, busy-runtime deferral, skills/configure acknowledgment, any provider-visible catalog/native skill signal, registered SKILL.md and subtree reads, context snapshots and token reports. Probe every claimed signal rather than assuming provider parity. Preserve task-scoped raw fixtures and bounded normalized evidence needed to explain observations."
  oracle = module.adjudicated("The probes exercise real bridge/runtime shapes with controlled skill roots and known reads. They separate resolved, active-staged, bridge-acknowledged, provider-observed, activated and subtree-read states. They confirm Claude Read attribution and frontmatter estimates and either prove or mark unsupported Codex activation/body attribution. Token evidence names provider/model/tokenizer/serializer/method and never apportions aggregate usage.", "reviewer")
}

local probe = new Guard {
  id = "skills-observability-evidence"
  owner = "implementer"
  needs { module.produced(probeBuild); module.verified(probeBuild) }
  observes { "\(s)/probes/**"; "\(e)/evidence/provider-observability.md" }
  outcome = "Run the provider probes and publish the exact signal and token-accounting matrix that the runtime and Analytics contracts can implement."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite observability-probe --timeout-ms 120000")
}

local measurement = new Guard {
  id = "skill-capability-and-measurement-policy"
  owner = "reviewer"
  needs { module.verified(probe); module.ruled(historyPolicy) }
  observes { "\(s)/probes/**"; "\(e)/evidence/provider-observability.md" }
  outcome = "Freeze the supported lifecycle evidence, revision identity, capture grain, denominators and token measurement semantics that contracts and parallel lanes may claim."
  oracle = module.adjudicated("The policy distinguishes resolved versus active catalogs, bridge acknowledgment versus provider observation, SKILL.md read versus instruction effect, and content footprint versus context occupancy or input consumption. Revision identity covers the declared SKILL.md/tree scope. Session-only observations may have no turn. Unsupported and aggregate-only measurements remain nullable. Historical pre-instrumentation sessions follow the ruled policy and are never silently counted as zero.", "reviewer")
}

local runtimeContract = new Action {
  id = "skill-runtime-event-contract"
  owner = "implementer"
  needs {
    module.verified(measurement); module.ruled(historyPolicy)
    module.produced(bootstrap); module.verified(bootstrap)
  }
  grant {
    "\(u)/packages/domain/src/provider-event.ts"
    "\(u)/packages/domain/src/**/skill*.ts"
    "\(u)/packages/provider-bridge-protocol/src/**"
    "\(u)/packages/host-daemon-contract/src/commands.ts"
    "\(u)/docs/provider-bridge-protocol.md"
    "\(s)/contracts/runtime-events/**"
  }
  outcome = "Define durable typed runtime observations for catalog resolution, active staging, bridge acknowledgment, provider observation, activation/read evidence and named token measurements. Preserve full internal identifiers, skill paths, source/plugin identity, actor/principal, SKILL.md and tree revisions, provider/model/session identity, nullable turn identity, capture trigger, failure status, exact evidence kind, serializer/tokenizer identity and bounded raw provider metadata. Specify deterministic IDs and deduplication across busy deferral, start, resume, compaction and reconfiguration."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite runtime-contract --timeout-ms 120000")
}

local analyticsContract = new Action {
  id = "skill-analytics-contract"
  owner = "implementer"
  needs {
    module.produced(runtimeContract); module.verified(runtimeContract)
    module.produced(bootstrap); module.verified(bootstrap); module.ruled(historyPolicy)
  }
  grant {
    "\(p)/skill-observation-contract.ts"; "\(p)/skill-fact-schema.ts"
    "\(p)/docs/skill-analytics-contract.md"; "\(s)/contracts/analytics/**"
  }
  outcome = "Define canonical skill lifecycle facts and query semantics. Cover exact skill/tree revision and source, resolved/active/configured/provider-observed/activated/read observations, catalog-entry and body/reference/asset measurements, evidence quality, observability gaps, nullable turn drilldown and deterministic identity. Define exact cohort/window formulas, precedence, missing values and percentile method for activation rate, no-activation-observed, content footprint, context occupancy and attributable consumption without conflating them."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite analytics-contract --timeout-ms 120000")
}

local retentionSurface = new Action {
  id = "skill-observation-retention-surface"
  owner = "implementer"
  needs {
    module.produced(runtimeContract); module.verified(runtimeContract)
    module.ruled(historyPolicy)
  }
  grant {
    "\(u)/packages/provider-bridge-protocol/src/assembler/delta-assembler.ts"
    "\(u)/packages/provider-bridge-protocol/src/assembler/delta-assembler.test.ts"
    "\(u)/packages/host-daemon-contract/src/commands.ts"
    "\(u)/apps/server/src/internal/events.ts"
    "\(u)/apps/server/src/services/threads/thread-events.ts"
    "\(u)/apps/server/src/services/threads/thread-storage.ts"
    "\(u)/apps/server/src/services/threads/thread-data.ts"
    "\(u)/packages/thread-view/src/event-decode.ts"
    "\(s)/retention-surface/**"
  }
  outcome = "Carry one versioned skill observation through the real bridge/domain/daemon/server persistence and public-source boundary, retaining session/thread identity and nullable turn identity across restart. Freeze old-reader behavior, schema allocation, bounded raw evidence and prospective coverage behavior, and update every exhaustive core event decoder before provider or Analytics projection work."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite retention-surface --timeout-ms 120000 --total-timeout-ms 300000 && pnpm --dir fork/upstream --filter @bb/thread-view typecheck && pnpm --dir fork/upstream --filter @bb/server typecheck")
}

local providerInstruments = new Action {
  id = "skill-provider-instruments"
  owner = "implementer"
  needs { module.produced(runtimeContract); module.verified(runtimeContract) }
  grant {
    "\(s)/suites/catalog-delivery.mjs"; "\(s)/suites/provider-codex.mjs"
    "\(s)/suites/provider-claude.mjs"; "\(s)/fixtures/providers/**"
  }
  outcome = "Build independently asserted catalog, Codex and Claude suites with negatives for busy catalog deferral, unsupported native signals, duplicate/late snapshots, missing turn IDs, path collisions, changed tree revisions and aggregate token reports."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite-instrument providers --negative-control wrong-revision,aggregate-apportionment --timeout-ms 30000")
}

local projectionInstrument = new Action {
  id = "skill-projection-instrument"
  owner = "implementer"
  needs { module.produced(analyticsContract); module.verified(analyticsContract) }
  grant { "\(s)/suites/retained-projection.mjs"; "\(s)/fixtures/projection/**"; "\(s)/projection/**" }
  outcome = "Build independently asserted retained-projection and migration fixtures for pre-skill stores, revision changes, duplicates, deletions, interrupted upgrades, coverage epochs and restart."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite-instrument projection --negative-control duplicate-event,interrupted-migration --timeout-ms 30000")
}

local queryUiInstrument = new Action {
  id = "skill-query-ui-instrument"
  owner = "implementer"
  needs { module.produced(analyticsContract); module.verified(analyticsContract) }
  grant {
    "\(s)/suites/dashboard-queries.mjs"; "\(s)/suites/dashboard-ui.mjs"
    "\(s)/fixtures/query-ui/**"; "\(s)/browser/fixtures/**"
  }
  outcome = "Build exact query and browser fixtures that reconcile every aggregate to raw contributing rows under identical filters and test missing telemetry, unequal coverage, same-name skills, multiple revisions, tokenizer/method partitions and pre-instrumentation unknowns."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite-instrument query-ui --negative-control wrong-denominator,pooled-tokenizer --timeout-ms 30000")
}

local catalog = new Action {
  id = "catalog-delivery-instrumentation"
  owner = "implementer"
  needs {
    module.produced(runtimeContract); module.verified(runtimeContract)
    module.produced(retentionSurface); module.verified(retentionSurface)
    module.produced(providerInstruments); module.verified(providerInstruments)
  }
  grant {
    "\(u)/apps/server/src/services/threads/thread-runtime-config.ts"
    "\(u)/apps/server/test/threads/thread-runtime-config.test.ts"
    "\(u)/apps/server/src/services/skills/skill-catalog.ts"
    "\(u)/apps/server/src/services/skills/injected-skills.ts"
    "\(u)/packages/host-daemon-contract/src/commands.ts"
    "\(u)/packages/host-daemon-contract/test/contract.test.ts"
    "\(u)/packages/agent-runtime/src/types.ts"
    "\(u)/packages/agent-runtime/src/runtime.ts"
    "\(u)/packages/agent-runtime/src/runtime-provider-process.ts"
    "\(u)/packages/agent-runtime/src/runtime.lifecycle.test.ts"
    "\(u)/packages/agent-runtime/src/runtime.skill-roots-capability.test.ts"
    "\(u)/packages/agent-runtime/src/integration.skill-roots.test.ts"
    "\(u)/apps/host-daemon/src/injected-skills.ts"
    "\(u)/apps/host-daemon/src/runtime-manager.ts"
    "\(u)/apps/host-daemon/src/injected-skills.test.ts"
    "\(u)/apps/host-daemon/src/runtime-manager.test.ts"
  }
  outcome = "Instrument the common runtime path so resolved, staged-active and bridge-acknowledged catalog revisions are distinct, including busy-runtime deferral. Carry bounded revision/provenance metadata through the typed host command and staged runtime config, and surface the actual skills/configure acknowledgment or failure through AgentRuntimeOptions.onEvent for durable retention. Retain full skill identity, source, path, plugin, description, per-skill/tree hashes, exact serialized catalog fragments and method-tagged token/byte measurements. Record failures and provider-observation support explicitly; avoid multiplying unchanged catalogs on every turn. A bridge acknowledgment proves only successful bridge configuration, never provider ingestion or use."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite catalog-delivery --timeout-ms 120000 && pnpm --dir fork/upstream --filter @bb/host-daemon-contract test && pnpm --dir fork/upstream --filter @bb/host-daemon test -- runtime-manager.test.ts && pnpm --dir fork/upstream --filter @bb/agent-runtime test -- runtime.skill-roots-capability.test.ts integration.skill-roots.test.ts runtime.lifecycle.test.ts")
}

local codex = new Action {
  id = "codex-skill-instrumentation"
  owner = "implementer"
  needs {
    module.produced(runtimeContract); module.verified(runtimeContract)
    module.produced(retentionSurface); module.verified(retentionSurface)
    module.produced(providerInstruments); module.verified(providerInstruments)
  }
  grant {
    "\(u)/plugins/provider-codex/src/**"; "\(s)/provider-codex/**"
  }
  outcome = "Emit Codex observations only for signals proven by the probe. Preserve configuration acknowledgment and bounded raw evidence; add activation/read attribution only if a real native event supports it. Keep aggregate token usage unassigned and mark per-skill activation, body loading or token consumption unsupported when no source exists."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite provider-codex --timeout-ms 120000")
}

local claude = new Action {
  id = "claude-skill-instrumentation"
  owner = "implementer"
  needs {
    module.produced(runtimeContract); module.verified(runtimeContract)
    module.produced(retentionSurface); module.verified(retentionSurface)
    module.produced(providerInstruments); module.verified(providerInstruments)
  }
  grant {
    "\(u)/plugins/provider-claude-code/src/**"; "\(s)/provider-claude/**"
  }
  outcome = "Emit Claude Code bridge-delivery and conservative Read-path observations. Attribute registered SKILL.md and contained subtree reads to the staged tree revision, preserve bounded provider evidence, and persist named skill-frontmatter estimates as session-scoped provider reports with nullable turn. Never label frontmatter estimates as body/reference/asset loading or instruction effect."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite provider-claude --timeout-ms 120000")
}

local providerCatalogIdentity = new Action {
  id = "skill-provider-catalog-identity-integration"
  owner = "implementer"
  needs {
    module.produced(catalog); module.verified(catalog)
    module.produced(codex); module.verified(codex)
    module.produced(claude); module.verified(claude)
  }
  grant {
    "\(u)/packages/provider-bridge-protocol/src/requests.ts"
    "\(u)/packages/provider-bridge-protocol/test/**"
    "\(u)/apps/host-daemon/src/injected-skills.ts"
    "\(u)/apps/host-daemon/src/injected-skills.test.ts"
    "\(u)/plugins/provider-codex/src/bridge/bridge.ts"
    "\(u)/plugins/provider-codex/src/**/*skill*.test.ts"
    "\(u)/plugins/provider-claude-code/src/bridge/skill-instrumentation.ts"
    "\(u)/plugins/provider-claude-code/src/bridge/bridge.ts"
    "\(u)/plugins/provider-claude-code/src/bridge/__tests__/skill-instrumentation.test.ts"
    "\(s)/suites/provider-catalog-identity.mjs"
    "\(s)/fixtures/providers/catalog-identity/**"
  }
  outcome = "Carry each canonical resolved skill identity and catalog revision through the typed skills/configure root into provider bridges. Claude staged-path Read and named-frontmatter observations must reuse the exact source kind, source ID, plugin ID and content revisions from the common catalog while retaining the actual staged read path as evidence; it must not relabel everything data-dir or derive a competing revision. Codex unsupported native observations must carry the configured catalog revision without claiming a skill. Same-name collisions remain ambiguous unless the provider report supplies an exact registered identity."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite provider-catalog-identity --timeout-ms 120000 && pnpm --dir fork/upstream --filter @bb/provider-bridge-protocol test && pnpm --dir fork/upstream --filter bb-plugin-provider-codex typecheck && pnpm --dir fork/upstream --filter bb-plugin-provider-claude-code test -- src/bridge/__tests__/skill-instrumentation.test.ts --maxWorkers=1")
}

local forkMaterialization = new Action {
  id = "skill-fork-patch-materialization"
  owner = "implementer"
  needs {
    module.produced(catalog); module.verified(catalog)
    module.produced(codex); module.verified(codex)
    module.produced(claude); module.verified(claude)
    module.produced(providerCatalogIdentity); module.verified(providerCatalogIdentity)
  }
  grant {
    "fork/patches/**"; "fork/result-tree.lock"; "fork/DOWNSTREAM.md"
    "\(e)/evidence/fork-materialization.md"
    "\(s)/suites/fork-materialization.mjs"
  }
  outcome = "Export the reviewed runtime/provider commits into the ordered durable fork patch queue, refresh patch checksums and result-tree receipt, and prove the materialized source used for verification has that exact tree. Do not treat edits in fork/upstream or generated build/bb as durable delivery."
  oracle = module.mechanical("./fork/scripts/verify && node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite fork-materialization --timeout-ms 120000 --total-timeout-ms 300000")
}

local projection = new Action {
  id = "retained-skill-observation-projection"
  owner = "implementer"
  needs {
    module.produced(analyticsContract); module.verified(analyticsContract)
    module.produced(retentionSurface); module.verified(retentionSurface)
    module.produced(projectionInstrument); module.verified(projectionInstrument)
    module.verified(retentionRelease); module.ruled(historyPolicy)
  }
  grant {
    "\(p)/skill-fact-projection.ts"; "\(p)/store.ts"
    "\(p)/extraction/**"; "\(p)/test/skill-fact-projection.test.ts"
    "\(p)/test/store.test.ts"
  }
  outcome = "Implement the additive skill-event projection and SQLite publication mechanics for lifecycle and token observations. Preserve revisions and raw internal drilldown dimensions, reconcile changed/deleted events, deduplicate repeated snapshots, migrate existing stores append-only, and publish skill facts atomically with truthful coverage and projection versioning. Live public-source extraction and authoritative thread-dimension enrichment are proved separately before queries consume these rows."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite retained-projection --timeout-ms 120000 --total-timeout-ms 300000")
}

local retainedSourceIntegration = new Action {
  id = "skill-retained-source-integration"
  owner = "implementer"
  needs {
    module.produced(retentionSurface); module.verified(retentionSurface)
    module.produced(projection); module.verified(projection)
    module.produced(projectionInstrument); module.verified(projectionInstrument)
    module.produced(providerInstruments); module.verified(providerInstruments)
    module.verified(retentionRelease); module.ruled(historyPolicy)
  }
  grant {
    "\(p)/skill-observation-contract.ts"; "\(p)/skill-fact-schema.ts"
    "\(p)/skill-fact-projection.ts"; "\(p)/store.ts"
    "\(p)/extraction/source-adapter.ts"; "\(p)/extraction/event-projector.ts"
    "\(p)/extraction/skill-observation-projector.ts"
    "\(s)/suites/retained-source-integration.mjs"
    "\(s)/fixtures/projection/retained-source-integration/**"
    "\(s)/contracts/analytics/schema-contract.ts"
    "\(s)/fixtures/providers/skill-observation-v1-contract.ts"
    "\(p)/test/skill-fact-projection.test.ts"; "\(p)/test/store.test.ts"
  }
  outcome = "Carry durable skill/observed rows from the real public threads SDK pagination path into the additive skill projection and atomic SQLite publication, requesting exactly the skill/observed event type so unrelated history cannot consume the retained-source budget. Enrich every fact from authoritative thread metadata with project ID, nullable environment ID and provider ID; never synthesize those dimensions from actor identity. Preserve nullable turn and exact source-event identity, distinguish pre-instrumentation from observed coverage, reconcile history rewrites and exact deletions, and prove commitSkillProjection has a live production caller without relying on an internal-only server helper."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite retained-source-integration --negative-control missing-project,wrong-environment,unwired-commit --timeout-ms 120000 --total-timeout-ms 300000 && npm --prefix community-plugins --workspace @phosphorco/bb-plugin-analytics test -- --run test/source-adapter.test.ts test/skill-fact-projection.test.ts test/store.test.ts")
}

local storeMigrationInstrument = new Action {
  id = "skill-store-migration-instrument"
  owner = "implementer"
  needs { module.produced(projection); module.verified(projection); module.ruled(historyPolicy) }
  grant {
    "\(s)/suites/store-migration-coverage.mjs"
    "\(s)/fixtures/projection/store-migration-coverage/**"
  }
  outcome = "Build a production-bound migration instrument that opens a representative pre-skill SQLite store, runs the real additive migration and projection, reopens and reruns idempotently, injects an interrupted upgrade, preserves tool_execution_fact_v1 plus saved bundle/reference bytes, and proves prospective unknown versus observed coverage without rewriting history. The instrument must derive expected rows independently and fail on duplicate source events, partial schema publication or invented pre-instrumentation zeroes."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite store-migration-coverage --negative-control duplicate-event,interrupted-migration,partial-publication --timeout-ms 120000 --total-timeout-ms 300000")
}

local storeMigration = new Guard {
  id = "skill-store-migration-and-coverage"
  owner = "implementer"
  needs {
    module.produced(projection); module.verified(projection)
    module.produced(storeMigrationInstrument); module.verified(storeMigrationInstrument)
    module.ruled(historyPolicy)
  }
  observes { "\(p)/store.ts"; "\(p)/skill-fact-projection.ts"; "\(s)/fixtures/projection/**" }
  outcome = "Prove skill storage upgrade, coverage epochs and reconciliation against current pre-skill databases before dashboard semantics consume them."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/skills/acceptance.mjs --suite store-migration-coverage --timeout-ms 120000 --total-timeout-ms 300000")
}

local retainedSourceRoundtrip = new Guard {
  id = "skill-retained-source-roundtrip"
  owner = "implementer"
  needs {
    module.produced(retainedSourceIntegration); module.verified(retainedSourceIntegration)
    module.verified(storeMigration)
  }
  observes {
    "\(p)/skill-observation-contract.ts"; "\(p)/skill-fact-schema.ts"
    "\(p)/skill-fact-projection.ts"; "\(p)/store.ts"; "\(p)/extraction/**"
    "\(s)/fixtures/projection/retained-source-integration/**"
  }
