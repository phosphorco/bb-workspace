amends "workbench:plan"

meta {
  title = "Context Magnet provider-session ETL refactor"
  goal = "Replace the unavailable BB host-trace architecture with a plugin-owned, rollback-safe ETL from public BB identity events, bounded Workbench decisions, and persisted context receipts in original Codex rollouts, rendered as a canonical semantic context trace without changing the BB fork."
}

// The prior host-trace plan and ledger remain historical evidence, not inputs.
// Hard boundaries:
// - no BB fork, SDK artifact, service, or host-trace API change;
// - no app-server launch or routed thread/read against an original account:
//   even thread/read startup mutates Codex SQLite/WAL state on this host;
// - original rollout JSONL is admitted only through one versioned, bounded,
//   streaming, read-only reducer that projects allowlisted context receipts;
// - the only native Codex carrier is an aligned response_item developer
//   message part whose content_item_kinds entry is hooks.additional_context;
//   generic developer messages are not Context Magnet evidence;
// - no timestamp, text-similarity, or inferred provider/session joins;
// - the rollout reducer never returns or persists raw provider records, paths,
//   messages, reasoning, commands, tool data, credentials, or unrelated text;
// - atomic facts retain one authority; derived associations retain all source
//   keys, route attestations, source digests, and the projector version;
// - a persisted rollout context receipt does not prove model transmission or use;
// - publication, promotion, normal-host retention, and historical fork-patch
//   deletion require separate authority.

local forkPreservationBaseline = new Action {
  id = "fork-preservation-baseline"
  owner = "workspace-conservator"
  outcome = "Capture the pre-refactor workspace and runtime preimage: tracked and untracked plugin/router files, Workbench source identity, fork and queued patches, SDK artifacts, loaded plugin generation, exact shared-hook bytes and executable digests, router revision, services, ports, provider processes, and active BB children. Separate protected prior dirty work from declared campaign grants."
  grant {
    "plans/context-magnet-session-etl-workspace-preimage.json"
    "plans/verify-context-magnet-session-etl-preimage.mjs"
  }
  oracle = module.mechanical("node plans/verify-context-magnet-session-etl-preimage.mjs baseline")
}

local mutationSafetyHarness = new Action {
  id = "mutation-safety-harness"
  owner = "workspace-conservator"
  outcome = "Build and self-test the parent-owned recovery harness: verify each node's expected preimage before dispatch, capture exact changed paths and a reverse patch, reject writes outside its grant, and restore only explicitly snapshotted proof-runtime state without stash, reset, clean, or broad deletion. Children never write the plan ledger or perform recovery."
  grant {
    "plans/context-magnet-session-etl-recovery.mjs"
    "plans/context-magnet-session-etl-recovery/**"
  }
  needs { module.produced(forkPreservationBaseline); module.verified(forkPreservationBaseline) }
  oracle = module.mechanical("node plans/context-magnet-session-etl-recovery.mjs self-test")
}

local codexSchemaReceipt = new Action {
  id = "codex-schema-receipt"
  owner = "session-access-investigator"
  outcome = "Record the router-selected realCodex launcher plus its resolved native Codex payload realpaths, versions and SHA-256 digests, and the app-server schema digest generated through that exact launcher chain; vendor only required version-matched initialize, thread/read, Thread, Turn, ThreadItem and hookPrompt shapes into the plugin; and fail closed on launcher, payload or schema mismatch."
  grant {
    "plugins/plugins/context-magnet-inspector/codex-app-server-schema/**"
    "plugins/plugins/context-magnet-inspector/docs/codex-reader-version-contract.md"
    "plugins/plugins/context-magnet-inspector/test/codex-schema-receipt.test.ts"
    "plugins/plugins/context-magnet-inspector/test/fixtures/codex-schema-receipt.json"
  }
  needs { module.produced(mutationSafetyHarness); module.verified(mutationSafetyHarness) }
  oracle = module.mechanical("node --test --experimental-strip-types test/codex-schema-receipt.test.ts")
}

local sessionAccessProbe = new Action {
  id = "session-access-probe"
  owner = "session-access-investigator"
  outcome = "Build and execute a bounded probe from one BB thread's bodyless metadata and server-filtered identity events. Require providerId=codex; resolve one existing enabled unambiguous router owner through a strictly read-only state snapshot; open the already-recorded original rollout with no-follow/containment and pre/post file-identity fences; stream bounded UTF-8 JSONL without launching Codex; validate the exact observed rollout dialect; and recognize only response_item developer-message parts whose aligned content_item_kinds entry is hooks.additional_context. Keep BB provider identity, native rollout id and native session_id distinct; bind provisional receipts to native session_id and metadata turn_id; project only redacted identity relations, bounded carrier/receipt counts and explicit gaps. Never return or persist unrelated record bodies or the rollout/account path. Cover native, missing, archived, disabled, divergent, unauthorized, forked, compacted, interrupted, failed, subagent, zero-receipt, malformed, duplicate, racing and oversized cases."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/codex-session-access-probe.md"
    "plugins/plugins/context-magnet-inspector/test/codex-session-access-probe.test.ts"
    "plugins/plugins/context-magnet-inspector/test/run-codex-session-access-probe.mts"
    "plugins/plugins/context-magnet-inspector/test/fixtures/codex-session-access-probe.json"
  }
  needs { module.produced(mutationSafetyHarness); module.verified(mutationSafetyHarness) }
  oracle = module.mechanical("node --experimental-strip-types test/run-codex-session-access-probe.mts && node --test --experimental-strip-types test/codex-session-access-probe.test.ts")
}

local sessionAccessReview = new Guard {
  id = "session-access-review"
  owner = "architecture-reviewer"
  outcome = "Review the provider-session access evidence and sensitive-response boundary."
  observes {
    "plugins/plugins/context-magnet-inspector/docs/codex-session-access-probe.md"
    "plugins/plugins/context-magnet-inspector/test/fixtures/codex-session-access-probe.json"
  }
  needs { module.produced(sessionAccessProbe); module.verified(sessionAccessProbe) }
  oracle = module.adjudicated("A fresh probe proves a non-resuming, non-assigning, account-scoped read of the original Codex rollout for an allowed provider; uses only server-filtered BB identity rows and a strictly read-only unambiguous router snapshot; validates and streams one versioned rollout dialect under byte/line/record/time caps; recognizes only aligned native hooks.additional_context carrier parts; keeps BB provider, rollout id and session_id distinct; fails closed for malformed or declared-invalid carrier evidence; makes duplicate, unbound and zero-receipt states explicit; never logs, persists, or returns raw provider bodies or paths; covers lifecycle and adversarial file cases; and shows identical rollout, router, BB, process, and workspace pre/post state. Any app-server launch against the original account fails this review.", "architecture-reviewer")
}

local sessionAccessRoute = new Guard {
  id = "session-access-route"
  owner = "architecture-reviewer"
  outcome = "Admit only the bounded router-owned, account-scoped, read-only original-rollout reducer; otherwise stop and revise as unsupported."
  observes {
    "plugins/plugins/context-magnet-inspector/docs/codex-session-access-probe.md"
    "plugins/plugins/subscription-router/host/router.mjs"
  }
  needs { module.verified(sessionAccessReview) }
  oracle = module.adjudicated("The route selects an already-owned enabled account without copy, repair, assignment, resume, Codex launch, or router mutation; proves rollout containment and stable file identity; and fails closed for native, unknown, disabled, divergent, archived, migrated-ambiguous, unsupported-dialect, unsafe-path, or changed sessions.", "architecture-reviewer")
}

local etlContract = new Action {
  id = "etl-contract"
  owner = "contract-author"
  outcome = "Define one versioned canonical semantic context-trace vocabulary, following the agent-evals normalization architecture while keeping Codex-dialect parsing inside one rollout reducer. A leading meta record binds projector version, BB and router fences, rollout dialect/file digest without its path, Workbench store instance/generation, and distinct BB provider/native rollout/session identities. Stable event seq is the citation identity; native BB turn/provider checkpoint, rollout ordinal, response-item id, metadata turn_id, content ordinal, and Workbench record/contribution keys are optional exact correlations, never substitutes. Workbench-minted unpredictable receipt envelopes bind native session_id and event-specific turn_id when present, ordered decision keys, emitted UTF-8 bytes and actual-body digest. The rollout reducer recognizes only aligned response_item developer-message input_text parts marked hooks.additional_context; generic developer content is never relabeled. Exact bounded Workbench-emitted text becomes a first-class context-admission only when a uniquely matching persisted rollout context receipt exists; unknown, missing, unbound, malformed, duplicate, partial and ambiguous cases become explicit gap events, never reconstructed admissions. Each event has resolvable redacted source locators and source-specific authority. Ban raw provider persistence, rollout paths, timestamp/text joins, and claims beyond persisted context receipt."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/session-etl-contract.md"
    "plugins/plugins/context-magnet-inspector/test/fixtures/session-etl.json"
    "plugins/plugins/context-magnet-inspector/test/session-etl-contract.test.ts"
  }
  needs {
    module.verified(sessionAccessRoute)
    module.produced(mutationSafetyHarness); module.verified(mutationSafetyHarness)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/session-etl-contract.test.ts")
}

local etlContractReview = new Guard {
  id = "etl-contract-review"
  owner = "architecture-reviewer"
  outcome = "Review identity, authority, freshness, privacy, ambiguity and canonical-projection laws before producer or consumer work."
  observes {
    "plugins/plugins/context-magnet-inspector/docs/session-etl-contract.md"
    "plugins/plugins/context-magnet-inspector/test/fixtures/session-etl.json"
    "plugins/plugins/context-magnet-inspector/test/session-etl-contract.test.ts"
  }
  needs { module.produced(etlContract); module.verified(etlContract) }
  oracle = module.adjudicated("Atomic facts name one authority; associations retain all supporting keys and projector version; providerId is Codex before interpreting providerThreadId; checkpoint-to-rollout-turn joins cover only emitting terminal states; thread and session identities may differ; event-specific hook identities may be absent; one Workbench store/generation and BB/route/rollout fence each snapshot; exact admissions retain body only from Workbench plus redacted locators; zero/duplicate/mismatched receipts and stale sources are gaps; UI/digest never parse provider dialects; and no event claims executable authorship, model transmission, or semantic use.", "architecture-reviewer")
}

// Verify in the canonical workbench-go checkout selected by Workbench Subject.
local workbenchReceiptProducer = new Action {
  id = "workbench-receipt-producer"
  owner = "workbench-context-author"
  outcome = "From a canonical branch-backed workbench-go checkout reproduced by Workbench Snapshot at installed revision 65f62403b31126431c8098d986dbba90d2fbdddd (never the detached /tmp evidence clone), add the reviewed durable emission receipt at the daemon/trace-store authority boundary. Give each trace store a durable instance id; mint a fresh unpredictable emission nonce after Plan selects the exact ordered offer; bind normalized audience, native session and event-specific turn when present, ordered generation/record/contribution identities, exact emitted UTF-8 bytes/SHA-256, and daemon-derived executable/source identity; synchronously append and flush before Observe returns an output-capable offer. Receipt persistence failure must suppress Context Magnet output while preserving harness availability—never emit an unreceipted body. Encode the versioned receipt line plus unchanged Workbench body in Codex additionalContext, retain the same structured receipt in history/inspect contribution/inspect turn JSON, preserve old-store behavior without fabricating v1 provenance, and keep Confirm's distinct post-write semantics. Add a bounded public `context inspect decision-slots NATIVE_SESSION_SLOT TURN_SLOT [NONCE_SLOT] --json` query that hashes retained native identities inside the trace authority, accepts only canonical sha256 slots, returns a complete slot-redacted decision/receipt envelope plus exact bounded emitted body, and never requires raw native identities to cross the router boundary. Add restart, clear, concurrent duplicate-body, malformed/bounded receipt, persistence-failure, transport, exact-envelope, slot-query and public-query acceptance proofs."
  grant {
    "internal/contexttrace/contexttrace.go"
    "internal/contexttrace/contexttrace_test.go"
    "internal/contextdaemon/api.go"
    "internal/contextdaemon/runtime.go"
    "internal/contextdaemon/runtime_review_test.go"
    "internal/contextdaemon/trace_runtime.go"
    "internal/contextdaemon/trace_runtime_test.go"
    "internal/contextdaemon/transport.go"
    "internal/contextdaemon/transport_lifetime_test.go"
    "cmd/workbench/context_runtime.go"
    "cmd/workbench/context_runtime_test.go"
    "cmd/workbench/context_cli.go"
    "cmd/workbench/context_cli_test.go"
    "acceptance/context_test.go"
    "docs/context.md"
    "docs/adr/2026-09-wokbench-context.md"
  }
  needs { module.produced(etlContract); module.verified(etlContractReview) }
  oracle = module.mechanical("GOCACHE=/tmp/cm-workbench-receipt-parent-gocache GOMODCACHE=/tmp/cm-workbench-receipt-parent-gomodcache PKL_EXECUTABLE=/home/ubuntu/.local/share/mise/installs/pkl/0.32.1/pkl go test ./internal/contexttrace ./internal/contextdaemon ./cmd/workbench && GOCACHE=/tmp/cm-workbench-receipt-parent-gocache GOMODCACHE=/tmp/cm-workbench-receipt-parent-gomodcache PKL_EXECUTABLE=/home/ubuntu/.local/share/mise/installs/pkl/0.32.1/pkl go test ./acceptance -run '^TestContext' -count=1 && git diff --check")
}

local workbenchRuntimeSelection = new Action {
  id = "workbench-runtime-selection"
  owner = "workbench-runtime-operator"
  outcome = "Build the accepted Workbench producer source as the one versioned executable at plans/context-magnet-workbench-runtime/bd9e7818cb2f4c7cbb6144544339b303df7c68e845d8d944cd825e4e2cb881f9/workbench, where the directory name is the accepted 16-file source-diff SHA-256. Record and verify its realpath, mode, platform, version, SHA-256, source revision, source-diff digest and build toolchain. The artifact is build-only evidence, not an alternate default runtime source. Do not install hooks, modify the shared-hook record, or touch provider processes."
  grant {
    "plans/context-magnet-workbench-runtime/bd9e7818cb2f4c7cbb6144544339b303df7c68e845d8d944cd825e4e2cb881f9/workbench"
    "plans/context-magnet-workbench-runtime-receipt.json"
    "plans/verify-context-magnet-workbench-runtime.mjs"
  }
  needs { module.produced(workbenchReceiptProducer); module.verified(workbenchReceiptProducer) }
  oracle = module.mechanical("node plans/verify-context-magnet-workbench-runtime.mjs build-only")
}

local bbEventIdentityAdapter = new Action {
  id = "bb-event-identity-adapter"
  owner = "bb-event-adapter-author"
  outcome = "Implement a bounded BB adapter that validates the Codex provider, captures an event high-watermark, reads only identity-bearing thread/turn events, recognizes checkpoint-emitting terminal states, pages safely, rereads completion, and rejects foreign, conflicting, missing, reordered, body-bearing, provider-neutral or inferred correlations."
  grant {
    "plugins/plugins/context-magnet-inspector/bb-event-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/bb-event-adapter.test.ts"
  }
  needs { module.produced(etlContract); module.verified(etlContractReview) }
  oracle = module.mechanical("node --test --experimental-strip-types test/bb-event-adapter.test.ts")
}

local codexSessionAdapter = new Action {
  id = "codex-session-adapter"
  owner = "codex-session-adapter-author"
  outcome = "Implement the router-owned reducer and plugin adapter: select only an existing unambiguous enabled owner from read-only state; attest the provider route and original rollout identity; open the contained regular rollout without following links; stream and validate the reviewed versioned JSONL dialect under byte/line/record/time caps; recognize only aligned response_item developer-message input_text parts marked hooks.additional_context; validate native item/session/turn locators and the versioned receipt; return canonical receipt facts and stable zero/unbound/malformed/duplicate gaps; and prove no router/session mutation. Never launch Codex or return/persist unrelated context text, messages, reasoning, commands, tool data, credentials, rollout paths, raw records, or crash bodies."
  grant {
    "plugins/plugins/context-magnet-inspector/codex-session-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/codex-session-adapter.test.ts"
    "plugins/plugins/subscription-router/host/context-magnet-session-reader.mjs"
    "plugins/plugins/subscription-router/test/context-magnet-session-reader.test.ts"
  }
  needs {
    module.verified(sessionAccessRoute)
    module.produced(etlContract); module.verified(etlContractReview)
  }
  oracle = module.mechanical("node --test --experimental-strip-types plugins/context-magnet-inspector/test/codex-session-adapter.test.ts plugins/subscription-router/test/context-magnet-session-reader.test.ts")
}

local workbenchAdapterV2 = new Action {
  id = "workbench-adapter-v2"
  owner = "workbench-adapter-author"
  outcome = "Upgrade the Workbench adapter to fixed shell-free explanation-history reads fenced to one store instance and generation. Resolve the audience exactly as codex:<native session_id>, query the exact BB provider checkpoint/native turn, and use Workbench history plus inspect contribution/turn as the only Workbench authority. Preserve exact record/contribution/turn/envelope identity, decision reasons/outcomes, exact bounded emitted body and gaps; reject invalid receipts, cross-session records, unsafe paths, oversized collections and incomplete/partial queries. A Workbench observation with null content and zero contribution remains an explicit no-contribution decision, never evidence that a hook failed."
  grant {
    "plugins/plugins/context-magnet-inspector/workbench-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/workbench-adapter-v2.test.ts"
  }
  needs { module.produced(etlContract); module.verified(etlContractReview) }
  oracle = module.mechanical("node --test --experimental-strip-types test/workbench-adapter-v2.test.ts")
}

local workbenchReceiptSlotAdapter = new Action {
  id = "workbench-receipt-slot-adapter"
  owner = "workbench-adapter-author"
  outcome = "Replace the raw-native-identity Workbench query seam with the verified decision-slots contract. Accept only canonical native-session, terminal-turn, optional receipt-nonce, store-instance and generation SHA-256 slots from the BB/router projections; invoke only fixed shell-free `context inspect decision-slots` argv; require one complete non-partial Workbench response; recompute emitted body bytes/digest; compare every receipt slot and ordered key slot; and return the existing bounded WorkbenchDecisionResult shape. Raw native session/turn/nonce values must never be inputs, outputs or inferred. A complete slot query with zero contribution remains explicit no-contribution; missing, duplicate, mismatched, stale, oversized or unsupported evidence is a named gap."
  grant {
    "plugins/plugins/context-magnet-inspector/workbench-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/workbench-adapter-v2.test.ts"
  }
  needs {
    module.produced(workbenchAdapterV2); module.verified(workbenchAdapterV2)
    module.produced(workbenchReceiptProducer); module.verified(workbenchReceiptProducer)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/workbench-adapter-v2.test.ts")
}

local sessionEtlProjection = new Action {
  id = "session-etl-projection"
  owner = "etl-author"
  outcome = "Purely project normalized BB, routing, Workbench and Codex facts into the canonical trace; renderers must not reinterpret provider shapes. Emit versioned meta, stable seq, exact source locators, lifecycle/selection/emission/context-admission/gap events, and a separate bounded summary projection retaining seq and locators. Distinguish unbound, selected, emitted, persisted rollout context receipt, unavailable, partial, unauthorized, compacted and semantic-use-unobserved states. Reject thread/session/turn collisions, source-freshness races, digest/nonce mismatch, duplicate matches and compaction ambiguity."
  grant {
    "plugins/plugins/context-magnet-inspector/context-magnet.ts"
    "plugins/plugins/context-magnet-inspector/test/session-etl-projection.test.ts"
  }
  needs {
    module.produced(bbEventIdentityAdapter); module.verified(bbEventIdentityAdapter)
    module.produced(codexSessionAdapter); module.verified(codexSessionAdapter)
    module.produced(workbenchAdapterV2); module.verified(workbenchAdapterV2)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/session-etl-projection.test.ts")
}

local hostFreeRenderer = new Action {
  id = "host-free-renderer"
  owner = "ui-author"
  outcome = "Keep native ThreadChat as the sole transcript owner and render only canonical Context Magnet events in an adjacent causal narrative; the installed ThreadChat API does not permit safe interleaving of plugin-owned rows, so never imitate or reparse its message/tool timeline. Make exact admitted text a first-class 'Context added' row carrying its exact native turn slot and canonical seq/locator, outside any folded operational summary because it changes what the agent can know next. Keep compact rows vertically scannable, surface the consequential fact before disclosure, and use one lazily realized keyboard-reachable metadata inspector whose opening does not remount or resize the reading path. Show missing/partial/unauthorized/compacted/unsupported, displaced-event bounds and unrecognized context-bearing evidence as explicit gaps, never reconstructed context; additive unknown metadata may remain inspectable. Remove host-authority language and prove loading, timeout, stale-thread switch, focus restoration, color-independent/accessibility semantics, maximum payload, bounded mounted rows/overlay work and a measurable responsiveness ceiling."
  grant {
    "plugins/plugins/context-magnet-inspector/app.tsx"
    "plugins/plugins/context-magnet-inspector/app.css"
    "plugins/plugins/context-magnet-inspector/test/session-etl-renderer.test.ts"
    "plugins/plugins/context-magnet-inspector/test/session-etl-performance.test.ts"
  }
  needs { module.produced(sessionEtlProjection); module.verified(sessionEtlProjection) }
  oracle = module.mechanical("node --test --experimental-strip-types test/session-etl-renderer.test.ts test/session-etl-performance.test.ts")
}

local routerReaderInvocation = new Action {
  id = "router-reader-invocation"
  owner = "router-reader-bridge-author"
  outcome = "Expose the accepted original-rollout reducer through one explicit read-only Subscription Router host command and a bounded inspector client over BB's public host-terminal API. The command must run from the active attested router generation, open state.db readonly/create:false without initialization, chmod, migration, status, ownership claim or lifecycle work, select one existing enabled non-draining owner with no migration claim, and invoke only the no-follow bounded reducer. The inspector client resolves the thread's actual host and host directory from bodyless public BB metadata, invokes the fixed router launcher with shell-quoted fixed argv, caps stdout/stderr/time/process lifetime, validates the strict redacted projection, rechecks active generation/source/route fences, and always closes its owned terminal. No rollout path, account/home value, raw router row or provider body may cross the command boundary; missing, legacy, divergent, racing or unsupported router state is an explicit unavailable gap."
  grant {
    "plugins/plugins/subscription-router/host/context-magnet-session-reader.mjs"
    "plugins/plugins/subscription-router/host/router.mjs"
    "plugins/plugins/subscription-router/deployment.ts"
    "plugins/plugins/subscription-router/test/context-magnet-session-reader.test.ts"
    "plugins/plugins/subscription-router/test/context-magnet-session-command.test.ts"
    "plugins/plugins/subscription-router/test/deployment.test.ts"
    "plugins/plugins/context-magnet-inspector/router-reader-client.ts"
    "plugins/plugins/context-magnet-inspector/test/router-reader-client.test.ts"
  }
  needs {
    module.produced(codexSessionAdapter); module.verified(codexSessionAdapter)
    module.verified(sessionAccessRoute)
  }
  oracle = module.mechanical("bun test plugins/subscription-router/test/context-magnet-session-reader.test.ts plugins/subscription-router/test/context-magnet-session-command.test.ts plugins/subscription-router/test/deployment.test.ts plugins/context-magnet-inspector/test/router-reader-client.test.ts")
}

local checkpointZeroContributionContract = new Action {
  id = "checkpoint-zero-contribution-contract"
  owner = "etl-contract-corrector"
  outcome = "Align the host-free ETL on the provider checkpoint rather than the BB scope turn, and make zero contribution a real complete-evidence state. Preserve both BB scope-turn and provider-checkpoint slots as separate facts, but use the provider checkpoint slot for the native receipt and Workbench decision join. A complete bounded rollout with zero native hook carriers/receipts must remain a complete zero-receipt projection, not a partial error. Permit a slot-only Workbench zero probe using native-session plus provider-checkpoint slots without inventing nonce/store/generation facts; accept only an explicit unique terminal zero decision. If that unfenced probe returns a contribution, or if native receipts coexist with a zero decision, fail closed with a named contradiction. Retain strict nonce/store/generation/key/body comparison whenever one persisted receipt exists, and keep malformed, unbound, duplicate, racing and incomplete evidence as explicit gaps. Tests must deliberately make the BB scope turn differ from the provider checkpoint/native turn and cover genuine zero, contradictory zero, unexpected complete contribution, and the strict receipted path."
  grant {
    "plugins/plugins/context-magnet-inspector/workbench-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/workbench-adapter-v2.test.ts"
    "plugins/plugins/subscription-router/host/context-magnet-session-reader.mjs"
    "plugins/plugins/subscription-router/test/context-magnet-session-reader.test.ts"
    "plugins/plugins/context-magnet-inspector/context-magnet.ts"
    "plugins/plugins/context-magnet-inspector/test/session-etl-projection.test.ts"
  }
  needs {
    module.produced(workbenchReceiptSlotAdapter); module.verified(workbenchReceiptSlotAdapter)
    module.produced(routerReaderInvocation); module.verified(routerReaderInvocation)
    module.produced(sessionEtlProjection); module.verified(sessionEtlProjection)
  }
  oracle = module.mechanical("node --test --experimental-strip-types plugins/context-magnet-inspector/test/workbench-adapter-v2.test.ts plugins/context-magnet-inspector/test/session-etl-projection.test.ts plugins/subscription-router/test/context-magnet-session-reader.test.ts")
}

local checkpointZeroRendererSchema = new Action {
  id = "checkpoint-zero-renderer-schema"
  owner = "ui-contract-corrector"
  outcome = "Align the bounded renderer validator and narrative with the corrected canonical ETL schema. Preserve BB scopeTurnSlot and providerCheckpointSlot as separate optional facts, use only providerCheckpointSlot as the Context-added/native-turn label, and never treat scopeTurnSlot as the provider turn. Accept Workbench storeInstance and generation only when both canonical slots are present; permit both to be absent for an otherwise complete explicit zero-contribution projection, while rejecting one-sided, malformed or receipt-bearing unfenced projections. Keep the exact 16-event correspondence, omission accounting, shared lazy inspector, focus restoration, stale-projection invalidation and raw-body/redaction rules. Add fixtures for divergent scope/checkpoint admission, valid zero without receipt fences, malformed partial fences, and replacement projections."
  grant {
    "plugins/plugins/context-magnet-inspector/app.tsx"
    "plugins/plugins/context-magnet-inspector/test/session-etl-renderer.test.ts"
    "plugins/plugins/context-magnet-inspector/test/session-etl-performance.test.ts"
  }
  needs {
    module.produced(hostFreeRenderer); module.verified(hostFreeRenderer)
    module.produced(checkpointZeroContributionContract); module.verified(checkpointZeroContributionContract)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/session-etl-renderer.test.ts test/session-etl-performance.test.ts")
}

local hostFreeRpc = new Action {
  id = "host-free-rpc"
  owner = "plugin-server-author"
