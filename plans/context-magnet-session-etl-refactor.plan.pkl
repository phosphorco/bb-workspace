    "plugins/plugins/context-magnet-inspector/docs/**"
    "plugins/plugins/context-magnet-inspector/test/**"
  }
  needs {
    module.produced(codexSchemaReceipt); module.verified(codexSchemaReceipt)
    module.verified(experienceReview)
    module.verified(pluginBoundaryAudit)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/host-free-boundary.test.ts test/*.test.ts")
}

local finalIntegration = new Guard {
  id = "final-integration"
  owner = "integration-author"
  outcome = "Re-run complete affected repository verification after legacy cleanup and confirm the reviewed plugin activation remains exact while its proof-owned child/process is absent."
  observes {
    "plugins/plugins/context-magnet-inspector/**"
    "plugins/plugins/subscription-router/**"
    "plans/context-magnet-session-etl-restoration-receipt.json"
  }
  needs {
    module.produced(legacyRetirement); module.verified(legacyRetirement)
    module.produced(activationFinalization); module.verified(activationFinalization)
  }
  oracle = module.mechanical("bun run sync:check && bun run references:check && bun run sdk-types:check && bun run --filter '@phosphor/bb-plugin-context-magnet-inspector' typecheck && bun run --filter '@phosphor/bb-plugin-context-magnet-inspector' test && bun run --filter '@phosphor/bb-plugin-context-magnet-inspector' build && bun run --filter '@phosphor/bb-plugin-subscription-router' typecheck && bun run --filter '@phosphor/bb-plugin-subscription-router' test && bun run --filter '@phosphor/bb-plugin-subscription-router' build")
}

local pluginGitlinkComposition = new Selector {
  id = "plugin-gitlink-composition"
  owner = "cole"
  outcome = "Choose whether the eventual workspace plugin gitlink may include all already-pushed unrelated commits currently on plugins/main through 7f6039f1 (the transcript-viewer commit and five later thread-progress/Recent-sort commits) after combined-composition verification, or whether Context Magnet needs a separately authorized isolated source-delivery path from the recorded 054d555a gitlink. Preserve unrelated dirty plugin work in either case. This choice does not authorize publication by itself; re-review if plugins/main advances again before promotion."
  question = "May the final workspace plugins gitlink include the currently pushed plugins/main composition through 7f6039f1, including unrelated viewer and thread-progress commits?"
  options { "include-current-main-and-test"; "isolated-delivery-path" }
}

local deliveryClosure = new Guard {
  id = "delivery-closure"
  owner = "outcome-owner"
  outcome = "Do not declare this Context Magnet campaign complete at the plugin test frontier. After satisfactory live proof, Cole experience review, legacy cleanup and full integration, gather three or four independent source-cited perspectives on the weakest evidenced areas using Codex gpt-6-sol BB threads; record each suggestion and its applied or reasoned disposition. Revise this graph with exact correction, affected/full verification, final plugin-only reload, Workbench source provenance and selected-repository publication nodes once those inputs are concrete. Completion requires the final loaded plugin/hook provenance and bounded rollback evidence, accepted source checks, selected Workbench source commit/push or equivalent reproducible provenance, selected plugins child commit/push, workspace gitlink promotion/push in child-first order, and explicit exclusion of unrelated dirty fork/community/SDK work. This adjudicated gate cannot stand in for missing implementation or publication nodes and must not pass before their recorded evidence."
  observes {
    "plans/context-magnet-session-etl-refactor.plan.pkl"
    "plans/context-magnet-session-etl-refactor.ledger.jsonl"
    "plans/context-magnet-session-etl-activation-receipt.json"
    "plugins/plugins/context-magnet-inspector/**"
    "plugins/plugins/subscription-router/**"
  }
  needs { module.verified(finalIntegration); module.ruled(pluginGitlinkComposition) }
  oracle = module.adjudicated("Three or four independent weak-lens reviews and reasoned dispositions are recorded; reasonable corrections and affected/full verification passed; the final plugin-only reload and loaded provenance were verified; the Workbench source and exact selected plugin changes were committed and pushed; the workspace gitlink and selected evidence were promoted and pushed only after child commits; unrelated dirty state is preserved. Concrete delivery nodes and their oracles are present and verified, not replaced by this judgment.", "outcome-owner")
}

