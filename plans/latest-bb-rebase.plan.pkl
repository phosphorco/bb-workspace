amends "workbench:plan"

meta {
  title = "Rebase the BB fork onto latest upstream"
  goal = "Select current upstream main, replay the minimal downstream queue, verify consumers, activate the canonical runtime, and publish one exact workspace composition."
}

local upstream = new Guard {
  id = "upstream"
  owner = "root"
  outcome = "Pin the current upstream main commit and record the delta from the selected 0.42.0 base."
  observes { "fork/upstream/**"; "fork/upstream.lock" }
  oracle = module.mechanical("test \"$(git -C fork/upstream rev-parse origin/main)\" = 10bacbc0fb1ead6c1f1a728b395bdb1f60e52f93")
}

local replay = new Action {
  id = "replay"
  owner = "root"
  outcome = "Replay the 16-patch downstream queue onto upstream 10bacbc and remove or revise patches already supplied upstream."
  needs { module.verified(upstream) }
  grant {
    "fork/upstream"
    "fork/upstream.lock"
    "fork/patches/**"
    "fork/result-tree.lock"
    "fork/README.md"
    "fork/DOWNSTREAM.md"
    "fork/plans/**"
  }
  oracle = module.mechanical("cd fork && ./scripts/verify")
}

local core = new Guard {
  id = "core"
  owner = "root"
  outcome = "Verify install, typecheck, tests, build and focused downstream behavior on the exact replay tree."
  observes { "fork/**" }
  needs { module.produced(replay); module.verified(replay) }
  oracle = module.adjudicated("The exact clean replay passes frozen install, all typecheck/test/build tasks, namespace and patch verification, plus focused identity, transcript, Tailnet and plugin route checks. Any removed patch is traced to upstream behavior or an explicit product decision.", "root")
}

local sdk = new Action {
  id = "sdk"
  owner = "root"
  outcome = "Rebuild and pin the fork SDK only if the replay changes its public package inputs."
  needs { module.produced(replay); module.verified(replay) }
  grant {
    "sdk-artifacts/**"
    "plugins/tools/workspaces-sync/definition.ts"
    "plugins/bun.lock"
    "plugins/package.json"
    "plugins/plugins/*/package.json"
    "plugins/packages/bb-identity/type-tests/browser/package.json"
  }
  oracle = module.adjudicated("Compare packages/plugin-sdk source and built package inputs. Reuse the selected artifact if identical; otherwise create a provenance receipt, preserve the old artifact, regenerate exact pins, and pass frozen install, SDK resolution, typecheck, tests and build for organization and community consumers.", "root")
}

local activation = new Action {
  id = "activation"
  owner = "root"
  outcome = "Activate the verified replay in /home/ubuntu/bb/fork/build/bb and exercise the live host."
  needs {
    module.verified(core)
    module.produced(sdk)
    module.verified(sdk)
  }
  grant { "fork/build/bb/**"; "plans/latest-bb-rebase-receipt.json" }
  oracle = module.adjudicated("The service restarts on the exact replay commit/tree, resumes this thread, reports healthy identity and plugin routes, and preserves child-thread creation, sender envelopes, Agent Connect token checks and canonical plugin source paths.", "root")
}

local delivery = new Action {
  id = "delivery"
  owner = "root"
  outcome = "Commit and push the fork and any SDK consumer changes, then promote and push the matching workspace gitlinks."
  needs { module.produced(activation); module.verified(activation) }
  grant { "fork/**"; "plugins/**"; "community-plugins/**"; "plans/latest-bb-rebase*"; ".gitmodules" }
  oracle = module.adjudicated("Every selected child commit is pushed before the workspace receipt, all gitlinks match clean child HEADs, the normal runtime composition check passes, and delivery reports the upstream SHA, replay tree, patch count, removed patches, validation and any remaining limitations.", "root")
}

nodes { upstream; replay; core; sdk; activation; delivery }
