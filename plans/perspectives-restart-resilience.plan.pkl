amends "workbench:plan"

meta {
  title = "Make Perspectives panels recover through BB threads"
  goal = "Replace gather_perspectives' process-local pipeline with a recoverable coordinator thread, native child completion reports, durable reconciliation prompts, and a full synthesis artifact that the calling thread can read. Preserve the asynchronous caller experience, bounded panel behavior, evidence standards, and explicit partial-result disclosure."
}

local nativeRecoveryProbe = new Guard {
  id = "native-recovery-contract"
  owner = "perspectives-implementer"
  outcome = "Establish the BB lifecycle contract for ordinary hidden child completion reports, discovery of children by parent and coordinator ID, and the source-level retry behavior of interrupted hidden threads. Show how the coordinator can reconcile persisted child identities and full outputs after a lost or duplicate report. Treat restart-resume as supplemental because its automatic scan has eligibility and recency limits. Reserve actual process-restart and lost-batch fault injection for live-restart-proof; if source inspection reveals an unrecoverable required state, revise the graph before implementation."
  observes {
    "fork/build/bb/apps/server/src/services/threads/child-thread-notifications.ts"
    "fork/build/bb/apps/server/src/services/threads/parent-system-messages.ts"
    "fork/build/bb/apps/cli/src/commands/thread/actions.ts"
    "fork/build/bb/apps/server/src/services/threads/thread-storage.ts"
    "community-plugins/plugins/restart-resume/server.ts"
  }
  oracle = module.adjudicated("Record source citations and disposable-thread observations for hidden ordinary child reporting, originKind eligibility, and child discovery. Identify the full-output API and confirm the parent receives the completion notice. Document lost-batch and interrupted-thread windows plus restart-resume limits as explicit cases for live-restart-proof. Do not infer that a native notice is durable.", "perspectives-reviewer")
}

local scheduledDeliveryProbe = new Guard {
  id = "scheduled-delivery-contract"
  owner = "perspectives-implementer"
  outcome = "Establish the persisted queue and dispatch contract for scheduled tells to active, idle, pending, and error-state threads using source and isolated database/dispatcher probes. Distinguish queued-row acknowledgement from provider delivery, inspect rows with failureReason and stale claims, and identify a concrete manual or automatic recovery route. Reserve server-process and repeated-restart fault injection for live-restart-proof; state what remains merely eventual."
  observes {
    "fork/build/bb/apps/cli/src/commands/thread/actions.ts"
    "fork/build/bb/apps/server/src/services/system/periodic-sweeps.ts"
    "fork/build/bb/apps/server/src/services/threads/parent-system-messages.ts"
    "community-plugins/plugins/restart-resume/recovery.ts"
  }
  oracle = module.adjudicated("Record source citations, queue-row IDs and matching dispatch events from isolated database/dispatcher probes for active, idle, pending, and error targets across database serialize/reopen. Demonstrate stale-claim release and a failed row's explicit retry or bounded outcome. Record the unproven server-restart and provider-acknowledgement windows for live-restart-proof. Do not infer a strict wall-clock cap from queue acceptance.", "perspectives-reviewer")
}

local artifactAccessProbe = new Guard {
  id = "artifact-access-contract"
  owner = "perspectives-implementer"
  outcome = "Prove the exact BB route by which the caller reads a coordinator-owned thread-storage file by coordinator ID and relative path. Define a stable path, atomic write method, and how the caller distinguishes absent, partial, and complete artifacts after a restart."
  observes {
    "fork/build/bb/apps/server/src/routes/threads/data.ts"
    "fork/build/bb/apps/server/src/services/threads/thread-storage.ts"
    "fork/build/bb/apps/cli/src/commands/thread/open.ts"
    "fork/build/bb/packages/sdk/src/areas/threads.ts"
  }
  oracle = module.adjudicated("Record an exact caller-context read of a full file in a disposable coordinator's thread storage, using its ID and relative path; verify bytes, not merely a UI link. Cite the route and its access/host constraints. Show how an atomic write and a failed write are observed. If the caller cannot read it, fail and revise the artifact contract.", "perspectives-reviewer")
}

local launchIdentityProbe = new Guard {
  id = "launch-identity-contract"
  owner = "perspectives-implementer"
  outcome = "Determine the BB-native durable identity available before and after coordinator creation and what an ambiguous spawn response permits. Use the coordinator thread ID as run identity after creation; define same-invocation rediscovery, explicit launch-uncertain response, and caller handling of a possible duplicate after process restart. Avoid promising exact one-per-call creation without a server idempotency primitive."
  observes {
    "community-plugins/plugins/perspectives/Perspectives.ts"
    "fork/build/bb/packages/sdk/src/areas/threads.ts"
    "fork/build/bb/apps/server/src/services/threads/thread-parent.ts"
  }
  oracle = module.adjudicated("Cite the actual spawn/list/search contracts and show a disposable-thread or fault-injection trace for an ambiguous spawn acknowledgement. A pass requires same-invocation rediscovery when possible and an explicit launch-uncertain outcome when it is not; no success receipt may claim an unidentified coordinator. Record the possibility of duplicate work after a crashed invocation is replayed.", "perspectives-reviewer")
}

local coordinatorContract = new Action {
  id = "coordinator-contract"
  owner = "perspectives-implementer"
  outcome = "Specify the recoverable launch and coordinator contract: queue one caller backstop bearing a unique invocation marker before spawning so a restart between committed spawn and plugin receipt cannot leave a committed coordinator with no caller wake; coordinator thread ID becomes the durable run identity after creation; successful launch receipt requires both the accepted caller row and identified coordinator ID; ambiguous spawn is rediscovered in the live invocation or reported launch-uncertain, and the retained backstop rediscovers zero/one/multiple children by marker after restart; possible duplicate panels after crashed replay stay visible; full validated request, 2-7 lenses, execution tuple, caller ID, and absolute deadlines go in the initial prompt; durable 20-minute wrap-up wake, 25-minute deadline wake, and one caller backstop; ordinary worker children with originKind null; per-wake rediscovery and full-output reconciliation; stop outstanding workers at the delayed deadline wake and publish one bounded complete/partial/failed synthesis file; an atomically published Markdown artifact with run ID, completion marker, and checksum; a short file-first final response; and caller retrieval by coordinator ID with missing, corrupt, or offline-host outcomes. Use BB thread transcripts, child records, queued messages, and the final artifact as durable state; any additional journal/checkpoint must be justified by an unrecoverable fact. Do not promise exactly-once creation/delivery or a strict wall-clock deadline."
  grant { "community-plugins/plugins/perspectives/COORDINATOR_DESIGN.md" }
  needs { module.verified(nativeRecoveryProbe); module.verified(scheduledDeliveryProbe); module.verified(artifactAccessProbe); module.verified(launchIdentityProbe) }
  oracle = module.adjudicated("Review state transitions against all four observed BB contracts. Cover ambiguity between spawn, wake-up scheduling, receipt, worker spawn, worker report, deadline, synthesis write, final report, and caller read. Map coordinator operations to BB CLI or another tool actually available inside its agent thread; prove the final-file publication sequence does not claim SDK create-only behavior absent from the CLI. Require queue and child reconciliation on every wake-up, the existing evidence and partial-result rules, and explicit failure paths. Reject an unnecessary plugin journal/checkpoint, minute-scale polling turns, post-deadline worker continuation, and any path relying only on an in-memory timer, truncated notification text, or a worker explicitly telling its parent.", "perspectives-reviewer")
}

local failingWitness = new Action {
  id = "restart-regression-witness"
  owner = "perspectives-implementer"
  outcome = "Add a focused expected-failure witness against the existing gather export: after a launch receipt, the detached pipeline has no durable coordinator or caller wake. Establish from BB source why a child completion report can be lost before its process-local batch flush, and retain live restart injection in live-restart-proof. Specify acceptance cases for ambiguous spawn response and no false success receipt; coordinator and caller scheduled queue rows; rediscovery of already-spawned children; possible duplicate panels after crashed replay; lost and duplicate reports; partial synthesis; atomic file write or explicit write failure; full-file retrieval; and lost or duplicate coordinator completion. Pending or fake-model cases are specifications, not implementation evidence."
  grant {
    "community-plugins/plugins/perspectives/test/Perspectives.test.ts"
    "community-plugins/plugins/perspectives/test/restart-recovery.test.ts"
  }
  needs { module.produced(coordinatorContract); module.verified(coordinatorContract) }
  oracle = module.adjudicated("Show a targeted, expected failure of the old gather implementation for a restart or lost-wake-up scenario; reject unrelated import or harness failures. Cite the BB child-notification batch and its loss window, and defer actual process-restart injection to live-restart-proof. Review the specified acceptance cases against the coordinator contract and record the exact command and output, including any TODO count. The harness must not modify a production BB service or operator state.", "perspectives-reviewer")
}

local coordinatorImplementation = new Action {
  id = "coordinator-implementation"
  owner = "perspectives-implementer"
  outcome = "Change gather_perspectives to validate inputs and execution settings, queue and confirm one marker-bearing caller backstop before coordinator spawn, create a hidden coordinator child of the caller, rediscover it after an ambiguous response while an invocation marker is available, and return the coordinator ID only after launch is recoverable. A retained backstop rediscovers zero/one/multiple matching children after restart and reports absence, uncertainty, or duplicates explicitly; a definite spawn rejection may cancel the row. Otherwise report launch uncertain without claiming success or blindly respawning. Have the coordinator schedule durable wrap-up and deadline wakes before launching ordinary hidden worker children, receive native reports, reconcile persisted children and full outputs on every wake-up, request wrap-up at about 20 minutes, stop unfinished workers at the delayed 25-minute deadline wake, synthesize usable evidence once, atomically write the full result to its thread storage, and finish with a short summary and file reference. Its prompt must explicitly permit its own BB orchestration and thread-storage artifact writes while keeping worker research and external side effects read-only; it cannot inherit the worker-only no-file/no-message/no-delegation prohibition. Caller reconciliation reads the exact file or reports a bounded failure and recognizes multiple coordinator children after replay. Remove the detached process-local gather pipeline; keep help behavior intact. Replace pending acceptance cases with runnable product-code tests wherever the implementation exposes a seam, and explicitly carry live-only cases to live-restart-proof."
  grant {
    "community-plugins/plugins/perspectives/Perspectives.ts"
    "community-plugins/plugins/perspectives/server.ts"
    "community-plugins/plugins/perspectives/test/Perspectives.test.ts"
    "community-plugins/plugins/perspectives/test/restart-recovery.test.ts"
    "community-plugins/plugins/perspectives/test/execution-application.test.ts"
    "community-plugins/plugins/perspectives/test/server.test.ts"
  }
  needs { module.produced(coordinatorContract); module.verified(coordinatorContract); module.produced(failingWitness); module.verified(failingWitness) }
  oracle = module.mechanical("npm run test --workspace @phosphorco/bb-plugin-perspectives && npm run typecheck --workspace @phosphorco/bb-plugin-perspectives")
}

local scopedRecoveryTools = new Action {
  id = "scoped-recovery-tools"
  owner = "perspectives-implementer"
  outcome = "Replace the coordinator's approval-blocked CLI protocol with narrowly scoped Perspectives agent tools backed by BB SDK operations, while keeping ordinary parented BB threads, native reports, queue rows, and thread storage as the durable state. Authenticate each coordinator and caller operation from BB thread identity and persisted run ancestry; never grant worker orchestration or external send authority. Reconcile an ambiguous child or queue result before any retry. Publish a byte-defined synthesis envelope through a plugin-computed digest and create-only atomic file write, then read back and validate exact bytes. Give the caller an authorized cross-thread read and verification path, including missing, corrupt, and host-offline outcomes. Do not silently elevate permission mode. Exercise the actual registered tools in the normal auto permission mode and verify rejection for an unauthorized worker or unrelated thread. Preserve explicit uncertain launch and duplicate disclosure where BB has no server-enforced spawn idempotency."
  grant {
    "community-plugins/plugins/perspectives/Perspectives.ts"
    "community-plugins/plugins/perspectives/server.ts"
    "community-plugins/plugins/perspectives/README.md"
    "community-plugins/plugins/perspectives/COORDINATOR_DESIGN.md"
    "community-plugins/plugins/perspectives/test/**"
  }
  needs { module.produced(publicContract); module.verified(publicContract) }
  oracle = module.adjudicated("Use product-code tests and an isolated real agent turn to show that the configured auto permission mode can initialize the coordinator, queue wakes, create workers, reconcile full outputs, publish a verifiable exact-byte artifact, and let the caller read it without shell approval. Check invalid caller/worker authorization, ambiguous writes, corrupt content, and host-offline reporting. Require npm test, typecheck, and build for the Perspectives package. A full-mode-only run, prompt inspection, or fake coordinator cannot pass this gate.", "perspectives-reviewer")
}

local restartProof = new Guard {
  id = "live-restart-proof"
  owner = "perspectives-reviewer"
  outcome = "In an isolated disposable BB runtime, run the final documented caller flow and restart only that runtime at launch, before/after a scheduled queue claim and request-event commit, during worker execution, after worker completion but before notification flush, during synthesis, and after artifact write. Inject an ambiguous spawn response, missed restart-resume eligibility, failed queue row, and duplicate/lost coordinator reports. Verify identifiable coordinator IDs for successful launches, honest launch-uncertain outcomes, queue-row persistence and dispatch or explicit bounded failure, actual child IDs and full outputs, eventual caller wake-up, partial/failure behavior, exact readable full artifact, and visible handling of any duplicate panel after replay. Repeat restarts and measure actual sweep and stale-claim delays."
  observes {
    "community-plugins/plugins/perspectives/Perspectives.ts"
    "community-plugins/plugins/perspectives/test/Perspectives.test.ts"
    "community-plugins/plugins/perspectives/test/restart-recovery.test.ts"
    "community-plugins/plugins/perspectives/COORDINATOR_DESIGN.md"
    "fork/patches/0036-test-perspectives-add-live-restart-fault-barriers.patch"
  }
  needs { module.produced(scopedRecoveryTools); module.verified(scopedRecoveryTools); module.verified(forkFaultBarrierQualification) }
  oracle = module.adjudicated("Record commands, runtime isolation, coordinator ID or launch-uncertain result, queue row IDs, delivery events, child IDs, event timing, exact artifact bytes, and caller outcome for each restart point. A pass requires a readable synthesis or explicit bounded failure/partial result after recovery, with no silent loss or undisclosed duplicate panel. If scheduled delivery cannot wake a required state, fail and revise the implementation or BB core before release.", "perspectives-reviewer")
}

local forkFaultBarrierQualification = new Guard {
  id = "fork-fault-barrier-qualification"
  owner = "perspectives-reviewer"
  outcome = "Qualify the opt-in BB fork fault barriers used by live-restart-proof without changing the normal runtime. Confirm the patch replays on the pinned upstream and series, disabled hooks preserve ordinary behavior, enabled hooks pause at the three exact durable boundaries, and an isolated patched server can run on disposable data. Inspect the changed fork composition and run relevant fork install, typecheck, tests, and build checks in a disposable authoring checkout."
  observes {
    "fork/patches/0036-test-perspectives-add-live-restart-fault-barriers.patch"
    "fork/patches/series"
    "fork/patches/sha256"
    "fork/result-tree.lock"
  }
  oracle = module.adjudicated("Record the patch hash and reproduced result tree, exact commands and outcomes for fork install/typecheck/focused and repository tests/build, a disabled-mode regression and all three enabled barrier seams, and the identity of a disposable patched server bundle. Inspect the diff for production effects and confirm fork/build/bb, normal service, and operator state remain untouched. A source-only or in-memory test cannot alone prove a live restart cut.", "perspectives-reviewer")
}

local publicContract = new Action {
  id = "public-contract-and-docs"
  owner = "perspectives-implementer"
  outcome = "Update the tool description, dynamic instructions, README, and focused tests to describe coordinator parenting, automatic child reports, the short completion summary and file location, scheduled recovery, partial outcomes, the actual cap semantics, and the caller's responsibility to read and present the synthesis. Preserve the rule that internal worker and planner references are not exposed in the final answer."
  grant {
    "community-plugins/plugins/perspectives/README.md"
    "community-plugins/plugins/perspectives/server.ts"
    "community-plugins/plugins/perspectives/test/server.test.ts"
    "community-plugins/plugins/perspectives/test/execution-application.test.ts"
  }
  needs { module.produced(coordinatorImplementation); module.verified(coordinatorImplementation) }
  oracle = module.mechanical("npm run test --workspace @phosphorco/bb-plugin-perspectives && npm run typecheck --workspace @phosphorco/bb-plugin-perspectives")
}

local repositoryQualification = new Guard {
  id = "community-repository-qualification"
  owner = "perspectives-reviewer"
  outcome = "Run the community repository's required clean-install, test, typecheck, and build checks against the candidate and inspect the diff for unrelated edits or generated output."
  observes { "community-plugins/**" }
  needs { module.produced(scopedRecoveryTools); module.verified(scopedRecoveryTools) }
  oracle = module.adjudicated("After scoped-recovery-tools changes, run from community-plugins: npm ci, npm run test, npm run typecheck, and npm run build. Record exact candidate source digests and results, inspect the complete Perspectives diff, and confirm generated dist output is not committed. Earlier qualification of the CLI-only candidate does not satisfy this oracle.", "perspectives-reviewer")
}

local releaseReview = new Guard {
  id = "release-review"
  owner = "cole"
  outcome = "Review the observed restart behavior, user-facing result flow, deadline and duplicate-delivery limits, and repository qualification against the promised outcome before any publication or activation."
  observes {
    "community-plugins/plugins/perspectives/COORDINATOR_DESIGN.md"
    "community-plugins/plugins/perspectives/README.md"
    "community-plugins/plugins/perspectives/Perspectives.ts"
    "fork/patches/0036-test-perspectives-add-live-restart-fault-barriers.patch"
  }
  needs { module.verified(restartProof); module.verified(repositoryQualification); module.verified(forkFaultBarrierQualification) }
  oracle = module.adjudicated("Cole accepts the demonstrated coordinator and caller experience, including any disclosed limits from the isolated restart proof, as ready for publication. This is a judgment on a concrete candidate, not an automatic publication grant.", "cole")
}

nodes {
  nativeRecoveryProbe
  scheduledDeliveryProbe
  artifactAccessProbe
  launchIdentityProbe
  coordinatorContract
  failingWitness
  coordinatorImplementation
  scopedRecoveryTools
  restartProof
  publicContract
  repositoryQualification
  forkFaultBarrierQualification
  releaseReview
}
