  id = "history-policy"
  owner = "cole"
  question = "Older package history contains private-plugin imports, campaign evidence and host paths (/home/ubuntu/.bb/thread-storage). Carry it into the public repo, or import the cleaned tree fresh with a pointer to the private source commit (history stays in private plugins)?"
  options { "preserve-split-history"; "fresh-import-with-source-pointer" }
}

