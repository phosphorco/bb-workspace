amends "workbench:plan"

// Ledger: --ledger /home/ubuntu/.bb/thread-storage/thr_i7xakgdxdd/package-publication.ledger.jsonl
// Oracles run with --cwd /home/ubuntu/bb; scripts and DESIGN.md live in plans/package-publication/.
// Every mechanical oracle judges freshly fetched origin/main in a verification-only worktree (shared trees and
// peer dirt untouched) and fails today; those failures are recorded as known-failure witnesses.
// Supersedes the open tail of plans/workspace-reconciliation.plan.pkl; its scripts are reused here with
// fresh-check.sh binding them to the post-move child heads.
// Authority: Cole, 2026-10-04 ("bring bb-identity and bb-provider-settings to publication"), plus the standing
// reconciliation grant to commit and merge across children while coordinating with peer threads by bb thread tell.
// Never: discard or publish peer dirt, change a production package API (additive /testing entries approved by Cole 2026-10-04), edit the fork, npm publish without Cole, restart
// bb.service, write provider settings, or change host plugin selection.

meta {
  title = "Move bb-identity and bb-provider-settings to bb-community-plugins and publish them"
  goal = "@phosphorco/bb-identity and @phosphorco/bb-provider-settings live in public phosphorco/bb-community-plugins with unchanged production API (plus the Cole-approved additive /testing conformance entries), consumer testing inverted (each plugin owns kit-based tests), are published to npm from it with provenance and trusted publishing configured, are consumed by exact npm version in plugins and community-plugins (Perspectives delivered), CI is green, and the combined workspace is fully checked, reloaded, promoted and clean."
}

local steward = "thr_i7xakgdxdd"
local campaign = "thr_qjduvhha3z"
local s = "plans/package-publication"
local r = "plans/workspace-reconciliation"

local planReview = new Guard {
  id = "plan-review"
  owner = steward
  outcome = "An independent reviewer accepts this graph, its scripts and DESIGN.md as a faithful, safe route to the goal."
  observes { "plans/package-publication.plan.pkl"; "\(s)/"; "AGENTS.md" }
  oracle = module.adjudicated("Every goal condition maps to an oracle with a recorded known-failure witness; edges reflect real inputs; oracles judge pushed SHAs; nothing discards or publishes peer work, changes a production package API (beyond approved additive /testing entries), publishes private evidence, edits the fork, or publishes to npm without Cole.", "plan-reviewer")
}

local ownerCoordination = new Guard {
  id = "owner-coordination"
  owner = steward
  outcome = "The provider-settings campaign and any active package owners accept the move and a package-edit freeze in plugins/packages until plugins consumes npm, and name in-flight edits."
  observes { "plugins/packages"; "community-plugins/plugins/perspectives"; "bb thread messages" }
  oracle = module.adjudicated("Ledger evidence records the owner's bb thread tell reply accepting move and freeze (or Cole's ruling).", steward)
}

local design = new Action {
  id = "design"
  owner = steward
  outcome = "DESIGN.md decides transfer method, community layout/toolchain, suite destinations, publish workflow, pin policy, references and a cut-over order that keeps every pushed commit green."
  grant { "\(s)/DESIGN.md" }
  needs { module.verified(ownerCoordination) }
  oracle = module.adjudicated("DESIGN.md answers each question from inspected files, and its order never pushes package changes while the private workflow can publish nor leaves plugins depending on an unpublished version.", "plan-reviewer")
}

local triageAccepted = new Guard {
  id = "triage-accepted"
  owner = campaign
  outcome = "The provider-settings campaign accepts the per-file triage (keep, kit, plugin, archive, prune), the /testing kit API and the per-plugin behaviour obligations [1]-[7] in thread storage package-publication/test-triage.md (Cole approved the redesign and ruthless pruning, 2026-10-04)."
  observes { "/home/ubuntu/.bb/thread-storage/thr_i7xakgdxdd/package-publication/test-triage.md" }
  needs { module.verified(design) }
  oracle = module.adjudicated("A bb thread tell from \(campaign) accepts the triage or lists changes that are folded in and re-accepted.", steward)
}

local archiveEvidence = new Action {
  id = "archive-evidence"
  owner = steward
  outcome = "Before anything moves, all campaign evidence in both packages (tracked and gitignored disk-only files: artifacts/, receipts, logs, STATUS/REVIEW, local-proof, retirement tooling) is copied byte-identically by archive.sh into the PRIVATE plugins repo at evidence/package-publication/ (bb-workspace is public) after an independent pre-copy inventory of original hashes, with MANIFEST.json (oldPath, archivedPath, sha256, tracked, source), relocation-run failure logs and per-item verbatim acceptance limits; nothing is rewritten or re-minted; committed and pushed to plugins main before any package file is removed."
  grant { "plugins/evidence/package-publication/"; "thread storage package-publication/archive-inventory.json" }
  needs { module.verified(triageAccepted) }
  oracle = module.mechanical("\(s)/archive-check.sh")
}

local packageKits = new Action {
  id = "package-kits"
  owner = steward
  outcome = "Pushed plugins main: bb-provider-settings gains ./testing (fixtures, fake catalog, owner probe/network, owner and invocation scenarios) and ./testing/react (mountEditor that settles the initial Read; UI scenarios) driving the real owner implementation through the SDK fake host, with a kit self-test and a negative self-test in its ordinary test; bb-identity ./testing gains createIdentityWireFake and defineStateStorageConformance. Kits name no consumer, import nothing outside the package, carry no evidence, and are documented as source conformance, not native proof."
  grant { "plugins/packages/bb-provider-settings/src/testing*.ts*"; "plugins/packages/bb-provider-settings/test/testing/"; "plugins/packages/bb-provider-settings/tools/ordinary-test.mjs and build.mjs (kit tests, types and entries)"; "plugins/packages/bb-provider-settings/tsconfig*.json (kit declarations)"; "plugins/packages/bb-identity/testing* and its runtime source for createIdentityWireFake / defineStateStorageConformance"; "plugins/packages/bb-identity/type-tests (kit tests)"; "plugins/tools/workspaces-sync/definition.ts (exports, build entries and externals, optional testing peers, dev dependencies)"; "generated manifests"; "plugins/bun.lock"; "package README/CONTRACT (testing section)"; "never the production owner/runtime implementation" }
  needs { module.verified(triageAccepted); module.verified(planReview) }
  oracle = module.mechanical("\(s)/kit-check.sh")
}

local pluginConformance = new Action {
  id = "plugin-conformance"
  owner = steward
  outcome = "Pushed plugins main: each private consumer (rosetta-slack, github-review, thread-progress, sticky-notes, btw, future-threads, review-to-disposition, plugin-provider-settings) owns kit-based tests for its obligations in test-triage.md section 3, with the stale and racing cases rewritten to the correct behaviour; thread-progress inbox tests use createIdentityWireFake; the central registry, consumer suites, native-boundaries and central page suites, source-loader and pinned runners leave the packages in the same commit as their replacements; every removed file is archived or recorded in DISPOSITION.md with where its behaviour is retained."
  grant { "plugins/plugins/{rosetta-slack,github-review,thread-progress,sticky-notes,btw,future-threads,review-to-disposition,plugin-provider-settings}/test/"; "plugins/packages/*/test, type-tests, tools, examples (removals per triage)"; "plugins/tools/workspaces-sync/definition.ts (scripts, workspaces)"; "plugins/tools/sdk-types/run.mts (fixture path)"; "plugins/package.json scripts"; "plugins/bun.lock"; "plugins/evidence/package-publication/DISPOSITION.md" }
  needs { module.verified(packageKits); module.verified(archiveEvidence) }
  oracle = module.mechanical("\(s)/conformance-check.sh")
}

