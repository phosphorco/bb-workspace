  id = "move-to-community"
  owner = steward
  outcome = "Pushed community main: both packages subtree-added from the plugins split tips (recorded in split-tips) into packages/ as the first npm workspace, with npm-valid manifests (exact catalog values, bun 1.3.14 devDependency, public SDK 0.5.29, community repository), unchanged exports/peers/dependency set, standalone code, packs covering every export; agentation-mentions pins bb-identity 0.1.0; Perspectives hand-off landed byte-identical with exact bb-provider-settings 0.1.0 and execution-settings.ts in files (adaptations in separate commits); lock links both; only the seven Perspectives rows are removed from held-paths.txt once committed (other rows stay with their owners), and the perspectives reload hold is lifted only after these checks pass."
  grant { "community-plugins/packages/"; "community-plugins/package.json"; "community-plugins/package-lock.json"; "community-plugins/plugins/agentation-mentions/package.json"; "community-plugins/plugins/perspectives (the seven hand-off files, package.json; no settings writes)"; "community-plugins/AGENTS.md"; "community-plugins/README.md (packages section)"; "\(s)/split-tips"; "\(r)/held-paths.txt"; "\(r)/reload-hold.txt" }
  needs { module.verified(pluginConformance); module.verified(conformanceAccepted); module.ruled(historyPolicy); module.verified(historyRevision) }
  oracle = module.mechanical("\(s)/community-moved.sh")
}

