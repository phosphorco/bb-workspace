amends "workbench:plan"

meta {
  title = "Analytics: shared queries and trustworthy chart references"
  goal = "Deliver the Analytics 80/20: retained typed facts, one bounded backend DuckDB query service, reusable declarative dashboards, and immutable chart-to-chat context, with measured performance and preserved existing workflows."
}

// Run from /home/ubuntu/bb. See analytics/brief.md for scope and acceptance.
// Future acceptance commands below are instruments to build, not existing proof.
// Cole authorized execution through BB child threads on 2026-09-08.
local probeBuild = new Action {
  id = "feasibility-instruments"
  owner = "implementer"
  outcome = "Build bounded probes of public SDK history/change semantics, isolated native versus Wasm DuckDB execution, resource enforcement, packaging, and current performance. Reproduce the observed parser and cancellation defects without reading unrelated data or exhausting the host."
  grant { "community-plugins/plugins/analytics/test/architecture/probes/**"; "community-plugins/plugins/analytics/docs/architecture-evidence/probes/**" }
  oracle = module.adjudicated("Inspect real SDK/engine calls, synthetic controls, redacted evidence, exact version/revision capture, bounded inputs and deadlines. The probe must distinguish unsupported capabilities from successful observations and must not accept crashes or missing imports as intended defect witnesses. Follow plans/analytics/brief.md.", "reviewer")
}

local feasibility = new Guard {
  id = "feasibility-evidence"
  owner = "implementer"
  observes { "community-plugins/plugins/analytics/test/architecture/probes/**"; "community-plugins/plugins/analytics/docs/architecture-evidence/probes/**"; "community-plugins/plugins/analytics/types/**" }
  needs { module.produced(probeBuild); module.verified(probeBuild) }
  outcome = "Record engine containment/cancellation/packaging, supported source pagination and invalidation, and baseline cold/warm costs. Measure extraction, serialization, SQL and rendering separately; preserve unsupported cases."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/probes/run.mjs --bounded --assert-evidence")
}

local runtime = new Selector {
  id = "backend-runtime"
  owner = "implementer"
  question = "Which backend process runtime meets measured isolation, cancellation, memory, startup and community-plugin packaging requirements? Choose native DuckDB or DuckDB-Wasm only after the probe; revise the plan if neither qualifies."
  options { "isolated-native-duckdb"; "isolated-wasm-duckdb" }
  probe = feasibility
  outcome = "Record a technical ruling with evidence. Both choices preserve one public execution interface. A ruling does not select code automatically: update runtime-specific grants and oracles before implementation."
}

local contract = new Action {
  id = "execution-contract"
  owner = "implementer"
  needs { module.verified(feasibility); module.ruled(runtime) }
  grant { "community-plugins/plugins/analytics/execution-contract.ts"; "community-plugins/plugins/analytics/docs/execution-contract.md"; "community-plugins/plugins/analytics/test/architecture/fixtures/**" }
  outcome = "Specify executable request/result/execution-reference schemas and fixtures: source scope, retention/backfill coverage, frozen range endpoints, source and bundle/query revisions, typed rows, stable keys, limits, cache identity, errors and cancellation. Define exact SQL grammar, selected runtime, migration, shared-host identity semantics and benchmark budgets before consumers implement them."
  oracle = module.adjudicated("The contract makes all acceptance rows in the brief testable. A 90-day label cannot imply unobserved history. Query and result identity include explicit time boundaries and scope. References identify historical bundle/query bindings and sibling consumers. Ordinary SQL authoring and legacy saved bundles have a documented supported/migration path. Runtime/retention/resource choices are evidence-backed; any promised-outcome change is attributed to Cole rather than silently assumed. No unsupported public APIs or invented private tenancy.", "reviewer")
}

local harness = new Action {
  id = "acceptance-instruments"
  owner = "implementer"
  needs { module.produced(contract); module.verified(contract) }
  grant { "community-plugins/plugins/analytics/test/architecture/acceptance.mjs"; "community-plugins/plugins/analytics/test/architecture/suites/**"; "community-plugins/plugins/analytics/test/architecture/browser/**" }
  outcome = "Build extraction, query-runtime, reference, UI, end-to-end, performance and migration suites against the accepted public contract. Include controlled clocks, process failure, crash checkpoints, adversarial SQL, real browser interactions and positive/negative assertion controls."
  oracle = module.adjudicated("Inspect each suite against the acceptance map. Tests must exercise production boundaries, fail on deliberately incorrect values/context and missing dependencies, and assert meaningful performance budgets rather than only write timing reports. The witness mode recognizes only the known parser/queue failures, with baseline source fingerprints. Runtime benchmark results include distributions, peak resources, cache/extraction counts and host responsiveness.", "reviewer")
}

// Test construction and product construction can overlap against the accepted
// contract. Full suite review still gates composition, and each implementation
// must pass its own normal suite; self-controls are never product evidence.
local runnerEvidence = new Guard {
  id = "acceptance-runner-historical"
  owner = "implementer"
  needs { module.produced(harness); module.verified(contract) }
  observes { "community-plugins/plugins/analytics/test/architecture/acceptance.mjs"; "community-plugins/plugins/analytics/test/architecture/browser/supervised-node.mjs"; "community-plugins/plugins/analytics/test/architecture/browser/runner-controls.test.mjs"; "community-plugins/plugins/analytics/test/architecture/suites/baseline-witnesses.mjs"; "community-plugins/plugins/analytics/test/architecture/probes/baseline/fixtures/historical/**" }
  outcome = "Verify the existing bounded suite supervisor and protocol with inert adversarial controls, plus immutable historical parser/queue witnesses. This permits contract-based implementation, not acceptance of unfinished suites or product behavior."
  oracle = module.mechanical("node --test community-plugins/plugins/analytics/test/architecture/browser/runner-controls.test.mjs && node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite baseline-witnesses")
}

local witness = new Guard {
  id = "historical-failing-witnesses"
  owner = "implementer"
  needs { module.produced(harness); module.verified(runnerEvidence) }
  observes { "community-plugins/plugins/analytics/sql-policy.ts"; "community-plugins/plugins/analytics/browser-engine.ts"; "community-plugins/plugins/analytics/test/architecture/**" }
  outcome = "Preserve the exact accepted nested catalog/table-function query and A-running/B-cancelled/C-overlapping schedule from the baseline as failing witnesses. If concurrent work already fixed them, preserve a controlled baseline reproduction and record current results separately."
  oracle = (module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite baseline-witnesses")) { once = true }
}

local extraction = new Action {
  id = "retained-fact-projection"
  owner = "implementer"
  needs { module.produced(contract); module.verified(contract); module.produced(harness); module.verified(runnerEvidence) }
  grant { "community-plugins/plugins/analytics/store.ts"; "community-plugins/plugins/analytics/fact-projection.ts"; "community-plugins/plugins/analytics/fact-schema.ts"; "community-plugins/plugins/analytics/extraction/**"; "community-plugins/plugins/analytics/test/store.test.ts"; "community-plugins/plugins/analytics/test/fact-projection.test.ts" }
  outcome = "Implement one pull-triggered resumable extractor and transactional fact/checkpoint publication. Retain facts within the agreed window when threads leave the recent list; reconcile mutations, deletions and projection upgrades via verified source semantics. Preserve good data on failure, bound cold backfill batches, and report earliest complete coverage. No periodic extraction while unused."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite extraction")
}

local queries = new Action {
  id = "isolated-query-service"
  owner = "implementer"
  needs { module.produced(contract); module.verified(contract); module.produced(harness); module.verified(runnerEvidence); module.verified(witness) }
  grant { "community-plugins/plugins/analytics/query-runtime/**"; "community-plugins/plugins/analytics/sql-policy.ts"; "community-plugins/plugins/analytics/analytics-verifier.ts"; "community-plugins/plugins/analytics/package.json"; "community-plugins/package.json"; "community-plugins/package-lock.json"; "community-plugins/plugins/analytics/THIRD_PARTY_NOTICES.md" }
  outcome = "Implement isolated DuckDB-Wasm in an explicitly packaged plugin-owned Node child and one shared query API for UI/agents. Fixed trusted core JSON bootstrap precedes disabled external access and locked configuration; authored input cannot enter bootstrap. Validate the complete accepted SQL tree, bind values, contain external capabilities and enforce the documented memory/time/result/queue envelope without claiming an unproven process-RSS cap. Cache and deduplicate by immutable execution inputs; cancellation of one subscriber cannot cancel other subscribers or violate serial ownership. Store bounded canonical execution results and historical definitions for references. Verification uses the same isolated path."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite query-runtime --timeout-ms 120000 --total-timeout-ms 300000")
}

local references = new Action {
  id = "immutable-reference-service"
  owner = "implementer"
  needs { module.produced(contract); module.verified(contract); module.produced(harness); module.verified(runnerEvidence) }
  grant { "community-plugins/plugins/analytics/analytics-reference.ts"; "community-plugins/plugins/analytics/reference-store.ts"; "community-plugins/plugins/analytics/reference-service.ts"; "community-plugins/plugins/analytics/test/analytics-reference.test.ts" }
  outcome = "Implement reference creation from authoritative execution ID plus selected datum key, never client-asserted SQL or row values. Capture bounded immutable query/bundle/visualization context and source coverage; support copy, mention resolution and agent lookup using one resolver. Define expiration/deletion and shared-host request admission without inventing private permission tiers."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite references")
}

local ui = new Action {
  id = "execution-backed-ui"
  owner = "implementer"
  needs { module.produced(contract); module.verified(contract); module.produced(harness); module.verified(runnerEvidence); module.verified(witness) }
  grant { "community-plugins/plugins/analytics/app.tsx"; "community-plugins/plugins/analytics/app.css"; "community-plugins/plugins/analytics/browser-engine.ts"; "community-plugins/plugins/analytics/analytics-model.ts"; "community-plugins/plugins/analytics/analytics-export.ts"; "community-plugins/plugins/analytics/analytics-status.ts"; "community-plugins/plugins/analytics/echarts-figure.tsx"; "community-plugins/plugins/analytics/echarts-options.ts"; "community-plugins/plugins/analytics/echarts-update-policy.ts"; "community-plugins/plugins/analytics/chart-environment.ts" }
  outcome = "Consume the shared execution API with small canonical results and preserve the current topbar/loading illustration/chart adapter. Eliminate browser fact loading and DuckDB ownership at cutover. Keep prior results during refresh; freeze complete menu context and export revision; give pointer and keyboard identical actions. Release subscriptions/observers/charts on unmount and preserve SQL order and truthful plotted counts."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite ui")
}

local compose = new Action {
  id = "compose-plugin"
  owner = "implementer"
  needs {
    module.produced(harness); module.verified(harness)
    module.produced(extraction); module.verified(extraction)
    module.produced(queries); module.verified(queries)
    module.produced(references); module.verified(references)
    module.produced(ui); module.verified(ui)
  }
  grant { "community-plugins/plugins/analytics/server.ts"; "community-plugins/plugins/analytics/rpc-contract.ts"; "community-plugins/plugins/analytics/bundle-contract.ts"; "community-plugins/plugins/analytics/builtin-bundles.ts"; "community-plugins/plugins/analytics/test/bundle-contract.test.ts" }
  outcome = "Wire lifecycle, migrations, loader, query service, UI RPC, CLI, mentions and agent tools through supported BB APIs. Preserve installed bundle compatibility and all current built-ins, including turn-efficiency/native-command analysis. Remove obsolete browser-engine asset/fact routes after consumers migrate. Reuse public bb-identity bindings if identity composition is needed; expose package/capability gaps instead of patching the fork."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite composition")
}

local endToEnd = new Guard {
  id = "analytical-interaction-proof"
  owner = "implementer"
  needs { module.produced(compose); module.verified(compose) }
  observes { "community-plugins/plugins/analytics/**" }
  outcome = "Observe the actual UI/query/reference path: rapid range changes, refresh and bundle edit with a menu open, exact table and pointer selection, copy and send-time mention resolution, and CSV/SVG export. Verify the same historical execution and coverage throughout; no real external messages are sent by tests."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite end-to-end")
}

local performance = new Guard {
  id = "performance-proof"
  owner = "implementer"
  needs { module.produced(compose); module.verified(compose) }
  observes { "community-plugins/plugins/analytics/**" }
  outcome = "Measure increasing retained history, 1/10/30 visualizations sharing queries, distinct queries, 1/4 viewers, 0/1/5/20/80 changed threads, cold/warm/stale refreshes, cancellations and repeated navigation. Assert accepted latency/resource/reuse budgets and equal analytical answers; capture host contention and no idle extraction."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite performance")
}

local compatibility = new Guard {
  id = "compatibility-proof"
  owner = "implementer"
  needs { module.produced(compose); module.verified(compose) }
  observes { "community-plugins/**"; "bin/check" }
  outcome = "Verify legacy storage/bundle/reference migration, restart and rollback behavior, clean community-plugin installation/packaging, all community checks and staging composition. Retain exact tested source identities and report unrelated failures without erasing authored work."
  oracle = module.mechanical("node community-plugins/plugins/analytics/test/architecture/acceptance.mjs --suite migration-packaging && npm --prefix community-plugins ci && npm --prefix community-plugins run test && npm --prefix community-plugins run typecheck && npm --prefix community-plugins run build && ./bin/check --role staging")
}

local handoff = new Action {
  id = "evidence-and-handoff"
  owner = "implementer"
  needs { module.verified(endToEnd); module.verified(performance); module.verified(compatibility) }
  grant { "community-plugins/plugins/analytics/README.md"; "community-plugins/plugins/analytics/docs/architecture-evidence/final/**" }
  outcome = "Publish the actual architecture, accepted runtime choice, reproducible performance report, exact coverage/freshness semantics, compatibility and recovery instructions, known limits and a workflow demonstration. Separate historical review claims from new observed evidence."
  oracle = module.adjudicated("Reports identify actual tested revisions, hardware, dataset shapes, distributions and budget results. Commands reproduce the acceptance evidence. Documentation matches implementation and preserves current workflows; no large-history, authorization, isolation or timing guarantees exceed the evidence.", "reviewer")
}

local finalReview = new Guard {
  id = "outcome-review"
  owner = "reviewer"
  needs { module.produced(handoff); module.verified(handoff); module.verified(endToEnd); module.verified(performance); module.verified(compatibility) }
  observes { "plans/analytics.plan.pkl"; "plans/analytics.ledger.jsonl"; "plans/analytics/brief.md"; "community-plugins/plugins/analytics/**" }
  outcome = "Judge the complete 80/20 outcome, including unresolved ledger notes and any discoveries that have not yet become nodes. This review does not publish packages or promote the normal host."
  oracle = module.adjudicated("Shared retained extraction and shared bounded queries work through the real product. Chart/table/export/chat context stays exact across edits, refresh, cancellation and restart. Performance/reuse/resource acceptance and legacy compatibility have current evidence. All in-scope unresolved notes are resolved, represented by failing/open obligations, or explicitly removed by the actual outcome owner; a green partial graph is insufficient.", "reviewer")
}

nodes {
  probeBuild; feasibility; runtime; contract; harness; runnerEvidence; witness
  extraction; queries; references; ui; compose
  endToEnd; performance; compatibility; handoff; finalReview
}
