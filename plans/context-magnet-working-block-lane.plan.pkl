    module.produced(legacyAdmissionCarrierCompatibility); module.verified(legacyAdmissionCarrierCompatibility)
  }
  oracle = module.adjudicated("In the running example child, the tree makes tool-heavy work scannable; every retained contribution is visible near its exact or nearest relevant timeline step; the reason for inclusion remains traceable when its triggering host-agent fact is unrendered; gaps are explicit; empty, rejected, delivered, suppressed, and consumed states remain distinguishable; popovers do not add timeline height; the native conversation remains intact; and the displayed loaded plugin/runtime provenance matches the activation receipt.", "cole")
}

