amends "workbench:plan"

meta {
  title = "Context Magnet working-block delivery lane"
  goal = "Deliver a high-performance, evidence-preserving Context Magnet working-block tree in which every retained contribution is visible near its relevant timeline point and its inclusion rationale remains traceable even when the triggering host-agent fact is not rendered, without rebuilding BB's native ThreadChat or inventing a provider join."
}

// This graph intentionally resolves the carrier before adding the carrier-specific
// implementation node. The present plugin has an explicit agent-cli trace and a
// test-only consumption witness, but it does not yet establish a public, lossless
// source of every BB operation and every Context Magnet contribution. Public
// thread events were preferred only when they satisfied the exhaustive visibility
// and rationale-provenance contract. The recorded `host-api-required` ruling now
// ran carrier-contract and host-api-topology in parallel. Before projection code
// starts, host-api-plan-revision requires this plan to contain the exact fork API,
// SDK artifact, and live-proof nodes, focused tests, narrow write footprints, and
// producer dependencies. The topology's generic configuration-selection proposal
// was tightened during review: only explicit plugin-supplied trace declarations
// are contributions, and tool-call turnId/callId is the model-owned receipt anchor.

local carrierProbe = new Action {
  id = "carrier-probe"
  owner = "trace-investigator"
  outcome = "Document, from the selected SDK and stored-thread-event contract, whether public thread events can enumerate every retained Context Magnet contribution, place it by a stable item/turn/sequence identity near the relevant rendered operation, and preserve an inclusion-rationale reference when its triggering host-agent fact is unrendered, without reading provider requests, guessing sessions, or widening retention."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/trace-carrier-probe.md"
  }
  oracle = module.mechanical("test -s plugins/plugins/context-magnet-inspector/docs/trace-carrier-probe.md")
}

local fixtureScenarios = new Action {
  id = "fixture-scenarios"
  owner = "fixture-author"
  outcome = "Create bounded, non-secret fixtures for tool-heavy working blocks that distinguish no context, rejected-before-injection, delivered, deduplicated, failed, unavailable, and behaviorally consumed evidence; include multiple contributions at one step, a contribution justified by an unrendered host-agent fact, pagination, and an explicit retention gap."
  grant {
    "plugins/plugins/context-magnet-inspector/test/fixtures/working-block-lane.json"
    "plugins/plugins/context-magnet-inspector/test/working-block-fixture.test.ts"
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/working-block-fixture.test.ts")
}

local carrierEvidence = new Guard {
  id = "carrier-evidence"
  owner = "architecture-reviewer"
  outcome = "Review whether public thread events provide a concrete exhaustive contribution source, stable operation identity, traceable rendered or unrendered rationale provenance, retention/lossiness boundaries, and the exact point at which each Context Magnet record attaches to the timeline."
  observes {
    "plugins/plugins/context-magnet-inspector/docs/trace-carrier-probe.md"
  }
  needs { module.produced(carrierProbe); module.verified(carrierProbe) }
  oracle = module.adjudicated("The probe cites exact SDK/event evidence; distinguishes observed data from inference; proves or disproves exhaustive contribution enumeration and a safe per-operation join; demonstrates how inclusion rationale remains traceable for unrendered host-agent facts; makes gaps explicit; and names no undocumented provider request or guessed session as a source.", "architecture-reviewer")
}

local carrierRoute = new Selector {
  id = "carrier-route"
  owner = "cole"
  outcome = "Choose the source of the per-operation trace needed by the working-block tree."
  question = "Do reviewed public BB thread events satisfy exhaustive contribution visibility, stable timeline attachment, and traceable rationale provenance including unrendered triggers, or is a narrow host trace API required?"
  options { "public-thread-events"; "host-api-required" }
  probe = carrierEvidence
}

local carrierContract = new Action {
  id = "carrier-contract"
  owner = "contract-author"
  outcome = "Write the ruled carrier contract: immutable operation key, turn/working-block boundary, event ordering, exhaustive contribution pagination, explicit Context Magnet link, inclusion-rationale provenance for rendered and unrendered triggers, unavailable/unmatched/gap representation, and the ban on inferred joins."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/trace-carrier-contract.md"
  }
  needs { module.ruled(carrierRoute) }
  oracle = module.mechanical("test -s plugins/plugins/context-magnet-inspector/docs/trace-carrier-contract.md")
}

local hostApiTopology = new Action {
  id = "host-api-topology"
  owner = "host-api-investigator"
  outcome = "Identify the exact durable fork source files, public SDK generation path, persistence/query boundary, retention semantics, and focused tests needed for a narrow paginated Context Magnet contribution-trace API; distinguish source-of-truth edits from materialized or generated outputs."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/host-trace-api-topology.md"
  }
  needs { module.ruled(carrierRoute) }
  oracle = module.mechanical("test -s plugins/plugins/context-magnet-inspector/docs/host-trace-api-topology.md")
}

local carrierContractReview = new Guard {
  id = "carrier-contract-review"
  owner = "architecture-reviewer"
  outcome = "Review the carrier contract before code consumes it."
  observes {
    "plugins/plugins/context-magnet-inspector/docs/trace-carrier-contract.md"
  }
  needs { module.produced(carrierContract); module.verified(carrierContract) }
  oracle = module.adjudicated("The contract names one canonical key and nearby attachment point for every retained contribution; makes pagination, gaps, and retention limits explicit; carries a safe rationale reference even for an unrendered trigger; and lets renderers distinguish no delivery from unknown evidence without retaining provider requests.", "architecture-reviewer")
}

local forkQueueBaseline = new Action {
  id = "fork-queue-baseline"
  owner = "fork-queue-conservator"
  outcome = "Record and mechanically verify the exact preexisting dirty 0024 queue state before Context Magnet edits: the 0024 patch bytes/hash, full series and checksum prefixes, downstream receipt diff, result tree, fork HEAD/status, and the rule that 0025 may only append without rewriting, dropping, or absorbing 0024. The verifier must support both an unchanged-baseline mode and a post-append mode used by host-trace-api."
  grant {
    "plans/context-magnet-fork-queue-baseline.json"
    "plans/verify-context-magnet-fork-queue-baseline.mjs"
  }
  needs { module.produced(hostApiTopology); module.verified(hostApiTopology) }
  oracle = module.mechanical("node plans/verify-context-magnet-fork-queue-baseline.mjs baseline")
}

local hostApiPlanRevision = new Guard {
  id = "host-api-plan-revision"
  owner = "architecture-reviewer"
  outcome = "Review that the ruled host API has become an executable, narrowly granted implementation subtree before plugin projection work begins."
  observes {
    "plans/context-magnet-working-block-lane.plan.pkl"
    "plans/context-magnet-fork-queue-baseline.json"
    "plans/verify-context-magnet-fork-queue-baseline.mjs"
    "plugins/plugins/context-magnet-inspector/docs/trace-carrier-contract.md"
    "plugins/plugins/context-magnet-inspector/docs/host-trace-api-topology.md"
  }
  needs {
    module.verified(carrierContractReview)
    module.produced(hostApiTopology); module.verified(hostApiTopology)
    module.produced(forkQueueBaseline); module.verified(forkQueueBaseline)
  }
  oracle = module.adjudicated("The current plan contains a concrete host trace API Action, an explicit plugin trace producer Action, and a reproducible SDK artifact Action with exact durable/generated write footprints, focused mechanical tests, and explicit producer dependencies from every consumer. A mechanically verified baseline protects the existing dirty 0024 patch and receipt prefixes before 0025 appends. The host accepts only explicit bounded Context Magnet trace declarations, records model-owned receipts from supplied host turnId/callId facts, and never relabels generic plugin configuration as Context Magnet. SDK proof binds the packed archive and provenance receipt to the fork result tree and installed consumer resolution. The live oracle executes an isolated candidate, proves cleanup/non-deployment, and does not merely validate a fixture. The carrier preserves exhaustive retained contributions, supplied anchors, unrendered-trigger rationale, snapshot completeness/gaps, and no provider bodies or inferred joins.", "architecture-reviewer")
}

local hostTraceApi = new Action {
  id = "host-trace-api"
  owner = "host-api-implementer"
  outcome = "Append one logical fork patch after the existing dirty 0024 queue that implements the v1 Context Magnet trace domain and immutable storage, generated migration, retention gaps, snapshot-bound paginated public read route, SDK method, and focused tests. Extend bb.agents.configure with an experimental bounded trace declaration so only explicit plugin-supplied contribution, rationale, trigger, and receipt-tool facts are persisted. On the successful registered receipt-tool path, resolve the supplied host turnId/callId to exactly one durable tool-call operation event and snapshot-safely project an initially unmatched witness contribution at that exact operation with model-owned consumption evidence; missing or ambiguous durable operation evidence remains explicit and unconsumed, never guessed. Preserve existing queue work, reject generic configuration synthesis, provider bodies, and inferred joins, and document the experimental public surface for audit."
  grant {
    "fork/DOWNSTREAM.md"
    "fork/patches/0025-feat-context-magnet-contribution-trace-api.patch"
    "fork/patches/series"
    "fork/patches/sha256"
    "fork/result-tree.lock"
    "fork/scripts/verify-context-magnet-contribution-trace"
  }
  needs {
    module.verified(hostApiPlanRevision)
    module.produced(forkQueueBaseline); module.verified(forkQueueBaseline)
    module.produced(carrierContract); module.verified(carrierContractReview)
    module.produced(hostApiTopology); module.verified(hostApiTopology)
  }
  oracle = module.mechanical("node plans/verify-context-magnet-fork-queue-baseline.mjs appended && cd fork && ./scripts/verify && ./scripts/verify-context-magnet-contribution-trace")
}

local hostSdkArtifact = new Action {
  id = "host-sdk-artifact"
  owner = "sdk-artifact-author"
  outcome = "Materialize the verified fork queue in disposable state, build and pack the public plugin SDK with its exact tree/input provenance, retain the derived archive and receipt under sdk-artifacts, advance the shared SDK definition, regenerate package manifests and the Bun lock through repository tooling, and prove installed plugin consumers resolve the new declarations. Do not edit fork/build/bb or bundled declaration output by hand."
  grant {
    "sdk-artifacts/README.md"
    "sdk-artifacts/checks.json"
    "sdk-artifacts/get-bb-plugin-sdk-*.tgz"
    "sdk-artifacts/get-bb-plugin-sdk-*.tgz.provenance.json"
    "sdk-artifacts/verify-context-magnet-sdk.mjs"
    "plugins/tools/workspaces-sync/definition.ts"
    "plugins/tsconfig.json"
    "plugins/plugins/*/package.json"
    "plugins/packages/bb-identity/type-tests/browser/package.json"
    "plugins/bun.lock"
    "plugins/node_modules/"
  }
  needs { module.produced(hostTraceApi); module.verified(hostTraceApi) }
  oracle = module.mechanical("node sdk-artifacts/verify-context-magnet-sdk.mjs && bun --cwd=plugins run sync:check && bun --cwd=plugins run sdk-types:check")
}

local projectionContract = new Action {
  id = "projection-contract"
  owner = "projection-author"
  outcome = "Define and test the plugin's typed working-block projection: primary transcript spine, operational block segments, every per-step Context Magnet outcome, nearest-rendered anchor plus explicit unrendered-trigger marker, inclusion-rationale provenance, paginated completeness/gaps, raw locators, and retained unmatched metadata."
  grant {
    "plugins/plugins/context-magnet-inspector/context-magnet.ts"
    "plugins/plugins/context-magnet-inspector/test/trace-projection.test.ts"
  }
  needs {
    module.verified(hostApiPlanRevision)
    module.produced(fixtureScenarios); module.verified(fixtureScenarios)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/trace-projection.test.ts")
}

// Once `projection-contract` is verified, these three write footprints are
// intentionally disjoint and can be delegated in parallel.
local agentCliProjection = new Action {
  id = "agent-cli-projection"
  owner = "adapter-author"
  outcome = "Project every explicit retained agent-cli contribution decision into typed per-step evidence, preserving supplied timeline links, inclusion rationale/provenance, pagination/gaps, and unmatched/withheld states while rejecting provider request bodies and guessed joins."
  grant {
    "plugins/plugins/context-magnet-inspector/agent-cli-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/agent-cli-step-projection.test.ts"
  }
  needs { module.produced(projectionContract); module.verified(projectionContract) }
  oracle = module.mechanical("node --test --experimental-strip-types test/agent-cli-step-projection.test.ts")
}

local hostTraceProjection = new Action {
  id = "host-trace-projection"
  owner = "host-trace-adapter-author"
  outcome = "Provide a bounded single-page projection for one ruled host contribution-trace snapshot cursor and an exhaustive multi-page composition over that same primitive. Preserve ordered operation lanes, stable supplied anchors, unrendered-trigger rationale, safe original/unknown evidence, redactions, completeness, gaps, and opaque continuation identity without inferring a provider/session/timestamp/log join."
  grant {
    "plugins/plugins/context-magnet-inspector/host-trace-adapter.ts"
    "plugins/plugins/context-magnet-inspector/test/host-trace-adapter.test.ts"
  }
  needs {
    module.produced(projectionContract); module.verified(projectionContract)
    module.produced(hostSdkArtifact); module.verified(hostSdkArtifact)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/host-trace-adapter.test.ts")
}

local witnessStepLink = new Action {
  id = "witness-step-link"
  owner = "witness-author"
  outcome = "Represent the test-only consumption witness as evidence linked to its exact model-owned operation through an explicit bounded non-secret witnessSelectionId retained in safe declaration evidence; keep the host-assigned contribution key separate, never retain the proof token, and keep consumed distinct from selected, delivered, invalid, or absent."
  grant {
    "plugins/plugins/context-magnet-inspector/witness.ts"
    "plugins/plugins/context-magnet-inspector/test/witness-step-link.test.ts"
  }
  needs {
    module.produced(projectionContract); module.verified(projectionContract)
    module.produced(hostSdkArtifact); module.verified(hostSdkArtifact)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/witness-step-link.test.ts")
}

local pluginTraceProducer = new Action {
  id = "plugin-trace-producer"
  owner = "plugin-trace-author"
  outcome = "Integrate the inspector's explicit bounded Context Magnet trace declaration into server.ts: bb.agents.configure supplies a bounded non-secret witnessSelectionId in safe evidence, safe rationale/trigger provenance, delivery outcome, and registered receipt-tool identity only when the witness is armed; the host alone assigns the canonical contribution key and the receipt tool remains the model-owned proof path. The proof token is never retained. Generic selected tools, skills, or instructions emit no trace. Prove invalid, unarmed, duplicate, oversized, body-bearing, and receipt-tool mismatch cases fail closed without provider bodies."
  grant {
    "plugins/plugins/context-magnet-inspector/server.ts"
    "plugins/plugins/context-magnet-inspector/trace-producer.ts"
    "plugins/plugins/context-magnet-inspector/test/plugin-trace-producer.test.ts"
  }
  needs {
    module.produced(hostSdkArtifact); module.verified(hostSdkArtifact)
    module.produced(witnessStepLink); module.verified(witnessStepLink)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/plugin-trace-producer.test.ts")
}

local workingBlockRenderer = new Action {
  id = "working-block-renderer"
  owner = "ui-author"
  outcome = "Render the approved plugin-owned working-block tree and aligned delivery lane: native ThreadChat remains intact; every contribution appears near its exact or nearest rendered operation; unrendered triggers and inclusion rationale are traceable; gaps are explicit; details are progressive disclosure; and closed/offscreen blocks create no per-row overlay work."
  grant {
    "plugins/plugins/context-magnet-inspector/app.tsx"
    "plugins/plugins/context-magnet-inspector/app.css"
    "plugins/plugins/context-magnet-inspector/test/working-block-renderer.test.ts"
    "plugins/plugins/context-magnet-inspector/test/working-block-performance.test.ts"
  }
  needs {
    module.produced(projectionContract); module.verified(projectionContract)
    module.produced(fixtureScenarios); module.verified(fixtureScenarios)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/working-block-renderer.test.ts test/working-block-performance.test.ts")
}

local inspectorPayload = new Action {
  id = "inspector-payload"
  owner = "rpc-author"
  outcome = "Expose one bounded, validated, snapshot-bound host page per inspection RPC with an opaque continuation cursor so integration can progressively enumerate every retained contribution without an aggregate cap. Each page contains ordered operation projections, inclusion-rationale provenance, evidence states, and explicit unavailable/partial/gap outcomes; refresh only the selected thread and never silently truncate or restart a continuation on a new snapshot."
  grant {
    "plugins/plugins/context-magnet-inspector/server.ts"
    "plugins/plugins/context-magnet-inspector/test/inspector-payload.test.ts"
  }
  needs {
    module.produced(projectionContract); module.verified(projectionContract)
    module.produced(agentCliProjection); module.verified(agentCliProjection)
    module.produced(hostTraceProjection); module.verified(hostTraceProjection)
    module.produced(witnessStepLink); module.verified(witnessStepLink)
    module.produced(pluginTraceProducer); module.verified(pluginTraceProducer)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/inspector-payload.test.ts")
}

local pluginIntegration = new Action {
  id = "plugin-integration"
  owner = "integrator"
  outcome = "Compose the authoritative page-local host payload into the approved working-block renderer beside native ThreadChat. Progressively append only opaque-cursor pages from the identical host snapshot, merge repeated host operation anchors without duplicating contributions, retain explicit unmatched and gap evidence, expose an accessible continuation control until nextCursor is null, and fail closed on snapshot, cursor, thread, or contribution-key drift. Never invent transcript nesting or provider/session/timestamp/text joins; keep closed blocks lazy and use one shared popover per open block."
  grant {
    "plugins/plugins/context-magnet-inspector/app.tsx"
    "plugins/plugins/context-magnet-inspector/app.css"
    "plugins/plugins/context-magnet-inspector/README.md"
    "plugins/plugins/context-magnet-inspector/test/plugin-integration.test.ts"
  }
  needs {
    module.produced(agentCliProjection); module.verified(agentCliProjection)
    module.produced(hostTraceProjection); module.verified(hostTraceProjection)
    module.produced(witnessStepLink); module.verified(witnessStepLink)
    module.produced(pluginTraceProducer); module.verified(pluginTraceProducer)
    module.produced(workingBlockRenderer); module.verified(workingBlockRenderer)
    module.produced(inspectorPayload); module.verified(inspectorPayload)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/plugin-integration.test.ts test/working-block-renderer.test.ts test/working-block-performance.test.ts && bun run typecheck && bun run build")
}

local witnessCarrierCompatibility = new Action {
  id = "witness-carrier-compatibility"
  owner = "witness-compatibility-author"
  outcome = "Align the v2 witness correlation matcher with the exact public host-carrier evidence shape selected by the installed SDK. Accept the carrier's bounded source, schema version, original selection identifier, unknown-fields, and redactions fields without requiring a rawLocators member that the host contract does not emit; continue to reject extra, malformed, proof-bearing, duplicated, cross-thread, non-exact, non-delivered, or non-model-owned evidence. Add a regression built from the real host page shape and preserve fail-closed behavior."
  grant {
    "plugins/plugins/context-magnet-inspector/witness.ts"
    "plugins/plugins/context-magnet-inspector/test/witness-step-link.test.ts"
  }
  needs {
    module.produced(hostSdkArtifact); module.verified(hostSdkArtifact)
    module.produced(witnessStepLink); module.verified(witnessStepLink)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/witness-step-link.test.ts && bun run typecheck")
}

local witnessTriggerCompatibility = new Action {
  id = "witness-trigger-compatibility"
  owner = "witness-trigger-author"
  outcome = "Make the test-only witness declaration use a trigger state that is valid without a fabricated host fact key. Because configure has no retained triggering host fact, emit an explicit unknown trigger with the bounded host-policy locator while preserving the safe inclusion rationale; do not relabel the trigger as rendered or unrendered, invent a fact key, or weaken the host adapter. Add a producer-to-adapter regression using the installed public carrier shape and retain all proof/body redaction guarantees."
  grant {
    "plugins/plugins/context-magnet-inspector/trace-producer.ts"
    "plugins/plugins/context-magnet-inspector/test/plugin-trace-producer.test.ts"
  }
  needs {
    module.produced(hostTraceProjection); module.verified(hostTraceProjection)
    module.produced(pluginTraceProducer); module.verified(pluginTraceProducer)
    module.produced(witnessCarrierCompatibility); module.verified(witnessCarrierCompatibility)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/plugin-trace-producer.test.ts test/host-trace-adapter.test.ts && bun run typecheck")
}

local prearmedStartDispatch = new Action {
  id = "prearmed-start-dispatch"
  owner = "prearmed-dispatch-author"
  outcome = "Fix context-magnet-demo start so the first executed command is assembled after the child-bound v2 metadata exists. Spawn one delayed child only to obtain and verify its ID/parent/project binding, arm that exact child, delete the stale spawn-time queued row whose agent configuration was assembled before arming, create one replacement queued message after arming, identify it exactly, and send only that row. On ambiguity or failure remove the owned queued row and child. Add regressions proving configure sees the armed metadata and that stale, ambiguous, or failed replacement paths never dispatch."
  grant {
    "plugins/plugins/context-magnet-inspector/server.ts"
    "plugins/plugins/context-magnet-inspector/test/inspector-payload.test.ts"
  }
  needs {
    module.produced(inspectorPayload); module.verified(inspectorPayload)
    module.produced(witnessTriggerCompatibility); module.verified(witnessTriggerCompatibility)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/inspector-payload.test.ts test/plugin-trace-producer.test.ts && bun run typecheck")
}

local postarmSendContract = new Action {
  id = "postarm-send-contract"
  owner = "postarm-send-author"
  outcome = "Use the existing-thread send contract for the first post-arm execution instead of treating queuedMessages.create as a fresh thread-start API. After verifying the child and arming its v2 metadata, delete the exact stale spawn-time row, call threads.send once with the explicit prompt and Terra/high/fast/accept-edits execution options, and accept only its typed sent or exactly identified queued result. Retain bounded failure-stage reporting and prove stale, rejected, or ambiguous outcomes never produce a consumption claim or a second dispatch."
  grant {
    "plugins/plugins/context-magnet-inspector/server.ts"
    "plugins/plugins/context-magnet-inspector/test/inspector-payload.test.ts"
  }
  needs {
    module.produced(prearmedStartDispatch); module.verified(prearmedStartDispatch)
  }
  oracle = module.mechanical("node --test --experimental-strip-types test/inspector-payload.test.ts test/plugin-trace-producer.test.ts && bun run typecheck")
}

local hostTraceSdkRuntime = new Action {
  id = "host-trace-sdk-runtime"
  owner = "host-sdk-runtime-author"
  outcome = "Extend the durable 0025 fork overlay with runtime coverage for the Context Magnet contribution-page SDK call, not just its public type key. Prove createNodeBbSdk emits GET /api/v1/threads/:id/context-magnet/contributions with the bounded limit and resolves the page, and prove the plugin-wrapped SDK can read the same page through the actual loopback transport. Reproduce the isolated inspector's pre-projection read failure, correct the narrow runtime binding/transport defect, retain route authorization and page schemas unchanged, regenerate receipts, and pass the strict disposable Node 22 replay without touching canonical upstream/build trees."
  grant {
    "fork/DOWNSTREAM.md"
    "fork/patches/0025-feat-context-magnet-contribution-trace-api.patch"
    "fork/patches/series"
    "fork/patches/sha256"
    "fork/result-tree.lock"
    "fork/scripts/verify-context-magnet-contribution-trace"
  }
  needs {
    module.produced(hostTraceApi); module.verified(hostTraceApi)
  }
  oracle = module.mechanical("node plans/verify-context-magnet-fork-queue-baseline.mjs appended && git -C fork diff --check && cd fork && ./scripts/verify-context-magnet-contribution-trace")
}

local hostSdkRuntimeArtifact = new Action {
  id = "host-sdk-runtime-artifact"
  owner = "sdk-artifact-author"
  outcome = "Repack the public plugin SDK from the verified host-trace SDK-runtime result tree, retain an exact archive and provenance receipt, advance the shared SDK selection and generated manifests through repository tooling, and prove installed plugin consumers resolve that exact artifact. Preserve prior retained SDK artifacts and do not edit fork/build/bb or bundled declaration output by hand."
  grant {
    "sdk-artifacts/README.md"
    "sdk-artifacts/checks.json"
    "sdk-artifacts/get-bb-plugin-sdk-*.tgz"
    "sdk-artifacts/get-bb-plugin-sdk-*.tgz.provenance.json"
    "sdk-artifacts/verify-context-magnet-sdk.mjs"
    "plugins/tools/workspaces-sync/definition.ts"
    "plugins/tsconfig.json"
    "plugins/plugins/*/package.json"
    "plugins/packages/bb-identity/type-tests/browser/package.json"
    "plugins/bun.lock"
    "plugins/node_modules/"
  }
  needs {
    module.produced(hostSdkArtifact); module.verified(hostSdkArtifact)
    module.produced(hostTraceSdkRuntime); module.verified(hostTraceSdkRuntime)
  }
  oracle = module.mechanical("node sdk-artifacts/verify-context-magnet-sdk.mjs && bun --cwd=plugins run sync:check && bun --cwd=plugins run sdk-types:check")
}

local receiptAdmissionProbe = new Action {
  id = "receipt-admission-probe"
  owner = "receipt-admission-investigator"
  outcome = "Trace the verified post-arm child turn from bb.agents.configure through host agent-tool selection, injected instructions, provider request construction, and provider-visible tool registration to explain why the retained Context Magnet declaration produced no receipt-tool call. Distinguish declaration persistence from actual model admission, cite the exact source/test seams, identify a safe non-provider-body observation boundary, and specify the narrow implementation and regression needed next without inferring consumption from delivery."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/receipt-admission-probe.md"
  }
  needs {
    module.produced(pluginTraceProducer); module.verified(pluginTraceProducer)
    module.produced(postarmSendContract); module.verified(postarmSendContract)
    module.produced(hostTraceSdkRuntime); module.verified(hostTraceSdkRuntime)
    module.produced(hostSdkRuntimeArtifact); module.verified(hostSdkRuntimeArtifact)
  }
  oracle = module.mechanical("test -s plugins/plugins/context-magnet-inspector/docs/receipt-admission-probe.md")
}

local providerAdmissionContract = new Action {
  id = "provider-admission-contract"
  owner = "admission-contract-author"
  outcome = "Define a provider-neutral Context Magnet admission contract that keeps declaration, constructed provider request, accepted provider request, and model-owned consumption distinct. Require a host-supplied stable association to the retained contribution without timestamp/session/text inference; bounded constructed/accepted phases; explicit unavailable/gap states; exact privacy exclusions for prompts, proofs, instructions, schemas, provider bodies, raw errors, and tool arguments; and a UI-safe projection that cannot label admission as consumption."
  grant {
    "plugins/plugins/context-magnet-inspector/docs/provider-admission-contract.md"
  }
  needs {
    module.produced(receiptAdmissionProbe); module.verified(receiptAdmissionProbe)
