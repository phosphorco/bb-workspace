amends "workbench:plan"

meta {
  title = "Consistent message transcripts"
  goal = "Make all delivered message transcripts match the approved source, sender, original-content and optional-attachments convention."
}

// Implementation commissioned on 2026-09-10; root is execution steward.
// This graph owns follow-up intent; its sibling ledger owns evidence and progress.
// Prior identity fallback deployment remains historical in identities-and-multiplayer.plan.pkl.
// Root coordinates ledger and integration. After contract, native/slack/consumers can run in parallel.
// Delegate with exact node/file ownership; BB workers report by messages, never bb wait.
// Native and consumer shared contracts are owned by contract lane before parallel edits.

local contract = new Action {
  id = "contract"
  owner = "root"
  outcome = "Settle one rendering owner per delivery path and exact transcript fixtures."
  grant {
    "docs/adrs/2026-09-identities-and-multiplayer.md"
    "plans/identity-lanes/transcript-gaps.md"
    "plugins/packages/bb-identity/**"
  }
  oracle = module.adjudicated("Trace native and external contribution assembly through provider input. Specify exact sender/native-reference closing rules, original text, optional attachment association, unknown/edit/delete/multimodal behavior. Prefer existing records and pure rendering; choose shared helper placement only when it reduces duplication without SDK churn. No schema or protocol addition without a demonstrated gap.", "root")
}

local binding = new Action {
  id = "binding"
  owner = "consumers"
  outcome = "Implement explicit host-versus-producer envelope ownership for external contributions and plugin SDK sends/queues."
  needs { module.verified(contract); module.produced(contract) }
  grant { "plugins/packages/bb-identity/**" }
  oracle = module.adjudicated("Optional externalMessageRendering host/producer behaves consistently on fork and upstream. Host renders one minimal envelope for generic callers; producer preserves rendered inputs and configures the optional plugin-scoped native SDK rendering hook. Old enhanced hosts without that hook report incompatibility for producer mode; plain upstream remains supported. Existing source attribution bookkeeping remains; no wire/DB change or body sniffing. Package and adapter tests, types/build and portable examples pass, with source frozen for root packaging.", "root")
}

local artifact = new Action {
  id = "artifact"
  owner = "root"
  outcome = "Pack and pin the changed shared identity library for community consumers."
  needs { module.verified(binding); module.produced(binding) }
  grant { "sdk-artifacts/**"; "community-plugins/package-lock.json"; "community-plugins/plugins/agentation-mentions/package.json" }
  oracle = module.adjudicated("Pack built public package through existing recipe, record hash/source provenance, preserve prior archive, update exact community dependency/lock and run frozen install. Retain SDK archive if SDK source is unchanged. Consumer verification uses actual selected archive, not path aliases or copied declarations.", "root")
}

local native = new Action {
  id = "native"
  owner = "native"
  outcome = "Update native BB transcript assembly through the existing fork patch."
  needs { module.verified(contract); module.produced(contract) }
  grant {
    "fork/patches/0016-*.patch"
    "fork/patches/sha256"
    "fork/result-tree.lock"
  }
  oracle = module.adjudicated("Real HTTP/SDK producer sends and explicit idle queues avoid a synthetic outer machine frame via a plugin-scoped presentation hint; producer snapshots remain in plugin storage. Ordinary person/machine/group/child/CLI inputs retain sender envelopes without nesting; existing command, author/editor, retry/queue and attachment behavior remains correct. Supported replay and relevant core checks pass. Edit materialized source only through fork tooling and update existing patch; no added patch for formatting.", "root")
}

local slack = new Action {
  id = "slack"
  owner = "slack"
  outcome = "Unify Slack initial requests, follow-ups, revisions and retrieved context."
  needs { module.verified(contract); module.produced(contract); module.verified(binding); module.produced(binding) }
  grant {
    "plugins/plugins/rosetta-slack/**"
  }
  oracle = module.adjudicated("Exact ADR examples pass through real plugin assembly: readable source label plus optional Slack reference, original body preserved, enrichment only in nonempty attached block. No initial/follow-up authority banners or blanket UNTRUSTED labels. No double native wrapper. Preserve ordered membership, request lifecycle, deduplication, deletion semantics and Slack credentials. Plugin tests/typecheck/build pass.", "root")
}

local consumers = new Action {
  id = "consumers"
  owner = "consumers"
  outcome = "Migrate Agentation and audit other concrete transcript producers."
  needs { module.verified(contract); module.produced(contract); module.verified(artifact); module.produced(artifact) }
  grant {
    "community-plugins/plugins/agentation-mentions/**"
    ".agents/skills/bb-identity/**"
  }
  oracle = module.adjudicated("Agentation uses the same contract with durable author metadata and unknown history preserved, no hidden mention context. Source search inventory accounts for other actual producers; do not implement a new GitHub integration. Update relevant examples/guidance and verify changed consumers against real selected artifacts.", "root")
}

local verify = new Guard {
  id = "verify"
  owner = "root/gather-perspectives"
  outcome = "Review fully assembled transcripts and ADR faithfulness."
  needs { module.verified(native); module.produced(native); module.verified(slack); module.produced(slack); module.verified(consumers); module.produced(consumers) }
  observes {
    "fork/**"
    "plugins/**"
    "community-plugins/**"
    "plans/identity-lanes/**"
  }
  oracle = module.adjudicated("Review actual full provider inputs, including external contribution and mention expansion, for all assessment cases. Independent review confirms no blanket trust/authority prose, no duplicate envelopes, no needless schema/patch additions. Distinguish controlled tests from live native/Slack evidence. Changed child checks pass; preserve unrelated concurrent changes.", "root")
}

local deliver = new Action {
  id = "deliver"
  owner = "root"
  outcome = "Deploy and promote the verified transcript composition."
  needs { module.verified(verify) }
  grant {
    "fork/**"
    "plugins/**"
    "community-plugins/**"
    "sdk-artifacts/**"
    "plans/identity-lanes/**"
  }
  oracle = module.adjudicated("Build and activate only canonical runtime/plugin roots, inspect live person/machine and configured Slack transcript behavior, and record any unavailable live witness honestly. Preserve old history. Push selected children before workspace gitlinks; normal composition check passes. No new credentials or deployment installation inferred from the example.", "root")
}

local communicate = new Guard {
  id = "communicate"
  owner = "root"
  outcome = "Communicate delivered behavior, examples, verification and any remaining limitations."
  needs { module.produced(deliver); module.verified(deliver) }
  observes { "plans/message-transcripts.ledger.jsonl"; "plans/identity-lanes/**" }
  oracle = module.adjudicated("Final delivery receipt identifies pushed workspace/child revisions, live runtime and actual transcript examples, summarizes behavior and checks, and clearly distinguishes controlled evidence from live Slack evidence. User receives a concise change report with links. No unresolved in-scope implementation or delivery work is hidden behind a complete graph.", "root")
}

nodes { contract; binding; native; artifact; slack; consumers; verify; deliver; communicate }
