#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd -P)"
[[ "$(git -C "$root" rev-parse --show-toplevel)" == "$root" ]]
cd "$root"

expected=(
  'fork https://github.com/phosphorco/bb-fork.git'
  'plugins https://github.com/phosphorco/bb-plugins.git'
  'community-plugins https://github.com/phosphorco/bb-community-plugins.git'
)

for entry in "${expected[@]}"; do
  path="${entry%% *}"
  url="${entry#* }"
  [[ "$(git config -f .gitmodules --get "submodule.$path.url")" == "$url" ]]
  [[ "$(git ls-files --stage -- "$path" | awk '{print $1}')" == 160000 ]]
done

grep -Fq 'MACHINE_BB_WORKSPACE_REV' README.md
grep -Fq 'Never automatically stash' AGENTS.md
grep -Fq '.agents/skills/<name>/SKILL.md' AGENTS.md

if find .agents/skills -mindepth 1 -maxdepth 1 -type f -print -quit | grep -q .; then
  printf 'loose files under .agents/skills are not discoverable skills\n' >&2
  exit 1
fi

for skill_dir in .agents/skills/*; do
  [[ -d "$skill_dir" ]] || continue
  [[ -f "$skill_dir/SKILL.md" ]]
done

for script in bin/check bin/setup-role bin/status bin/test-contract; do
  bash -n "$script"
done

printf 'workspace static contract passed\n'
